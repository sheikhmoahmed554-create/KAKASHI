// ⑦ and ⑩ Keltner touch — the two sides share one set of parameters
G_S7 = "⑦⑩ لمسة Keltner — شراء وبيع"
s7On = input.bool(true, "⑦ شغّل الشراء", group=G_S7)
s10On = input.bool(true, "⑩ شغّل البيع", group=G_S7)
s7Resp = input.bool(true, "⑦ يحترم الصفقة المفتوحة", group=G_S7)
s10Resp = input.bool(true, "⑩ يحترم الصفقة المفتوحة", group=G_S7)
s7Tgt = input.float(4.0, "الهدف ×مدى الشمعة", minval=0.5, maxval=20, step=0.1, group=G_S7)
s7Stp = input.float(2.0, "الستوب ×مدى الشمعة", minval=0.5, maxval=20, step=0.1, group=G_S7)
s7TgtP = input.float(86, "   ...أو الهدف بالنقاط", minval=1, maxval=2000, step=1, group=G_S7)
