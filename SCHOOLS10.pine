// ⑮ five down closes under the 200 — SELL. The biggest earner of the six.
G_S15 = "⑮ خمس إغلاقات هابطة تحت الـ200 — بيع"
s15On = input.bool(false, "شغّل", group=G_S15)
s15Resp = input.bool(true, "يحترم الصفقة المفتوحة", group=G_S15)
s15Tgt = input.float(8.0, "الهدف ×مدى الشمعة", minval=0.5, maxval=30, step=0.1, group=G_S15)
s15Stp = input.float(4.0, "الستوب ×مدى الشمعة", minval=0.5, maxval=30, step=0.1, group=G_S15)
s15TgtP = input.float(171, "   ...أو الهدف بالنقاط", minval=1, maxval=2000, step=1, group=G_S15)
s15StpP = input.float(86, "   ...والستوب بالنقاط", minval=1, maxval=2000, step=1, group=G_S15)
