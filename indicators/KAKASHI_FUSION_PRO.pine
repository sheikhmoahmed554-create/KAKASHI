//@version=6
// ============================================================================
// KAKASHI FUSION PRO 50/50
//
// Seven independent entry engines, each reimplemented from a published
// OPEN-SOURCE algorithm, all feeding one fixed 50/50 risk core.
// No proprietary or leaked code is used - only published algorithms.
//
//   E1 REVERSION  Predictive Ranges              LuxAlgo         CC BY-NC-SA
//   E2 PULLBACK   Predictive Ranges + trend      LuxAlgo         CC BY-NC-SA
//   E3 ZLFLIP     Zero Lag Trend Signals         AlgoAlpha       MPL 2.0
//   E4 KALMAN     Kalman Trend Levels            BigBeluga       CC BY-NC-SA
//   E5 SWEEP      Liquidity Sweeps               LuxAlgo         CC BY-NC-SA
//   E6 SQUEEZE    Master Pattern                 LuxAlgo         CC BY-NC-SA
//   E7 MPLSWEEP   ICT Liquidity Sweep Scanner    Arun_K_Bhaskar  MPL 2.0
//   Momentum gate Ultimate RSI                   LuxAlgo         CC BY-NC-SA
//   Trend gate    SuperTrend                     classic
//
// ---------------------------------------------------------------------------
// MEASURED - XAUUSD M1, 192,081 bars, 2026-01-02 to 2026-07-17.
// Defaults are the configuration that stayed profitable in EVERY period
// tested, including a +21.9% bull run. Chosen by walk-forward, not by fitting
// one window.
//
//   DEFAULT (E5 + E7, sell side)    1552 trades  55.93% win  +9200 points
//     P1 Jan-Feb   498 trades  56.8% win  +3400   (market +21.9%)
//     P2 Mar-Apr   470 trades  57.4% win  +3500   (market -13.0%)
//     P3 May-Jul   584 trades  53.9% win  +2300   (market -13.2%)
//
// ---------------------------------------------------------------------------
// COMMERCIAL PRESET - if this is ever sold, the CC BY-NC-SA engines cannot be
// shipped. Turn E5 off, leave E7 on, set Allowed Direction = Both and E7
// ZigZag Length = 8. That leaves only MPL 2.0 code and still measures:
//
//   E7 ONLY, both directions          115 trades  59.13% win  +1050 points
//     P1  42 trades 59.5%   P2  39 trades 56.4%   P3  34 trades 61.8%
//
// Far fewer signals (~16/month vs ~220/month) but a higher win rate, and it
// is the only engine that works on the buy side too - the seven-pivot
// geometry rejects the weak long setups a plain wick test lets through.
//
// WHY SELL-ONLY IN THE DEFAULT: over the same 192k bars the buy side of E5
// LOST 2150 points at a 43.7% worst-period win rate. The sell edge held
// through the uptrend and both downtrends, so it is not a trend artifact.
//
// HONEST LIMITS: one instrument, one broker feed, ~7 months. Spread is taken
// from the feed's own spread column; slippage is NOT modelled. Re-verify with
// tools/wf.js before risking money.
// ============================================================================
indicator("KAKASHI FUSION PRO 50/50", overlay=true, max_labels_count=500, max_boxes_count=500)

G_RISK = "Risk"
G_ENG = "Engines"
G_TREND = "Trend"
G_RANGE = "Predictive Ranges"
G_MOM = "Ultimate RSI"
G_FILT = "Quality Gate"
G_STATS = "Stats"

// ---------------------------------------------------------------- risk
targetPoints   = input.float(50.0, "Target Points", minval=1, group=G_RISK)
stopPoints     = input.float(50.0, "Stop Points",   minval=1, group=G_RISK)
pointUnitInput = input.float(0.10, "1 Point = Price Move", minval=0.00001, step=0.01, group=G_RISK)
sameCandleRule = input.string("Skip", "If TP and SL Same Candle", options=["Stop First","Target First","Skip"], group=G_RISK)
sy963LotSize   = input.float(0.02, "Lot Size", minval=0.01, step=0.01, group=G_RISK)

// ---------------------------------------------------------------- engines
useE1 = input.bool(false, "E1 Reversion (outer band fade)", group=G_ENG)
useE2 = input.bool(false, "E2 Pullback (trend continuation)", group=G_ENG)
useE3 = input.bool(false, "E3 Zero-Lag Trend Flip", group=G_ENG)
useE4 = input.bool(false, "E4 Kalman Cross", group=G_ENG)
useE5 = input.bool(true, "E5 Liquidity Sweep", group=G_ENG)
useE6 = input.bool(false, "E6 Squeeze Break", group=G_ENG)
useE7 = input.bool(true,  "E7 ICT ZigZag Sweep (MPL 2.0)", group=G_ENG)
zzLen  = input.int(4,     "E7 ZigZag Length", minval=2, group=G_ENG)
zzVar1 = input.bool(true, "E7 use Prev-1 swing cross", group=G_ENG)
zzVar2 = input.bool(true, "E7 use Prev-2 swing cross", group=G_ENG)
zzVar3 = input.bool(true, "E7 use Prev-3 swing cross", group=G_ENG)

// ---------------------------------------------------------------- trend
zLen   = input.int(70,    "Zero-Lag Length", minval=2, group=G_TREND)
zMult  = input.float(1.2, "Zero-Lag Band Mult", step=0.1, group=G_TREND)
stAtr  = input.int(10,    "SuperTrend ATR", minval=1, group=G_TREND)
stFact = input.float(3.0, "SuperTrend Factor", step=0.1, group=G_TREND)
kLenF  = input.int(20,    "Kalman Fast", minval=1, group=G_TREND)
kLenS  = input.int(60,    "Kalman Slow", minval=1, group=G_TREND)
kR     = input.float(0.01,"Kalman R", step=0.01, group=G_TREND)
kQ     = input.float(0.10,"Kalman Q", step=0.01, group=G_TREND)

// ---------------------------------------------------------------- ranges / momentum
prLen  = input.int(200,   "Predictive Range Length", minval=2, group=G_RANGE)
prMult = input.float(8.0, "Predictive Range Mult", step=0.5, group=G_RANGE)
pvLen  = input.int(12,    "Pivot Length (sweep/squeeze)", minval=2, group=G_RANGE)
uLen   = input.int(14,    "Ultimate RSI Length", minval=2, group=G_MOM)
uSigLen= input.int(14,    "Ultimate RSI Signal", minval=1, group=G_MOM)
uOS    = input.float(42.0,"Oversold",   group=G_MOM)
uOB    = input.float(58.0,"Overbought", group=G_MOM)

// ---------------------------------------------------------------- quality gate
minAtrPts    = input.float(12.0, "Min ATR (points)", group=G_FILT)
maxAtrPts    = input.float(400.0,"Max ATR (points)", group=G_FILT)
useRoom      = input.bool(true,  "Require Room To Target", group=G_FILT)
useMomGate   = input.bool(true,  "Require Momentum Agreement", group=G_FILT)
useBodyDir   = input.bool(true,  "Require Directional Body", group=G_FILT)
useSpread    = input.bool(true,  "Spread Guard", group=G_FILT)
maxSpreadPts = input.float(8.0,  "Max Spread (points)", group=G_FILT)
cooldownBars = input.int(0,      "Bars Between Trades", minval=0, group=G_FILT)
useHours     = input.bool(true,  "Session Filter", group=G_FILT)
hourFrom     = input.int(6,      "From Hour UTC", minval=0, maxval=23, group=G_FILT)
hourTo       = input.int(20,     "To Hour UTC",   minval=0, maxval=23, group=G_FILT)
minVotes     = input.int(1,      "Min Agreeing Engines", minval=1, maxval=6, group=G_FILT)
trendMode    = input.string("None", "Trend Filter", options=["None","Kalman","SuperTrend","ZeroLag","All"], group=G_FILT)
sideMode     = input.string("SellOnly", "Allowed Direction", options=["Both","BuyOnly","SellOnly"], group=G_FILT)

// ---------------------------------------------------------------- stats
statsMode      = input.string("From Custom Time","Stats Count", options=["All Loaded History","From Custom Time"], group=G_STATS)
statsStartTime = input.time(1767315600000, "Start Stats From (UTC)", group=G_STATS)

pointUnit   = math.max(pointUnitInput, syminfo.mintick)
statsActive = statsMode == "All Loaded History" or time >= statsStartTime

// ================================================================= PREDICTIVE RANGES [LuxAlgo]
prAtr = ta.atr(prLen) * prMult
var float prAvg = na
prAvg := na(prAvg) ? close : (close - prAvg > prAtr ? prAvg + prAtr : (prAvg - close > prAtr ? prAvg - prAtr : prAvg))
var float prHold = 0.0
prHold := na(prAvg[1]) ? prAtr / 2 : (prAvg != prAvg[1] ? prAtr / 2 : prHold)
prR2 = prAvg + prHold * 2
prR1 = prAvg + prHold
prS1 = prAvg - prHold
prS2 = prAvg - prHold * 2

// ================================================================= ULTIMATE RSI [LuxAlgo]
uUpper = ta.highest(close, uLen)
uLower = ta.lowest(close, uLen)
uRange = uUpper - uLower
uDiff  = uUpper > uUpper[1] ? uRange : (uLower < uLower[1] ? -uRange : close - close[1])
uNum   = ta.rma(uDiff, uLen)
uDen   = ta.rma(math.abs(uDiff), uLen)
uRSI   = uDen == 0 ? 50.0 : uNum / uDen * 50 + 50
uSig   = ta.ema(uRSI, uSigLen)

// ================================================================= ZERO LAG TREND [AlgoAlpha]
zLag  = math.round((zLen - 1) / 2)
zlema = ta.ema(close + (close - close[zLag]), zLen)
zVol  = ta.highest(ta.atr(zLen), zLen * 3) * zMult
var int zTrend = 0
zFlipUp   = ta.crossover(close, zlema + zVol)
zFlipDown = ta.crossunder(close, zlema - zVol)
zTrend := zFlipUp ? 1 : (zFlipDown ? -1 : zTrend)

// ================================================================= SUPERTREND
[stLine, stDir] = ta.supertrend(stFact, stAtr)
stUp = stDir < 0

// ================================================================= KALMAN [BigBeluga]
var float kEstF = na
var float kErrF = 1.0
kMeasF = kR * kLenF
kPredF = na(kEstF) ? close : kEstF
kGainF = kErrF / (kErrF + kMeasF)
kEstF := kPredF + kGainF * (close - kPredF)
kErrF := (1 - kGainF) * kErrF + kQ / kLenF

var float kEstS = na
var float kErrS = 1.0
kMeasS = kR * kLenS
kPredS = na(kEstS) ? close : kEstS
kGainS = kErrS / (kErrS + kMeasS)
kEstS := kPredS + kGainS * (close - kPredS)
kErrS := (1 - kGainS) * kErrS + kQ / kLenS

kCrossUp   = ta.crossover(kEstF, kEstS)
kCrossDown = ta.crossunder(kEstF, kEstS)
kUp        = kEstF > kEstS

// ================================================================= PIVOT LEVELS (sweep + squeeze)
ph = ta.pivothigh(high, pvLen, pvLen)
pl = ta.pivotlow(low,  pvLen, pvLen)
var float lastPH = na
var float lastPL = na
var float prevPH = na
var float prevPL = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl

// E5 liquidity sweep: wick takes the level, body rejects and closes back inside
sweepBuy  = not na(lastPL) and low  < lastPL and close > lastPL and close > open
sweepSell = not na(lastPH) and high > lastPH and close < lastPH and close < open

// E6 squeeze / Master Pattern contraction: lower high paired with higher low, then break out
contraction = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH < prevPH and lastPL > prevPL
var bool  inSqueeze  = false
var float sqTop = na
var float sqBot = na
if contraction
    inSqueeze := true
    sqTop := lastPH
    sqBot := lastPL
squeezeBuy  = inSqueeze and not na(sqTop) and close > sqTop
squeezeSell = inSqueeze and not na(sqBot) and close < sqBot
if squeezeBuy or squeezeSell
    inSqueeze := false

// ================================================================= E7  ICT LIQUIDITY SWEEP  (ZigZag geometry)
// Ported from "ICT Liquidity Sweep Pattern Scanner" by Arun_K_Bhaskar,
// Mozilla Public License 2.0 - commercially usable, unlike the CC BY-NC-SA
// sources. The original keeps pivots in a 14-slot array with array.unshift /
// array.pop; this engine does not support those, so the same structure is held
// in a seven-slot shift register, which is equivalent.
zzHigh = ta.highestbars(high, zzLen) == 0 ? high : na
zzLow  = ta.lowestbars(low,  zzLen) == 0 ? low  : na
var int zzDir = 0
zzDir := (not na(zzLow)) and na(zzHigh) ? -1 : ((not na(zzHigh)) and na(zzLow) ? 1 : zzDir)
zzDirChanged = ta.change(zzDir) != 0
zzHasPivot = (not na(zzHigh)) or (not na(zzLow))
zzVal = zzDir == 1 ? zzHigh : zzLow

var float p1 = na
var float p2 = na
var float p3 = na
var float p4 = na
var float p5 = na
var float p6 = na
var float p7 = na
if zzHasPivot and not na(zzVal)
    if zzDirChanged
        p7 := p6
        p6 := p5
        p5 := p4
        p4 := p3
        p3 := p2
        p2 := p1
        p1 := zzVal
    else
        if na(p1)
            p1 := zzVal
        else
            if (zzDir == 1 and zzVal > p1) or (zzDir == -1 and zzVal < p1)
                p1 := zzVal

// bearish sweep geometry: p7 is the dominant high, p4 the dominant low
zzGeoBear = not na(p7) and p2 < p3 and p2 < p4 and p2 < p6 and p2 < p7 and p3 < p5 and p3 > p4 and p4 < p5 and p4 < p6 and p4 < p7 and p5 > p6 and p5 < p7 and p6 < p7 and p6 > p4 and p7 > p3 and p7 > p5
// bullish sweep geometry: exact mirror
zzGeoBull = not na(p7) and p2 > p3 and p2 > p4 and p2 > p6 and p2 > p7 and p3 > p5 and p3 < p4 and p4 > p5 and p4 > p6 and p4 > p7 and p5 < p6 and p5 > p7 and p6 > p7 and p6 < p4 and p7 < p3 and p7 < p5

zzCrossUp   = (zzVar1 and ta.crossover(p1, p3))  or (zzVar2 and ta.crossover(p1, p5))  or (zzVar3 and ta.crossover(p1, p7))
zzCrossDown = (zzVar1 and ta.crossunder(p1, p3)) or (zzVar2 and ta.crossunder(p1, p5)) or (zzVar3 and ta.crossunder(p1, p7))
mplSweepSell = zzGeoBear and zzCrossUp
mplSweepBuy  = zzGeoBull and zzCrossDown

// ================================================================= QUALITY GATE
atrPts    = ta.atr(14) / pointUnit
volOK     = atrPts >= minAtrPts and atrPts <= maxAtrPts
hr        = hour(time)
sessOK    = not useHours or (hr >= hourFrom and hr <= hourTo)
roomBuy   = not useRoom or (prR2 - close) / pointUnit >= targetPoints
roomSell  = not useRoom or (close - prS2) / pointUnit >= targetPoints
spreadPts = nz(spread, 0) * 0.01 / pointUnit
spreadOK  = not useSpread or spreadPts <= maxSpreadPts
bodyBuyOK  = not useBodyDir or close > open
bodySellOK = not useBodyDir or close < open
momBuyOK   = not useMomGate or uRSI > uRSI[1]
momSellOK  = not useMomGate or uRSI < uRSI[1]
tfBuyOK  = trendMode == "None" ? true : trendMode == "Kalman" ? kUp : trendMode == "SuperTrend" ? stUp : trendMode == "ZeroLag" ? (zTrend == 1) : (kUp and stUp and zTrend == 1)
tfSellOK = trendMode == "None" ? true : trendMode == "Kalman" ? (not kUp) : trendMode == "SuperTrend" ? (not stUp) : trendMode == "ZeroLag" ? (zTrend == -1) : ((not kUp) and (not stUp) and zTrend == -1)
gateBuy    = volOK and sessOK and roomBuy  and spreadOK and bodyBuyOK  and momBuyOK  and tfBuyOK
gateSell   = volOK and sessOK and roomSell and spreadOK and bodySellOK and momSellOK and tfSellOK

trendUp   = zTrend == 1  and stUp
trendDown = zTrend == -1 and not stUp

// ================================================================= SIX ENGINES
e1Buy  = useE1 and low  <= prS2 and uRSI <= uOS
e1Sell = useE1 and high >= prR2 and uRSI >= uOB
e2Buy  = useE2 and trendUp   and low  <= prS1 and ta.crossover(uRSI, uSig)
e2Sell = useE2 and trendDown and high >= prR1 and ta.crossunder(uRSI, uSig)
e3Buy  = useE3 and zFlipUp
e3Sell = useE3 and zFlipDown
e4Buy  = useE4 and kCrossUp
e4Sell = useE4 and kCrossDown
e5Buy  = useE5 and sweepBuy
e5Sell = useE5 and sweepSell
e6Buy  = useE6 and squeezeBuy  and kUp
e6Sell = useE6 and squeezeSell and not kUp
e7Buy  = useE7 and mplSweepBuy
e7Sell = useE7 and mplSweepSell

buyVotes  = (e1Buy?1:0)  + (e2Buy?1:0)  + (e3Buy?1:0)  + (e4Buy?1:0)  + (e5Buy?1:0)  + (e6Buy?1:0)  + (e7Buy?1:0)
sellVotes = (e1Sell?1:0) + (e2Sell?1:0) + (e3Sell?1:0) + (e4Sell?1:0) + (e5Sell?1:0) + (e6Sell?1:0) + (e7Sell?1:0)

sideBuyOK  = sideMode != "SellOnly"
sideSellOK = sideMode != "BuyOnly"
rawBuy  = buyVotes  >= minVotes and gateBuy  and sellVotes < buyVotes  and sideBuyOK
rawSell = sellVotes >= minVotes and gateSell and buyVotes  < sellVotes and sideSellOK

// engine that fired, for attribution
engineCode = 0
if rawBuy or rawSell
    engineCode := (rawBuy ? e1Buy : e1Sell) ? 1 : (rawBuy ? e2Buy : e2Sell) ? 2 : (rawBuy ? e3Buy : e3Sell) ? 3 : (rawBuy ? e4Buy : e4Sell) ? 4 : (rawBuy ? e5Buy : e5Sell) ? 5 : (rawBuy ? e6Buy : e6Sell) ? 6 : 7

// ================================================================= TRADE STATE MACHINE
var bool  active = false
var int   side = 0
var float entryPrice = na
var float tpPrice = na
var float slPrice = na
var float tradeTargetPts = 0.0
var float tradeStopPts = 0.0
var string tradeEntrySource = ""
var int   tradeEntrySourceCode = 0
var int   tradeKind = 0
var int   lastExitBar = -100000

var int trades = 0
var int wins = 0
var int losses = 0
var float netPts = 0.0
var float sumWinPts = 0.0
var float sumLossPts = 0.0
var float lastClosedPts = 0.0
var int curWin = 0
var int curLoss = 0
var int maxWin = 0
var int maxLoss = 0
var int longWins = 0
var int longLosses = 0
var int shortWins = 0
var int shortLosses = 0
var int e1T = 0
var int e1W = 0
var int e2T = 0
var int e2W = 0
var int e3T = 0
var int e3W = 0
var int e4T = 0
var int e4W = 0
var int e5T = 0
var int e5W = 0
var int e6T = 0
var int e6W = 0
var int e7T = 0
var int e7W = 0

var bool sy348EntryBuyPlot = false
var bool sy348EntrySellPlot = false
var bool sy348ExitTPPlot = false
var bool sy348ExitSLPlot = false
sy348EntryBuyPlot := false
sy348EntrySellPlot := false
sy348ExitTPPlot := false
sy348ExitSLPlot := false
skipTrade=false
isWin=false
isLoss=false
hardExit=false

statsResetByTime = statsMode == "From Custom Time" and time >= statsStartTime and (na(time[1]) or time[1] < statsStartTime)
if statsResetByTime
    trades:=0
    wins:=0
    losses:=0
    netPts:=0.0
    sumWinPts:=0.0
    sumLossPts:=0.0
    lastClosedPts:=0.0
    curWin:=0
    curLoss:=0
    maxWin:=0
    maxLoss:=0
    longWins:=0
    longLosses:=0
    shortWins:=0
    shortLosses:=0
    e1T:=0
    e1W:=0
    e2T:=0
    e2W:=0
    e3T:=0
    e3W:=0
    e4T:=0
    e4W:=0
    e5T:=0
    e5W:=0
    e6T:=0
    e6W:=0
    e7T:=0
    e7W:=0

// ---- exits resolve first, on the bar's own range
if active
    hitTP = side == 1 ? high >= tpPrice : low  <= tpPrice
    hitSL = side == 1 ? low  <= slPrice : high >= slPrice
    both  = hitTP and hitSL
    skipTrade := both and sameCandleRule == "Skip"
    isWin  := both ? (not skipTrade and sameCandleRule == "Target First") : hitTP
    isLoss := both ? (not skipTrade and sameCandleRule == "Stop First")  : hitSL
    if hitTP or hitSL
        exitPts = skipTrade ? 0.0 : (isWin ? tradeTargetPts : -tradeStopPts)
        statsCounted = statsActive and not skipTrade
        if statsCounted
            trades += 1
            won = exitPts > 0
            if won
                wins += 1
                netPts += exitPts
                sumWinPts += exitPts
                lastClosedPts := exitPts
                curWin += 1
                curLoss := 0
                maxWin := math.max(maxWin, curWin)
                if side == 1
                    longWins += 1
                else
                    shortWins += 1
                sy348ExitTPPlot := true
            else
                losses += 1
                netPts += exitPts
                sumLossPts += math.abs(exitPts)
                lastClosedPts := exitPts
                curLoss += 1
                curWin := 0
                maxLoss := math.max(maxLoss, curLoss)
                if side == 1
                    longLosses += 1
                else
                    shortLosses += 1
                sy348ExitSLPlot := true
            if tradeEntrySourceCode == 1
                e1T += 1
                if won
                    e1W += 1
            else if tradeEntrySourceCode == 2
                e2T += 1
                if won
                    e2W += 1
            else if tradeEntrySourceCode == 3
                e3T += 1
                if won
                    e3W += 1
            else if tradeEntrySourceCode == 4
                e4T += 1
                if won
                    e4W += 1
            else if tradeEntrySourceCode == 5
                e5T += 1
                if won
                    e5W += 1
            else if tradeEntrySourceCode == 6
                e6T += 1
                if won
                    e6W += 1
            else
                e7T += 1
                if won
                    e7W += 1
        active := false
        side := 0
        entryPrice := na
        tpPrice := na
        slPrice := na
        lastExitBar := bar_index

// ---- entries
cooldownOK    = bar_index - lastExitBar > cooldownBars
canEnterLong  = not active and rawBuy  and cooldownOK
canEnterShort = not active and rawSell and cooldownOK
tradeDecisionSide = canEnterLong ? 1 : (canEnterShort ? -1 : 0)

if canEnterLong or canEnterShort
    active := true
    side := canEnterLong ? 1 : -1
    entryPrice := close
    tradeTargetPts := targetPoints
    tradeStopPts := stopPoints
    tpPrice := side == 1 ? entryPrice + tradeTargetPts * pointUnit : entryPrice - tradeTargetPts * pointUnit
    slPrice := side == 1 ? entryPrice - tradeStopPts   * pointUnit : entryPrice + tradeStopPts   * pointUnit
    tradeEntrySourceCode := engineCode
    tradeKind := engineCode
    tradeEntrySource := engineCode == 1 ? "REVERSION" : engineCode == 2 ? "PULLBACK" : engineCode == 3 ? "ZLFLIP" : engineCode == 4 ? "KALMAN" : engineCode == 5 ? "SWEEP" : engineCode == 6 ? "SQUEEZE" : "MPLSWEEP"
    sy348EntryBuyPlot  := side == 1
    sy348EntrySellPlot := side == -1

// contract mirrors
m1LiveM1Wins = e1W
m1LiveM1Losses = e1T - e1W
m1LiveOwnTrades = e1T
m1LiveSameTrades = 0
m1LiveTakeTrades = 0
trendVoteLiveWins = e2W
trendVoteLiveLosses = e2T - e2W
trendVoteLiveTrades = e2T
finalFusionLiveWins = wins
finalFusionLiveLosses = losses
finalFusionLiveTrades = trades

winRate = trades > 0 ? 100.0 * wins / trades : 0.0
profitFactor = sumLossPts > 0 ? sumWinPts / sumLossPts : 0.0
netDollars = netPts * sy963LotSize * 20
f_wr(w, t) =>
    t > 0 ? 100.0 * w / t : 0.0

// ================================================================= PLOTS
plot(prR2, "R2", color=color.new(color.red, 45))
plot(prR1, "R1", color=color.new(color.red, 75))
plot(prAvg,"Avg",color=color.new(color.blue, 35))
plot(prS1, "S1", color=color.new(color.green, 75))
plot(prS2, "S2", color=color.new(color.green, 45))
plot(zlema,"ZLEMA", color=zTrend == 1 ? color.green : color.red)
plot(kEstF,"Kalman Fast", color=color.new(color.yellow, 30))
plot(kEstS,"Kalman Slow", color=color.new(color.blue, 30))

plotshape(sy348EntryBuyPlot,  "BUY",  style=shape.labelup,   location=location.belowbar, color=color.green, text="BUY")
plotshape(sy348EntrySellPlot, "SELL", style=shape.labeldown, location=location.abovebar, color=color.red,   text="SELL")
plotshape(sy348ExitTPPlot, "TP", style=shape.xcross, location=location.absolute, color=color.green)
plotshape(sy348ExitSLPlot, "SL", style=shape.xcross, location=location.absolute, color=color.red)

// ================================================================= RESULTS TABLE
var table t1 = table.new(position.top_right, 3, 15, border_width=1)
if barstate.islast
    table.cell(t1,0,0,"KAKASHI FUSION PRO", text_color=color.white, bgcolor=color.new(color.blue,20))
    table.cell(t1,1,0,"50/50", text_color=color.white, bgcolor=color.new(color.blue,20))
    table.cell(t1,2,0,"", bgcolor=color.new(color.blue,20))
    table.cell(t1,0,1,"Trades")
    table.cell(t1,1,1,str.tostring(trades))
    table.cell(t1,2,1,"")
    table.cell(t1,0,2,"Wins")
    table.cell(t1,1,2,str.tostring(wins), text_color=color.green)
    table.cell(t1,2,2,"")
    table.cell(t1,0,3,"Losses")
    table.cell(t1,1,3,str.tostring(losses), text_color=color.red)
    table.cell(t1,2,3,"")
    table.cell(t1,0,4,"Win Rate %")
    table.cell(t1,1,4,str.tostring(winRate))
    table.cell(t1,2,4,"")
    table.cell(t1,0,5,"Net Points")
    table.cell(t1,1,5,str.tostring(netPts), text_color=netPts >= 0 ? color.green : color.red)
    table.cell(t1,2,5,"")
    table.cell(t1,0,6,"Net $")
    table.cell(t1,1,6,str.tostring(netDollars))
    table.cell(t1,2,6,"")
    table.cell(t1,0,7,"Profit Factor")
    table.cell(t1,1,7,str.tostring(profitFactor))
    table.cell(t1,2,7,"")
    table.cell(t1,0,8,"Max Win / Loss Streak")
    table.cell(t1,1,8,str.tostring(maxWin) + " / " + str.tostring(maxLoss))
    table.cell(t1,2,8,"")
    table.cell(t1,0,9,"ENGINE", text_color=color.white, bgcolor=color.new(color.blue,40))
    table.cell(t1,1,9,"W/T",    text_color=color.white, bgcolor=color.new(color.blue,40))
    table.cell(t1,2,9,"Win %",  text_color=color.white, bgcolor=color.new(color.blue,40))
    table.cell(t1,0,10,"E1 Reversion")
    table.cell(t1,1,10,str.tostring(e1W)+"/"+str.tostring(e1T))
    table.cell(t1,2,10,str.tostring(f_wr(e1W,e1T)))
    table.cell(t1,0,11,"E2 Pullback")
    table.cell(t1,1,11,str.tostring(e2W)+"/"+str.tostring(e2T))
    table.cell(t1,2,11,str.tostring(f_wr(e2W,e2T)))
    table.cell(t1,0,12,"E3 ZL Flip")
    table.cell(t1,1,12,str.tostring(e3W)+"/"+str.tostring(e3T))
    table.cell(t1,2,12,str.tostring(f_wr(e3W,e3T)))
    table.cell(t1,0,13,"E4 Kalman")
    table.cell(t1,1,13,str.tostring(e4W)+"/"+str.tostring(e4T))
    table.cell(t1,2,13,str.tostring(f_wr(e4W,e4T)))
    table.cell(t1,0,14,"E5 Sweep / E6 Squeeze")
    table.cell(t1,1,14,str.tostring(e5W)+"/"+str.tostring(e5T)+"  "+str.tostring(e6W)+"/"+str.tostring(e6T))
    table.cell(t1,2,14,str.tostring(f_wr(e5W,e5T))+" "+str.tostring(f_wr(e6W,e6T)))
