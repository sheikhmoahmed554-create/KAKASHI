//@version=6
// KAKASHI LAB B — مولّد آلياً من بحث كاكاشي
// النسخة B • 150 عائلة (57 شراء، 93 بيع)
// قياس خارج العينة: 67.8% فوز • 35.1 صفقة/يوم • توقّع +4.72 نقطة • متوسط 7.0 شمعة
// القيود: صفقة واحدة مفتوحة • وقف زمني 30 شمعة • هدف 30 / وقف 50
indicator("KAKASHI LAB B", overlay=true, max_bars_back=600)

// ══════════ الخصائص ══════════
pu   = 0.1
dayIdx = int(time / 86400000)
newDay = dayIdx != dayIdx[1]
atrR = ta.rma(ta.tr(true), 14)
atr14 = atrR / pu
atr60 = ta.rma(ta.tr(true), 60) / pu
atr_ratio = atr14 / math.max(atr60, 1e-9)
atr_accel = atr14 / math.max(atr14[30], 1e-9)
rng = math.max(high - low, 1e-9)

rsi14 = ta.rsi(close, 14)
rsi3  = ta.rsi(close, 3)
body  = math.abs(close - open) / rng
dnwick = (math.min(open, close) - low) / rng

ret1 = (close - close[1]) / pu
ret5 = (close - close[5]) / pu
roc5 = (close - close[5]) / math.max(close[5], 1e-9) * 10000

hh20 = ta.highest(high, 20)
ll20 = ta.lowest(low, 20)
hh60 = ta.highest(high, 60)
ll60 = ta.lowest(low, 60)
hh240 = ta.highest(high, 240)
ll240 = ta.lowest(low, 240)
pos20  = (close - ll20)  / math.max(hh20 - ll20, 1e-9) * 100
pos60  = (close - ll60)  / math.max(hh60 - ll60, 1e-9) * 100
pos240 = (close - ll240) / math.max(hh240 - ll240, 1e-9) * 100

bbMid = ta.sma(close, 20)
bbSd = ta.stdev(close, 20)
bb_z = (close - bbMid) / math.max(bbSd, 1e-9)
kMid = ta.ema(close, 20)
kAtr = ta.rma(math.max(high - low, 1e-9), 20)
kelt_z = (close - kMid) / math.max(2 * kAtr, 1e-9)
bb_squeeze = (bbSd * 4) / math.max(kAtr * 2, 1e-9)

ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
ema9_21  = (ema9 - ema21) / pu
ema21_50 = (ema21 - ema50) / pu

vol_ratio = nz(volume, 0) / math.max(ta.sma(nz(volume, 0), 60), 1e-9)

stoch5  = (close - ta.lowest(low, 5))  / math.max(ta.highest(high, 5)  - ta.lowest(low, 5),  1e-9) * 100
stoch14 = (close - ta.lowest(low, 14)) / math.max(ta.highest(high, 14) - ta.lowest(low, 14), 1e-9) * 100
stoch21 = (close - ta.lowest(low, 21)) / math.max(ta.highest(high, 21) - ta.lowest(low, 21), 1e-9) * 100
willr5  = -100 * (ta.highest(high, 5)  - close) / math.max(ta.highest(high, 5)  - ta.lowest(low, 5),  1e-9)
willr14 = -100 * (ta.highest(high, 14) - close) / math.max(ta.highest(high, 14) - ta.lowest(low, 14), 1e-9)
willr21 = -100 * (ta.highest(high, 21) - close) / math.max(ta.highest(high, 21) - ta.lowest(low, 21), 1e-9)
mfTyp = hlc3
mfRaw = mfTyp * nz(volume, 0)
mfUp  = mfTyp > mfTyp[1] ? mfRaw : 0.0
mfDn  = mfTyp < mfTyp[1] ? mfRaw : 0.0
mfi14 = 100 - 100 / (1 + ta.sma(mfUp, 14) / math.max(ta.sma(mfDn, 14), 1e-9))
[pDI, mDI, adxv] = ta.dmi(14, 14)
adx = adxv
di_diff = pDI - mDI

// VWAP يومي وانحرافه بالـ ATR
var float vwCumPV = 0.0
var float vwCumV  = 0.0
vwTyp = hlc3
vwV   = math.max(nz(volume, 0), 1e-9)
if newDay
    vwCumPV := vwTyp * vwV
    vwCumV  := vwV
else
    vwCumPV := vwCumPV + vwTyp * vwV
    vwCumV  := vwCumV + vwV
vwapD = vwCumPV / math.max(vwCumV, 1e-9)
vwap_dist = (close - vwapD) / pu
vwap_dist_atr = vwap_dist / math.max(atr14, 1e-9)

// إيشيموكو
ten = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2
kij = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
ichi_price_kij = (close - kij) / pu
ichi_price_kij_atr = ichi_price_kij / math.max(atr14, 1e-9)

// Parabolic SAR
var float sarv = na
var float sarEP = na
var float sarAF = 0.02
var bool  sarUp = true
if na(sarv)
    sarv := low
    sarEP := high
else
    sarv := sarv + sarAF * (sarEP - sarv)
    if sarUp
        if low < sarv
            sarUp := false
            sarv := sarEP
            sarEP := low
            sarAF := 0.02
        else if high > sarEP
            sarEP := high
            sarAF := math.min(sarAF + 0.02, 0.2)
    else
        if high > sarv
            sarUp := true
            sarv := sarEP
            sarEP := high
            sarAF := 0.02
        else if low < sarEP
            sarEP := low
            sarAF := math.min(sarAF + 0.02, 0.2)
sar_dist = (close - sarv) / pu
sar_dist_atr = sar_dist / math.max(atr14, 1e-9)

// دونشيان
dh20 = ta.highest(high, 20)[1]
dl20 = ta.lowest(low, 20)[1]
dh55 = ta.highest(high, 55)
dl55 = ta.lowest(low, 55)
donch55_pos = (close - dl55) / math.max(dh55 - dl55, 1e-9) * 100
donch20_brk_dn = close < dl20 ? 1 : 0
donch55_brk_dn = close < ta.lowest(low, 55)[1] ? 1 : 0

// نقاط محورية يومية من اليوم السابق
var float curH = na
var float curL = na
var float pdH  = na
var float pdL  = na
var float pdC  = na
if newDay
    pdH := curH
    pdL := curL
    pdC := close[1]
    curH := high
    curL := low
else
    curH := math.max(nz(curH, high), high)
    curL := math.min(nz(curL, low), low)
pivP = (nz(pdH) + nz(pdL) + nz(pdC)) / 3
piv_dist    = na(pdH) ? 0.0 : (close - pivP) / pu
piv_r1_dist = na(pdH) ? 0.0 : (close - (2 * pivP - pdL)) / pu
piv_s1_dist = na(pdH) ? 0.0 : (close - (2 * pivP - pdH)) / pu
piv_r1_dist_atr = piv_r1_dist / math.max(atr14, 1e-9)
piv_s1_dist_atr = piv_s1_dist / math.max(atr14, 1e-9)

// فيبوناتشي من مدى 120 شمعة
fH = ta.highest(high, 120)
fL = ta.lowest(low, 120)
fSpan = math.max(fH - fL, 1e-9)
fib_382_dist_atr = ((close - (fL + fSpan * 0.382)) / pu) / math.max(atr14, 1e-9)

// هيكل السوق: قمم وقيعان مؤكَّدة بعد 3 شموع
swH = ta.pivothigh(high, 3, 3)
swL = ta.pivotlow(low, 3, 3)
var float lastSwH = na
var float lastSwL = na
if not na(swH)
    lastSwH := swH
if not na(swL)
    lastSwL := swL
dist_swing_hi = na(lastSwH) ? 0.0 : (lastSwH - close) / pu
dist_swing_lo = na(lastSwL) ? 0.0 : (close - lastSwL) / pu

// اكتساح السيولة ودايفرجنس
sweep_high = (high > ta.highest(high, 20)[1] and close < ta.highest(high, 20)[1]) ? 1 : 0
pMin30 = ta.lowest(close, 30)
rMin30 = ta.lowest(rsi14, 30)
div_bull = (close <= pMin30 and rsi14 > rMin30 + 3) ? 1 : 0

// سلاسل الصعود والهبوط
var int upS = 0
var int dnS = 0
upS := close > open ? upS + 1 : 0
dnS := close < open ? dnS + 1 : 0
up_streak = upS
dn_streak = dnS

// نطاق افتتاح اليوم (أول 60 دقيقة)
var float orH = na
var float orL = na
var int    orN = 0
if newDay
    orH := high
    orL := low
    orN := 0
else
    orN := orN + 1
    if orN < 60
        orH := math.max(orH, high)
        orL := math.min(orL, low)
or_pos    = (na(orH) or orH <= orL) ? 50.0 : (close - orL) / math.max(orH - orL, 1e-9) * 100
or_brk_up = (not na(orH) and close > orH and orN >= 60) ? 1 : 0

// ميل الفريمات الأعلى (مبني من M1)
e45  = ta.ema(close, 45)
htf5_slope  = (e45  - e45[5])   / pu
e135 = ta.ema(close, 135)
htf15_slope = (e135 - e135[15]) / pu
e540 = ta.ema(close, 540)
htf60_slope = (e540 - e540[60]) / pu

// الجلسات بتوقيت UTC
hUTC = hour(time, "UTC")
sess_asia   = (hUTC >= 0  and hUTC < 7)  ? 1 : 0
sess_london = (hUTC >= 7  and hUTC < 13) ? 1 : 0
sess_ny     = (hUTC >= 13 and hUTC < 21) ? 1 : 0


// ══════════ القواعد ══════════
r001 = piv_r1_dist > 697.3 and pos20 > 82.83 and vwap_dist_atr > 13.67   // SELL 79.1% / 79.2%
r002 = rsi14 < 26.99 and or_brk_up == 1 and sar_dist_atr < -2.862 and dist_swing_lo < -48.3   // BUY 76.4% / 76.9%
r003 = kelt_z < -1.489 and or_brk_up == 1 and mfi14 < 30.01 and donch20_brk_dn == 1   // BUY 75.2% / 80.9%
r004 = atr_ratio < 0.7661 and vwap_dist_atr > 10.69 and sess_ny == 1 and atr_accel < 0.7666   // SELL 75.6% / 75.0%
r005 = piv_r1_dist > 697.3 and rsi3 > 74.73 and vwap_dist_atr > 13.67   // SELL 75.0% / 74.5%
r006 = or_pos > 680.3 and vwap_dist_atr > 13.67 and willr5 > -15.55   // SELL 75.4% / 74.4%
r007 = piv_r1_dist > 697.3 and mfi14 > 63.5 and piv_dist > 1319   // SELL 74.4% / 75.7%
r008 = or_pos > 466.2 and sweep_high == 1 and vwap_dist_atr > 10.69   // SELL 80.5% / 74.0%
r009 = piv_dist > 1319 and mfi14 > 56.36 and or_pos > 466.2   // SELL 73.9% / 75.8%
r010 = rsi14 < 26.99 and or_brk_up == 1 and sar_dist_atr < -2.198 and mfi14 < 30.01   // BUY 73.8% / 74.2%
r011 = or_pos > 466.2 and stoch21 > 82.8 and vwap_dist_atr > 18.37   // SELL 74.0% / 73.6%
r012 = or_pos > 466.2 and stoch21 > 82.8 and atr_ratio < 0.8338 and willr21 > -17.18   // SELL 77.5% / 73.6%
r013 = or_pos > 680.3 and vwap_dist_atr > 13.67 and stoch21 > 82.8   // SELL 78.0% / 73.3%
r014 = or_pos > 466.2 and rsi3 > 84.28 and piv_dist > 929.4   // SELL 73.2% / 76.5%
r015 = vwap_dist_atr > 24.58 and or_pos > 466.2 and vwap_dist > 203.5   // SELL 73.2% / 73.2%
r016 = ichi_price_kij_atr < -2.047 and fib_382_dist_atr < -5.683 and roc5 < -13.68   // BUY 73.2% / 80.5%
r017 = sar_dist_atr < -3.399 and donch55_pos < 2.167 and or_brk_up == 1 and dn_streak > 2   // BUY 73.1% / 73.9%
r018 = fib_382_dist_atr < -4.993 and adx > 38.24 and dist_swing_lo < -48.3 and donch55_pos < 5.649   // BUY 73.4% / 73.1%
r019 = piv_r1_dist > -114.7 and kelt_z < -0.5562 and bb_squeeze > 4.111 and rsi14 < 40.72   // BUY 73.5% / 73.1%
r020 = vwap_dist_atr > 18.37 and pos20 > 87.48 and ret5 > 23.1   // SELL 73.0% / 73.5%
r021 = ichi_price_kij_atr < -2.725 and htf15_slope > 13.02 and mfi14 < 25.84   // BUY 73.0% / 79.1%
r022 = piv_r1_dist > 697.3 and mfi14 > 63.5 and willr5 > -15.55   // SELL 72.9% / 76.2%
r023 = vwap_dist_atr > 13.67 and sweep_high == 1 and piv_s1_dist_atr > 69.87   // SELL 73.0% / 72.9%
r024 = ichi_price_kij_atr < -2.047 and fib_382_dist_atr < -5.683 and mfi14 < 32.32   // BUY 72.8% / 72.7%
r025 = fib_382_dist_atr < -4.557 and mfi14 < 27.84 and vol_ratio > 1.312   // BUY 73.1% / 72.7%
r026 = vwap_dist_atr > 13.67 and sweep_high == 1 and vwap_dist > 332.4   // SELL 72.6% / 76.9%
r027 = vwap_dist_atr > 24.58 and rsi3 > 74.73 and bb_z > 1.708   // SELL 72.5% / 79.5%
r028 = or_pos > 466.2 and stoch21 > 82.8 and vwap_dist_atr > 8.461 and atr_accel < 0.7978   // SELL 80.5% / 72.5%
r029 = fib_382_dist_atr < -4.993 and di_diff < -12.41 and vol_ratio > 1.356   // BUY 72.5% / 73.4%
r030 = donch55_brk_dn == 1 and or_brk_up == 1 and dist_swing_lo < -48.3 and mfi14 < 30.01   // BUY 77.1% / 72.5%
r031 = vwap_dist_atr > 16.18 and rsi3 > 82.23 and vwap_dist > 403.2   // SELL 72.4% / 72.6%
r032 = fib_382_dist_atr < -4.557 and vol_ratio > 1.312 and roc5 < -13.68   // BUY 72.6% / 72.4%
r033 = piv_r1_dist > 697.3 and piv_s1_dist_atr > 69.87 and bb_z > 1.249   // SELL 76.2% / 72.3%
r034 = vwap_dist_atr > 16.18 and rsi3 > 82.23 and sar_dist_atr > 3.816   // SELL 74.5% / 72.3%
r035 = fib_382_dist_atr < -4.993 and sar_dist_atr < -2.862 and di_diff < -29.32   // BUY 75.7% / 72.3%
r036 = vwap_dist_atr > 18.37 and piv_s1_dist_atr > 83.99 and stoch5 > 68.67   // SELL 72.3% / 73.0%
r037 = vwap_dist_atr > 21.78 and or_pos > 402.1 and piv_s1_dist_atr > 77.53   // SELL 72.1% / 76.9%
r038 = rsi3 > 79.32 and bb_z > 1.463 and vwap_dist_atr > 15.24 and sess_ny == 1   // SELL 72.1% / 74.5%
r039 = or_pos > 801.8 and vwap_dist_atr > 12.4 and vwap_dist > 403.2   // SELL 75.5% / 72.1%
r040 = or_pos > 466.2 and mfi14 > 56.36 and piv_s1_dist_atr > 59.79   // SELL 73.2% / 72.0%
r041 = vwap_dist > 332.4 and rsi3 > 90.11 and vwap_dist_atr > 18.37   // SELL 72.0% / 73.2%
r042 = dn_streak > 6 and dist_swing_lo < -13.1 and di_diff < -26.72   // BUY 72.0% / 73.1%
r043 = mfi14 < 25.84 and sar_dist < -63.48 and or_brk_up == 1   // BUY 71.9% / 73.9%
r044 = piv_r1_dist > 697.3 and rsi3 > 74.73 and piv_s1_dist_atr > 69.87   // SELL 73.2% / 71.9%
r045 = bb_z < -2.094 and mfi14 < 25.84 and or_brk_up == 1 and di_diff < -18.43   // BUY 73.2% / 71.9%
r046 = or_pos > 466.2 and pos20 > 78.05 and atr_ratio < 0.8091   // SELL 78.8% / 71.7%
r047 = kelt_z < -1.489 and or_brk_up == 1 and dist_swing_lo < -48.3 and pos60 < 5.755   // BUY 71.7% / 75.9%
r048 = piv_r1_dist > 697.3 and piv_s1_dist_atr > 83.99 and piv_dist > 929.4   // SELL 76.7% / 71.7%
r049 = vwap_dist_atr > 16.18 and stoch21 > 90.22 and rsi3 > 82.23   // SELL 71.6% / 76.6%
r050 = vwap_dist_atr > 16.18 and rsi3 > 87.71 and vwap_dist > 298.6   // SELL 71.6% / 72.6%
r051 = piv_r1_dist > 697.3 and rsi3 > 84.28 and vwap_dist > 203.5   // SELL 80.0% / 71.4%
r052 = vwap_dist_atr > 18.37 and piv_s1_dist_atr > 83.99 and vwap_dist > 203.5   // SELL 73.9% / 71.4%
r053 = rsi3 < 17.95 and fib_382_dist_atr < -5.683 and ema9_21 < -21.24   // BUY 71.9% / 71.4%
r054 = or_pos > 466.2 and mfi14 > 65.72 and piv_s1_dist_atr > 59.79   // SELL 75.4% / 71.4%
r055 = atr_ratio < 0.7661 and vwap_dist_atr > 15.24 and sess_ny == 1   // SELL 71.6% / 71.4%
r056 = vwap_dist_atr > 18.37 and stoch5 > 79.43 and sar_dist_atr > 2.042   // SELL 71.3% / 71.3%
r057 = or_pos > 466.2 and vwap_dist > 470 and bb_z > 1.249   // SELL 71.3% / 72.2%
r058 = vwap_dist_atr > 16.18 and rsi14 > 66.99 and vwap_dist > 403.2   // SELL 71.3% / 77.8%
r059 = vwap_dist_atr > 24.58 and piv_s1_dist_atr > 52.38 and stoch21 > 82.8   // SELL 71.2% / 72.4%
r060 = rsi3 > 79.32 and vwap_dist > 257 and vwap_dist_atr > 15.24 and pos20 > 93.92   // SELL 71.2% / 73.6%
r061 = vwap_dist_atr > 18.37 and piv_s1_dist_atr > 83.99 and roc5 > 2.715   // SELL 71.0% / 71.9%
r062 = atr14 < 15.67 and pos60 > 91.41 and htf15_slope > 16.79   // BUY 71.0% / 71.8%
r063 = vwap_dist_atr > 18.37 and piv_s1_dist_atr > 83.99 and mfi14 > 56.36   // SELL 70.8% / 83.3%
r064 = vwap_dist_atr > 16.18 and pos20 > 90.25 and vwap_dist > 403.2   // SELL 73.1% / 70.8%
r065 = rsi14 > 61.92 and vwap_dist_atr > 10.69 and sess_london == 1 and htf60_slope > 47.95   // SELL 71.0% / 70.8%
r066 = or_pos > 466.2 and piv_dist > 929.4 and piv_s1_dist_atr > 69.87   // SELL 70.8% / 75.0%
r067 = vwap_dist_atr > 8.461 and dnwick > 0.8005 and piv_s1_dist_atr > 52.38   // SELL 70.7% / 71.4%
r068 = kelt_z < -0.8696 and htf15_slope > 16.79 and mfi14 < 30.01   // BUY 70.8% / 70.7%
r069 = vwap_dist_atr > 10.69 and piv_s1_dist_atr > 83.99 and or_pos > 466.2   // SELL 81.2% / 70.7%
r070 = sar_dist_atr < -3.399 and mfi14 < 25.84 and or_brk_up == 1 and donch55_pos < 11.18   // BUY 70.7% / 71.4%
r071 = piv_r1_dist > 697.3 and up_streak > 2 and piv_s1_dist_atr > 52.38   // SELL 76.3% / 70.6%
r072 = fib_382_dist_atr < -4.557 and willr5 < -90.22 and kelt_z < -1.737   // BUY 70.5% / 74.4%
r073 = vwap_dist_atr > 18.37 and stoch21 > 87.45 and stoch5 > 89.15   // SELL 72.1% / 70.5%
r074 = rsi3 > 86.52 and bb_z > 1.827 and vwap_dist_atr > 15.24   // SELL 70.5% / 72.7%
r075 = vwap_dist_atr > 16.18 and piv_s1_dist_atr > 77.53 and rsi3 > 82.23   // SELL 70.5% / 72.0%
r076 = htf15_slope > 13.02 and htf5_slope < -6.87 and piv_r1_dist_atr > 0.9323   // BUY 70.5% / 71.9%
r077 = piv_r1_dist > -114.7 and ichi_price_kij_atr < -2.725 and rsi3 < 9.952   // BUY 71.4% / 70.5%
r078 = vol_ratio > 1.531 and htf15_slope > 21.87 and ret1 < -5.4   // BUY 70.5% / 73.2%
r079 = piv_r1_dist > 697.3 and mfi14 > 63.5 and vwap_dist_atr > 13.67   // SELL 75.0% / 70.5%
r080 = or_brk_up == 1 and ret5 < -45 and pos240 < 4.161   // BUY 71.4% / 70.4%
r081 = vwap_dist_atr > 18.37 and piv_s1_dist_atr > 83.99 and sar_dist_atr > 2.042   // SELL 74.7% / 70.4%
r082 = pos240 > 86.48 and body > 0.8267 and vwap_dist_atr > 15.24   // SELL 70.4% / 70.8%
r083 = atr_ratio < 0.8091 and pos60 > 93.18 and sess_ny == 1   // SELL 70.4% / 70.9%
r084 = roc5 < -6.316 and htf60_slope > 38.06 and kelt_z < -1.489   // BUY 70.3% / 72.5%
r085 = vwap_dist_atr > 12.4 and sweep_high == 1 and rsi3 > 82.23   // SELL 70.3% / 72.4%
r086 = rsi14 > 61.92 and pos20 > 87.48 and vwap_dist_atr > 15.24 and sess_ny == 1   // SELL 70.2% / 73.3%
r087 = rsi3 > 79.32 and vwap_dist_atr > 15.24 and htf60_slope > 47.95 and sess_ny == 1   // SELL 70.1% / 80.5%
r088 = kelt_z < -1.02 and willr5 < -98.5 and div_bull == 1   // BUY 70.5% / 70.1%
r089 = sar_dist_atr < -3.997 and or_brk_up == 1 and mfi14 < 30.01   // BUY 70.1% / 73.7%
r090 = rsi3 > 86.52 and vwap_dist > 257 and vwap_dist_atr > 10.69 and sess_ny == 1   // SELL 70.1% / 70.5%
r091 = vwap_dist_atr > 18.37 and bb_z > 1.249 and piv_s1_dist_atr > 52.38   // SELL 70.0% / 71.3%
r092 = or_pos > 466.2 and stoch21 > 87.45 and piv_s1_dist_atr > 59.79   // SELL 72.6% / 70.0%
r093 = piv_dist > 1319 and vwap_dist_atr > 10.69 and rsi3 > 79.32   // SELL 69.9% / 74.4%
r094 = or_pos > 466.2 and atr_ratio < 0.8091 and stoch5 > 68.67   // SELL 72.3% / 69.9%
