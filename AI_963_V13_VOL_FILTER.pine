mtf30Line = request.security(syminfo.tickerid, "30", f_mtfKnnLine(mtf30PriceValue, mtf30PriceLen, mtf30TargetValue, mtf30TargetLen, mtf30ClosestValues, mtf30Smoothing, mtf30SignalLine, mtf30LineType)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
mtf60Line = request.security(syminfo.tickerid, "60", f_mtfKnnLine(mtf60PriceValue, mtf60PriceLen, mtf60TargetValue, mtf60TargetLen, mtf60ClosestValues, mtf60Smoothing, mtf60SignalLine, mtf60LineType)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

mtf2PlotStyle = mtf2PlotStyleInput == "Line" ? plot.style_line : mtf2PlotStyleInput == "Circles" ? plot.style_circles : plot.style_stepline
mtf3PlotStyle = mtf3PlotStyleInput == "Line" ? plot.style_line : mtf3PlotStyleInput == "Circles" ? plot.style_circles : plot.style_stepline
mtf5PlotStyle = mtf5PlotStyleInput == "Line" ? plot.style_line : mtf5PlotStyleInput == "Circles" ? plot.style_circles : plot.style_stepline
