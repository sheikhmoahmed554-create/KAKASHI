showTradeLines = input.bool(true, "Show Entry / TP / SL Lines", group=G_VIS)
showLineTags   = input.bool(true, "Show Entry / TP / SL Tags", group=G_VIS)
showTable      = input.bool(true, "Show Stats Table", group=G_VIS)
lineBars       = input.int(70, "Active Line Bars", minval=5, maxval=500, group=G_VIS)
statsMode      = input.string("All Loaded History", "Stats Count", options=["All Loaded History", "From Custom Time"], group=G_VIS)
statsStartTime = input.time(1785564000000, "Start Stats From (UTC)", group=G_VIS)
manualResetKey = input.int(0, "Manual Reset Number", minval=0, group=G_VIS)

// ═════════════════════════════════════════════════════════════════
// 07 ■ ALERTS / WEBHOOK / BOT
// The title said "+ BOT" but the alert() payload, the secret key, the symbol and
// the lot size were missing from this build. They are restored here using the
// SAME field names and the SAME JSON shape as the main indicator, so an existing
// bot reads these messages without any change on its side.
//
// One message per opened trade, on the confirmed close of the entry bar. The
// message carries the source that opened it (CHART / 2m / 3m / ... / 1H) because
// this indicator can hold several trades at once, one per timeframe.
//
// TP and SL are the ones the trade was actually opened with. When a source runs
// the Independent Exit Engine it has no fixed TP, so the fallback target below is
// sent instead and a CLOSE message follows when the engine reverses.
// ═════════════════════════════════════════════════════════════════
botUseAlertFunction = input.bool(true, "Send BOT Message alert()", group=G_BOT)
botWebhookKey = input.string("SECRET_135", "BOT Secret Key", group=G_BOT)
botSymbol = input.string("XAUUSD", "BOT Symbol - Message Only", group=G_BOT)
botLotSize = input.float(0.02, "BOT Lot Size - Message Only", minval=0.01, step=0.01, group=G_BOT)
botAlertFormat = input.string("JSON", "alert() Message Format", options=["JSON", "Simple"], group=G_BOT)
botSendBuy = input.bool(true, "Send BUY", group=G_BOT, inline="BOTSIDE")
botSendSell = input.bool(true, "Send SELL", group=G_BOT, inline="BOTSIDE")
botSendClose = input.bool(true, "Send CLOSE when the Independent Exit Engine reverses", group=G_BOT, tooltip="TP and SL are hard prices the broker already holds, so no CLOSE is needed for those. Only the engine exit has to be closed by message.")
botFallbackTargetPoints = input.float(90.0, "BOT Fallback Target Points — only when a source has no fixed TP", minval=1.0, step=1.0, group=G_BOT)
botFallbackStopPoints = input.float(90.0, "BOT Fallback Stop Points — only when a source has no fixed SL", minval=1.0, step=1.0, group=G_BOT)

// ══════════════════════════════════════════════════════════════════
// LINE TYPE LIBRARY
// The support/resistance line was hard-wired to RMA. These are the
// alternatives, measured on 2026 / 2021 / 2023 before being offered.
//
// Ranked by how well price honoured the line — how often it turned away after
// touching it, and how often a close through it really ran, both scored against
// the same test started from a random bar so a trending market could not
// flatter the result:
//
//   1  TEMA     4  LSMA     7  WMA      10  KAMA     13  VIDYA
//   2  HMA      5  ALMA     8  EMA      11  RMA      14  T3
//   3  DEMA     6  SSF      9  MEDIAN   12  KNN-RMA (the original)
//
// Honest note: every one of them scored below a coin flip on average. The
// ranking is real and consistent across the three years, but it separates
// "less bad" from "bad" — no line type turns this into an edge on its own.
// The measured penetration depth was 0.219-0.234 ATR for ALL of them, so no
// line gives a sharper zone than another either.
//
// Every branch is computed on every bar and only then selected. The four
// recursive lines (SSF, KAMA, VIDYA, McGinley) would lose their history if they
// were only evaluated when chosen, which is why nothing here is computed lazily.
// ══════════════════════════════════════════════════════════════════
f_smooth(type_, src_, len_) =>
    // ── plain, stateless ──
    rma_  = ta.rma(src_, len_)
    ema1_ = ta.ema(src_, len_)
    ema2_ = ta.ema(ema1_, len_)
    ema3_ = ta.ema(ema2_, len_)
    dema_ = 2.0 * ema1_ - ema2_
    tema_ = 3.0 * ema1_ - 3.0 * ema2_ + ema3_
    // Tillson T3, volume factor 0.7
    e4_ = ta.ema(ema3_, len_)
    e5_ = ta.ema(e4_, len_)
    e6_ = ta.ema(e5_, len_)
    v_  = 0.7
    c1_ = -v_ * v_ * v_
    c2_ = 3.0 * v_ * v_ + 3.0 * v_ * v_ * v_
    c3_ = -6.0 * v_ * v_ - 3.0 * v_ - 3.0 * v_ * v_ * v_
    c4_ = 1.0 + 3.0 * v_ + v_ * v_ * v_ + 3.0 * v_ * v_
    t3_ = c1_ * e6_ + c2_ * e5_ + c3_ * e4_ + c4_ * ema3_

    // ── recursive: computed every bar so their history stays intact ──
    // Ehlers two-pole super smoother
    a_  = math.exp(-math.pi * math.sqrt(2.0) / len_)
    b_  = 2.0 * a_ * math.cos(math.pi * math.sqrt(2.0) / len_)
    sc2_ = b_
    sc3_ = -a_ * a_
    sc1_ = 1.0 - sc2_ - sc3_
    var float ssf_ = na
    ssf_ := bar_index < 2 or na(ssf_[1]) or na(ssf_[2]) ? src_ : sc1_ * (src_ + nz(src_[1], src_)) / 2.0 + sc2_ * ssf_[1] + sc3_ * ssf_[2]

    // Kaufman adaptive
    kVol_ = math.sum(math.abs(ta.change(src_)), len_)
    kEr_  = kVol_ == 0 ? 0.0 : math.abs(src_ - nz(src_[len_], src_)) / kVol_
    kSc_  = math.pow(kEr_ * (2.0 / 3.0 - 2.0 / 31.0) + 2.0 / 31.0, 2)
    var float kama_ = na
    kama_ := na(kama_[1]) ? src_ : kama_[1] + kSc_ * (src_ - kama_[1])

    // Chande VIDYA
    vUp_  = math.sum(math.max(ta.change(src_), 0.0), len_)
    vDn_  = math.sum(math.max(-ta.change(src_), 0.0), len_)
    vCmo_ = (vUp_ + vDn_) == 0.0 ? 0.0 : math.abs((vUp_ - vDn_) / (vUp_ + vDn_))
    vAl_  = 2.0 / (len_ + 1)
    var float vidya_ = na
    vidya_ := na(vidya_[1]) ? src_ : vidya_[1] + vAl_ * vCmo_ * (src_ - vidya_[1])

    // McGinley dynamic
    var float mcg_ = na
    mcgRatio_ = na(mcg_[1]) or mcg_[1] == 0.0 ? 1.0 : src_ / mcg_[1]
    mcg_ := na(mcg_[1]) ? src_ : mcg_[1] + (src_ - mcg_[1]) / (len_ * math.pow(mcgRatio_ == 0.0 ? 1.0 : mcgRatio_, 4))

    hma_    = ta.hma(src_, len_)
    wma_    = ta.wma(src_, len_)
    sma_    = ta.sma(src_, len_)
    lsma_   = ta.linreg(src_, len_, 0)
    alma_   = ta.alma(src_, len_, 0.85, 6.0)
    median_ = ta.percentile_linear_interpolation(src_, len_, 50)

    switch type_
        "RMA (original)" => rma_
        "HMA"            => hma_
        "TEMA"           => tema_
        "DEMA"           => dema_
        "LSMA"           => lsma_
        "ALMA"           => alma_
        "T3"             => t3_
        "EMA"            => ema1_
        "WMA"            => wma_
        "SMA"            => sma_
        "MEDIAN"         => median_
        "Ehlers SSF"     => ssf_
        "KAMA"           => kama_
        "VIDYA"          => vidya_
        "McGinley"       => mcg_
        => rma_

// ══════════════════════════════════════════════════════════════════
// ORIGINAL KNN CALCULATION
// ══════════════════════════════════════════════════════════════════
value_in = switch PriceValue
    "hl2"  => ta.sma(hl2, maLen)
    "VWAP" => ta.vwap(close[maLen])
    "sma"  => ta.sma(close, maLen)
    "wma"  => ta.wma(close, maLen)
    "ema"  => ta.ema(close, maLen)
    "hma"  => ta.hma(close, maLen)

meanOfKClosest(value_, target_) =>
    closestDistances = array.new_float(numberOfClosestValues, 1e10)
    closestValues = array.new_float(numberOfClosestValues, 0.0)
    for i = 1 to windowSize
        value = value_[i]
        distance = math.abs(target_ - value)
        maxDistIndex = 0
        maxDistValue = array.get(closestDistances, 0)
        for j = 1 to numberOfClosestValues - 1
            if array.get(closestDistances, j) > maxDistValue
                maxDistIndex := j
                maxDistValue := array.get(closestDistances, j)
        if distance < maxDistValue
            array.set(closestDistances, maxDistIndex, distance)
            array.set(closestValues, maxDistIndex, value)
    array.sum(closestValues) / numberOfClosestValues

target_in = switch TargetValue
    "Price Action" => ta.rma(close, maLen_)
    "VWAP"         => ta.vwap(close[maLen_])
    "Volatility"   => ta.atr(14)
    "sma"          => ta.sma(close, maLen_)
    "wma"          => ta.wma(close, maLen_)
    "ema"          => ta.ema(close, maLen_)
    "hma"          => ta.hma(close, maLen_)

knnMA = meanOfKClosest(value_in, target_in)

price = math.avg(knnMA, close)
c = ta.rma(knnMA[1], smoothingPeriod)
o = ta.rma(knnMA, smoothingPeriod)

knn(price_) =>
    Pos_count = 0
    Neg_count = 0
    min_distance = 10e10
    nearest_index = 0
    for j = 1 to 10
        distance = math.sqrt(math.pow(price_[j] - price_, 2))
        if distance < min_distance
            min_distance := distance
            nearest_index := j
            Neg = c[nearest_index] > o[nearest_index]
            Pos = c[nearest_index] < o[nearest_index]
            if Pos
                Pos_count += 1
            if Neg
                Neg_count += 1
    Pos_count > Neg_count ? 1 : -1

knn_prediction_raw = knn(price)
knn_prediction = ta.wma(knn_prediction_raw, 3)

knnMA_ = ta.wma(knnMA, 5)
knnMA_col = knnMA_ > knnMA_[1] ? Upknn_col : knnMA_ < knnMA_[1] ? Dnknn_col : Neuknn_col

// This is the exact Average KNN line identified in the supplied screenshot.
MAknn_ = f_smooth(chartLineType, knnMA, smoothingPeriod)

plot(showKnnClassifier ? knnMA_ : na, "Knn Classifier Line", knnMA_col)
plot(showAverageKnn ? MAknn_ : na, "Average Knn Classifier Line", Maknn_col, 2)

// Complete independent KNN calculation used inside every request.security()
// context. Each call receives only that timeframe's own input set.
f_mtfKnnLine(priceValueType_, priceLen_, targetValueType_, targetLen_, closestCount_, smoothing_, signalLine_, lineType_) =>
    valueSeries_ = switch priceValueType_
        "hl2"  => ta.sma(hl2, priceLen_)
        "VWAP" => ta.vwap(close[priceLen_])
        "sma"  => ta.sma(close, priceLen_)
        "wma"  => ta.wma(close, priceLen_)
        "ema"  => ta.ema(close, priceLen_)
        "hma"  => ta.hma(close, priceLen_)

    targetSeries_ = switch targetValueType_
        "Price Action" => ta.rma(close, targetLen_)
        "VWAP"         => ta.vwap(close[targetLen_])
        "Volatility"   => ta.atr(14)
        "sma"          => ta.sma(close, targetLen_)
        "wma"          => ta.wma(close, targetLen_)
        "ema"          => ta.ema(close, targetLen_)
        "hma"          => ta.hma(close, targetLen_)

    windowSize_ = math.max(closestCount_, 30)
    closestDistances_ = array.new_float(closestCount_, 1e10)
    closestValues_ = array.new_float(closestCount_, 0.0)
    for i_ = 1 to windowSize_
        historicalValue_ = valueSeries_[i_]
        distance_ = math.abs(targetSeries_ - historicalValue_)
        maxDistanceIndex_ = 0
        maxDistanceValue_ = array.get(closestDistances_, 0)
        for j_ = 1 to closestCount_ - 1
            if array.get(closestDistances_, j_) > maxDistanceValue_
                maxDistanceIndex_ := j_
                maxDistanceValue_ := array.get(closestDistances_, j_)
        if distance_ < maxDistanceValue_
            array.set(closestDistances_, maxDistanceIndex_, distance_)
            array.set(closestValues_, maxDistanceIndex_, historicalValue_)

    knnValue_ = array.sum(closestValues_) / closestCount_
    classifierLine_ = ta.wma(knnValue_, 5)
    averageLine_ = f_smooth(lineType_, knnValue_, smoothing_)
    signalLine_ == "KNN Classifier" ? classifierLine_ : averageLine_

// A dedicated exit-only KNN engine. It is calculated in its selected timeframe
// and uses only fully closed source candles. The returned event timestamps stay
// unchanged until the next confirmed reversal, allowing the chart timeframe to
// create exactly one exit pulse per source-timeframe reversal.
f_independentExitEngine(priceValueType_, priceLen_, targetValueType_, targetLen_, closestCount_, smoothing_, signalLine_, confirmBars_, lineType_) =>
    exitLine_ = f_mtfKnnLine(priceValueType_, priceLen_, targetValueType_, targetLen_, closestCount_, smoothing_, signalLine_, lineType_)
    bullishConfirmed_ = true
    bearishConfirmed_ = true
    for confirmationIndex_ = 0 to confirmBars_ - 1
        bullishConfirmed_ := bullishConfirmed_ and exitLine_[confirmationIndex_] > exitLine_[confirmationIndex_ + 1]
        bearishConfirmed_ := bearishConfirmed_ and exitLine_[confirmationIndex_] < exitLine_[confirmationIndex_ + 1]
    bullishSwitch_ = bullishConfirmed_ and not bullishConfirmed_[1]
    bearishSwitch_ = bearishConfirmed_ and not bearishConfirmed_[1]
    bullishEventTime_ = ta.valuewhen(bullishSwitch_[1], time[1], 0)
    bearishEventTime_ = ta.valuewhen(bearishSwitch_[1], time[1], 0)
    bullishEventClose_ = ta.valuewhen(bullishSwitch_[1], close[1], 0)
    bearishEventClose_ = ta.valuewhen(bearishSwitch_[1], close[1], 0)
    [exitLine_[1], bullishEventTime_, bearishEventTime_, bullishEventClose_, bearishEventClose_]

f_newConfirmedEvent(eventTime_) =>
    not na(eventTime_) and (na(eventTime_[1]) or eventTime_ != eventTime_[1])

f_timeframeLabel(timeframe_) =>
    timeframe_ == "60" ? "1H" : timeframe_ + "m"

// [1] + lookahead_on exposes only the last fully closed source-timeframe line.
mtf2Line = request.security(syminfo.tickerid, "2", f_mtfKnnLine(mtf2PriceValue, mtf2PriceLen, mtf2TargetValue, mtf2TargetLen, mtf2ClosestValues, mtf2Smoothing, mtf2SignalLine, mtf2LineType)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
mtf3Line = request.security(syminfo.tickerid, "3", f_mtfKnnLine(mtf3PriceValue, mtf3PriceLen, mtf3TargetValue, mtf3TargetLen, mtf3ClosestValues, mtf3Smoothing, mtf3SignalLine, mtf3LineType)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
