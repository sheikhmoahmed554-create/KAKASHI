green = knn_prediction < 0.5
red = knn_prediction > -0.5
bgcolor(green and showTrendBackground ? color.new(Dn_col, 80) : red and showTrendBackground ? color.new(Up_col, 80) : na)

// ══════════════════════════════════════════════════════════════════
// KNN LINE SUPPORT / RESISTANCE SIGNAL ENGINE
// Signals are confirmed only when the candle closes.
// ══════════════════════════════════════════════════════════════════
pointUnit = pointUnitInput
signalAtr = ta.atr(14)

filterAtr = ta.atr(volAtrLength)
entryAtrPoints = pointUnit > 0 ? filterAtr / pointUnit : 0.0
volFilterOK = not useVolFilter or (entryAtrPoints <= maxEntryAtrPoints and entryAtrPoints >= minEntryAtrPoints)

f_lineSignalSet(line_, wickBodySameSide_, touchTolerancePoints_, minimumWickPoints_, breakoutBufferPoints_, atr_, useAtrDistances_, touchToleranceAtr_, minimumWickAtr_, breakoutBufferAtr_) =>
    touchTolerance_ = useAtrDistances_ ? atr_ * touchToleranceAtr_ : touchTolerancePoints_ * pointUnit
    minimumWick_ = useAtrDistances_ ? atr_ * minimumWickAtr_ : minimumWickPoints_ * pointUnit
    breakoutBuffer_ = useAtrDistances_ ? atr_ * breakoutBufferAtr_ : breakoutBufferPoints_ * pointUnit
    ready_ = barstate.isconfirmed and not na(line_) and not na(line_[1])
    wasAbove_ = close[1] > line_[1]
    wasBelow_ = close[1] < line_[1]
    bodyLow_ = math.min(open, close)
    bodyHigh_ = math.max(open, close)
    lowerWick_ = math.max(bodyLow_ - low, 0.0)
    upperWick_ = math.max(high - bodyHigh_, 0.0)
    touchFromAbove_ = low <= line_ + touchTolerance_
    touchFromBelow_ = high >= line_ - touchTolerance_
    bodyStayedAbove_ = bodyLow_ >= line_
    bodyStayedBelow_ = bodyHigh_ <= line_
    buyRejection_ = ready_ and wasAbove_ and touchFromAbove_ and close > line_ and lowerWick_ > 0 and lowerWick_ >= minimumWick_ and (not wickBodySameSide_ or bodyStayedAbove_)
    sellRejection_ = ready_ and wasBelow_ and touchFromBelow_ and close < line_ and upperWick_ > 0 and upperWick_ >= minimumWick_ and (not wickBodySameSide_ or bodyStayedBelow_)
    buyBreakout_ = ready_ and close[1] <= line_[1] and low <= line_ + touchTolerance_ and close > line_ + breakoutBuffer_
    sellBreakout_ = ready_ and close[1] >= line_[1] and high >= line_ - touchTolerance_ and close < line_ - breakoutBuffer_
    [buyRejection_, sellRejection_, buyBreakout_, sellBreakout_]

[buyRejectionSetup, sellRejectionSetup, buyBreakoutSetup, sellBreakoutSetup] = f_lineSignalSet(MAknn_, wickBodySameSide, touchTolerancePoints, minimumWickPoints, breakoutBufferPoints, signalAtr, useAtrSignalDistances, touchToleranceAtr, minimumWickAtr, breakoutBufferAtr)
[mtf2BuyRejectionSetup, mtf2SellRejectionSetup, mtf2BuyBreakoutSetup, mtf2SellBreakoutSetup] = f_lineSignalSet(mtf2Line, mtf2WickBodySameSide, mtf2TouchTolerancePoints, mtf2MinimumWickPoints, mtf2BreakoutBufferPoints, signalAtr, mtf2UseAtrSignalDistances, mtf2TouchToleranceAtr, mtf2MinimumWickAtr, mtf2BreakoutBufferAtr)
[mtf3BuyRejectionSetup, mtf3SellRejectionSetup, mtf3BuyBreakoutSetup, mtf3SellBreakoutSetup] = f_lineSignalSet(mtf3Line, mtf3WickBodySameSide, mtf3TouchTolerancePoints, mtf3MinimumWickPoints, mtf3BreakoutBufferPoints, signalAtr, mtf3UseAtrSignalDistances, mtf3TouchToleranceAtr, mtf3MinimumWickAtr, mtf3BreakoutBufferAtr)
[mtf5BuyRejectionSetup, mtf5SellRejectionSetup, mtf5BuyBreakoutSetup, mtf5SellBreakoutSetup] = f_lineSignalSet(mtf5Line, mtf5WickBodySameSide, mtf5TouchTolerancePoints, mtf5MinimumWickPoints, mtf5BreakoutBufferPoints, signalAtr, mtf5UseAtrSignalDistances, mtf5TouchToleranceAtr, mtf5MinimumWickAtr, mtf5BreakoutBufferAtr)
[mtf10BuyRejectionSetup, mtf10SellRejectionSetup, mtf10BuyBreakoutSetup, mtf10SellBreakoutSetup] = f_lineSignalSet(mtf10Line, mtf10WickBodySameSide, mtf10TouchTolerancePoints, mtf10MinimumWickPoints, mtf10BreakoutBufferPoints, signalAtr, mtf10UseAtrSignalDistances, mtf10TouchToleranceAtr, mtf10MinimumWickAtr, mtf10BreakoutBufferAtr)
[mtf15BuyRejectionSetup, mtf15SellRejectionSetup, mtf15BuyBreakoutSetup, mtf15SellBreakoutSetup] = f_lineSignalSet(mtf15Line, mtf15WickBodySameSide, mtf15TouchTolerancePoints, mtf15MinimumWickPoints, mtf15BreakoutBufferPoints, signalAtr, mtf15UseAtrSignalDistances, mtf15TouchToleranceAtr, mtf15MinimumWickAtr, mtf15BreakoutBufferAtr)
[mtf30BuyRejectionSetup, mtf30SellRejectionSetup, mtf30BuyBreakoutSetup, mtf30SellBreakoutSetup] = f_lineSignalSet(mtf30Line, mtf30WickBodySameSide, mtf30TouchTolerancePoints, mtf30MinimumWickPoints, mtf30BreakoutBufferPoints, signalAtr, mtf30UseAtrSignalDistances, mtf30TouchToleranceAtr, mtf30MinimumWickAtr, mtf30BreakoutBufferAtr)
[mtf60BuyRejectionSetup, mtf60SellRejectionSetup, mtf60BuyBreakoutSetup, mtf60SellBreakoutSetup] = f_lineSignalSet(mtf60Line, mtf60WickBodySameSide, mtf60TouchTolerancePoints, mtf60MinimumWickPoints, mtf60BreakoutBufferPoints, signalAtr, mtf60UseAtrSignalDistances, mtf60TouchToleranceAtr, mtf60MinimumWickAtr, mtf60BreakoutBufferAtr)

// The chart/1m source is now independently switchable, even when MTF is off.
chartSignalsAllowed = useChartSignals

buyRejectionSignal = enableSignals and chartSignalsAllowed and enableBuy and enableWickRejection and buyRejectionSetup
sellRejectionSignal = enableSignals and chartSignalsAllowed and enableSell and enableWickRejection and sellRejectionSetup
buyBreakoutSignal = enableSignals and chartSignalsAllowed and enableBuy and enableBreakout and buyBreakoutSetup
sellBreakoutSignal = enableSignals and chartSignalsAllowed and enableSell and enableBreakout and sellBreakoutSetup

mtf2BuyRejectionSignal = enableSignals and enableMTF and useMtf2 and mtf2EnableBuy and mtf2EnableWickRejection and mtf2BuyRejectionSetup
mtf2SellRejectionSignal = enableSignals and enableMTF and useMtf2 and mtf2EnableSell and mtf2EnableWickRejection and mtf2SellRejectionSetup
mtf2BuyBreakoutSignal = enableSignals and enableMTF and useMtf2 and mtf2EnableBuy and mtf2EnableBreakout and mtf2BuyBreakoutSetup
mtf2SellBreakoutSignal = enableSignals and enableMTF and useMtf2 and mtf2EnableSell and mtf2EnableBreakout and mtf2SellBreakoutSetup

mtf3BuyRejectionSignal = enableSignals and enableMTF and useMtf3 and mtf3EnableBuy and mtf3EnableWickRejection and mtf3BuyRejectionSetup
mtf3SellRejectionSignal = enableSignals and enableMTF and useMtf3 and mtf3EnableSell and mtf3EnableWickRejection and mtf3SellRejectionSetup
