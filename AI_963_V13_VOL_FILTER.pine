mtf10SellBreakoutSignal = enableSignals and enableMTF and useMtf10 and mtf10EnableSell and mtf10EnableBreakout and mtf10SellBreakoutSetup

mtf15BuyRejectionSignal = enableSignals and enableMTF and useMtf15 and mtf15EnableBuy and mtf15EnableWickRejection and mtf15BuyRejectionSetup
mtf15SellRejectionSignal = enableSignals and enableMTF and useMtf15 and mtf15EnableSell and mtf15EnableWickRejection and mtf15SellRejectionSetup
mtf15BuyBreakoutSignal = enableSignals and enableMTF and useMtf15 and mtf15EnableBuy and mtf15EnableBreakout and mtf15BuyBreakoutSetup
mtf15SellBreakoutSignal = enableSignals and enableMTF and useMtf15 and mtf15EnableSell and mtf15EnableBreakout and mtf15SellBreakoutSetup

mtf30BuyRejectionSignal = enableSignals and enableMTF and useMtf30 and mtf30EnableBuy and mtf30EnableWickRejection and mtf30BuyRejectionSetup
mtf30SellRejectionSignal = enableSignals and enableMTF and useMtf30 and mtf30EnableSell and mtf30EnableWickRejection and mtf30SellRejectionSetup
mtf30BuyBreakoutSignal = enableSignals and enableMTF and useMtf30 and mtf30EnableBuy and mtf30EnableBreakout and mtf30BuyBreakoutSetup
mtf30SellBreakoutSignal = enableSignals and enableMTF and useMtf30 and mtf30EnableSell and mtf30EnableBreakout and mtf30SellBreakoutSetup

mtf60BuyRejectionSignal = enableSignals and enableMTF and useMtf60 and mtf60EnableBuy and mtf60EnableWickRejection and mtf60BuyRejectionSetup
mtf60SellRejectionSignal = enableSignals and enableMTF and useMtf60 and mtf60EnableSell and mtf60EnableWickRejection and mtf60SellRejectionSetup
mtf60BuyBreakoutSignal = enableSignals and enableMTF and useMtf60 and mtf60EnableBuy and mtf60EnableBreakout and mtf60BuyBreakoutSetup
mtf60SellBreakoutSignal = enableSignals and enableMTF and useMtf60 and mtf60EnableSell and mtf60EnableBreakout and mtf60SellBreakoutSetup

mtf2BuySignal = mtf2BuyRejectionSignal or mtf2BuyBreakoutSignal
mtf2SellSignal = mtf2SellRejectionSignal or mtf2SellBreakoutSignal
mtf3BuySignal = mtf3BuyRejectionSignal or mtf3BuyBreakoutSignal
mtf3SellSignal = mtf3SellRejectionSignal or mtf3SellBreakoutSignal
mtf5BuySignal = mtf5BuyRejectionSignal or mtf5BuyBreakoutSignal
mtf5SellSignal = mtf5SellRejectionSignal or mtf5SellBreakoutSignal
mtf10BuySignal = mtf10BuyRejectionSignal or mtf10BuyBreakoutSignal
mtf10SellSignal = mtf10SellRejectionSignal or mtf10SellBreakoutSignal
mtf15BuySignal = mtf15BuyRejectionSignal or mtf15BuyBreakoutSignal
mtf15SellSignal = mtf15SellRejectionSignal or mtf15SellBreakoutSignal
mtf30BuySignal = mtf30BuyRejectionSignal or mtf30BuyBreakoutSignal
mtf30SellSignal = mtf30SellRejectionSignal or mtf30SellBreakoutSignal
mtf60BuySignal = mtf60BuyRejectionSignal or mtf60BuyBreakoutSignal
mtf60SellSignal = mtf60SellRejectionSignal or mtf60SellBreakoutSignal

chartBuySignal = buyRejectionSignal or buyBreakoutSignal
chartSellSignal = sellRejectionSignal or sellBreakoutSignal

// Every source owns a separate trade slot. A source whose "Respect Other Trades"
// option is enabled may enter only when all slots are flat. When disabled, that
// source can run independently beside positions opened by other timeframes.
SOURCE_COUNT = 8
var sourceNames = array.from("CHART " + timeframe.period, "2m", "3m", "5m", "10m", "15m", "30m", "1H")
var sourceBuySignals = array.new_bool(SOURCE_COUNT, false)
var sourceSellSignals = array.new_bool(SOURCE_COUNT, false)
var sourceExitBullSignals = array.new_bool(SOURCE_COUNT, false)
var sourceExitBearSignals = array.new_bool(SOURCE_COUNT, false)
var sourceExitBullPrices = array.new_float(SOURCE_COUNT, na)
var sourceExitBearPrices = array.new_float(SOURCE_COUNT, na)
var sourceBuyRejections = array.new_bool(SOURCE_COUNT, false)
var sourceSellRejections = array.new_bool(SOURCE_COUNT, false)
var sourceTargetPoints = array.from(targetPoints, mtf2TargetPoints, mtf3TargetPoints, mtf5TargetPoints, mtf10TargetPoints, mtf15TargetPoints, mtf30TargetPoints, mtf60TargetPoints)
var sourceStopPoints = array.from(stopPoints, mtf2StopPoints, mtf3StopPoints, mtf5StopPoints, mtf10StopPoints, mtf15StopPoints, mtf30StopPoints, mtf60StopPoints)
var sourceRespectOtherTrades = array.from(chartRespectOtherTrades, mtf2RespectOtherTrades, mtf3RespectOtherTrades, mtf5RespectOtherTrades, mtf10RespectOtherTrades, mtf15RespectOtherTrades, mtf30RespectOtherTrades, mtf60RespectOtherTrades)
var sourceExitEnabled = array.from(chartExitEnabled, mtf2ExitEnabled, mtf3ExitEnabled, mtf5ExitEnabled, mtf10ExitEnabled, mtf15ExitEnabled, mtf30ExitEnabled, mtf60ExitEnabled)
var sourceExitTimeframes = array.from(chartExitTimeframe, mtf2ExitTimeframe, mtf3ExitTimeframe, mtf5ExitTimeframe, mtf10ExitTimeframe, mtf15ExitTimeframe, mtf30ExitTimeframe, mtf60ExitTimeframe)
var sourceCooldownBars = array.from(cooldownBars, mtf2CooldownBars, mtf3CooldownBars, mtf5CooldownBars, mtf10CooldownBars, mtf15CooldownBars, mtf30CooldownBars, mtf60CooldownBars)
var sourceBuyCooldownBars = array.from(buyCooldownBars, mtf2BuyCooldownBars, mtf3BuyCooldownBars, mtf5BuyCooldownBars, mtf10BuyCooldownBars, mtf15BuyCooldownBars, mtf30BuyCooldownBars, mtf60BuyCooldownBars)
var sourceSellCooldownBars = array.from(sellCooldownBars, mtf2SellCooldownBars, mtf3SellCooldownBars, mtf5SellCooldownBars, mtf10SellCooldownBars, mtf15SellCooldownBars, mtf30SellCooldownBars, mtf60SellCooldownBars)

array.set(sourceBuySignals, 0, chartBuySignal)
array.set(sourceBuySignals, 1, mtf2BuySignal)
array.set(sourceBuySignals, 2, mtf3BuySignal)
array.set(sourceBuySignals, 3, mtf5BuySignal)
array.set(sourceBuySignals, 4, mtf10BuySignal)
array.set(sourceBuySignals, 5, mtf15BuySignal)
array.set(sourceBuySignals, 6, mtf30BuySignal)
array.set(sourceBuySignals, 7, mtf60BuySignal)
array.set(sourceSellSignals, 0, chartSellSignal)
array.set(sourceSellSignals, 1, mtf2SellSignal)
array.set(sourceSellSignals, 2, mtf3SellSignal)
array.set(sourceSellSignals, 3, mtf5SellSignal)
array.set(sourceSellSignals, 4, mtf10SellSignal)
array.set(sourceSellSignals, 5, mtf15SellSignal)
array.set(sourceSellSignals, 6, mtf30SellSignal)
array.set(sourceSellSignals, 7, mtf60SellSignal)

// The exit arrays belong to the entry source at the same index; they never
// borrow another entry engine and therefore cannot change its entry signals.
array.set(sourceExitBullSignals, 0, chartExitBullSignal)
array.set(sourceExitBullSignals, 1, mtf2ExitBullSignal)
array.set(sourceExitBullSignals, 2, mtf3ExitBullSignal)
array.set(sourceExitBullSignals, 3, mtf5ExitBullSignal)
array.set(sourceExitBullSignals, 4, mtf10ExitBullSignal)
array.set(sourceExitBullSignals, 5, mtf15ExitBullSignal)
array.set(sourceExitBullSignals, 6, mtf30ExitBullSignal)
array.set(sourceExitBullSignals, 7, mtf60ExitBullSignal)
array.set(sourceExitBearSignals, 0, chartExitBearSignal)
array.set(sourceExitBearSignals, 1, mtf2ExitBearSignal)
array.set(sourceExitBearSignals, 2, mtf3ExitBearSignal)
array.set(sourceExitBearSignals, 3, mtf5ExitBearSignal)
array.set(sourceExitBearSignals, 4, mtf10ExitBearSignal)
array.set(sourceExitBearSignals, 5, mtf15ExitBearSignal)
array.set(sourceExitBearSignals, 6, mtf30ExitBearSignal)
array.set(sourceExitBearSignals, 7, mtf60ExitBearSignal)
array.set(sourceExitBullPrices, 0, chartExitBullClose)
array.set(sourceExitBullPrices, 1, mtf2ExitBullClose)
array.set(sourceExitBullPrices, 2, mtf3ExitBullClose)
array.set(sourceExitBullPrices, 3, mtf5ExitBullClose)
array.set(sourceExitBullPrices, 4, mtf10ExitBullClose)
array.set(sourceExitBullPrices, 5, mtf15ExitBullClose)
array.set(sourceExitBullPrices, 6, mtf30ExitBullClose)
array.set(sourceExitBullPrices, 7, mtf60ExitBullClose)
array.set(sourceExitBearPrices, 0, chartExitBearClose)
array.set(sourceExitBearPrices, 1, mtf2ExitBearClose)
array.set(sourceExitBearPrices, 2, mtf3ExitBearClose)
array.set(sourceExitBearPrices, 3, mtf5ExitBearClose)
array.set(sourceExitBearPrices, 4, mtf10ExitBearClose)
array.set(sourceExitBearPrices, 5, mtf15ExitBearClose)
array.set(sourceExitBearPrices, 6, mtf30ExitBearClose)
array.set(sourceExitBearPrices, 7, mtf60ExitBearClose)

array.set(sourceBuyRejections, 0, buyRejectionSignal)
array.set(sourceBuyRejections, 1, mtf2BuyRejectionSignal)
array.set(sourceBuyRejections, 2, mtf3BuyRejectionSignal)
array.set(sourceBuyRejections, 3, mtf5BuyRejectionSignal)
array.set(sourceBuyRejections, 4, mtf10BuyRejectionSignal)
array.set(sourceBuyRejections, 5, mtf15BuyRejectionSignal)
array.set(sourceBuyRejections, 6, mtf30BuyRejectionSignal)
array.set(sourceBuyRejections, 7, mtf60BuyRejectionSignal)
array.set(sourceSellRejections, 0, sellRejectionSignal)
array.set(sourceSellRejections, 1, mtf2SellRejectionSignal)
array.set(sourceSellRejections, 2, mtf3SellRejectionSignal)
array.set(sourceSellRejections, 3, mtf5SellRejectionSignal)
array.set(sourceSellRejections, 4, mtf10SellRejectionSignal)
array.set(sourceSellRejections, 5, mtf15SellRejectionSignal)
array.set(sourceSellRejections, 6, mtf30SellRejectionSignal)
array.set(sourceSellRejections, 7, mtf60SellRejectionSignal)

// ══════════════════════════════════════════════════════════════════
// TRADE STATE / STATISTICS
// ══════════════════════════════════════════════════════════════════
statsActive = statsMode == "All Loaded History" or time >= statsStartTime

var string lastSignalText = "-"

var lastTradeBars = array.new_int(SOURCE_COUNT, na)
var lastBuyLossBars = array.new_int(SOURCE_COUNT, na)
var lastSellLossBars = array.new_int(SOURCE_COUNT, na)
var activeTrades = array.new_bool(SOURCE_COUNT, false)
var tradeSides = array.new_int(SOURCE_COUNT, 0)
var entryPrices = array.new_float(SOURCE_COUNT, na)
var tpPrices = array.new_float(SOURCE_COUNT, na)
var slPrices = array.new_float(SOURCE_COUNT, na)
var activeTargetPoints = array.new_float(SOURCE_COUNT, na)
var activeStopPoints = array.new_float(SOURCE_COUNT, na)
var entryBars = array.new_int(SOURCE_COUNT, na)
var activeSignalTypes = array.new_string(SOURCE_COUNT, "-")

// Exit decisions are calculated before new entries so a closing trade can
// start the global cooldown on its actual closing bar. State is cleared only
// after entry decisions, preserving V12's no-reversal-on-the-exit-bar rule.
var pendingExit = array.new_bool(SOURCE_COUNT, false)
var pendingExitReason = array.new_int(SOURCE_COUNT, 0) // -1=fixed SL, 1=fixed TP, 2=independent reversal, 3=same-candle skip
var pendingExitPoints = array.new_float(SOURCE_COUNT, 0.0)
var pendingExitPrice = array.new_float(SOURCE_COUNT, na)

var int globalCooldownUntil = na
var string globalCooldownReason = "-"

var int wins = 0
var int losses = 0
var int trades = 0
var int buyWins = 0
var int buyLosses = 0
var int sellWins = 0
var int sellLosses = 0
var int rejectionEntries = 0
var int breakoutEntries = 0
var int curWin = 0
var int maxWin = 0
var int curLoss = 0
var int maxLoss = 0
var float netPts = 0.0
var float sumWinPts = 0.0
var float sumLossPts = 0.0
var float lastClosedPts = 0.0

var entryLines = array.new_line(SOURCE_COUNT, na)
var tpLines = array.new_line(SOURCE_COUNT, na)
var slLines = array.new_line(SOURCE_COUNT, na)
var entryTags = array.new_label(SOURCE_COUNT, na)
var tpTags = array.new_label(SOURCE_COUNT, na)
var slTags = array.new_label(SOURCE_COUNT, na)

var bool entryBuyPlot = false
var bool entrySellPlot = false
var bool exitTPPlot = false
var bool exitSLPlot = false
var bool exitEnginePlot = false
var bool buyRejectionEntryAlert = false
var bool sellRejectionEntryAlert = false
var bool buyBreakoutEntryAlert = false
var bool sellBreakoutEntryAlert = false
var enteredBuyBySource = array.new_bool(SOURCE_COUNT, false)
var enteredSellBySource = array.new_bool(SOURCE_COUNT, false)
var int lastResetKey = manualResetKey

entryBuyPlot := false
entrySellPlot := false
exitTPPlot := false
exitSLPlot := false
exitEnginePlot := false
buyRejectionEntryAlert := false
sellRejectionEntryAlert := false
buyBreakoutEntryAlert := false
sellBreakoutEntryAlert := false

for sourceIndex = 0 to SOURCE_COUNT - 1
    array.set(enteredBuyBySource, sourceIndex, false)
    array.set(enteredSellBySource, sourceIndex, false)
    array.set(pendingExit, sourceIndex, false)
    array.set(pendingExitReason, sourceIndex, 0)
    array.set(pendingExitPoints, sourceIndex, 0.0)
    array.set(pendingExitPrice, sourceIndex, na)

f_delete_trade_visuals(sourceIndex_) =>
    entryLine_ = array.get(entryLines, sourceIndex_)
    tpLine_ = array.get(tpLines, sourceIndex_)
    slLine_ = array.get(slLines, sourceIndex_)
    entryTag_ = array.get(entryTags, sourceIndex_)
    tpTag_ = array.get(tpTags, sourceIndex_)
    slTag_ = array.get(slTags, sourceIndex_)
    if not na(entryLine_)
        line.delete(entryLine_)
    if not na(tpLine_)
        line.delete(tpLine_)
    if not na(slLine_)
        line.delete(slLine_)
    if not na(entryTag_)
        label.delete(entryTag_)
    if not na(tpTag_)
        label.delete(tpTag_)
    if not na(slTag_)
        label.delete(slTag_)
    array.set(entryLines, sourceIndex_, na)
    array.set(tpLines, sourceIndex_, na)
    array.set(slLines, sourceIndex_, na)
    array.set(entryTags, sourceIndex_, na)
    array.set(tpTags, sourceIndex_, na)
    array.set(slTags, sourceIndex_, na)

if manualResetKey != lastResetKey
    for sourceIndex = 0 to SOURCE_COUNT - 1
        f_delete_trade_visuals(sourceIndex)
        array.set(activeTrades, sourceIndex, false)
        array.set(tradeSides, sourceIndex, 0)
        array.set(entryPrices, sourceIndex, na)
        array.set(tpPrices, sourceIndex, na)
        array.set(slPrices, sourceIndex, na)
        array.set(activeTargetPoints, sourceIndex, na)
        array.set(activeStopPoints, sourceIndex, na)
        array.set(entryBars, sourceIndex, na)
        array.set(activeSignalTypes, sourceIndex, "-")
        array.set(lastTradeBars, sourceIndex, na)
        array.set(lastBuyLossBars, sourceIndex, na)
        array.set(lastSellLossBars, sourceIndex, na)
    lastSignalText := "-"
    globalCooldownUntil := na
    globalCooldownReason := "-"
    wins := 0
    losses := 0
    trades := 0
    buyWins := 0
    buyLosses := 0
    sellWins := 0
    sellLosses := 0
    rejectionEntries := 0
    breakoutEntries := 0
    curWin := 0
    maxWin := 0
    curLoss := 0
    maxLoss := 0
    netPts := 0.0
    sumWinPts := 0.0
    sumLossPts := 0.0
    lastClosedPts := 0.0
    lastResetKey := manualResetKey

// Pre-calculate exits before new entries. The fixed stop has priority if it and
// a confirmed exit-engine reversal occur on the same chart bar. Each reversal
// price comes from the closed candle of that source's selected exit timeframe.
cooldownClock_ = nz(time_close, time)
for sourceIndex = 0 to SOURCE_COUNT - 1
    active_ = array.get(activeTrades, sourceIndex)
    entryBar_ = array.get(entryBars, sourceIndex)

    if active_ and bar_index > entryBar_
        side_ = array.get(tradeSides, sourceIndex)
        entryPrice_ = array.get(entryPrices, sourceIndex)
        tpPrice_ = array.get(tpPrices, sourceIndex)
        slPrice_ = array.get(slPrices, sourceIndex)
        targetPoints_ = array.get(activeTargetPoints, sourceIndex)
        stopPoints_ = array.get(activeStopPoints, sourceIndex)
        exitEngineEnabled_ = array.get(sourceExitEnabled, sourceIndex)
        hitTP_ = not exitEngineEnabled_ and not na(tpPrice_) and (side_ == 1 ? high >= tpPrice_ : low <= tpPrice_)
        hitSL_ = side_ == 1 ? low <= slPrice_ : high >= slPrice_
        bothHit_ = hitTP_ and hitSL_
        skipTrade_ = bothHit_ and sameCandleRule == "Skip"
        fixedTargetWin_ = bothHit_ ? (not skipTrade_ and sameCandleRule == "Target First") : hitTP_
        fixedStopLoss_ = bothHit_ ? (not skipTrade_ and sameCandleRule == "Stop First") : hitSL_
        exitEngineSignal_ = exitEngineEnabled_ and not hitSL_ and (side_ == 1 ? array.get(sourceExitBearSignals, sourceIndex) : array.get(sourceExitBullSignals, sourceIndex))
        exitEnginePrice_ = side_ == 1 ? array.get(sourceExitBearPrices, sourceIndex) : array.get(sourceExitBullPrices, sourceIndex)
        exitReason_ = skipTrade_ ? 3 : fixedTargetWin_ ? 1 : fixedStopLoss_ ? -1 : exitEngineSignal_ ? 2 : 0
        shouldClose_ = exitReason_ != 0

        if shouldClose_
            confirmedExitPrice_ = not na(exitEnginePrice_) ? exitEnginePrice_ : close
            exitPoints_ = exitReason_ == 3 ? 0.0 : exitReason_ == 1 ? targetPoints_ : exitReason_ == -1 ? -stopPoints_ : side_ == 1 ? (confirmedExitPrice_ - entryPrice_) / pointUnit : (entryPrice_ - confirmedExitPrice_) / pointUnit
            exitPrice_ = exitReason_ == 1 ? tpPrice_ : exitReason_ == -1 ? slPrice_ : exitReason_ == 3 ? close : confirmedExitPrice_

            array.set(pendingExit, sourceIndex, true)
            array.set(pendingExitReason, sourceIndex, exitReason_)
            array.set(pendingExitPoints, sourceIndex, exitPoints_)
            array.set(pendingExitPrice, sourceIndex, exitPrice_)

            if exitReason_ != 3
                resultCooldownMinutes_ = exitPoints_ > 0 ? globalCooldownAfterWinMinutes : globalCooldownAfterLossMinutes
                sideCooldownMinutes_ = side_ == 1 ? globalCooldownAfterBuyMinutes : globalCooldownAfterSellMinutes
                appliedCooldownMinutes_ = math.max(resultCooldownMinutes_, sideCooldownMinutes_)

                if enableGlobalCooldown and appliedCooldownMinutes_ > 0
                    candidateCooldownUntil_ = cooldownClock_ + appliedCooldownMinutes_ * 60000
                    if na(globalCooldownUntil) or candidateCooldownUntil_ >= globalCooldownUntil
                        globalCooldownUntil := candidateCooldownUntil_
                        resultText_ = exitPoints_ > 0 ? "WIN" : "LOSS"
                        globalCooldownReason := (side_ == 1 ? "BUY " : "SELL ") + resultText_

globalCooldownActive = enableGlobalCooldown and not na(globalCooldownUntil) and cooldownClock_ < globalCooldownUntil

openTradesBeforeEntries = 0
for sourceIndex = 0 to SOURCE_COUNT - 1
    if array.get(activeTrades, sourceIndex)
        openTradesBeforeEntries += 1

openTradesDuringEntries = openTradesBeforeEntries
barSignalText = ""

// Process from the highest timeframe to the chart timeframe. When several
// respecting sources trigger together, the highest timeframe receives the slot.
for priorityOffset = 0 to SOURCE_COUNT - 1
    sourceIndex = SOURCE_COUNT - 1 - priorityOffset
    buySignal_ = array.get(sourceBuySignals, sourceIndex)
    sellSignal_ = array.get(sourceSellSignals, sourceIndex)
    signalSide_ = buySignal_ and not sellSignal_ ? 1 : sellSignal_ and not buySignal_ ? -1 : 0
    sourceIsFlat_ = not array.get(activeTrades, sourceIndex)
    respectsOthers_ = array.get(sourceRespectOtherTrades, sourceIndex)
    otherTradesOK_ = not respectsOthers_ or openTradesDuringEntries == 0
    lastTradeBar_ = array.get(lastTradeBars, sourceIndex)
    lastBuyLossBar_ = array.get(lastBuyLossBars, sourceIndex)
    lastSellLossBar_ = array.get(lastSellLossBars, sourceIndex)
    sourceCooldownOK_ = not perTfCooldownEnabled or na(lastTradeBar_) or bar_index - lastTradeBar_ >= array.get(sourceCooldownBars, sourceIndex)
    buyCooldownOK_ = not perTfCooldownEnabled or na(lastBuyLossBar_) or bar_index - lastBuyLossBar_ >= array.get(sourceBuyCooldownBars, sourceIndex)
    sellCooldownOK_ = not perTfCooldownEnabled or na(lastSellLossBar_) or bar_index - lastSellLossBar_ >= array.get(sourceSellCooldownBars, sourceIndex)
    directionCooldownOK_ = signalSide_ == 1 ? buyCooldownOK_ : signalSide_ == -1 ? sellCooldownOK_ : false
    canEnterSource_ = barstate.isconfirmed and volFilterOK and signalSide_ != 0 and sourceIsFlat_ and otherTradesOK_ and sourceCooldownOK_ and directionCooldownOK_ and not globalCooldownActive

    if canEnterSource_
        sourceName_ = array.get(sourceNames, sourceIndex)
        targetPoints_ = array.get(sourceTargetPoints, sourceIndex)
        stopPoints_ = array.get(sourceStopPoints, sourceIndex)
        exitEngineEnabled_ = array.get(sourceExitEnabled, sourceIndex)
        exitTimeframeLabel_ = f_timeframeLabel(array.get(sourceExitTimeframes, sourceIndex))
        exitModeText_ = exitEngineEnabled_ ? " EXIT→" + exitTimeframeLabel_ : " TP " + str.tostring(targetPoints_, "#")
        entryPrice_ = close
        tpPrice_ = exitEngineEnabled_ ? na : signalSide_ == 1 ? entryPrice_ + targetPoints_ * pointUnit : entryPrice_ - targetPoints_ * pointUnit
        slPrice_ = signalSide_ == 1 ? entryPrice_ - stopPoints_ * pointUnit : entryPrice_ + stopPoints_ * pointUnit
        entryIsRejection_ = signalSide_ == 1 ? array.get(sourceBuyRejections, sourceIndex) : array.get(sourceSellRejections, sourceIndex)
        signalType_ = entryIsRejection_ ? "REJECTION" : "BREAKOUT"
        signalText_ = (signalSide_ == 1 ? "BUY " : "SELL ") + sourceName_ + " " + signalType_ + exitModeText_

        array.set(activeTrades, sourceIndex, true)
        array.set(tradeSides, sourceIndex, signalSide_)
        array.set(entryPrices, sourceIndex, entryPrice_)
        array.set(tpPrices, sourceIndex, tpPrice_)
        array.set(slPrices, sourceIndex, slPrice_)
        array.set(activeTargetPoints, sourceIndex, targetPoints_)
        array.set(activeStopPoints, sourceIndex, stopPoints_)
        array.set(entryBars, sourceIndex, bar_index)
        array.set(activeSignalTypes, sourceIndex, signalType_)
        openTradesDuringEntries += 1
        barSignalText := barSignalText == "" ? signalText_ : barSignalText + " | " + signalText_

        // ── BOT message for this entry ──
        botSideOK_ = signalSide_ == 1 ? botSendBuy : botSendSell
        if botUseAlertFunction and botSideOK_
            botSideTxt_ = signalSide_ == 1 ? "BUY" : "SELL"
            botTpPts_ = na(tpPrice_) ? botFallbackTargetPoints : targetPoints_
            botSlPts_ = na(slPrice_) ? botFallbackStopPoints : stopPoints_
            botTpPx_ = na(tpPrice_) ? (signalSide_ == 1 ? entryPrice_ + botTpPts_ * pointUnit : entryPrice_ - botTpPts_ * pointUnit) : tpPrice_
            botSlPx_ = na(slPrice_) ? (signalSide_ == 1 ? entryPrice_ - botSlPts_ * pointUnit : entryPrice_ + botSlPts_ * pointUnit) : slPrice_
            botUid_ = botSymbol + "-" + str.tostring(time) + "-" + botSideTxt_ + "-" + sourceName_
            botJson_ = '{"key":"' + botWebhookKey + '","action":"' + botSideTxt_ + '","side":"' + botSideTxt_ + '","symbol":"' + botSymbol + '","lot":' + str.tostring(botLotSize) + ',"tp_points":' + str.tostring(botTpPts_, "#.##") + ',"sl_points":' + str.tostring(botSlPts_, "#.##") + ',"target_points":' + str.tostring(botTpPts_, "#.##") + ',"stop_points":' + str.tostring(botSlPts_, "#.##") + ',"point_unit":' + str.tostring(pointUnit) + ',"entry":' + str.tostring(entryPrice_, format.mintick) + ',"tp_price":' + str.tostring(botTpPx_, format.mintick) + ',"sl_price":' + str.tostring(botSlPx_, format.mintick) + ',"source":"' + sourceName_ + '","signal":"' + signalType_ + '","exit_model":"' + (exitEngineEnabled_ ? "INDEPENDENT_EXIT_ENGINE" : "FIXED_TP_SL") + '","trade_uid":"' + botUid_ + '","indicator":"AI 963","time":"' + str.tostring(time) + '"}'
            botSimple_ = botWebhookKey + " " + botSideTxt_ + " " + botSymbol + " SRC " + sourceName_ + " LOT " + str.tostring(botLotSize) + " TP " + str.tostring(botTpPts_, "#.##") + " SL " + str.tostring(botSlPts_, "#.##")
            alert(botAlertFormat == "JSON" ? botJson_ : botSimple_, alert.freq_once_per_bar_close)

        if statsActive
            if entryIsRejection_
                rejectionEntries += 1
            else
                breakoutEntries += 1

        if signalSide_ == 1
            entryBuyPlot := true
            array.set(enteredBuyBySource, sourceIndex, true)
            if entryIsRejection_
                buyRejectionEntryAlert := true
            else
                buyBreakoutEntryAlert := true
        else
            entrySellPlot := true
            array.set(enteredSellBySource, sourceIndex, true)
            if entryIsRejection_
                sellRejectionEntryAlert := true
            else
                sellBreakoutEntryAlert := true

        if showTradeLines
            entryLine_ = line.new(bar_index, entryPrice_, bar_index + lineBars, entryPrice_, xloc=xloc.bar_index, extend=extend.none, color=EN_C, width=1)
            tpLine_ = not na(tpPrice_) ? line.new(bar_index, tpPrice_, bar_index + lineBars, tpPrice_, xloc=xloc.bar_index, extend=extend.none, color=TP_C, width=1) : na
            slLine_ = line.new(bar_index, slPrice_, bar_index + lineBars, slPrice_, xloc=xloc.bar_index, extend=extend.none, color=SL_C, width=1)
            array.set(entryLines, sourceIndex, entryLine_)
            array.set(tpLines, sourceIndex, tpLine_)
            array.set(slLines, sourceIndex, slLine_)

            if showLineTags
                entryTag_ = label.new(bar_index + lineBars, entryPrice_, "ENTRY " + sourceName_ + exitModeText_, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=EN_C, textcolor=color.black, size=size.tiny)
                tpTag_ = not na(tpPrice_) ? label.new(bar_index + lineBars, tpPrice_, "TP " + sourceName_ + " " + str.tostring(targetPoints_, "#"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=TP_C, textcolor=TXT_C, size=size.tiny) : na
                slTag_ = label.new(bar_index + lineBars, slPrice_, "SL " + sourceName_ + " " + str.tostring(stopPoints_, "#"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=SL_C, textcolor=TXT_C, size=size.tiny)
                array.set(entryTags, sourceIndex, entryTag_)
                array.set(tpTags, sourceIndex, tpTag_)
                array.set(slTags, sourceIndex, slTag_)

if barSignalText != ""
    lastSignalText := barSignalText

// Apply the exit decisions cached before entries. An entry opened on this bar
// was not part of the cache and therefore cannot close on its entry candle.
for sourceIndex = 0 to SOURCE_COUNT - 1
    if array.get(pendingExit, sourceIndex)
        side_ = array.get(tradeSides, sourceIndex)
        targetPoints_ = array.get(activeTargetPoints, sourceIndex)
        stopPoints_ = array.get(activeStopPoints, sourceIndex)
        sourceName_ = array.get(sourceNames, sourceIndex)
        exitReason_ = array.get(pendingExitReason, sourceIndex)
        exitPoints_ = array.get(pendingExitPoints, sourceIndex)
        exitPrice_ = array.get(pendingExitPrice, sourceIndex)
        exitByTarget_ = exitReason_ == 1
        exitByEngine_ = exitReason_ == 2
        skipTrade_ = exitReason_ == 3
        statsCounted_ = statsActive and not skipTrade_

        array.set(lastTradeBars, sourceIndex, bar_index)
        if not skipTrade_ and exitPoints_ <= 0
            if side_ == 1
                array.set(lastBuyLossBars, sourceIndex, bar_index)
            else
                array.set(lastSellLossBars, sourceIndex, bar_index)

        if exitByEngine_
            exitEnginePlot := true
            // ── BOT CLOSE message. TP and SL are hard prices the broker already
            //    holds, so only the engine exit needs to be closed by message. ──
            if botUseAlertFunction and botSendClose
                botCloseSide_ = side_ == 1 ? "BUY" : "SELL"
                botCloseJson_ = '{"key":"' + botWebhookKey + '","action":"CLOSE","side":"' + botCloseSide_ + '","symbol":"' + botSymbol + '","lot":' + str.tostring(botLotSize) + ',"close_price":' + str.tostring(exitPrice_, format.mintick) + ',"close_points":' + str.tostring(exitPoints_, "#.##") + ',"reason":"INDEPENDENT_EXIT_ENGINE","source":"' + sourceName_ + '","indicator":"AI 963","time":"' + str.tostring(time) + '"}'
                botCloseSimple_ = botWebhookKey + " CLOSE " + botSymbol + " " + botCloseSide_ + " SRC " + sourceName_ + " PTS " + str.tostring(exitPoints_, "#.##")
                alert(botAlertFormat == "JSON" ? botCloseJson_ : botCloseSimple_, alert.freq_once_per_bar_close)
        else if exitByTarget_
            exitTPPlot := true
        else if not skipTrade_
            exitSLPlot := true

        if statsCounted_
            trades += 1
            netPts += exitPoints_
            lastClosedPts := exitPoints_

            if exitPoints_ > 0
                wins += 1
                sumWinPts += exitPoints_
                curWin += 1
                curLoss := 0
                maxWin := math.max(maxWin, curWin)
                if side_ == 1
                    buyWins += 1
                else
                    sellWins += 1
            else
                losses += 1
                sumLossPts += math.abs(exitPoints_)
                curLoss += 1
                curWin := 0
                maxLoss := math.max(maxLoss, curLoss)
                if side_ == 1
                    buyLosses += 1
                else
                    sellLosses += 1

        if showSignals and statsCounted_
            if exitByEngine_
                exitFrameLabel_ = f_timeframeLabel(array.get(sourceExitTimeframes, sourceIndex))
                exitText_ = "EXIT " + sourceName_ + " BY " + exitFrameLabel_ + " " + (exitPoints_ > 0 ? "+" : "") + str.tostring(exitPoints_, "#.##")
                label.new(bar_index, exitPrice_, exitText_, xloc=xloc.bar_index, yloc=yloc.price, style=exitPoints_ > 0 ? label.style_label_down : label.style_label_up, color=exitPoints_ > 0 ? BUY_C : SELL_C, textcolor=TXT_C, size=size.tiny)
            else if exitByTarget_
                label.new(bar_index, exitPrice_, "TP " + sourceName_ + " " + str.tostring(targetPoints_, "#"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=TP_C, textcolor=TXT_C, size=size.tiny)
            else
                label.new(bar_index, exitPrice_, "SL " + sourceName_ + " " + str.tostring(stopPoints_, "#"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=SL_C, textcolor=TXT_C, size=size.tiny)

        f_delete_trade_visuals(sourceIndex)
        array.set(activeTrades, sourceIndex, false)
        array.set(tradeSides, sourceIndex, 0)
        array.set(entryPrices, sourceIndex, na)
        array.set(tpPrices, sourceIndex, na)
        array.set(slPrices, sourceIndex, na)
        array.set(activeTargetPoints, sourceIndex, na)
        array.set(activeStopPoints, sourceIndex, na)
        array.set(entryBars, sourceIndex, na)
        array.set(activeSignalTypes, sourceIndex, "-")

// ══════════════════════════════════════════════════════════════════
// R30 CHART VISUALS
// ══════════════════════════════════════════════════════════════════
plotshape(showSignals and statsActive and entryBuyPlot, title="AI 963 BUY", style=shape.labelup, location=location.belowbar, color=BUY_C, text="BUY", textcolor=TXT_C, size=size.small)
plotshape(showSignals and statsActive and entrySellPlot, title="AI 963 SELL", style=shape.labeldown, location=location.abovebar, color=SELL_C, text="SELL", textcolor=TXT_C, size=size.small)
plotshape(showSignals and exitTPPlot, title="AI 963 TP", style=shape.circle, location=location.abovebar, color=TP_C, text="TP", textcolor=TXT_C, size=size.tiny)
plotshape(showSignals and exitSLPlot, title="AI 963 SL", style=shape.circle, location=location.belowbar, color=SL_C, text="SL", textcolor=TXT_C, size=size.tiny)
plotshape(showSignals and exitEnginePlot, title="AI 963 Independent Exit Engine Reversal", style=shape.diamond, location=location.abovebar, color=EXIT_C, text="EXIT", textcolor=TXT_C, size=size.tiny)

// ══════════════════════════════════════════════════════════════════
// R30-STYLE STATISTICS TABLE
// ══════════════════════════════════════════════════════════════════
winRate = trades > 0 ? wins * 100.0 / trades : 0.0
avgWinPoints = wins > 0 ? sumWinPts / wins : 0.0
avgLossPoints = losses > 0 ? sumLossPts / losses : 0.0
// Spelling out all eight types would re-widen the table by itself, so the row
// names the chart's line and only says whether the other frames disagree.
allSameLineType = chartLineType == mtf2LineType and mtf2LineType == mtf3LineType and mtf3LineType == mtf5LineType and mtf5LineType == mtf10LineType and mtf10LineType == mtf15LineType and mtf15LineType == mtf30LineType and mtf30LineType == mtf60LineType
lineTypeText = str.replace_all(chartLineType, " (original)", "") + (allSameLineType ? "" : " +mix")

var table statsTable = table.new(position.top_right, 2, 13, bgcolor=TBL_BG, border_width=0, frame_color=color.new(color.black, 100), frame_width=0)

// Compact by design. The three long rows — Open, Last Signal and Manager — set
// the whole table's width from their longest line of text, which is what made
// it stretch across the chart. They are gone; everything left is short.
// Line and From sit on top: they say which line is drawn and where the count
// starts from, which is the context every number below depends on.
if showTable and barstate.islast
    table.cell(statsTable, 0, 0, "AI 963", text_color=TXT_C, bgcolor=TBL_BG_HEAD, text_size=size.small)
    table.cell(statsTable, 1, 0, enableMTF ? "MTF S/R" : "S/R", text_color=EN_C, bgcolor=TBL_BG_HEAD, text_size=size.small)

    table.cell(statsTable, 0, 1, "Line", text_color=TBL_TXT, bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(statsTable, 1, 1, lineTypeText, text_color=EN_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(statsTable, 0, 2, "From", text_color=TBL_TXT, bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(statsTable, 1, 2, statsMode == "All Loaded History" ? "ALL" : str.format_time(statsStartTime, "dd MMM HH:mm", "UTC") + " UTC", text_color=EN_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(statsTable, 0, 3, "Win", text_color=TBL_TXT, bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(statsTable, 1, 3, str.tostring(wins), text_color=BUY_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(statsTable, 0, 4, "Loss", text_color=TBL_TXT, bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(statsTable, 1, 4, str.tostring(losses), text_color=SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(statsTable, 0, 5, "WR", text_color=TBL_TXT, bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(statsTable, 1, 5, str.tostring(winRate, "#.##") + "%", text_color=winRate >= 60 ? BUY_C : winRate >= 55 ? EN_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(statsTable, 0, 6, "Net", text_color=TBL_TXT, bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(statsTable, 1, 6, str.tostring(netPts, "#"), text_color=netPts >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(statsTable, 0, 7, "Max W", text_color=TBL_TXT, bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(statsTable, 1, 7, str.tostring(maxWin), text_color=BUY_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(statsTable, 0, 8, "Max L", text_color=TBL_TXT, bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(statsTable, 1, 8, str.tostring(maxLoss), text_color=maxLoss <= 9 ? EN_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(statsTable, 0, 9, "Avg Win", text_color=TBL_TXT, bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(statsTable, 1, 9, str.tostring(avgWinPoints, "#.#"), text_color=BUY_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(statsTable, 0, 10, "Avg Loss", text_color=TBL_TXT, bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(statsTable, 1, 10, str.tostring(avgLossPoints, "#.#"), text_color=SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(statsTable, 0, 11, "Last", text_color=TBL_TXT, bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(statsTable, 1, 11, (lastClosedPts > 0 ? "+" : "") + str.tostring(lastClosedPts, "#"), text_color=lastClosedPts >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    // Current volatility and whether it is letting entries through, so the
    // reason for a quiet stretch is visible instead of guessed at.
    table.cell(statsTable, 0, 12, "ATR", text_color=TBL_TXT, bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(statsTable, 1, 12, str.tostring(entryAtrPoints, "#.#") + (not useVolFilter ? " off" : volFilterOK ? " ok" : " HOLD"), text_color=not useVolFilter ? TBL_TXT : volFilterOK ? BUY_C : WAIT_C, bgcolor=TBL_BG_ROW, text_size=size.small)
else if not showTable and barstate.islast
    table.clear(statsTable, 0, 0, 1, 12)

// ══════════════════════════════════════════════════════════════════
// ALERTS — all are confirmed at candle close.
// ══════════════════════════════════════════════════════════════════
alertcondition(entryBuyPlot, "AI 963 BUY", "AI 963 BUY | CHART/MTF KNN LINE S/R")
alertcondition(entrySellPlot, "AI 963 SELL", "AI 963 SELL | CHART/MTF KNN LINE S/R")
alertcondition(buyRejectionEntryAlert, "AI 963 BUY - Strong Wick Rejection", "AI 963 BUY | CHART/MTF STRONG WICK REJECTION")
alertcondition(sellRejectionEntryAlert, "AI 963 SELL - Strong Wick Rejection", "AI 963 SELL | CHART/MTF STRONG WICK REJECTION")
alertcondition(buyBreakoutEntryAlert, "AI 963 BUY - Confirmed Breakout", "AI 963 BUY | CHART/MTF CONFIRMED BREAKOUT")
alertcondition(sellBreakoutEntryAlert, "AI 963 SELL - Confirmed Breakout", "AI 963 SELL | CHART/MTF CONFIRMED BREAKOUT")
alertcondition(exitEnginePlot, "AI 963 Independent Exit", "AI 963 EXIT | INDEPENDENT EXIT ENGINE REVERSAL")

// Source-specific alerts fire only after that source passes its open-trade rule.
alertcondition(array.get(enteredBuyBySource, 0), "AI 963 Chart TF BUY", "AI 963 CHART TF BUY")
alertcondition(array.get(enteredSellBySource, 0), "AI 963 Chart TF SELL", "AI 963 CHART TF SELL")
alertcondition(array.get(enteredBuyBySource, 1), "AI 963 2m BUY", "AI 963 2m BUY")
alertcondition(array.get(enteredSellBySource, 1), "AI 963 2m SELL", "AI 963 2m SELL")
alertcondition(array.get(enteredBuyBySource, 2), "AI 963 3m BUY", "AI 963 3m BUY")
alertcondition(array.get(enteredSellBySource, 2), "AI 963 3m SELL", "AI 963 3m SELL")
alertcondition(array.get(enteredBuyBySource, 3), "AI 963 5m BUY", "AI 963 5m BUY")
alertcondition(array.get(enteredSellBySource, 3), "AI 963 5m SELL", "AI 963 5m SELL")
alertcondition(array.get(enteredBuyBySource, 4), "AI 963 10m BUY", "AI 963 10m BUY")
alertcondition(array.get(enteredSellBySource, 4), "AI 963 10m SELL", "AI 963 10m SELL")
alertcondition(array.get(enteredBuyBySource, 5), "AI 963 15m BUY", "AI 963 15m BUY")
alertcondition(array.get(enteredSellBySource, 5), "AI 963 15m SELL", "AI 963 15m SELL")
alertcondition(array.get(enteredBuyBySource, 6), "AI 963 30m BUY", "AI 963 30m BUY")
alertcondition(array.get(enteredSellBySource, 6), "AI 963 30m SELL", "AI 963 30m SELL")
alertcondition(array.get(enteredBuyBySource, 7), "AI 963 1H BUY", "AI 963 1H BUY")
alertcondition(array.get(enteredSellBySource, 7), "AI 963 1H SELL", "AI 963 1H SELL")

// The nine legacy AI Trend Navigator notification conditions are intentionally
// omitted to keep this multi-timeframe build below TradingView's 64-plot limit.
// BUY / SELL / source-specific entry / independent EXIT alerts remain available.

// To receive these messages create the alert with "Any alert() function call".
// No alertcondition is registered for the bot: this build is already near
// TradingView's 64-plot budget and alertcondition counts against it.
