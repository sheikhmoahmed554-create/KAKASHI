// Eight fully independent exit engines — one linked to each entry source.
[chartExitLine, chartExitBullTime, chartExitBearTime, chartExitBullClose, chartExitBearClose] = request.security(syminfo.tickerid, chartExitTimeframe, f_independentExitEngine(chartExitPriceValue, chartExitPriceLen, chartExitTargetValue, chartExitTargetLen, chartExitClosestValues, chartExitSmoothing, chartExitSignalLine, chartExitConfirmBars, "RMA (original)"), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
