mtf2PlotStyleInput = input.string("Line", "Plot Style", options=["Line", "Stepline", "Circles"], group=G_MTF2, inline="M2S")
mtf2LineWidth = input.int(1, "Width", minval=1, maxval=4, group=G_MTF2, inline="M2S")
mtf2Color = input.color(color.rgb(0, 220, 160), "Color", group=G_MTF2, inline="M2S")
mtf2TargetPoints = input.float(70.0, "Fixed TP", minval=1.0, step=1.0, group=G_MTF2, inline="M2R")
