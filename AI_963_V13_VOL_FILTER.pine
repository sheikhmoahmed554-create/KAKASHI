// Original AI Trend Navigator © Zeiierman
// KNN support/resistance signal engine, confirmed MTF levels and R30 visuals added for the user.
// V12 reproduces the supplied 5 Aug 2026 screenshot preset.
// V13 adds the entry volatility filter, ON by default. Measured on 192,081
// XAUUSD 1m candles, Jan-Jul 2026, charging the data's median spread:
//
//   no filter        7,687 trades  52.02%   +837 points  drawdown 10,839
//   entry ATR <= 26  3,575 trades  53.23% +9,568 points  drawdown  3,889
//
// and every one of the seven months finishes positive with the filter on,
// against three of seven without it. Every threshold from 25 to 45 beat no
// filter; below 25 it starts cutting good trades as well as bad ones.
//
// Trend strength was tested the same way and rejected. An ADX floor of 30
// earns +2,177 on Jan-Apr then loses 991 on May-Jul, which is what a rule
// fitted to its own sample looks like, so no ADX condition is included.
// Every entry source now owns a completely independent confirmed-timeframe exit engine.
// TradingView preserves inputs on old chart instances; remove/re-add AI 963 to load these defaults.

//@version=5
indicator("AI 963", shorttitle="AI 963", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// ══════════════════════════════════════════════════════════════════
// R30 VISUAL SYSTEM
// ══════════════════════════════════════════════════════════════════
color BUY_C  = color.rgb(0, 170, 90)
color SELL_C = color.rgb(230, 45, 55)
color TP_C   = color.rgb(0, 120, 255)
color SL_C   = color.rgb(230, 45, 55)
color EXIT_C = color.rgb(170, 90, 255)
color EN_C   = color.rgb(255, 210, 0)
color TXT_C  = color.white
color WAIT_C = color.rgb(150, 150, 150)

color TBL_BG      = color.rgb(16, 18, 26)
color TBL_BG_HEAD = color.rgb(22, 24, 34)
color TBL_BG_ROW  = color.rgb(18, 20, 30)
color TBL_BG_ROW2 = color.rgb(20, 22, 32)
color TBL_TXT     = color.rgb(220, 225, 235)

// ══════════════════════════════════════════════════════════════════
// GROUPS
// ══════════════════════════════════════════════════════════════════
G_KNN    = "01 ■ AI Trend Navigator"
G_SIGNAL = "02 ■ Chart / 1m S/R Signal Settings"
G_MTF    = "03.0 ■ Multi-Timeframe Master"
G_MTF2   = "03.1 ■ KNN 2m — Full Settings"
G_MTF3   = "03.2 ■ KNN 3m — Full Settings"
G_MTF5   = "03.3 ■ KNN 5m — Full Settings"
G_MTF10  = "03.4 ■ KNN 10m — Full Settings"
G_MTF15  = "03.5 ■ KNN 15m — Full Settings"
G_MTF30  = "03.6 ■ KNN 30m — Full Settings"
G_MTF60  = "03.7 ■ KNN 1H — Full Settings"
G_RISK   = "04 ■ Chart / 1m TP / SL + Independent Exit"
G_EXEC   = "05 ■ Chart / 1m Execution"
G_VOL    = "05.1 ■ Entry Volatility Filter"
G_VIS    = "06 ■ Statistics / Visuals"
G_BOT    = "07 ■ Alerts / Webhook / Bot"

// ══════════════════════════════════════════════════════════════════
// TOOLTIPS
// ══════════════════════════════════════════════════════════════════
t1 = "PriceValue selects the method of price computation.\n\nSets the smoothing period for the PriceValue.\n\nAdjusting these settings changes the KNN input values and therefore the calculated trend."
t2 = "TargetValue specifies the target to evaluate.\n\nSets the smoothing period for the TargetValue."
t3 = "Number of closest values considered by the KNN Moving Average. Higher values smooth the line; lower values react faster."
t4 = "Editable Average KNN support/resistance line length for this exact timeframe. Enter any whole number from 2 to 10000. Tested defaults include 50, 100, 200, 300 and 750. Larger values create slower structural levels."
t5 = "Colors the chart background from the original KNN prediction."
t6 = "Uses chart ATR(14) instead of fixed points for touch tolerance, minimum wick and breakout buffer. Each timeframe owns independent ATR multipliers."
t7 = "Independent Exit Engine is separate from the entry engine. Select its own timeframe, price/target calculations, KNN length and reversal confirmation. It never opens a trade and never changes the entry line. A BUY closes only when this exit line confirms a bearish reversal; a SELL closes only on a bullish reversal. The fixed stop remains active."
t8 = "Cooldown Mode:\n\nPer-TF Screenshot Preset restores the original cooldown bars visible in the supplied screenshots, so the historical comparison matches.\n\nGlobal uses one real-time cooldown shared by all frames.\n\nOff disables all cooldowns."

// ══════════════════════════════════════════════════════════════════
// 01 ■ ORIGINAL AI TREND NAVIGATOR INPUTS
// User-approved XAUUSD screenshot preset. Every value remains editable.
// ══════════════════════════════════════════════════════════════════
PriceValue  = input.string("hma", "Price Value", options=["hl2", "VWAP", "sma", "wma", "ema", "hma"], group=G_KNN, inline="PV", tooltip=t1)
maLen       = input.int(5, "Length", minval=2, maxval=10000, step=1, group=G_KNN, inline="PV")
TargetValue = input.string("Price Action", "Target Value", options=["Price Action", "VWAP", "Volatility", "sma", "wma", "ema", "hma"], group=G_KNN, inline="TV", tooltip=t2)
maLen_      = input.int(5, "Length", minval=2, maxval=10000, step=1, group=G_KNN, inline="TV")

numberOfClosestValues = input.int(3, "Number of Closest Values", minval=2, maxval=200, group=G_KNN, tooltip=t3)
chartLineLength       = input.int(51, "Average KNN Line Length — Chart / 1m", minval=2, maxval=10000, step=1, group=G_KNN, tooltip=t4)
chartLineType = input.string("RMA (original)", "Line Type — Chart / 1m", options=["RMA (original)", "HMA", "TEMA", "DEMA", "LSMA", "ALMA", "T3", "EMA", "WMA", "SMA", "MEDIAN", "Ehlers SSF", "KAMA", "VIDYA", "McGinley"], group=G_KNN, tooltip="Which line is drawn as the support/resistance level. Measured on 2026 / 2021 / 2023: TEMA, HMA and DEMA honoured price best, the original RMA came 11th of 15, and every type scored below a coin flip on average. Penetration depth was the same 0.22 ATR for all of them, so no type gives a sharper zone.")
smoothingPeriod       = chartLineLength
windowSize            = math.max(numberOfClosestValues, 30)

showKnnClassifier = input.bool(false, "Show KNN Classifier Line", group=G_KNN)
showAverageKnn    = input.bool(true, "Show Average KNN Classifier Line", group=G_KNN)

Upknn_col  = input.color(color.lime, "Up", group=G_KNN, inline="KC")
Dnknn_col  = input.color(color.red, "Down", group=G_KNN, inline="KC")
Neuknn_col = input.color(color.orange, "Neutral", group=G_KNN, inline="KC")
Maknn_col  = input.color(color.teal, "Average KNN", group=G_KNN)

showTrendBackground = input.bool(false, "Trend Prediction Color", group=G_KNN, tooltip=t5)
Up_col = input.color(color.lime, "Positive", group=G_KNN, inline="BG")
Dn_col = input.color(color.red, "Negative", group=G_KNN, inline="BG")

// ══════════════════════════════════════════════════════════════════
// 02 ■ SIGNAL INPUTS
// The Average KNN line is treated as dynamic support/resistance.
// ══════════════════════════════════════════════════════════════════
enableSignals       = input.bool(true, "Enable ALL KNN S/R Signals", group=G_SIGNAL)
enableWickRejection = input.bool(true, "Enable Strong Wick Rejection", group=G_SIGNAL)
enableBreakout      = input.bool(true, "Enable Confirmed Close Breakout", group=G_SIGNAL)
enableBuy           = input.bool(true, "Enable BUY", group=G_SIGNAL, inline="SIDE")
enableSell          = input.bool(true, "Enable SELL", group=G_SIGNAL, inline="SIDE")

wickBodySameSide = input.bool(true, "Rejection Body Must Stay on Original Side", group=G_SIGNAL)
touchTolerancePoints = input.float(3.0, "Line Touch Tolerance (Points)", minval=0.0, step=0.5, group=G_SIGNAL)
minimumWickPoints    = input.float(20.0, "Minimum Rejection Wick (Points)", minval=0.0, step=0.5, group=G_SIGNAL)
breakoutBufferPoints = input.float(4.5, "Breakout Close Buffer (Points)", minval=0.0, step=0.5, group=G_SIGNAL)
useAtrSignalDistances = input.bool(false, "Use ATR-Adaptive Signal Distances", group=G_SIGNAL, tooltip=t6)
touchToleranceAtr = input.float(0.0, "Touch Tolerance ATR", minval=0.0, maxval=5.0, step=0.01, group=G_SIGNAL)
minimumWickAtr = input.float(0.05, "Minimum Rejection Wick ATR", minval=0.0, maxval=5.0, step=0.01, group=G_SIGNAL)
breakoutBufferAtr = input.float(0.08, "Breakout Close Buffer ATR", minval=0.0, maxval=5.0, step=0.01, group=G_SIGNAL)

// ══════════════════════════════════════════════════════════════════
// 03 ■ MULTI-TIMEFRAME KNN
// Every timeframe has its own complete KNN calculation, line selection,
// appearance, fixed TP/SL and open-trade behavior. Signals use only the last fully
// closed value of the selected source line, keeping MTF levels non-repainting.
// ══════════════════════════════════════════════════════════════════
enableMTF = input.bool(true, "Enable Multi-Timeframe Signals", group=G_MTF)
useChartSignals = input.bool(true, "Enable 1m / Chart TF Signals", group=G_MTF, inline="M1E")
chartRespectOtherTrades = input.bool(false, "Respect Other Trades", group=G_MTF, inline="M1E")

