sy967SellContinuationOK = not vtzActive or not vtzUp or vtzRetestSellZone or close < ema20 or bearMomentum or sy130TrendDown

sy967BlockBuyFade = sy967VTZActive and vtzDown and vtzMiddleFadeZone and not vtzEdgeBuyException
sy967BlockSellFade = sy967VTZActive and vtzUp and vtzMiddleFadeZone and not vtzEdgeSellException

sy967BlockLateBuy = sy967VTZActive and vtzLateChase and vtzUp and not vtzRetestBuyZone and not sy360FibBoostBuy and not sy361LiqBoostBuy
sy967BlockLateSell = sy967VTZActive and vtzLateChase and vtzDown and not vtzRetestSellZone and not sy360FibBoostSell and not sy361LiqBoostSell

sy967ZoneGuardBuyOK = not sy967BlockBuyFade and not sy967BlockLateBuy
sy967ZoneGuardSellOK = not sy967BlockSellFade and not sy967BlockLateSell

sy967RetestGuardBuyOK = sy967ZoneGuardBuyOK and sy967BuyContinuationOK
sy967RetestGuardSellOK = sy967ZoneGuardSellOK and sy967SellContinuationOK

sy967VTZBuyOK = not sy967VTZActive ? true : vtzMode == "Retest Guard" ? sy967RetestGuardBuyOK : sy967ZoneGuardBuyOK
sy967VTZSellOK = not sy967VTZActive ? true : vtzMode == "Retest Guard" ? sy967RetestGuardSellOK : sy967ZoneGuardSellOK

rawBuyBeforeTrendGuard = sy967RawBuyBeforeVTZ and sy967VTZBuyOK
rawSellBeforeTrendGuard = sy967RawSellBeforeVTZ and sy967VTZSellOK

// R13 FIX: Fast Trend TF was only a weak 1-point vote and the old default threshold (5.0)
// was outside the possible HTF score range (-4.5..+4.5), so this gate practically never blocked.
// It now participates directly. A confirmed sweep/real reversal can still bypass the trend block.
fastMapBuyAgainst = tf5Dir == -1
fastMapSellAgainst = tf5Dir == 1
sy354MapBuyOK = not useRealMapDirectGate or ((not fastMapBuyAgainst) and htfScore > -directOppScoreBlock) or sy338TrueCounterBuy or sweepLow or realRevBuy
sy354MapSellOK = not useRealMapDirectGate or ((not fastMapSellAgainst) and htfScore < directOppScoreBlock) or sy338TrueCounterSell or sweepHigh or realRevSell
sy354RangeBuyOK = not sy354UseDirectGates or rangePos <= sy354BuyMaxRange or sweepLow or realRevBuy or retestBuy or bullFVG
sy354RangeSellOK = not sy354UseDirectGates or rangePos >= sy354SellMinRange or sweepHigh or realRevSell or retestSell or bearFVG
sy354PremiumDiscountBuyOK = not useZoneDirectGate or rangePos <= discountLevel or sweepLow or realRevBuy or retestBuy or bullFVG
sy354PremiumDiscountSellOK = not useZoneDirectGate or rangePos >= premiumLevel or sweepHigh or realRevSell or retestSell or bearFVG
sy354CandleBuyOK = not useCandleDirectGate or not sy354RequireReaction or bullReject or bullMomentum or realRevBuy or sweepLow
sy354CandleSellOK = not useCandleDirectGate or not sy354RequireReaction or bearReject or bearMomentum or realRevSell or sweepHigh

hiddenFibOffOrAssist = hiddenFibMode == "Off" or hiddenFibMode == "Assist Only"

sy358MiddleLow = math.min(hiddenFibMiddleLow, hiddenFibMiddleHigh)
sy358MiddleHigh = math.max(hiddenFibMiddleLow, hiddenFibMiddleHigh)
sy358InMiddle = not na(rangePos) and rangePos >= sy358MiddleLow and rangePos <= sy358MiddleHigh

sy358BuyAssistStory = sweepLow or realRevBuy or retestBuy or bullFVG
sy358SellAssistStory = sweepHigh or realRevSell or retestSell or bearFVG

sy358FibBuyScore = (hiddenFibBuyOK ? 2 : hiddenFibInBuyZone ? 1 : 0) + (sy358BuyAssistStory ? 1 : 0) + (htfScore >= 0 ? 1 : 0) + (rangePos <= hiddenFibBuyMaxNoFib ? 1 : 0)
sy358FibSellScore = (hiddenFibSellOK ? 2 : hiddenFibInSellZone ? 1 : 0) + (sy358SellAssistStory ? 1 : 0) + (htfScore <= 0 ? 1 : 0) + (rangePos >= hiddenFibSellMinNoFib ? 1 : 0)

sy358SmartBuyOK = not sy358InMiddle or sy358FibBuyScore >= hiddenFibMinScore
sy358SmartSellOK = not sy358InMiddle or sy358FibSellScore >= hiddenFibMinScore

sy358OldMiddleBuyOK = hiddenFibBuyOK or sy358BuyAssistStory or na(rangePos) or rangePos <= hiddenFibBuyMaxNoFib
sy358OldMiddleSellOK = hiddenFibSellOK or sy358SellAssistStory or na(rangePos) or rangePos >= hiddenFibSellMinNoFib

hiddenFibBuyFilterOK = hiddenFibOffOrAssist ? true : hiddenFibMode == "Require Fib Zone" ? hiddenFibBuyOK : hiddenFibMode == "Smart Assist Score" ? sy358SmartBuyOK : sy358OldMiddleBuyOK
hiddenFibSellFilterOK = hiddenFibOffOrAssist ? true : hiddenFibMode == "Require Fib Zone" ? hiddenFibSellOK : hiddenFibMode == "Smart Assist Score" ? sy358SmartSellOK : sy358OldMiddleSellOK

rawBuyBase389 = rawBuyBeforeTrendGuard and sy354MapBuyOK and sy354RangeBuyOK and sy354PremiumDiscountBuyOK and sy354CandleBuyOK and hiddenFibBuyFilterOK and not sy338BlockBuyAgainstDownTrend and sy130BuyAllowed
rawSellBase389 = rawSellBeforeTrendGuard and sy354MapSellOK and sy354RangeSellOK and sy354PremiumDiscountSellOK and sy354CandleSellOK and hiddenFibSellFilterOK and not sy338BlockSellAgainstUpTrend and sy130SellAllowed

sy389LocalSlope = (ta.linreg(close, sy389RegLen, 0) - ta.linreg(close, sy389RegLen, 0)[sy389SlopeLen]) / math.max(atr, syminfo.mintick)
sy389LocalMove = math.abs(close - close[sy389RegLen])
sy389LocalNoise = ta.sma(math.abs(ta.change(close)), sy389RegLen) * sy389RegLen
sy389LocalER = sy389LocalNoise <= syminfo.mintick ? 0.0 : sy389LocalMove / sy389LocalNoise

sy389LocalUp = sy389LocalSlope >= sy389MinSlopeATR and close > ema50 and ema20 >= ema50 and sy389LocalER >= sy389MinER
sy389LocalDown = sy389LocalSlope <= -sy389MinSlopeATR and close < ema50 and ema20 <= ema50 and sy389LocalER >= sy389MinER
sy389HTFUp = sy389BiasDirHTF == 1
sy389HTFDown = sy389BiasDirHTF == -1

sy389OldHTFUp = tf5Dir == 1 or tf15Dir == 1 or htfScore > 0
sy389OldHTFDown = tf5Dir == -1 or tf15Dir == -1 or htfScore < 0

sy389UpAggressive = sy389LocalUp or sy389HTFUp
sy389DownAggressive = sy389LocalDown or sy389HTFDown
sy389UpBalanced = (sy389LocalUp and not sy389HTFDown) or (sy389HTFUp and not sy389LocalDown)
sy389DownBalanced = (sy389LocalDown and not sy389HTFUp) or (sy389HTFDown and not sy389LocalUp)
sy389UpConservative = sy389LocalUp and sy389HTFUp
sy389DownConservative = sy389LocalDown and sy389HTFDown

sy389BiasUpRaw = sy389BiasMode == "Conservative" ? sy389UpConservative : sy389BiasMode == "Aggressive" ? sy389UpAggressive : sy389UpBalanced
sy389BiasDownRaw = sy389BiasMode == "Conservative" ? sy389DownConservative : sy389BiasMode == "Aggressive" ? sy389DownAggressive : sy389DownBalanced

sy389BiasUp = useSY389BiasEngine and sy389BiasUpRaw and not sy389BiasDownRaw and (not sy389UseHTFConfirm or sy389OldHTFUp)
sy389BiasDown = useSY389BiasEngine and sy389BiasDownRaw and not sy389BiasUpRaw and (not sy389UseHTFConfirm or sy389OldHTFDown)
sy389BiasRange = not sy389BiasUp and not sy389BiasDown

sy389WrongSellInUp = sy389BiasUp and rawSellBase389 and roomBuy
sy389WrongBuyInDown = sy389BiasDown and rawBuyBase389 and roomSell

rawBuy = not useSY389BiasEngine ? rawBuyBase389 : sy389BiasUp ? (rawBuyBase389 or (sy389ConvertWrongSide and sy389WrongSellInUp)) : sy389BiasDown ? false : (sy389KeepRangeOriginal ? rawBuyBase389 : false)
rawSell = not useSY389BiasEngine ? rawSellBase389 : sy389BiasDown ? (rawSellBase389 or (sy389ConvertWrongSide and sy389WrongBuyInDown)) : sy389BiasUp ? false : (sy389KeepRangeOriginal ? rawSellBase389 : false)

baseBuySignal = allowLong and rawBuy and not rawSell
baseSellSignal = allowShort and rawSell and not rawBuy

m1AtrSafe = math.max(atr, syminfo.mintick)
syr30BodyATR = body / m1AtrSafe
syr30SignedVolume = (close > open ? 1.0 : close < open ? -1.0 : 0.0) * nz(volume, 0.0)
syr30FlowFast = ta.ema(syr30SignedVolume, 5)
syr30FlowSlow = ta.ema(syr30SignedVolume, 20)
syr30FlowStd = ta.stdev(syr30SignedVolume, 30)
syr30FlowZ = (syr30FlowFast - syr30FlowSlow) / math.max(nz(syr30FlowStd, 0.0), 0.000001)

// ━━━ SYR30 SCHOOL 1: BALANCE RESET LAUNCH ━━━
syr30BalanceHigh = ta.highest(high, syr30BalanceBars)[1]
syr30BalanceLow = ta.lowest(low, syr30BalanceBars)[1]
syr30BalanceWidthATR = (syr30BalanceHigh - syr30BalanceLow) / m1AtrSafe
syr30ImpulseUp = close[syr30BalanceBars] - close[syr30BalanceBars + syr30ImpulseBars] > syr30ImpulseMinATR * atr[syr30BalanceBars]
syr30ImpulseDown = close[syr30BalanceBars + syr30ImpulseBars] - close[syr30BalanceBars] > syr30ImpulseMinATR * atr[syr30BalanceBars]
syr30RecentBalanceVolume = ta.sma(nz(volume, 0.0), syr30BalanceBars)[1]
syr30OlderBalanceVolume = ta.sma(nz(volume, 0.0), syr30BalanceVolumeLookback)[syr30BalanceBars + 1]
syr30BalanceVolumeOK = not syr30BalanceRequireVolumeContract or syr30RecentBalanceVolume < syr30OlderBalanceVolume
syr30BalanceUpTrend = ema20 > ema50 and tf5Dir == 1 and tf15Dir >= 0 and pDI > mDI
syr30BalanceDownTrend = ema20 < ema50 and tf5Dir == -1 and tf15Dir <= 0 and mDI > pDI
syr30BalanceBuy = syr30UseBalance and syr30BalanceBuyEnabled and tradeableBase and syr30BalanceUpTrend and syr30ImpulseUp and syr30BalanceWidthATR >= syr30BalanceMinWidthATR and syr30BalanceWidthATR <= syr30BalanceMaxWidthATR and syr30BalanceVolumeOK and close > syr30BalanceHigh and close > open and closePosBuy > syr30BalanceMinClosePos and syr30BodyATR >= syr30BalanceMinBodyATR and syr30BodyATR <= syr30BalanceMaxBodyATR and adx >= syr30BalanceMinADX
syr30BalanceSell = syr30UseBalance and syr30BalanceSellEnabled and tradeableBase and syr30BalanceDownTrend and syr30ImpulseDown and syr30BalanceWidthATR >= syr30BalanceMinWidthATR and syr30BalanceWidthATR <= syr30BalanceMaxWidthATR and syr30BalanceVolumeOK and close < syr30BalanceLow and close < open and closePosSell > syr30BalanceMinClosePos and syr30BodyATR >= syr30BalanceMinBodyATR and syr30BodyATR <= syr30BalanceMaxBodyATR and adx >= syr30BalanceMinADX

// ━━━ SYR30 SCHOOL 2: ASIA ACCEPTED BREAK-RETEST ━━━
syr30UtcMinute = int((time % 86400000) / 60000)
syr30UtcDay = int(time / 86400000)
syr30NewUtcDay = ta.change(syr30UtcDay) != 0
var float syr30AsiaHigh = na
var float syr30AsiaLow = na
if syr30NewUtcDay
    syr30AsiaHigh := na
    syr30AsiaLow := na
syr30AsiaBuilding = syr30UtcMinute >= syr30AsiaBuildStartUTC and syr30UtcMinute < syr30AsiaBuildEndUTC
if syr30AsiaBuilding
    syr30AsiaHigh := na(syr30AsiaHigh) ? high : math.max(syr30AsiaHigh, high)
    syr30AsiaLow := na(syr30AsiaLow) ? low : math.min(syr30AsiaLow, low)
syr30AsiaReady = syr30UtcMinute >= syr30AsiaBuildEndUTC and not na(syr30AsiaHigh) and not na(syr30AsiaLow)
syr30AsiaBreakBuy = syr30AsiaReady and close > syr30AsiaHigh + syr30AsiaBreakBufferATR * atr
syr30AsiaBreakSell = syr30AsiaReady and close < syr30AsiaLow - syr30AsiaBreakBufferATR * atr
syr30AsiaRecentBreakBuy = ta.highest(syr30AsiaBreakBuy ? 1.0 : 0.0, syr30AsiaBreakMemory)[1] > 0
syr30AsiaRecentBreakSell = ta.highest(syr30AsiaBreakSell ? 1.0 : 0.0, syr30AsiaBreakMemory)[1] > 0
syr30AsiaWindow = syr30UtcMinute >= syr30AsiaTradeStartUTC and syr30UtcMinute < syr30AsiaTradeEndUTC
syr30AsiaFastBuyOK = not syr30AsiaRequireFastTrend or tf5Dir >= 0
syr30AsiaFastSellOK = not syr30AsiaRequireFastTrend or tf5Dir <= 0
syr30AsiaBuy = syr30UseAsia and syr30AsiaBuyEnabled and tradeableBase and syr30AsiaWindow and syr30AsiaRecentBreakBuy and low <= syr30AsiaHigh + syr30AsiaRetestToleranceATR * atr and close > syr30AsiaHigh and close > open and closePosBuy > syr30AsiaMinClosePos and syr30FlowZ > syr30AsiaBuyMinFlowZ and syr30AsiaFastBuyOK
syr30AsiaSell = syr30UseAsia and syr30AsiaSellEnabled and tradeableBase and syr30AsiaWindow and syr30AsiaRecentBreakSell and high >= syr30AsiaLow - syr30AsiaRetestToleranceATR * atr and close < syr30AsiaLow and close < open and closePosSell > syr30AsiaMinClosePos and syr30FlowZ < syr30AsiaSellMaxFlowZ and syr30AsiaFastSellOK

// ━━━ SYR30 SCHOOL 3: DEAD AUCTION RECLAIM ━━━
syr30AuctionHigh = ta.highest(high, syr30AuctionLookback)[1]
syr30AuctionLow = ta.lowest(low, syr30AuctionLookback)[1]
syr30AuctionWidth = syr30AuctionHigh - syr30AuctionLow
syr30AuctionWidthPts = syr30AuctionWidth / pointUnit
syr30AuctionMid = (syr30AuctionHigh + syr30AuctionLow) * 0.5
syr30AuctionPosPrev = (close[1] - syr30AuctionLow) / math.max(syr30AuctionWidth, syminfo.mintick)
syr30AuctionCenterNow = syr30AuctionPosPrev >= 0.30 and syr30AuctionPosPrev <= 0.70
syr30AuctionCenterAcceptance = ta.sma(syr30AuctionCenterNow ? 1.0 : 0.0, syr30AuctionLookback)
syr30AuctionLowTouchNow = low[1] <= syr30AuctionLow + syr30AuctionTouchBand * syr30AuctionWidth
syr30AuctionHighTouchNow = high[1] >= syr30AuctionHigh - syr30AuctionTouchBand * syr30AuctionWidth
syr30AuctionLowTouches = ta.sma(syr30AuctionLowTouchNow ? 1.0 : 0.0, syr30AuctionTouchLookback) * syr30AuctionTouchLookback
syr30AuctionHighTouches = ta.sma(syr30AuctionHighTouchNow ? 1.0 : 0.0, syr30AuctionTouchLookback) * syr30AuctionTouchLookback
syr30AuctionMidSlopeATR = math.abs(syr30AuctionMid - syr30AuctionMid[8]) / m1AtrSafe
syr30AuctionTypical = hlc3
syr30AuctionVolumeAvg = ta.sma(nz(volume, 0.0), syr30AuctionLookback)[1]
syr30AuctionVWAP = ta.sma(syr30AuctionTypical * nz(volume, 0.0), syr30AuctionLookback)[1] / math.max(syr30AuctionVolumeAvg, 0.000001)
syr30AuctionValueDistancePts = math.abs(syr30AuctionVWAP - close) / pointUnit
syr30AuctionRegime = syr30UseDeadAuction and tradeableBase and adx <= syr30AuctionMaxADX and sy389LocalER <= syr30AuctionMaxER and syr30AuctionMidSlopeATR <= syr30AuctionMaxMidSlopeATR and syr30AuctionCenterAcceptance >= syr30AuctionMinCenterAcceptance and syr30AuctionLowTouches >= syr30AuctionMinTouches and syr30AuctionHighTouches >= syr30AuctionMinTouches and syr30AuctionWidthPts >= syr30AuctionMinWidthPts and syr30AuctionWidthPts <= syr30AuctionMaxWidthPts and syr30AuctionValueDistancePts >= syr30AuctionMinValueDistancePts
syr30DeadAuctionBuy = syr30AuctionRegime and syr30AuctionBuyEnabled and low < syr30AuctionLow and close > syr30AuctionLow and close > open and closePosBuy >= syr30AuctionMinClosePos and syr30BodyATR >= syr30AuctionMinBodyATR and syr30BodyATR <= syr30AuctionMaxBodyATR
syr30DeadAuctionSell = syr30AuctionRegime and syr30AuctionSellEnabled and high > syr30AuctionHigh and close < syr30AuctionHigh and close < open and closePosSell >= syr30AuctionMinClosePos and syr30BodyATR >= syr30AuctionMinBodyATR and syr30BodyATR <= syr30AuctionMaxBodyATR

syr30SchoolBuyVotes = (syr30BalanceBuy ? 1 : 0) + (syr30AsiaBuy ? 1 : 0) + (syr30DeadAuctionBuy ? 1 : 0)
syr30SchoolSellVotes = (syr30BalanceSell ? 1 : 0) + (syr30AsiaSell ? 1 : 0) + (syr30DeadAuctionSell ? 1 : 0)
syr30ReplacementBuy = syr30UseSchoolRouter and syr30SchoolBuyVotes > syr30SchoolSellVotes
syr30ReplacementSell = syr30UseSchoolRouter and syr30SchoolSellVotes > syr30SchoolBuyVotes
syr30ReplacementSide = syr30ReplacementBuy ? 1 : syr30ReplacementSell ? -1 : 0

// The removed M1 Compression source no longer competes with the base branch.
m1BaseSide = baseBuySignal and not baseSellSignal ? 1 : baseSellSignal and not baseBuySignal ? -1 : 0
int m1SelectedSide = m1BaseSide
int m1SelectedSourceCode = 0

int sy8624BaseSide = m1SelectedSide
int sy8624BaseSourceCode = m1SelectedSourceCode

pbTol = atr * pbRetestTolATR
pbM1Bull = tradeableBase and close > open and bodyPct >= pbM1MinBodyPct and closePosBuy >= pbM1MinClosePos
pbM1Bear = tradeableBase and close < open and bodyPct >= pbM1MinBodyPct and closePosSell >= pbM1MinClosePos

var int pbLastBullObSignalId = na
var int pbLastBearObSignalId = na

pbObBuyCandidate = pbObBullActive and not na(pbObBullId) and high >= pbObBullBottom and low <= pbObBullTop and close > pbObBullTop and pbM1Bull
pbObSellCandidate = pbObBearActive and not na(pbObBearId) and high >= pbObBearBottom and low <= pbObBearTop and close < pbObBearBottom and pbM1Bear

pbObBuyNow = pbObBuyCandidate and (na(pbLastBullObSignalId) or pbLastBullObSignalId != pbObBullId)
pbObSellNow = pbObSellCandidate and (na(pbLastBearObSignalId) or pbLastBearObSignalId != pbObBearId)

if pbObBuyNow
    pbLastBullObSignalId := pbObBullId
if pbObSellNow
    pbLastBearObSignalId := pbObBearId

pbBreakBullNew = not na(pbBreakBullTime) and pbBreakBullTime != pbBreakBullTime[1]
pbBreakBearNew = not na(pbBreakBearTime) and pbBreakBearTime != pbBreakBearTime[1]
pbBreakBullBars = ta.barssince(pbBreakBullNew)
pbBreakBearBars = ta.barssince(pbBreakBearNew)

pbSlowBuyOK = not pbRequireSlowTrend or pbSlowTrend != -1
pbSlowSellOK = not pbRequireSlowTrend or pbSlowTrend != 1
pbBreakerBuyNow = not na(pbBreakBullBars) and pbBreakBullBars <= pbBreakValidBars and not na(pbBreakBullLevel) and low <= pbBreakBullLevel + pbTol and close > pbBreakBullLevel and pbM1Bull and pbSlowBuyOK
pbBreakerSellNow = not na(pbBreakBearBars) and pbBreakBearBars <= pbBreakValidBars and not na(pbBreakBearLevel) and high >= pbBreakBearLevel - pbTol and close < pbBreakBearLevel and pbM1Bear and pbSlowSellOK

pbObBuyBars = ta.barssince(pbObBuyNow)
pbObSellBars = ta.barssince(pbObSellNow)
pbBreakerBuyBars = ta.barssince(pbBreakerBuyNow)
pbBreakerSellBars = ta.barssince(pbBreakerSellNow)

pbObBuyRecent = not na(pbObBuyBars) and pbObBuyBars <= pbHarmonyWindow
pbObSellRecent = not na(pbObSellBars) and pbObSellBars <= pbHarmonyWindow
pbBreakerBuyRecent = not na(pbBreakerBuyBars) and pbBreakerBuyBars <= pbHarmonyWindow
pbBreakerSellRecent = not na(pbBreakerSellBars) and pbBreakerSellBars <= pbHarmonyWindow

pbEitherBuy = (pbObBuyNow and pbBreakerBuyRecent) or (pbBreakerBuyNow and pbObBuyRecent)
pbEitherSell = (pbObSellNow and pbBreakerSellRecent) or (pbBreakerSellNow and pbObSellRecent)
pbPocThenBreakerBuy = pbBreakerBuyNow and pbObBuyRecent
pbPocThenBreakerSell = pbBreakerSellNow and pbObSellRecent
pbBreakerThenPocBuy = pbObBuyNow and pbBreakerBuyRecent
pbBreakerThenPocSell = pbObSellNow and pbBreakerSellRecent

pbPairBuyRaw = pbPairMode == "POC Then Breaker" ? pbPocThenBreakerBuy : pbPairMode == "Breaker Then POC" ? pbBreakerThenPocBuy : pbEitherBuy
pbPairSellRaw = pbPairMode == "POC Then Breaker" ? pbPocThenBreakerSell : pbPairMode == "Breaker Then POC" ? pbBreakerThenPocSell : pbEitherSell
pbPairBuy = usePocBreakerPair and pbEnableBuy and pbPairBuyRaw
pbPairSell = usePocBreakerPair and pbEnableSell and pbPairSellRaw
pbPairSide = pbPairBuy and not pbPairSell ? 1 : pbPairSell and not pbPairBuy ? -1 : 0

int sy8624SelectedSide = pbOriginalPriority ? (sy8624BaseSide != 0 ? sy8624BaseSide : pbPairSide) : (pbPairSide != 0 ? pbPairSide : sy8624BaseSide)
int sy8624SelectedSourceCode = pbOriginalPriority ? (sy8624BaseSide != 0 ? sy8624BaseSourceCode : pbPairSide != 0 ? 4 : 0) : (pbPairSide != 0 ? 4 : sy8624BaseSourceCode)

tvRet = close - close[1]
tvERMove = math.abs(close - close[tvERLen])
tvERPath = math.max(f_roll_sum(math.abs(tvRet), tvERLen), syminfo.mintick)
tvER = tvERMove / tvERPath

tvLin = ta.linreg(close, tvLinLen, 0)
tvLinPrev = ta.linreg(close, tvLinLen, 1)
tvSlopeATR = (tvLin - tvLinPrev) / math.max(atr, syminfo.mintick)

tvRetStd10 = math.max(ta.stdev(tvRet, tvVolFastLen), syminfo.mintick)
tvRetStd60 = math.max(ta.stdev(tvRet, tvVolSlowLen), syminfo.mintick)
tvVolRatio = tvRetStd10 / tvRetStd60
tvRetZ = tvRet / math.max(ta.stdev(tvRet, tvRetZLen), syminfo.mintick)
tvAutoCorr = nz(ta.correlation(tvRet, tvRet[1], tvAutoCorrLen), 0.0)
tvUpShare = f_roll_sum(close > close[1] ? 1.0 : 0.0, tvShareLen) / tvShareLen
tvDownShare = 1.0 - tvUpShare

tvHigh8 = ta.highest(high[1], tvBuyBreakFastLen)
tvLow10 = ta.lowest(low[1], tvSellBreakFastLen)
tvHigh12 = ta.highest(high[1], tvBuyBreakBalancedLen)
tvLow15 = ta.lowest(low[1], tvSellBreakBalancedLen)
tvHigh20 = ta.highest(high[1], tvBuyBreakStrictLen)
tvLow24 = ta.lowest(low[1], tvSellBreakStrictLen)

tvBreak8Buy = tradeableBase and close > tvHigh8 and close[1] <= tvHigh8[1]
tvBreak12Buy = tradeableBase and close > tvHigh12 and close[1] <= tvHigh12[1]
tvBreak20Buy = tradeableBase and close > tvHigh20 and close[1] <= tvHigh20[1]

tvBreak10Sell = tradeableBase and close < tvLow10 and close[1] >= tvLow10[1]
tvBreak15Sell = tradeableBase and close < tvLow15 and close[1] >= tvLow15[1]
tvBreak24Sell = tradeableBase and close < tvLow24 and close[1] >= tvLow24[1]


tvExactFastBuy = tvBreak8Buy and tvER >= tvBuyFastER and tvSlopeATR > tvBuyFastSlopeATR and tvAutoCorr >= tvBuyFastAutoCorr and tvUpShare >= tvBuyFastUpShare
tvExactBalBuy = tvBreak12Buy and tvER >= tvBuyBalancedER and tvSlopeATR > tvBuyBalancedSlopeATR and tvAutoCorr >= tvBuyBalancedAutoCorr and tvVolRatio >= tvBuyBalancedVolRatio
tvExactStrictBuy = tvBreak20Buy and tvER >= tvBuyStrictER and tvSlopeATR > tvBuyStrictSlopeATR and tvAutoCorr >= tvBuyStrictAutoCorr and tvVolRatio >= tvBuyStrictVolRatio
tvExactImpulseBuy = tradeableBase and tvRetZ >= tvBuyImpulseZ and tvER >= tvBuyImpulseER and tvSlopeATR > tvBuyImpulseSlopeATR and tvUpShare >= tvBuyImpulseUpShare and bodyPct >= tvBuyImpulseBodyPct and closePosBuy >= tvBuyImpulseClosePos
tvExactBuyVotes = (tvExactFastBuy ? 1 : 0) + (tvExactBalBuy ? 1 : 0) + (tvExactStrictBuy ? 1 : 0) + (tvExactImpulseBuy ? 1 : 0)


tvStrictFastSell = tvBreak10Sell and tvER >= tvSellFastER and tvSlopeATR < -tvSellFastSlopeATR and tvAutoCorr >= tvSellFastAutoCorr and tvDownShare >= tvSellFastDownShare
tvStrictBalSell = tvBreak15Sell and tvER >= tvSellBalancedER and tvSlopeATR < -tvSellBalancedSlopeATR and tvAutoCorr >= tvSellBalancedAutoCorr and tvVolRatio >= tvSellBalancedVolRatio
tvStrictStrictSell = tvBreak24Sell and tvER >= tvSellStrictER and tvSlopeATR < -tvSellStrictSlopeATR and tvAutoCorr >= tvSellStrictAutoCorr and tvVolRatio >= tvSellStrictVolRatio
tvStrictImpulseSell = tradeableBase and tvRetZ <= -tvSellImpulseZ and tvER >= tvSellImpulseER and tvSlopeATR < -tvSellImpulseSlopeATR and tvDownShare >= tvSellImpulseDownShare and bodyPct >= tvSellImpulseBodyPct and closePosSell >= tvSellImpulseClosePos
tvStrictSellVotes = (tvStrictFastSell ? 1 : 0) + (tvStrictBalSell ? 1 : 0) + (tvStrictStrictSell ? 1 : 0) + (tvStrictImpulseSell ? 1 : 0)

tvAddonBuy = useTrendVoteAddon and trendVoteEnableBuy and tvExactBuyVotes >= trendVoteBuyMinVotes
tvAddonSell = useTrendVoteAddon and trendVoteEnableSell and tvStrictSellVotes >= trendVoteSellMinVotes
int tvAddonSide = tvAddonBuy and not tvAddonSell ? 1 : tvAddonSell and not tvAddonBuy ? -1 : 0

int syCleanSelectedSide = sy8624SelectedSide != 0 ? sy8624SelectedSide : tvAddonSide
int syCleanSelectedSourceCode = sy8624SelectedSide != 0 ? sy8624SelectedSourceCode : tvAddonSide != 0 ? 5 : 0

buySignal = syCleanSelectedSide == 1
sellSignal = syCleanSelectedSide == -1
m1SelectedSourceCode := syCleanSelectedSourceCode

capBBKCExactBuy = bbkcBuy
capRsi34S = ta.ema(rsi34, 8)
capRsi34Sig = ta.ema(capRsi34S, 21)
capQqeStrictBuy = tfCtxBuy and ta.crossover(capRsi34S, capRsi34Sig) and capRsi34S < 60 and close > ema20 and adx >= 18
capQqeStrictSell = tfCtxSell and ta.crossunder(capRsi34S, capRsi34Sig) and capRsi34S > 40 and close < ema20 and adx >= 18
cap331ExactBuy = sy331Buy
cap331ExactSell = false
capLiqExactBuy = sy361LiqBoostBuy
capLiqExactSell = sy361LiqBoostSell
capCleanMoveUltra = math.abs(close - close[20]) / math.max(ta.sma(math.abs(close - close[1]), 20) * 20, syminfo.mintick) >= 0.45
capMomUltraBuy = tradeableBase and capCleanMoveUltra and bullMomentum and bodyPct >= 60 and closePosBuy >= 0.78 and close > ema50 and htfScore >= 2.0 and roomBuy
capMomUltraSell = tradeableBase and capCleanMoveUltra and bearMomentum and bodyPct >= 60 and closePosSell >= 0.78 and close < ema50 and htfScore <= -2.0 and roomSell

capTr21 = f_roll_sum(f_tr(high, low, close), 21)
capViP21 = capTr21 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(high - low[1]), 21) / capTr21
capViM21 = capTr21 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(low - high[1]), 21) / capTr21
capQVUltraBuy = tradeableBase and capQqeStrictBuy and capViP21 > capViM21 and pDI > mDI and adx >= 22 and htfScore >= 1.0 and roomBuy
capQVUltraSell = tradeableBase and capQqeStrictSell and capViM21 > capViP21 and mDI > pDI and adx >= 22 and htfScore <= -1.0 and roomSell

capTen9 = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2.0
capKij26 = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2.0
capTen18 = (ta.highest(high, 18) + ta.lowest(low, 18)) / 2.0
capKij52 = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2.0
capIchiMidSell = tradeableBase and ta.crossunder(capTen9, capKij26) and close < ema20 and tf15Dir != 1 and roomSell
capIchiUltraBuy = tradeableBase and ta.crossover(capTen18, capKij52) and close > ema100 and tfCtxBuy and bodyPct >= 38 and roomBuy
cap331MidSell = tradeableBase and cap331ExactSell and bodyPct >= 24 and closePosSell >= 0.58 and roomSell
cap331UltraBuy = tradeableBase and cap331ExactBuy and bodyPct >= 42 and closePosBuy >= 0.72 and htfScore >= 1.0 and roomBuy
f_final_school_side(_buy, _sell) =>
    _buy and not _sell ? 1 : _sell and not _buy ? -1 : 0

finalS06 = fusionUseMomentum ? f_final_school_side(capMomUltraBuy, capMomUltraSell) : 0
finalS09 = fusionUseBBKC ? f_final_school_side(capBBKCExactBuy, false) : 0
finalS11 = fusionUseQQEVortex ? f_final_school_side(capQVUltraBuy, capQVUltraSell) : 0
finalS12 = syr30UseSchoolRouter ? f_final_school_side(syr30BalanceBuy, syr30BalanceSell) : 0
finalS17 = syr30UseSchoolRouter ? f_final_school_side(syr30DeadAuctionBuy, syr30DeadAuctionSell) : 0
finalS18 = fusionUseIchimoku ? f_final_school_side(capIchiUltraBuy, capIchiMidSell) : 0
finalS19 = fusionUseSidePack ? f_final_school_side(cap331UltraBuy, cap331MidSell) : 0
finalS22 = fusionUseLiquidity ? f_final_school_side(capLiqExactBuy, capLiqExactSell) : 0
finalS23 = syr30UseSchoolRouter ? f_final_school_side(syr30AsiaBuy, syr30AsiaSell) : 0

finalFusionBuyVotes = (finalS06 == 1 ? 1 : 0) + (finalS09 == 1 ? 1 : 0) + (finalS11 == 1 ? 1 : 0) + (finalS12 == 1 ? 1 : 0) + (finalS17 == 1 ? 1 : 0) + (finalS18 == 1 ? 1 : 0) + (finalS19 == 1 ? 1 : 0) + (finalS22 == 1 ? 1 : 0) + (finalS23 == 1 ? 1 : 0)
finalFusionSellVotes = (finalS06 == -1 ? 1 : 0) + (finalS09 == -1 ? 1 : 0) + (finalS11 == -1 ? 1 : 0) + (finalS12 == -1 ? 1 : 0) + (finalS17 == -1 ? 1 : 0) + (finalS18 == -1 ? 1 : 0) + (finalS19 == -1 ? 1 : 0) + (finalS22 == -1 ? 1 : 0) + (finalS23 == -1 ? 1 : 0)

finalFusionBuy = useFinalSchoolFusion and finalFusionBuyVotes >= finalFusionSellVotes + fusionMinVoteAdvantage
finalFusionSell = useFinalSchoolFusion and finalFusionSellVotes >= finalFusionBuyVotes + fusionMinVoteAdvantage
int finalFusionSide = finalFusionBuy ? 1 : finalFusionSell ? -1 : 0

finalFusionWinningVotes = finalFusionSide == 1 ? finalFusionBuyVotes : finalFusionSide == -1 ? finalFusionSellVotes : 0
finalFusionM1Only = finalFusionWinningVotes == 1 and ((finalFusionSide == 1 and finalS23 == 1) or (finalFusionSide == -1 and finalS23 == -1))
int finalFusionSourceCode = finalFusionSide == 0 ? 0 : finalFusionM1Only ? 1 : 6

float K3_CACHE_OPPOSE_LIMIT = k3CacheOpposeLimit

int k3BaseRawSide = sy8624SelectedSide
int k3TVRawSide = tvAddonSide
int k3FusionRawSide = finalFusionSide

bool k3BasePass = k3BaseRawSide == 1 ? not (k3CacheHTFScore <= -K3_CACHE_OPPOSE_LIMIT and k3CacheBiasDir == -1) :
     k3BaseRawSide == -1 ? not (k3CacheHTFScore >= K3_CACHE_OPPOSE_LIMIT and k3CacheBiasDir == 1) : false
bool k3TVPass = k3TVRawSide == 1 ? not (k3CacheHTFScore <= -K3_CACHE_OPPOSE_LIMIT and k3CacheBiasDir == -1) :
     k3TVRawSide == -1 ? not (k3CacheHTFScore >= K3_CACHE_OPPOSE_LIMIT and k3CacheBiasDir == 1) : false
bool k3FusionPass = k3FusionRawSide == 1 ? not (k3CacheHTFScore <= -K3_CACHE_OPPOSE_LIMIT and k3CacheBiasDir == -1) :
     k3FusionRawSide == -1 ? not (k3CacheHTFScore >= K3_CACHE_OPPOSE_LIMIT and k3CacheBiasDir == 1) : false

int k3BaseSide = (not k3UseCacheGateBase or k3BasePass) ? k3BaseRawSide : 0
int k3TVSide = (not k3UseCacheGateTrendVote or k3TVPass) ? k3TVRawSide : 0
int k3FusionSide = (not k3UseCacheGateFusion or k3FusionPass) ? k3FusionRawSide : 0

int syFinalSelectedSide = 0
int syFinalSelectedSourceCode = 0

if k3SourcePriority == "Fusion > Trend Vote > Base"
    syFinalSelectedSide := k3FusionSide != 0 ? k3FusionSide : k3TVSide != 0 ? k3TVSide : k3BaseSide
    syFinalSelectedSourceCode := k3FusionSide != 0 ? finalFusionSourceCode : k3TVSide != 0 ? 5 : k3BaseSide != 0 ? sy8624SelectedSourceCode : 0
else if k3SourcePriority == "Trend Vote > Fusion > Base"
    syFinalSelectedSide := k3TVSide != 0 ? k3TVSide : k3FusionSide != 0 ? k3FusionSide : k3BaseSide
    syFinalSelectedSourceCode := k3TVSide != 0 ? 5 : k3FusionSide != 0 ? finalFusionSourceCode : k3BaseSide != 0 ? sy8624SelectedSourceCode : 0
else if k3SourcePriority == "Base > Trend Vote > Fusion"
    syFinalSelectedSide := k3BaseSide != 0 ? k3BaseSide : k3TVSide != 0 ? k3TVSide : k3FusionSide
    syFinalSelectedSourceCode := k3BaseSide != 0 ? sy8624SelectedSourceCode : k3TVSide != 0 ? 5 : k3FusionSide != 0 ? finalFusionSourceCode : 0
else
    syFinalSelectedSide := k3BaseSide != 0 ? k3BaseSide : k3FusionSide != 0 ? k3FusionSide : k3TVSide
    syFinalSelectedSourceCode := k3BaseSide != 0 ? sy8624SelectedSourceCode : k3FusionSide != 0 ? finalFusionSourceCode : k3TVSide != 0 ? 5 : 0

// R13 FIX: apply Fast Trend TF to every final source (Base / Trend Vote / Fusion),
// not only to the legacy base path. It blocks only when Fast agrees with Mid or Bias
// against the selected side. Real sweep/reversal setups remain allowed.
fastFinalBuyBypass = sy338TrueCounterBuy or sweepLow or realRevBuy or sy360FibBoostBuy or sy361LiqBoostBuy or syr30DeadAuctionBuy
fastFinalSellBypass = sy338TrueCounterSell or sweepHigh or realRevSell or sy360FibBoostSell or sy361LiqBoostSell or syr30DeadAuctionSell
fastFinalBuyBlock = useRealMapDirectGate and tf5Dir == -1 and (tf15Dir == -1 or k3CacheBiasDir == -1) and not fastFinalBuyBypass
fastFinalSellBlock = useRealMapDirectGate and tf5Dir == 1 and (tf15Dir == 1 or k3CacheBiasDir == 1) and not fastFinalSellBypass

if syFinalSelectedSide == 1 and fastFinalBuyBlock
    syFinalSelectedSide := 0
    syFinalSelectedSourceCode := 0
else if syFinalSelectedSide == -1 and fastFinalSellBlock
    syFinalSelectedSide := 0
    syFinalSelectedSourceCode := 0

buySignal := syFinalSelectedSide == 1
sellSignal := syFinalSelectedSide == -1
m1SelectedSourceCode := syFinalSelectedSourceCode

plotshape(showFinalFusionMarks and k3FusionSide == 1 and syFinalSelectedSide == 1, title="FINAL FUSION BUY", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), text="F", textcolor=color.black, size=size.tiny)
plotshape(showFinalFusionMarks and k3FusionSide == -1 and syFinalSelectedSide == -1, title="FINAL FUSION SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), text="F", textcolor=color.white, size=size.tiny)

plotshape(trendVoteShowMarks and k3FusionSide == 0 and k3TVSide == 1 and syFinalSelectedSide == 1, title="TREND VOTE CLEAN BUY", style=shape.triangleup, location=location.belowbar, color=color.new(color.aqua, 0), text="TV", textcolor=color.black, size=size.tiny)
plotshape(trendVoteShowMarks and k3FusionSide == 0 and k3TVSide == -1 and syFinalSelectedSide == -1, title="TREND VOTE CLEAN SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), text="TV", textcolor=color.black, size=size.tiny)

plotshape(showPocBreakerMarks and pbObBuyNow, title="SYXAUUSD POC OB BUY", style=shape.circle, location=location.belowbar, color=color.new(color.aqua, 0), text="POC", textcolor=color.black, size=size.tiny)
plotshape(showPocBreakerMarks and pbObSellNow, title="SYXAUUSD POC OB SELL", style=shape.circle, location=location.abovebar, color=color.new(color.fuchsia, 0), text="POC", textcolor=color.white, size=size.tiny)
plotshape(showPocBreakerMarks and pbBreakerBuyNow, title="SYXAUUSD BREAKER BUY", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), text="BRK", textcolor=color.black, size=size.tiny)
plotshape(showPocBreakerMarks and pbBreakerSellNow, title="SYXAUUSD BREAKER SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), text="BRK", textcolor=color.black, size=size.tiny)

sy999BuyCounter = sy389BiasDown or htfScore <= -0.5
sy999SellCounter = sy389BiasUp or htfScore >= 0.5
sy999SignalCounter = buySignal ? sy999BuyCounter : sy999SellCounter
sy999SignalAligned = buySignal ? (sy389BiasUp or htfScore > 0) : (sy389BiasDown or htfScore < 0)
sy999SignalStrongAligned = sy999SignalAligned and math.abs(htfScore) >= 2.0 and adx >= 20
sy999SignalRange = math.abs(htfScore) < 1.0 and adx < 20
sy999SignalHighVol = atrRatio >= 1.55
sy999SignalQuiet = atrRatio <= 0.72 or adx < 15
sy999SignalRegime = (vtzActive or sy999SignalHighVol) ? 4 : sy999SignalCounter ? 3 : (sy999SignalRange or sy999SignalQuiet) ? 2 : sy999SignalStrongAligned ? 0 : 1

f_sy999_progress_bin(_mfe, _target) =>
    _x = _mfe / math.max(_target, 1.0)
    _x < 0.15 ? 0 : _x < 0.35 ? 1 : _x < 0.60 ? 2 : _x < 0.85 ? 3 : 4

f_sy999_adverse_bin(_mae, _stop) =>
    _x = _mae / math.max(_stop, 1.0)
    _x < 0.15 ? 0 : _x < 0.35 ? 1 : _x < 0.60 ? 2 : _x < 0.85 ? 3 : 4

f_sy999_time_bin(_bars) =>
    _bars <= 2 ? 0 : _bars <= 5 ? 1 : _bars <= 10 ? 2 : _bars <= 20 ? 3 : 4

f_sy999_regime_key(_regime, _mfe, _mae, _bars, _target, _stop) =>
    _rg = math.max(0, math.min(4, _regime))
    _pg = f_sy999_progress_bin(_mfe, _target)
    _ad = f_sy999_adverse_bin(_mae, _stop)
    _tb = f_sy999_time_bin(_bars)
    (((_rg * 5) + _pg) * 5 + _ad) * 5 + _tb

f_sy999_prob(array<int> _cnt, array<int> _win, _key) =>
    _n = _key >= 0 and _key < array.size(_cnt) ? array.get(_cnt, _key) : 0
    _w = _key >= 0 and _key < array.size(_win) ? array.get(_win, _key) : 0
    _p = (_w + wfPriorWinRate * wfPriorStrength) / math.max(_n + wfPriorStrength, 1.0)
    [_p, _n]

f_sy999_upper_bound(_p, _n) =>
    _se = math.sqrt(math.max(_p * (1.0 - _p), 0.000001) / math.max(_n + wfPriorStrength, 1.0))
    math.min(1.0, _p + wfConfidenceZ * _se)

f_sy999_regime80_exit(_pnl, _mfe, _bars, _target, _stop, _pR, _nR) =>
    _holdR = _pR * _target - (1.0 - _pR) * _stop
    _advR = _pnl - _holdR
    _giveback = _mfe - _pnl
    _profitProtect = _pnl >= realCostPts + 6.0 and _giveback >= math.max(8.0, _target * 0.14)
    _uR = f_sy999_upper_bound(_pR, _nR)
    _bars >= 3 and _nR >= wfMinSamples and _profitProtect and _uR < 0.80 and _advR >= math.max(5.0, wfMinExitAdvantage - 2.0)

f_sy999_add_unique(array<int> _a, _v) =>
    if array.indexof(_a, _v) == -1
        array.push(_a, _v)

f_sy999_learn_update(array<int> _cnt, array<int> _win, array<int> _visited, _isWin) =>
    if array.size(_visited) > 0
        for i = 0 to array.size(_visited) - 1
            _k = array.get(_visited, i)
            if _k >= 0 and _k < array.size(_cnt)
                array.set(_cnt, _k, array.get(_cnt, _k) + 1)
                if _isWin
                    array.set(_win, _k, array.get(_win, _k) + 1)

f_sy999_current_plan(_side, _entry) =>
    _buy = _side == 1
    _atrSafe = math.max(atr, syminfo.mintick)
    _atrPts = _atrSafe / pointUnit

    _stopLo = math.max(1.0, math.min(smartMinStopPts, smartMaxStopPts))
    _stopHi = math.max(_stopLo, math.max(smartMinStopPts, smartMaxStopPts))
    _targetLo = math.max(1.0, math.min(smartMinTargetPts, smartMaxTargetPts))
    _targetHi = math.max(_targetLo, math.max(smartMinTargetPts, smartMaxTargetPts))

    _trend = _buy ? (powerUp or localTrendBuy or mapBuy or sy130TrendUp or htfScore >= 2.0 or (adx >= smartMomentumADX and pDI > mDI) or bullMomentum) : (powerDown or localTrendSell or mapSell or sy130TrendDown or htfScore <= -2.0 or (adx >= smartMomentumADX and mDI > pDI) or bearMomentum)
    _sweep = _buy ? (sweepLow or realRevBuy or sy338TrueCounterBuy or sy361LiqBoostBuy) : (sweepHigh or realRevSell or sy338TrueCounterSell or sy361LiqBoostSell)
    _highVol = atrRatio >= smartHighVolRatio or barRange / _atrSafe >= 1.35
    _chop = rangeMarket or (adx <= smartChopADX and math.abs(htfScore) < 1.5 and atrRatio < smartHighVolRatio)

    _buf = smartFixedBufferPts + _atrPts * smartATRBufferMult + ((_highVol or _sweep) ? smartMomentumStopAdd : 0.0)
    _rawStop = _buy ? (_entry - ta.lowest(low, smartStopLookback)) / pointUnit + _buf : (ta.highest(high, smartStopLookback) - _entry) / pointUnit + _buf
    _stop = f_clamp_float(_rawStop, _stopLo, _stopHi)

    _stateMaxRaw = _chop ? math.max(_targetLo, _targetHi - smartChopTargetCut) : _trend ? _targetHi : math.max(_targetLo, _targetHi - smartChopTargetCut * 0.35)
    _stateMax = f_clamp_float(_stateMaxRaw, _targetLo, _targetHi)
    _minT = f_clamp_float(math.max(_targetLo, _stop * smartMinRR), _targetLo, _stateMax)
    _maxT = f_clamp_float(math.max(_minT, _stop * smartMaxRR), _minT, _stateMax)
    _swing = _buy ? f_nearest_buy_liq_pts(_entry, _minT, _maxT, smartTargetLookback, true, pointUnit) : f_nearest_sell_liq_pts(_entry, _minT, _maxT, smartTargetLookback, true, pointUnit)
    _any = na(_swing) and not smartUseSwingTargetOnly ? (_buy ? f_nearest_buy_liq_pts(_entry, _minT, _maxT, smartTargetLookback, false, pointUnit) : f_nearest_sell_liq_pts(_entry, _minT, _maxT, smartTargetLookback, false, pointUnit)) : _swing
    _fallbackRaw = _trend ? targetPoints + smartMomentumTargetAdd : _chop ? targetPoints - smartChopTargetCut : targetPoints
    _fallback = f_clamp_float(_fallbackRaw, _minT, _maxT)
    _target = na(_any) ? _fallback : _any

    [math.round(f_clamp_float(_target, _targetLo, _targetHi)), math.round(f_clamp_float(_stop, _stopLo, _stopHi))]

f_sy999_source_plan(_side, _entry, _sourceCode, _tradeKind) =>
    [_adaptiveTarget, _adaptiveStop] = f_sy999_current_plan(_side, _entry)

    float _target = useSmartExitPlanner ? _adaptiveTarget : targetPoints
    float _stop = useSmartExitPlanner ? _adaptiveStop : stopPoints

    // Primary risk precedence: Separate Side > Trade Type > Adaptive/Fixed.
    // R11 had Separate Side before Trade Type, so Trade Type silently overwrote it.
    if useSY333TypeRisk
        if _tradeKind == 1
            _target := buyRangeTarget
            _stop := buyRangeStop
        else if _tradeKind == 2
            _target := buySweepTarget
            _stop := buySweepStop
        else if _tradeKind == 3
            _target := buyTrendTarget
            _stop := buyTrendStop
        else if _tradeKind == -1
            _target := sellRangeTarget
            _stop := sellRangeStop
        else if _tradeKind == -2
            _target := sellSweepTarget
            _stop := sellSweepStop
        else if _tradeKind == -3
            _target := sellTrendTarget
            _stop := sellTrendStop

    if useSeparateSideRisk
        _target := _side == 1 ? buyTargetPoints : sellTargetPoints
        _stop := _side == 1 ? buyStopPoints : sellStopPoints
    _isPocSource = _sourceCode == 4

    if useSourceRiskManager and usePocTargetExtension and _isPocSource
        _target := _adaptiveTarget + pocTargetAddPoints
        _stop := pocKeepAdaptiveStop ? _adaptiveStop : pocFixedStopPoints

    [math.round(_target), math.round(_stop)]

// Calculated continuously on every M1 bar so the custom platform and Pine use a complete series.
daeProtectedLow = ta.lowest(low, daeStopLookback)
daeProtectedHigh = ta.highest(high, daeStopLookback)

f_dae_exit_plan(_side, _entry, _baseTarget, _baseStop, _tradeKind) =>
    _buy = _side == 1
    _sideSign = _buy ? 1.0 : -1.0
    _atrSafe = math.max(atr, syminfo.mintick)
    _atrPts = _atrSafe / pointUnit

    _targetLo = math.max(5.0, math.min(daeMinTargetPts, daeMaxTargetPts))
    _targetHi = math.max(_targetLo, math.max(daeMinTargetPts, daeMaxTargetPts))
    _stopLo = math.max(5.0, math.min(daeMinStopPts, daeMaxStopPts))
    _stopHi = math.max(_stopLo, math.max(daeMinStopPts, daeMaxStopPts))
    _baseT = f_clamp_float((_baseTarget + daeBaseTargetPts) * 0.5, _targetLo, _targetHi)
    _baseS = f_clamp_float(_baseStop, _stopLo, _stopHi)

    _m1Raw = ema20 > ema50 and close > ema20 ? 1.0 : ema20 < ema50 and close < ema20 ? -1.0 : 0.0
    _slopeRaw = sy325EmaSlope >= sy325DriverSlopeATR ? 1.0 : sy325EmaSlope <= -sy325DriverSlopeATR ? -1.0 : 0.0
    _dmiRaw = pDI > mDI ? 1.0 : mDI > pDI ? -1.0 : 0.0
    _vwapRaw = na(vwapVal) ? 0.0 : close > vwapVal ? 1.0 : close < vwapVal ? -1.0 : 0.0
    _biasRaw = sy389BiasUp ? 1.0 : sy389BiasDown ? -1.0 : 0.0
    _m5Raw = float(nz(daeM5Dir, 0))
    _m15Raw = float(nz(daeM15Dir, 0))
    _marketRaw = _m1Raw * 1.0 + _slopeRaw * 0.75 + _dmiRaw * 0.75 + _vwapRaw * 0.50 + _m5Raw * 1.50 + _m15Raw * 2.00 + _biasRaw * 1.00
    _score = _marketRaw * _sideSign

    _sameM5 = daeM5Dir == _side
    _sameM15 = daeM15Dir == _side
    _oppM15 = daeM15Dir == -_side
    _reversal = _buy ? (sweepLow and (realRevBuy or sy338TrueCounterBuy or sy361LiqBoostBuy)) : (sweepHigh and (realRevSell or sy338TrueCounterSell or sy361LiqBoostSell))
    _rangeKind = math.abs(_tradeKind) == 1
    _sweepKind = math.abs(_tradeKind) == 2
    _strong = _score >= daeStrongScore and _sameM5 and _sameM15
    _aligned = _score >= 1.50 and not _oppM15
    _rangeState = rangeMarket or _rangeKind or (math.abs(_marketRaw) < 1.50 and not _reversal)
    _counter = (_score <= 0.0 or _oppM15) and not _reversal

    _chaseATR = _buy ? math.max(0.0, (close - ema20) / _atrSafe) : math.max(0.0, (ema20 - close) / _atrSafe)
    _recentMovePts = _buy ? sy337UpMovePts : sy337DownMovePts
    _late = _chaseATR > daeMaxChaseATR or _recentMovePts > daeMaxTargetPts * 1.15

    _strongTarget = math.min(_targetHi, math.max(_baseT, daeBaseTargetPts + math.min(20.0, _atrPts * 0.80)))
    _alignedTarget = math.min(_targetHi, math.max(_baseT, daeBaseTargetPts + math.min(10.0, _atrPts * 0.35)))
    _rangeTarget = math.min(math.max(_targetLo, daeRangeTargetCap), math.max(_targetLo, _baseT * 0.78))
    _reversalTarget = math.min(math.max(_targetLo, daeCounterTargetCap), math.max(_targetLo, _baseT * (_sweepKind ? 0.82 : 0.72)))
    _counterTarget = math.min(math.max(_targetLo, daeCounterTargetCap), math.max(_targetLo, _baseT * 0.62))

    _wanted = _strong ? _strongTarget : _aligned ? _alignedTarget : _reversal ? _reversalTarget : _rangeState ? _rangeTarget : _counterTarget
    _wanted := _counter ? math.min(_wanted, daeCounterTargetCap) : _wanted
    _wanted := _late ? math.min(_wanted, daeLateTargetCap) : _wanted
    _wanted := f_clamp_float(_wanted, _targetLo, _targetHi)

    _liqMax = f_clamp_float(_wanted + (_strong ? 8.0 : 4.0), _targetLo, _targetHi)
    _liqSwing = _buy ? f_nearest_buy_liq_pts(_entry, _targetLo, _liqMax, daeLiquidityLookback, true, pointUnit) : f_nearest_sell_liq_pts(_entry, _targetLo, _liqMax, daeLiquidityLookback, true, pointUnit)
    _liqAny = na(_liqSwing) ? (_buy ? f_nearest_buy_liq_pts(_entry, _targetLo, _liqMax, daeLiquidityLookback, false, pointUnit) : f_nearest_sell_liq_pts(_entry, _targetLo, _liqMax, daeLiquidityLookback, false, pointUnit)) : _liqSwing
    _target = na(_liqAny) ? _wanted : math.min(_wanted, math.max(_targetLo, _liqAny - 2.0))
    _target := f_clamp_float(_target, _targetLo, _targetHi)

    _stopBuffer = math.max(3.0, _atrPts * 0.22)
    _rawStop = _buy ? (_entry - daeProtectedLow) / pointUnit + _stopBuffer : (daeProtectedHigh - _entry) / pointUnit + _stopBuffer
    _rawStopSafe = na(_rawStop) ? _baseS : _rawStop
    _structureStop = f_clamp_float(_rawStopSafe, _stopLo, _stopHi)
    _stop = _strong ? math.min(_baseS, math.max(_stopLo, _structureStop)) : (_counter or _reversal ? math.max(_baseS, _structureStop) : (_baseS + _structureStop) * 0.5)
    _stop := f_clamp_float(_stop, _stopLo, _stopHi)

    _mode = _late ? 5 : _counter ? 4 : _reversal ? 3 : _rangeState ? 2 : _strong ? 0 : 1

    // R16 context profiles. They are selected only from live market state at entry;
    // there are no date/month rules. Minimum target remains locked at 30 points.
    _contextProfile = daeUseContextProfiles and (_mode == 1 or _mode == 5)
    _contextTarget = _mode == 5 ? (_buy ? daeBuyLateTargetPts : daeSellLateTargetPts) : (_buy ? daeBuyAlignedTargetPts : daeSellAlignedTargetPts)
    _contextStop = _mode == 5 ? (_buy ? daeBuyLateStopPts : daeSellLateStopPts) : (_buy ? daeBuyAlignedStopPts : daeSellAlignedStopPts)
    _adaptiveTarget = _contextProfile ? math.max(30.0, _contextTarget) : _target
    _adaptiveStop = _contextProfile ? math.max(1.0, _contextStop) : _stop

    _finalTarget = useDirectionalAdaptiveExit ? _adaptiveTarget : _baseTarget
    _finalStop = useDirectionalAdaptiveExit ? _adaptiveStop : _baseStop
    [math.round(_finalTarget), math.round(_finalStop), _mode, _score]

