allowShort = tradeSide == "BOTH" or tradeSide == "SHORT"
pointUnit = math.max(pointUnitInput, syminfo.mintick)
statsActive = statsMode == "All Loaded History" or time >= statsStartTime
statsResetByTime = statsMode == "From Custom Time" and time >= statsStartTime and (na(time[1]) or time[1] < statsStartTime)
f_hidden_fib_assist() =>
    _atr = ta.atr(14)
    _pHigh = ta.pivothigh(high, hiddenFibPivotLen, hiddenFibPivotLen)
    _pLow = ta.pivotlow(low, hiddenFibPivotLen, hiddenFibPivotLen)

    var float _lastPivotHigh = na
    var float _lastPivotLow = na
    var int _lastPivotHighBar = na
    var int _lastPivotLowBar = na
    var float _lockedHigh = na
    var float _lockedLow = na
    var int _lockedDir = 0

    if not na(_pHigh)
        _lastPivotHigh := _pHigh
        _lastPivotHighBar := bar_index - hiddenFibPivotLen

    if not na(_pLow)
        _lastPivotLow := _pLow
        _lastPivotLowBar := bar_index - hiddenFibPivotLen

    _ready = not na(_lastPivotHigh) and not na(_lastPivotLow) and not na(_lastPivotHighBar) and not na(_lastPivotLowBar)
    _wave = _ready ? math.abs(_lastPivotHigh - _lastPivotLow) : na
    _strongWave = _ready and _wave >= _atr * hiddenFibMinWaveATR

    _newUpWave = _strongWave and _lastPivotHighBar > _lastPivotLowBar
    _newDownWave = _strongWave and _lastPivotLowBar > _lastPivotHighBar

    if _strongWave
        if _newUpWave and (_lockedDir != 1 or _lockedHigh != _lastPivotHigh or _lockedLow != _lastPivotLow)
            _lockedHigh := _lastPivotHigh
            _lockedLow := _lastPivotLow
            _lockedDir := 1
        if _newDownWave and (_lockedDir != -1 or _lockedHigh != _lastPivotHigh or _lockedLow != _lastPivotLow)
            _lockedHigh := _lastPivotHigh
            _lockedLow := _lastPivotLow
            _lockedDir := -1

    _hasFib = not na(_lockedHigh) and not na(_lockedLow) and _lockedDir != 0
    _rng = _hasFib ? math.max(_lockedHigh - _lockedLow, syminfo.mintick) : na

    _zTop = math.min(hiddenFibZoneTop, hiddenFibZoneBottom)
    _zBot = math.max(hiddenFibZoneTop, hiddenFibZoneBottom)

    _buyTop = _hasFib ? _lockedHigh - _rng * _zTop : na
    _buyBot = _hasFib ? _lockedHigh - _rng * _zBot : na

    _sellBot = _hasFib ? _lockedLow + _rng * _zTop : na
    _sellTop = _hasFib ? _lockedLow + _rng * _zBot : na

    _tol = _atr * hiddenFibToleranceATR
    _cRange = math.max(high - low, syminfo.mintick)
    _closePos = (close - low) / _cRange
    _bullReject = close > open and _closePos >= 0.55
    _bearReject = close < open and _closePos <= 0.45

    _inBuy = _hasFib and _lockedDir == 1 and close <= _buyTop + _tol and close >= _buyBot - _tol
    _inSell = _hasFib and _lockedDir == -1 and close >= _sellBot - _tol and close <= _sellTop + _tol

    _buyOK = _inBuy and (not hiddenFibRequireReaction or _bullReject)
    _sellOK = _inSell and (not hiddenFibRequireReaction or _bearReject)

    [_buyOK[1], _sellOK[1], _inBuy[1], _inSell[1], _lockedDir[1]]

f_hidden_liq_sweep_assist() =>
    _prevLow = ta.lowest(low, hiddenLiqLookback)[1]
    _prevHigh = ta.highest(high, hiddenLiqLookback)[1]
    _buySweep = not na(_prevLow) and low < _prevLow and (hiddenLiqRequireCloseReclaim ? close > _prevLow : close > low)
    _sellSweep = not na(_prevHigh) and high > _prevHigh and (hiddenLiqRequireCloseReclaim ? close < _prevHigh : close < high)

    [_buySweep[1], _sellSweep[1], _prevLow[1], _prevHigh[1]]

f_sy130_smoothrng(_x, _t, _m) =>
    _wper = _t * 2 - 1
    _avrng = ta.ema(math.abs(_x - _x[1]), _t)
    ta.ema(_avrng, _wper) * _m

f_sy130_rngfilt(_x, _r) =>
    var float _rf = na
    _prev = nz(_rf[1], _x)
    _rf := _x > _prev ? math.max(_prev, _x - _r) : math.min(_prev, _x + _r)
    _rf

f_sy130_rp_dir() =>
    _src = close
    _smrng1 = f_sy130_smoothrng(_src, sy130RPFastSmooth, sy130RPFastMult)
    _smrng2 = f_sy130_smoothrng(_src, sy130RPSlowSmooth, sy130RPSensitivity)
    _smrng = (_smrng1 + _smrng2) / 2.0
    _filt = f_sy130_rngfilt(_src, _smrng)
    int _dir = 0
    _dir := _filt > _filt[1] ? 1 : _filt < _filt[1] ? -1 : nz(_dir[1], 0)
    [_dir, _filt]

f_sy130_ualgo_dir() =>
    _atr = ta.atr(sy130ATRLen)
    _up = sy130ATRSource - sy130ATRMult * _atr
    _up1 = nz(_up[1], _up)
    _up := close[1] > _up1 ? math.max(_up, _up1) : _up
    _dn = sy130ATRSource + sy130ATRMult * _atr
    _dn1 = nz(_dn[1], _dn)
    _dn := close[1] < _dn1 ? math.min(_dn, _dn1) : _dn
    var int _trend = 1
    _trend := nz(_trend[1], _trend)
    _trend := _trend == -1 and close > _dn1 ? 1 : _trend == 1 and close < _up1 ? -1 : _trend
    [_trend, _up, _dn]

f_sy130_rp_dir_only() =>
    [_d, _line] = f_sy130_rp_dir()
    _d

f_sy130_ualgo_dir_only() =>
    [_d, _up, _dn] = f_sy130_ualgo_dir()
    _d

f_sy389_bias() =>
    _atr = ta.atr(14)
    _ema20 = ta.ema(close, 20)
    _ema50 = ta.ema(close, 50)
    _reg = ta.linreg(close, sy389RegLen, 0)
    _slope = (_reg - _reg[sy389SlopeLen]) / math.max(_atr, syminfo.mintick)
    _move = math.abs(close - close[sy389RegLen])
    _noise = ta.sma(math.abs(ta.change(close)), sy389RegLen) * sy389RegLen
    _er = _noise <= syminfo.mintick ? 0.0 : _move / _noise
    _up = _slope >= sy389MinSlopeATR and close > _ema50 and _ema20 >= _ema50 and _er >= sy389MinER
    _down = _slope <= -sy389MinSlopeATR and close < _ema50 and _ema20 <= _ema50 and _er >= sy389MinER
    _dir = _up ? 1 : _down ? -1 : 0
    [_dir[1], _slope[1], _er[1], _ema20[1], _ema50[1], close[1]]

f_poc_breaker_ob() =>
    _atr = ta.atr(14)
    _prevHigh = ta.highest(high, pbObBosLookback)[1]
    _prevLow = ta.lowest(low, pbObBosLookback)[1]
    _bullBos = not na(_prevHigh) and close > _prevHigh and close[1] <= _prevHigh and close > open
    _bearBos = not na(_prevLow) and close < _prevLow and close[1] >= _prevLow and close < open

    var float _bullTop = na
    var float _bullBottom = na
    var int _bullId = na
    var bool _bullActive = false
    var float _bearTop = na
    var float _bearBottom = na
    var int _bearId = na
    var bool _bearActive = false

    if _bullBos
        _lb = int(math.abs(ta.lowestbars(low[1], pbObBosLookback))) + 1
        _poc = (high[_lb] + low[_lb] + close[_lb]) / 3.0
        _bullTop := math.max(math.max(open[_lb], close[_lb]), _poc)
        _bullBottom := math.min(low[_lb], _poc)
        _bullId := time
        _bullActive := true

    if _bearBos
        _hb = int(math.abs(ta.highestbars(high[1], pbObBosLookback))) + 1
        _poc = (high[_hb] + low[_hb] + close[_hb]) / 3.0
        _bearTop := math.max(high[_hb], _poc)
        _bearBottom := math.min(math.min(open[_hb], close[_hb]), _poc)
        _bearId := time
        _bearActive := true

    if _bullActive and close < _bullBottom - _atr * pbObInvalidATR
        _bullActive := false
    if _bearActive and close > _bearTop + _atr * pbObInvalidATR
        _bearActive := false

    [_bullTop[1], _bullBottom[1], _bullId[1], _bullActive[1],
     _bearTop[1], _bearBottom[1], _bearId[1], _bearActive[1]]

f_poc_breaker_structure(_len) =>
    _ph = ta.pivothigh(high, _len, _len)
    _pl = ta.pivotlow(low, _len, _len)

    var float _lastHigh = na
    var float _lastLow = na
    var int _trend = 0
    var int _lastBullBreakTime = na
    var int _lastBearBreakTime = na
    var float _lastBullBreakLevel = na
    var float _lastBearBreakLevel = na

    if not na(_ph)
        _lastHigh := _ph
    if not na(_pl)
        _lastLow := _pl

    _bullBreak = not na(_lastHigh) and close > _lastHigh and close[1] <= _lastHigh
    _bearBreak = not na(_lastLow) and close < _lastLow and close[1] >= _lastLow

    if _bullBreak
        _trend := 1
        _lastBullBreakTime := time
        _lastBullBreakLevel := _lastHigh

    if _bearBreak
        _trend := -1
        _lastBearBreakTime := time
        _lastBearBreakLevel := _lastLow

    [_trend[1], _lastHigh[1], _lastLow[1],
     _lastBullBreakTime[1], _lastBearBreakTime[1],
     _lastBullBreakLevel[1], _lastBearBreakLevel[1]]

f_htf_dir() =>
    _ema20 = ta.ema(close, 20)[1]
    _ema50 = ta.ema(close, 50)[1]
    _ema100 = ta.ema(close, 100)[1]
    [_p, _m, _adx] = ta.dmi(14, 14)
    _c = close[1]
    _buy = _ema20 > _ema50 and _ema50 > _ema100 and _c > _ema50 and _p[1] >= _m[1]
    _sell = _ema20 < _ema50 and _ema50 < _ema100 and _c < _ema50 and _m[1] >= _p[1]
    _dir = _buy ? 1 : _sell ? -1 : 0
    [_dir, _adx[1], _p[1], _m[1], _c]

f_dae_htf_dir_only() =>
    [_d, _adx, _p, _m, _c] = f_htf_dir()
    _d

f_trix(_src, _len) =>
    _e1 = ta.ema(_src, _len)
    _e2 = ta.ema(_e1, _len)
    _e3 = ta.ema(_e2, _len)
    nz((_e3 - _e3[1]) / math.max(math.abs(_e3[1]), syminfo.mintick) * 10000.0)

f_smi(_len) =>
    _hh = ta.highest(high, _len)
    _ll = ta.lowest(low, _len)
    _mid = (_hh + _ll) / 2.0
    _rng = math.max((_hh - _ll) / 2.0, syminfo.mintick)
    _num = ta.ema(ta.ema(close - _mid, 3), 3)
    _den = math.max(ta.ema(ta.ema(_rng, 3), 3), syminfo.mintick)
    100.0 * _num / _den

f_tr(_h, _l, _c) =>
    math.max(_h - _l, math.max(math.abs(_h - nz(_c[1], _c)), math.abs(_l - nz(_c[1], _c))))

[tf5Dir, tf5Adx, tf5P, tf5M, tf5Close] = request.security(syminfo.tickerid, tfFast, f_htf_dir(), barmerge.gaps_off, barmerge.lookahead_off)
[tf15Dir, tf15Adx, tf15P, tf15M, tf15Close] = request.security(syminfo.tickerid, tfMid, f_htf_dir(), barmerge.gaps_off, barmerge.lookahead_off)
[tf60Dir, tf60Adx, tf60P, tf60M, tf60Close] = request.security(syminfo.tickerid, tfBig, f_htf_dir(), barmerge.gaps_off, barmerge.lookahead_off)
daeM5Dir = request.security(syminfo.tickerid, daeM5TF, f_dae_htf_dir_only(), barmerge.gaps_off, barmerge.lookahead_off)
daeM15Dir = request.security(syminfo.tickerid, daeM15TF, f_dae_htf_dir_only(), barmerge.gaps_off, barmerge.lookahead_off)
[sy389BiasDirHTF, sy389SlopeHTF, sy389ERHTF, sy389Ema20HTF, sy389Ema50HTF, sy389CloseHTF] = request.security(syminfo.tickerid, sy389BiasTF, f_sy389_bias(), barmerge.gaps_off, barmerge.lookahead_off)

[pbObBullTop, pbObBullBottom, pbObBullId, pbObBullActive, pbObBearTop, pbObBearBottom, pbObBearId, pbObBearActive] = request.security(syminfo.tickerid, pbObTF, f_poc_breaker_ob(), barmerge.gaps_off, barmerge.lookahead_off)
[pbBreakTrend, pbBreakHigh, pbBreakLow, pbBreakBullTime, pbBreakBearTime, pbBreakBullLevel, pbBreakBearLevel] = request.security(syminfo.tickerid, pbStructureTF, f_poc_breaker_structure(pbStructurePivotLen), barmerge.gaps_off, barmerge.lookahead_off)
[pbSlowTrend, pbSlowHigh, pbSlowLow, pbSlowBullTime, pbSlowBearTime, pbSlowBullLevel, pbSlowBearLevel] = request.security(syminfo.tickerid, pbSlowTF, f_poc_breaker_structure(pbStructurePivotLen), barmerge.gaps_off, barmerge.lookahead_off)

var int k3Cache5Dir = 0
var int k3Cache15Dir = 0
var int k3Cache60Dir = 0
var int k3CacheBiasDir = 0

if barstate.isfirst or timeframe.change(tfFast)
    k3Cache5Dir := nz(tf5Dir, 0)
if barstate.isfirst or timeframe.change(tfMid)
    k3Cache15Dir := nz(tf15Dir, 0)
if barstate.isfirst or timeframe.change(tfBig)
    k3Cache60Dir := nz(tf60Dir, 0)
if barstate.isfirst or timeframe.change(sy389BiasTF)
    k3CacheBiasDir := nz(sy389BiasDirHTF, 0)

k3CacheHTFScore = (k3Cache5Dir == 1 ? 1.0 : k3Cache5Dir == -1 ? -1.0 : 0.0) + (k3Cache15Dir == 1 ? 1.5 : k3Cache15Dir == -1 ? -1.5 : 0.0) + (k3Cache60Dir == 1 ? 2.0 : k3Cache60Dir == -1 ? -2.0 : 0.0)

htfScore = (tf5Dir == 1 ? 1.0 : tf5Dir == -1 ? -1.0 : 0.0) + (tf15Dir == 1 ? 1.5 : tf15Dir == -1 ? -1.5 : 0.0) + (tf60Dir == 1 ? 2.0 : tf60Dir == -1 ? -2.0 : 0.0)
mapBuy = htfScore > 1.0
mapSell = htfScore < -1.0

atr = ta.atr(atrLen)
atrAvg = ta.sma(atr, atrAvgLen)
atrRatio = atrAvg <= syminfo.mintick ? 1.0 : atr / atrAvg
ema10 = ta.ema(close, emaFastLen)
ema20 = ta.ema(close, 20)
ema34 = ta.ema(close, 34)
ema50 = ta.ema(close, emaMidLen)
ema90 = ta.ema(close, emaSlowLen)
ema100 = ta.ema(close, 100)
vwapVal = ta.vwap(hlc3)
[pDI, mDI, adx] = ta.dmi(14, 14)
stStretch = atr == 0 ? 0.0 : (close - ta.ema(close, 20)) / atr
stRsi3 = ta.rsi(close, 3)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

barRange = math.max(high - low, syminfo.mintick)
body = math.abs(close - open)
bodyPct = body / barRange * 100.0
upperWickPct = (high - math.max(open, close)) / barRange * 100.0
lowerWickPct = (math.min(open, close) - low) / barRange * 100.0
closePosBuy = (close - low) / barRange
closePosSell = (high - close) / barRange
bullReject = close > open and bodyPct >= minBodyPct and lowerWickPct >= minWickPct and closePosBuy >= 0.55
bearReject = close < open and bodyPct >= minBodyPct and upperWickPct >= minWickPct and closePosSell >= 0.55
bullMomentum = close > open and bodyPct >= strongBodyPct and closePosBuy >= 0.55
bearMomentum = close < open and bodyPct >= strongBodyPct and closePosSell >= 0.55
signalCandleOK = barRange <= atr * maxSignalCandleATR
crazyCandle = barRange >= atr * newsSpikeATR or body >= atr * newsSpikeATR * 0.70
atrOK = atrRatio >= minAtrVsAvg and atrRatio <= maxAtrVsAvg
tradeableBase = barstate.isconfirmed and signalCandleOK and not crazyCandle and atrOK

localHigh = ta.highest(high, localSwingLen)
localLow = ta.lowest(low, localSwingLen)
localRange = math.max(localHigh - localLow, syminfo.mintick)
rangePos = (close - localLow) / localRange * 100.0
premium = rangePos >= premiumLevel
discount = rangePos <= discountLevel

localTrendBuy = ema10 > ema50 and ema50 > ema90 and close > ema50 and pDI >= mDI
localTrendSell = ema10 < ema50 and ema50 < ema90 and close < ema50 and mDI >= pDI
powerUp = htfScore >= 2 and ema20 > ema50 and close > ema20
powerDown = htfScore <= -2 and ema20 < ema50 and close < ema20

roomBuy = not useRoomFilter or (localHigh - close) / pointUnit >= targetPoints
roomSell = not useRoomFilter or (close - localLow) / pointUnit >= targetPoints

vtzTR = ta.tr(true)
vtzFastVol = ta.ema(vtzTR, vtzATRLenFast)
vtzSlowVol = ta.sma(vtzTR, vtzATRLenSlow)
vtzVolRatio = vtzSlowVol <= syminfo.mintick ? 1.0 : vtzFastVol / vtzSlowVol

vtzBoxHigh = ta.highest(high, vtzBoxLookback)
vtzBoxLow = ta.lowest(low, vtzBoxLookback)
vtzBoxATR = (vtzBoxHigh - vtzBoxLow) / math.max(vtzSlowVol, syminfo.mintick)
vtzCompressed = useVTZ and vtzMode != "Off" and vtzBoxATR <= vtzMaxBoxATR and vtzVolRatio <= vtzQuietATRRatio

vtzBreakUpNow = vtzCompressed[1] and close > vtzBoxHigh[1] + vtzBreakBufferPts * pointUnit and vtzTR >= vtzSlowVol * vtzImpulseTR and close > open
vtzBreakDownNow = vtzCompressed[1] and close < vtzBoxLow[1] - vtzBreakBufferPts * pointUnit and vtzTR >= vtzSlowVol * vtzImpulseTR and close < open

var int vtzLastBreakBar = na
var int vtzDir = 0
var float vtzBreakHigh = na
var float vtzBreakLow = na
var float vtzBreakPrice = na

if vtzBreakUpNow
    vtzLastBreakBar := bar_index
    vtzDir := 1
    vtzBreakHigh := vtzBoxHigh[1]
    vtzBreakLow := vtzBoxLow[1]
    vtzBreakPrice := close

if vtzBreakDownNow
    vtzLastBreakBar := bar_index
    vtzDir := -1
    vtzBreakHigh := vtzBoxHigh[1]
    vtzBreakLow := vtzBoxLow[1]
    vtzBreakPrice := close

vtzBarsFromBreak = na(vtzLastBreakBar) ? 100000 : bar_index - vtzLastBreakBar
vtzActive = useVTZ and vtzMode != "Off" and not na(vtzLastBreakBar) and vtzBarsFromBreak <= vtzFollowBars
vtzUp = vtzActive and vtzDir == 1
vtzDown = vtzActive and vtzDir == -1

vtzUpperRetest = not na(vtzBreakHigh) and math.abs(close - vtzBreakHigh) / pointUnit <= vtzRetestTolerancePts
vtzLowerRetest = not na(vtzBreakLow) and math.abs(close - vtzBreakLow) / pointUnit <= vtzRetestTolerancePts
vtzRetestBuyZone = vtzUp and vtzUpperRetest
vtzRetestSellZone = vtzDown and vtzLowerRetest

vtzChasePts = na(vtzBreakPrice) ? 0.0 : math.abs(close - vtzBreakPrice) / pointUnit
vtzLateChase = vtzActive and vtzChasePts > vtzLateChasePts

vtzMiddleFadeZone = not vtzBlockMiddleFade ? true : rangePos > discountLevel and rangePos < premiumLevel

sweepHighLevel = ta.highest(high, baseSweepLookback)[1]
sweepLowLevel = ta.lowest(low, baseSweepLookback)[1]
sweepLow = not na(sweepLowLevel) and low < sweepLowLevel and (not baseSweepRequireCloseReclaim or close > sweepLowLevel)
sweepHigh = not na(sweepHighLevel) and high > sweepHighLevel and (not baseSweepRequireCloseReclaim or close < sweepHighLevel)

breakHigh20 = ta.highest(high, baseRetestLookback)[1]
breakLow20 = ta.lowest(low, baseRetestLookback)[1]
retestBuy = not na(breakHigh20) and low <= breakHigh20 + atr * baseRetestToleranceATR and close > breakHigh20 and (not baseRetestRequireDirectionCandle or close > open)
retestSell = not na(breakLow20) and high >= breakLow20 - atr * baseRetestToleranceATR and close < breakLow20 and (not baseRetestRequireDirectionCandle or close < open)

bullFVG = useBaseFVG and low > high[2] and (low - high[2]) >= atr * baseFVGMinATR and (not baseFVGRequireEMA or close > ema20)
bearFVG = useBaseFVG and high < low[2] and (low[2] - high) >= atr * baseFVGMinATR and (not baseFVGRequireEMA or close < ema20)

fibBuy = rangePos >= baseFibBuyMin and rangePos <= baseFibBuyMax and (bullReject or bullMomentum)
fibSell = rangePos >= baseFibSellMin and rangePos <= baseFibSellMax and (bearReject or bearMomentum)

bb20Basis = ta.sma(close, baseBBLength)
bb20Dev = ta.stdev(close, baseBBLength) * baseBBDeviation
bb20U = bb20Basis + bb20Dev
bb20L = bb20Basis - bb20Dev
rangeMarket = adx < baseRangeMaxADX and math.abs(htfScore) < baseRangeMaxHTFScore
bbRangeBuy = rangeMarket and low <= bb20L and bullReject and discount
bbRangeSell = rangeMarket and high >= bb20U and bearReject and premium

valueBuy = low <= ema20 + atr * baseValueToleranceATR or low <= ema34 + atr * baseValueToleranceATR or low <= ema50 + atr * baseValueToleranceATR or (not na(vwapVal) and low <= vwapVal + atr * baseValueToleranceATR)
valueSell = high >= ema20 - atr * baseValueToleranceATR or high >= ema34 - atr * baseValueToleranceATR or high >= ema50 - atr * baseValueToleranceATR or (not na(vwapVal) and high >= vwapVal - atr * baseValueToleranceATR)

cleanMove = math.abs(close - close[baseCleanMoveLookback]) / math.max(ta.sma(math.abs(close - close[1]), baseCleanMoveLookback) * baseCleanMoveLookback, syminfo.mintick) >= baseCleanMoveMinEfficiency
momentumBuy = cleanMove and mapBuy and bullMomentum and not premium
momentumSell = cleanMove and mapSell and bearMomentum and not discount
realRevBuy = sweepLow and (discount or bbRangeBuy) and (bullReject or bullMomentum)
realRevSell = sweepHigh and (premium or bbRangeSell) and (bearReject or bearMomentum)

buyStory = (localTrendBuy and valueBuy and (bullReject or bullMomentum) and (mapBuy or powerUp)) or (sweepLow and (discount or mapBuy) and (bullReject or bullMomentum)) or retestBuy or bullFVG or fibBuy or bbRangeBuy or momentumBuy or realRevBuy
sellStory = (localTrendSell and valueSell and (bearReject or bearMomentum) and (mapSell or powerDown)) or (sweepHigh and (premium or mapSell) and (bearReject or bearMomentum)) or retestSell or bearFVG or fibSell or bbRangeSell or momentumSell or realRevSell
buyPlace = discount or rangePos <= baseBuyPlaceMaxRange or sweepLow or retestBuy or bullFVG or realRevBuy
sellPlace = premium or rangePos >= baseSellPlaceMinRange or sweepHigh or retestSell or bearFVG or realRevSell

baseBuyPowerOK = true
baseSellPowerOK = true
baseBuy = tradeableBase and buyStory and buyPlace and baseBuyPowerOK and roomBuy
baseSell = tradeableBase and sellStory and sellPlace and baseSellPowerOK and roomSell

rsi14 = ta.rsi(close, 14)
// ── بدائل inline للراوتر (نفس منطق الأبطال الجداد) ──
quadBuy = stRsi3 < 18.0 and rsi14 < 40 and (high - low) > 1.5 * atr and close > open
quadSell = stRsi3 > 82.0 and rsi14 > 60 and (high - low) > 1.5 * atr and close < open
rsi14ShiftBuy = rsi14 < 30 and rsi14 > rsi14[1] and stStretch < -1.5
rsi14ShiftSell = rsi14 > 70 and rsi14 < rsi14[1] and stStretch > 1.5
bbkcEma55 = ta.ema(close, 55)
bbkcBuy = close[1] <= math.max(ema20, bbkcEma55)[1] and close > math.max(ema20, bbkcEma55) and close > open
bbkcSell = close[1] >= math.min(ema20, bbkcEma55)[1] and close < math.min(ema20, bbkcEma55) and close < open
rsi28 = ta.rsi(close, 28)
rsi34 = ta.rsi(close, 34)


rsi28Buy = rsi28[1] < 55 and rsi28 >= 55 and close > ema20
rsi28Sell = rsi28[1] > 45 and rsi28 <= 45 and close < ema20
rsi34Buy = rsi34[1] < 55 and rsi34 >= 55 and close > ema20
rsi34Sell = rsi34[1] > 45 and rsi34 <= 45 and close < ema20

rsi14BullRange = ta.lowest(rsi14, rsiRangeBars) > 38
rsi14BearRange = ta.highest(rsi14, rsiRangeBars) < 62

bb50Basis = ta.sma(close, 50)
bb50Dev = ta.stdev(close, 50) * 2.0
bb50U = bb50Basis + bb50Dev
bb50L = bb50Basis - bb50Dev
kc50Basis = ta.ema(close, 50)
kc50U = kc50Basis + atr * 1.5
kc50L = kc50Basis - atr * 1.5
squeeze50 = bb50U < kc50U and bb50L > kc50L
wasSqueeze50 = ta.highest(squeeze50 ? 1.0 : 0.0, squeezeLookback) > 0


trendCorrBuyContext = tf15Dir == 1 and tf60Dir == 1 and pDI >= mDI
trendCorrSellContext = tf15Dir == -1 and tf60Dir == -1 and mDI >= pDI
trendCorrBuy = useTrendCorrection and trendCorrBuyContext and stRsi3 < schTCRsi and (high - low) > schBigK * atr and close > open
trendCorrSell = useTrendCorrection and trendCorrSellContext and stRsi3 > 100 - schTCRsi and (high - low) > schBigK * atr and close < open

tfCtxBuy = tf15Dir == 1 and tf60Dir != -1
tfCtxSell = tf15Dir == -1 and tf60Dir != 1

rsi28Smooth = ta.ema(rsi28, 5)
rsi28Signal = ta.ema(rsi28Smooth, 13)

tr14 = f_roll_sum(f_tr(high, low, close), 14)
viPlus14 = tr14 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(high - low[1]), 14) / tr14
viMinus14 = tr14 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(low - high[1]), 14) / tr14

don70High = ta.highest(high, 70)[1]
don70Low = ta.lowest(low, 70)[1]
don70Mid = (don70High + don70Low) / 2.0



trix34 = f_trix(close, 34)
trix34Sig = ta.ema(trix34, 9)
sy319TrendBuy = false
sy319TrendSell = false

sy326VWAPSlope = (ema20 - ema20[5]) / math.max(atr, syminfo.mintick)
