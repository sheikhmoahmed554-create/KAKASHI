sy315WebSell = sy327RangeSell

extraBuyVotes = (quadBuy ? 1.0 : 0.0) + (rsi14ShiftBuy ? 1.0 : 0.0) + (bbkcBuy ? 1.0 : 0.0)
extraSellVotes = (quadSell ? 1.0 : 0.0) + (rsi14ShiftSell ? 1.0 : 0.0) + (bbkcSell ? 1.0 : 0.0)

researchVoteBuy = minVotes == 2.0 ? (quadBuy or rsi14ShiftBuy or bbkcBuy) : (extraBuyVotes >= minVotes and close > ema20)
researchVoteSell = minVotes == 2.0 ? (quadSell or rsi14ShiftSell or bbkcSell) : (extraSellVotes >= minVotes and close < ema20)

bestNetBuy = ((baseBuy or quadBuy or rsi14ShiftBuy or bbkcBuy) or trendCorrBuy or sy315WebBuy)
bestNetSell = ((baseSell or quadSell or rsi14ShiftSell or bbkcSell) or trendCorrSell or sy315WebSell)
higherWRBuy = (((baseBuy or quadBuy or rsi14ShiftBuy) and rsi28 < 72 and atrRatio >= 0.18 and atrRatio <= 3.6) or trendCorrBuy or sy315WebBuy)
higherWRSell = (((baseSell or quadSell or rsi14ShiftSell) and rsi28 > 28 and atrRatio >= 0.18 and atrRatio <= 3.6) or trendCorrSell or sy315WebSell)
