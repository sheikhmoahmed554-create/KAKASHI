sy320WeakHTFBlockSell = useSY320PhaseGuard and useSY320WeakHTFBlock and sy320WeakOppSell and not counterSellAllowed
sy320SellTrixBlock = useSY320PhaseGuard and useSY320SellTrixBlock and trix34Diff >= sy320Trix34BlockLevel and not counterSellAllowed
sy320BuyOK = not sy320WeakHTFBlockBuy
sy320SellOK = not sy320WeakHTFBlockSell and not sy320SellTrixBlock

sy322ShockBlock = useSY322RegimeGuard and useSY322ShockATRBlock and atrRatio >= sy322MaxAtrRatio
