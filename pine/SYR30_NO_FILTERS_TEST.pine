hiddenLiqSellNotLate = hiddenLiqSellAfterPts <= hiddenLiqMaxLatePoints

sy130BuyVotes = (sy130UseRP and sy130LocalRPDir == 1 ? 1 : 0) + (sy130UseATRTrend and sy130LocalATRDir == 1 ? 1 : 0) + (sy130UseRP and sy130HTFRPDir == 1 ? 1 : 0) + (sy130UseATRTrend and sy130HTFATRDir == 1 ? 1 : 0)
sy130SellVotes = (sy130UseRP and sy130LocalRPDir == -1 ? 1 : 0) + (sy130UseATRTrend and sy130LocalATRDir == -1 ? 1 : 0) + (sy130UseRP and sy130HTFRPDir == -1 ? 1 : 0) + (sy130UseATRTrend and sy130HTFATRDir == -1 ? 1 : 0)
sy130TrendUp = useSY130TrendProtect and sy130BuyVotes >= sy130MinVotes and sy130BuyVotes > sy130SellVotes
sy130TrendDown = useSY130TrendProtect and sy130SellVotes >= sy130MinVotes and sy130SellVotes > sy130BuyVotes

sy130ProtectOff = not useSY130TrendProtect or sy130ProtectMode == "Off" or sy130ProtectMode == "Assist Only"
sy130BuyAllowed = sy130ProtectOff or (sy130ProtectMode == "Block Countertrend" ? (not sy130TrendDown or sy338TrueCounterBuy) : (sy130TrendUp or sy338TrueCounterBuy))
sy130SellAllowed = sy130ProtectOff or (sy130ProtectMode == "Block Countertrend" ? (not sy130TrendUp or sy338TrueCounterSell) : (sy130TrendDown or sy338TrueCounterSell))
