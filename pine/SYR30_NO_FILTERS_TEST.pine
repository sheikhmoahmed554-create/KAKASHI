sy325DriverSell = close < ema20 and sy325EmaSlope <= -sy325DriverSlopeATR and (not sy325UseEMA50 or ema20 <= ema50)
sy325BuyAgainstDriver = useSY325FastDriver and sy325DriverSell
sy325SellAgainstDriver = useSY325FastDriver and sy325DriverBuy
