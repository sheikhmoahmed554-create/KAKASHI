sy324ImpulseATR = sy324ImpulseRange / math.max(atr, syminfo.mintick)
sy324CompressionRatio = sy324CompressionRange / sy324ImpulseRange
sy324ImpulsePos = (close - sy324ImpulseLow) / sy324ImpulseRange * 100.0
sy324PostImpulseQuiet = useSY324QuietFix and sy324ImpulseATR >= sy324MinImpulseATR and sy324CompressionRatio <= sy324MaxCompression and sy324ImpulsePos >= sy324MiddleMin and sy324ImpulsePos <= sy324MiddleMax
sy324QuietOK = not sy324PostImpulseQuiet

