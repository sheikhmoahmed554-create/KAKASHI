hiddenFibSellRecent = hiddenFibActive and not na(hiddenFibBarsSinceSell) and hiddenFibBarsSinceSell <= hiddenFibValidBars
hiddenFibBuyAfterPts = (close - ta.lowest(low, hiddenFibValidBars)) / pointUnit
hiddenFibSellAfterPts = (ta.highest(high, hiddenFibValidBars) - close) / pointUnit
hiddenFibBuyNotLate = hiddenFibBuyAfterPts <= hiddenFibMaxLatePoints
hiddenFibSellNotLate = hiddenFibSellAfterPts <= hiddenFibMaxLatePoints

[hiddenLiqFastBuyRaw, hiddenLiqFastSellRaw, hiddenLiqFastPrevLow, hiddenLiqFastPrevHigh] = request.security(syminfo.tickerid, hiddenLiqFastTF, f_hidden_liq_sweep_assist(), barmerge.gaps_off, barmerge.lookahead_off)
[hiddenLiqSlowBuyRaw, hiddenLiqSlowSellRaw, hiddenLiqSlowPrevLow, hiddenLiqSlowPrevHigh] = request.security(syminfo.tickerid, hiddenLiqSlowTF, f_hidden_liq_sweep_assist(), barmerge.gaps_off, barmerge.lookahead_off)

hiddenLiqBuyTouch = hiddenLiqUseAssist and (hiddenLiqFastBuyRaw or hiddenLiqSlowBuyRaw)
hiddenLiqSellTouch = hiddenLiqUseAssist and (hiddenLiqFastSellRaw or hiddenLiqSlowSellRaw)
