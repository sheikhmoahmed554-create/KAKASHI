hiddenLiqSellRecent = hiddenLiqUseAssist and not na(hiddenLiqBarsSinceSell) and hiddenLiqBarsSinceSell <= hiddenLiqValidBars

hiddenLiqBuyAfterPts = (close - ta.lowest(low, hiddenLiqValidBars)) / pointUnit
hiddenLiqSellAfterPts = (ta.highest(high, hiddenLiqValidBars) - close) / pointUnit
