moreTradesSell = ((baseSell or researchVoteSell) or trendCorrSell or sy315WebSell)

rawBuy0 = useResearchGate ? (mode == "Higher WR" ? higherWRBuy : mode == "More Trades" ? moreTradesBuy : bestNetBuy) : baseBuy
rawSell0 = useResearchGate ? (mode == "Higher WR" ? higherWRSell : mode == "More Trades" ? moreTradesSell : bestNetSell) : baseSell

counterBuyZoneOK = true
counterSellZoneOK = true
counterBuyCandleOK = true
counterSellCandleOK = true
