    active := false
    side := 0
    entryPrice := na
    tpPrice := na
    slPrice := na
    tradeTargetPts := na
    tradeStopPts := na
    tradeKind := 0
    entryBar := na
    lastTradeBar := na
    lastLongStopBar := na
    lastShortStopBar := na
    lastBuyRangeStopBar := na
    lastBuySweepStopBar := na
    lastBuyTrendStopBar := na
    lastSellRangeStopBar := na
    lastSellSweepStopBar := na
    lastSellTrendStopBar := na
    wins := 0
    losses := 0
