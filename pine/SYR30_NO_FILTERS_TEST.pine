sy130BlockSell = useSY130TrendProtect and not sy130SellAllowed

sy360FibCounterBuyOK = hiddenFibMode != "Off" and hiddenFibCanBypassTrendBlock and hiddenFibBuyOK
sy360FibCounterSellOK = hiddenFibMode != "Off" and hiddenFibCanBypassTrendBlock and hiddenFibSellOK

sy338BlockBuyAgainstDownTrend = sy338StrongDown and not (sy338TrueCounterBuy or sy360FibCounterBuyOK)
sy338BlockSellAgainstUpTrend = sy338StrongUp and not (sy338TrueCounterSell or sy360FibCounterSellOK)

sy360FibM1ReactionBuy = not hiddenFibNeedM1Reaction or bullReject or bullMomentum or sweepLow or realRevBuy
sy360FibM1ReactionSell = not hiddenFibNeedM1Reaction or bearReject or bearMomentum or sweepHigh or realRevSell
sy360FibRoomBuy = not hiddenFibNeedRoom or roomBuy
sy360FibRoomSell = not hiddenFibNeedRoom or roomSell

sy360BuyNearSY356Story = hiddenFibEntryAlone ? true : (buyStory or sy334BuySweepRaw or realRevBuy or retestBuy or bullFVG)
sy360SellNearSY356Story = hiddenFibEntryAlone ? true : (sellStory or sy334SellSweepRaw or sy334SellRangeRaw or sy334SellTrendRaw or sy336SellBest or baseSell or realRevSell or retestSell or bearFVG)

