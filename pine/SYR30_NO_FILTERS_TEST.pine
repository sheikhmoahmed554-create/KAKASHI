sy967RawBuyBeforeVTZ = useSY337QuickRouter ? (sy337RawBuy or sy360FibBoostBuy or sy361LiqBoostBuy) : (oldRawBuy or sy360FibBoostBuy or sy361LiqBoostBuy)
sy967RawSellBeforeVTZ = useSY337QuickRouter ? (sy337RawSell or sy360FibBoostSell or sy361LiqBoostSell) : (oldRawSell or sy360FibBoostSell or sy361LiqBoostSell)

sy967VTZActive = useVTZ and vtzMode != "Off" and vtzMode != "Assist Only"

vtzEdgeBuyException = vtzAllowEdgeReversal and (realRevBuy or sweepLow or sy338TrueCounterBuy or sy360FibBoostBuy or sy361LiqBoostBuy) and (discount or vtzLowerRetest)
vtzEdgeSellException = vtzAllowEdgeReversal and (realRevSell or sweepHigh or sy338TrueCounterSell or sy360FibBoostSell or sy361LiqBoostSell) and (premium or vtzUpperRetest)

