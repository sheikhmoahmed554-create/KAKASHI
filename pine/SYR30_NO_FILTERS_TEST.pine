    m1SrcNet := 0.0
    pocSrcNet := 0.0
    tvSrcNet := 0.0
    fusionSrcNet := 0.0
    longLossN := 0
    shortLossN := 0
    longNetPts := 0.0
    shortNetPts := 0.0
    sumWinPts := 0.0
    sumLossPts := 0.0
    lastClosedPts := 0.0
    tradeRiskState := ""
    tradeTargetSource := ""
    tradeEntrySource := ""
    tradeEntrySourceCode := 0
    tradeExitMode := 1
    tradeDirectionScore := 0.0
    m1LiveOwnTrades := 0
    m1LiveSameTrades := 0
    m1LiveTakeTrades := 0
    m1LiveM1Wins := 0
    m1LiveM1Losses := 0
    trendVoteLiveTrades := 0
    trendVoteLiveWins := 0
    trendVoteLiveLosses := 0
    finalFusionLiveTrades := 0
    finalFusionLiveWins := 0
    finalFusionLiveLosses := 0
    realClosePendingTradeId := na
    realCloseLastSendBar := na
    realCloseAttempts := 0
    realCloseRequestCount := 0
    realCloseEntryTime := na
    realCloseTradeUid := ""
    lastExitPlan := ""
    sy999TradeMFE := 0.0
    sy999TradeMAE := 0.0
    sy999TradeRegime := 1
    sy999TradeId := 0
    sy999EarlyExitCount := 0
    sy999CloseAlertTradeId := na
    sy999IntrabarExitTradeId := na
    sy999IntrabarExitPrice := na
    realClosePendingTradeId := na
    realCloseLastSendBar := na
    realCloseAttempts := 0
    realCloseEntryTime := time
    realCloseTradeUid := sy963BotSymbol + "-" + str.tostring(time) + "-" + (side == 1 ? "BUY" : "SELL") + "-" + str.tostring(sy999TradeId)
    if not na(sy348EntryLine)
        line.delete(sy348EntryLine)
    if not na(sy348TPLine)
        line.delete(sy348TPLine)
    if not na(sy348SLLine)
        line.delete(sy348SLLine)
    sy348EntryLine := na
    sy348TPLine := na
    sy348SLLine := na
    lastResetKey := manualResetKey

longTypeNow = sy334BuySweep ? 2 : sy334BuyRange ? 1 : 3
shortTypeNow = sy334SellSweep ? -2 : sy334SellRange ? -1 : -3

// ── R6: SMC Order Block Filter (فلتر الأوردر بلوك — منطق LuxAlgo SMC، سعري فقط) ──
r6Ph = ta.pivothigh(high, r6ObSize, r6ObSize)
r6Pl = ta.pivotlow(low, r6ObSize, r6ObSize)
var float r6SwingH = na
var float r6SwingL = na
var bool  r6XH = true
var bool  r6XL = true
var int   r6PhBar = na
var int   r6PlBar = na
if not na(r6Ph)
    r6SwingH := r6Ph
    r6XH := false
    r6PhBar := bar_index - r6ObSize
if not na(r6Pl)
    r6SwingL := r6Pl
    r6XL := false
    r6PlBar := bar_index - r6ObSize
var array<float> r6BearTop = array.new_float()
var array<float> r6BearBot = array.new_float()
var array<float> r6BullTop = array.new_float()
var array<float> r6BullBot = array.new_float()
r6BreakUp = not na(r6SwingH) and not r6XH and close[1] <= r6SwingH and close > r6SwingH
r6BreakDn = not na(r6SwingL) and not r6XL and close[1] >= r6SwingL and close < r6SwingL
if r6BreakUp
    r6XH := true
    int aB = nz(r6PlBar, bar_index)
    int backB = math.min(bar_index - aB, 400)
    float mnB = low
    int offB = 0
    for k = 1 to backB
        if low[k] < mnB
            mnB := low[k]
            offB := k
    array.push(r6BullTop, high[offB])
    array.push(r6BullBot, mnB)
    if array.size(r6BullTop) > r6ObMax
        array.shift(r6BullTop)
        array.shift(r6BullBot)
if r6BreakDn
    r6XL := true
    int aS = nz(r6PhBar, bar_index)
    int backS = math.min(bar_index - aS, 400)
    float mxS = high
    int offS = 0
    for k = 1 to backS
        if high[k] > mxS
            mxS := high[k]
            offS := k
    array.push(r6BearTop, mxS)
    array.push(r6BearBot, low[offS])
    if array.size(r6BearTop) > r6ObMax
        array.shift(r6BearTop)
        array.shift(r6BearBot)
// موت الـOB: الاغلاق يعبر الطرف البعيد
if array.size(r6BullTop) > 0
    int kB = array.size(r6BullTop) - 1
    while kB >= 0
        if close < array.get(r6BullBot, kB)
            array.remove(r6BullTop, kB)
            array.remove(r6BullBot, kB)
        kB -= 1
if array.size(r6BearTop) > 0
    int kS = array.size(r6BearTop) - 1
    while kS >= 0
        if close > array.get(r6BearTop, kS)
            array.remove(r6BearTop, kS)
            array.remove(r6BearBot, kS)
        kS -= 1
r6InBearOB = false
r6InBullOB = false
if array.size(r6BearTop) > 0
    for k = 0 to array.size(r6BearTop) - 1
        if close >= array.get(r6BearBot, k) and close <= array.get(r6BearTop, k)
            r6InBearOB := true
if array.size(r6BullTop) > 0
    for k = 0 to array.size(r6BullTop) - 1
        if close >= array.get(r6BullBot, k) and close <= array.get(r6BullTop, k)
            r6InBullOB := true

// ── R4: Trend Alignment Filter (فلتر محاذاة الترند) ──
taLr0 = ta.linreg(close, 20, 0)
taLr1 = ta.linreg(close, 20, 1)
taOppBuy = (k3CacheHTFScore <= -2 ? 1 : 0) + (tf15Dir == -1 ? 1 : 0) + (tf60Dir == -1 ? 1 : 0) + (ema20 < ema50 ? 1 : 0) + (close < ema50 ? 1 : 0) + (taLr0 <= taLr1 ? 1 : 0)
taOppSell = (k3CacheHTFScore >= 2 ? 1 : 0) + (tf15Dir == 1 ? 1 : 0) + (tf60Dir == 1 ? 1 : 0) + (ema20 > ema50 ? 1 : 0) + (close > ema50 ? 1 : 0) + (taLr0 > taLr1 ? 1 : 0)
taOppNow = syFinalSelectedSide == 1 ? taOppBuy : taOppSell
taIsSweep = syFinalSelectedSide == 1 ? longTypeNow == 2 : shortTypeNow == -2
taPass = trendAlignFilter == "Off" ? true : trendAlignFilter == "Light (max 4 oppose)" ? taOppNow <= 4 : trendAlignFilter == "Medium (max 3 oppose) — R10" ? taOppNow <= 3 : trendAlignFilter == "Balanced (max 2 + Sweep)" ? taOppNow <= 2 or taIsSweep : taOppNow <= 2
buySignal := buySignal and taPass
sellSignal := sellSignal and taPass
// R6: منع البيع داخل أوردر بلوك هابط (والشراء داخل صاعد اختياري)
sellSignal := sellSignal and (not r6UseObSellFilter or not r6InBearOB)
buySignal := buySignal and (not r6UseObBuyFilter or not r6InBullOB)

// ── R8: Extra Signal Sources (مصادر إضافية — اختياري، مطفي افتراضياً) ──
// UT Bot Alerts (ATR trailing flip)
r8xATR = ta.atr(3)
r8nLoss = 1.0 * r8xATR
var float r8xts = na
r8xtsPrev = nz(r8xts[1], close)
r8xts := close > r8xtsPrev and close[1] > r8xtsPrev ? math.max(r8xtsPrev, close - r8nLoss) : close < r8xtsPrev and close[1] < r8xtsPrev ? math.min(r8xtsPrev, close + r8nLoss) : close > r8xtsPrev ? close - r8nLoss : close + r8nLoss
r8UtDir = close > r8xts ? 1 : -1
r8UtBuy = r8UtDir == 1 and r8UtDir[1] == -1
r8UtSell = r8UtDir == -1 and r8UtDir[1] == 1
// WaveTrend (LazyBear) — cross من مناطق التشبع
r8ap = hlc3
r8esa = ta.ema(r8ap, 10)
r8dd = ta.ema(math.abs(r8ap - r8esa), 10)
r8ci = (r8ap - r8esa) / (0.015 * r8dd)
r8tci = ta.ema(r8ci, 21)
r8wt2 = ta.sma(r8tci, 4)
r8WtBuy = ta.crossover(r8tci, r8wt2) and r8wt2 < -53
r8WtSell = ta.crossunder(r8tci, r8wt2) and r8wt2 > 53
// Bollinger Bounce — رجوع داخل الباند
r8basis = ta.sma(close, 20)
r8dev = 2.0 * ta.stdev(close, 20)
r8upBB = r8basis + r8dev
r8loBB = r8basis - r8dev
r8BbBuy = close > r8loBB and close[1] <= r8loBB[1]
r8BbSell = close < r8upBB and close[1] >= r8upBB[1]
// Gates: ATR عالي + السوق مو مزدحم بالإشارات
r8SigRate = math.sum((buySignal or sellSignal) ? 1.0 : 0.0, r8DensityWin) / r8DensityWin * 1440
r8ExtraOK = r8UseExtraSources and (atr / pointUnit) >= r8ExtraAtrMin and r8SigRate < r8MaxSigDensity
r8XBuy = r8ExtraOK and (r8UtBuy or r8WtBuy or r8BbBuy)
r8XSell = r8ExtraOK and (r8UtSell or r8WtSell or r8BbSell)
buySignal := buySignal or r8XBuy
sellSignal := sellSignal or r8XSell
// ━━━ R9 اختياري: مصدر QQE-RSI28 ━━━
r9rsi28 = ta.rsi(close, 28)
r9r28sm = ta.ema(r9rsi28, 5)
r9r28sg = ta.ema(r9r28sm, 13)
r9ema20 = ta.ema(close, 20)
// ━━━ R11: محرك كونورز RSI(2) — شراء تحت 10 / بيع فوق 90 / كولداون 20 (بدون فلتر ترند) ━━━
r11Rsi2 = nz(ta.rsi(close, 3), 50.0)
r11WarmOK = bar_index > 260
var int r11LastConnB = -100000
var int r11LastConnS = -100000
r11ConnB = r11UseConnors and r11WarmOK and r11Rsi2 < r11ConnorsThB and bar_index - r11LastConnB > r11ConnorsCD
r11ConnS = r11UseConnors and r11WarmOK and r11Rsi2 > r11ConnorsThS and bar_index - r11LastConnS > r11ConnorsCD
if r11ConnB
    r11LastConnB := bar_index
if r11ConnS
    r11LastConnS := bar_index
buySignal := buySignal or r11ConnB
sellSignal := sellSignal or r11ConnS

// ━━━ R17 FINAL QUALITY ARBITER ━━━
// K3 becomes a candidate generator. This last gate receives every source,
// including R8/R9/R11 sources that previously bypassed the router.
qaRawBuy = buySignal
qaRawSell = sellSignal
qaBuyReversal = qaAllowStrongReversal and (realRevBuy or sy338TrueCounterBuy or syr30DeadAuctionBuy or (sweepLow and (bullReject or bullMomentum)))
qaSellReversal = qaAllowStrongReversal and (realRevSell or sy338TrueCounterSell or syr30DeadAuctionSell or (sweepHigh and (bearReject or bearMomentum)))
qaBuyRoomOK = not qaRequireRoom or roomBuy or qaBuyReversal
qaSellRoomOK = not qaRequireRoom or roomSell or qaSellReversal
qaBuyLate = sy337UpMovePts > qaMaxLatePts and not qaBuyReversal
qaSellLate = sy337DownMovePts > qaMaxLatePts and not qaSellReversal

qaBuySourceScore = (syFinalSelectedSide == 1 ? 1.20 : 0.0) + (k3FusionSide == 1 ? 0.55 + math.min(finalFusionBuyVotes, 4) * 0.18 : 0.0) + (k3TVSide == 1 ? 0.65 : 0.0) + (pbPairBuy ? 0.85 : 0.0) + (syr30BalanceBuy ? 1.10 : 0.0) + (syr30AsiaBuy ? 0.95 : 0.0) + (syr30DeadAuctionBuy ? 1.05 : 0.0) + (r11ConnB ? 0.20 : 0.0) + (r8XBuy ? 0.20 : 0.0)
qaSellSourceScore = (syFinalSelectedSide == -1 ? 1.20 : 0.0) + (k3FusionSide == -1 ? 0.55 + math.min(finalFusionSellVotes, 4) * 0.18 : 0.0) + (k3TVSide == -1 ? 0.65 : 0.0) + (pbPairSell ? 0.85 : 0.0) + (syr30BalanceSell ? 1.10 : 0.0) + (syr30AsiaSell ? 0.95 : 0.0) + (syr30DeadAuctionSell ? 1.05 : 0.0) + (r11ConnS ? 0.20 : 0.0) + (r8XSell ? 0.20 : 0.0)

qaBuyTrendScore = (htfScore >= 2.0 ? 1.10 : htfScore > 0 ? 0.45 : htfScore <= -2.0 ? -1.15 : -0.35) + (tf5Dir == 1 ? 0.40 : tf5Dir == -1 ? -0.40 : 0.0) + (tf15Dir == 1 ? 0.55 : tf15Dir == -1 ? -0.55 : 0.0) + (sy389BiasUp ? 0.55 : sy389BiasDown ? -0.55 : 0.0) + (pDI > mDI ? 0.35 : -0.20) + (sy325EmaSlope >= 0.10 ? 0.35 : sy325EmaSlope < -0.10 ? -0.35 : 0.0)
qaSellTrendScore = (htfScore <= -2.0 ? 1.10 : htfScore < 0 ? 0.45 : htfScore >= 2.0 ? -1.15 : -0.35) + (tf5Dir == -1 ? 0.40 : tf5Dir == 1 ? -0.40 : 0.0) + (tf15Dir == -1 ? 0.55 : tf15Dir == 1 ? -0.55 : 0.0) + (sy389BiasDown ? 0.55 : sy389BiasUp ? -0.55 : 0.0) + (mDI > pDI ? 0.35 : -0.20) + (sy325EmaSlope <= -0.10 ? 0.35 : sy325EmaSlope > 0.10 ? -0.35 : 0.0)

qaBuyLocationScore = (rangePos <= 25 ? 0.70 : rangePos <= 45 ? 0.35 : rangePos >= 82 ? -0.75 : 0.0) + (bullReject ? 0.45 : bullMomentum ? 0.30 : 0.0) + (sweepLow ? 0.55 : 0.0) + (close > ema20 ? 0.20 : -0.20)
qaSellLocationScore = (rangePos >= 75 ? 0.70 : rangePos >= 55 ? 0.35 : rangePos <= 18 ? -0.75 : 0.0) + (bearReject ? 0.45 : bearMomentum ? 0.30 : 0.0) + (sweepHigh ? 0.55 : 0.0) + (close < ema20 ? 0.20 : -0.20)

qaBuyScore = qaRawBuy ? 1.0 + qaBuySourceScore + qaBuyTrendScore + qaBuyLocationScore + (qaBuyReversal ? 0.80 : 0.0) - (qaBuyLate ? 1.20 : 0.0) - (not qaBuyRoomOK ? 2.00 : 0.0) : -100.0
qaSellScore = qaRawSell ? 1.0 + qaSellSourceScore + qaSellTrendScore + qaSellLocationScore + (qaSellReversal ? 0.80 : 0.0) - (qaSellLate ? 1.20 : 0.0) - (not qaSellRoomOK ? 2.00 : 0.0) : -100.0
qaBuyPass = qaRawBuy and qaBuyRoomOK and not qaBuyLate and qaBuyScore >= qaMinScore
qaSellPass = qaRawSell and qaSellRoomOK and not qaSellLate and qaSellScore >= qaMinScore
qaBuyWinsCollision = qaBuyPass and (not qaSellPass or qaBuyScore >= qaSellScore + qaMinEdge)
qaSellWinsCollision = qaSellPass and (not qaBuyPass or qaSellScore >= qaBuyScore + qaMinEdge)

if useFinalQualityArbiter
    buySignal := qaBuyWinsCollision
    sellSignal := qaSellWinsCollision

// Final side filter after all schools and the final arbiter.
buySignal := buySignal and allowLong
sellSignal := sellSignal and allowShort
longLastStopForType = longTypeNow == 1 ? lastBuyRangeStopBar : longTypeNow == 2 ? lastBuySweepStopBar : lastBuyTrendStopBar
shortLastStopForType = shortTypeNow == -1 ? lastSellRangeStopBar : shortTypeNow == -2 ? lastSellSweepStopBar : lastSellTrendStopBar
longLossCooldownForType = buyLossCooldownBars
shortLossCooldownForType = sellLossCooldownBars

baseCanCooldown = na(lastTradeBar) or bar_index - lastTradeBar >= (useSY337QuickRouter ? sy339EffCooldown : cooldownBars)
baseCanLongAfterLoss = useSY337QuickRouter ? (na(lastLongStopBar) or bar_index - lastLongStopBar >= sy339EffLossCooldown) : (useSY333TypeRisk ? (na(longLastStopForType) or bar_index - longLastStopForType >= longLossCooldownForType) : (na(lastLongStopBar) or bar_index - lastLongStopBar >= (useSeparateSideRisk ? buyLossCooldownBars : lossCooldownBars)))
baseCanShortAfterLoss = useSY337QuickRouter ? (na(lastShortStopBar) or bar_index - lastShortStopBar >= sy339EffLossCooldown) : (useSY333TypeRisk ? (na(shortLastStopForType) or bar_index - shortLastStopForType >= shortLossCooldownForType) : (na(lastShortStopBar) or bar_index - lastShortStopBar >= (useSeparateSideRisk ? sellLossCooldownBars : lossCooldownBars)))

lastAnyStopBar = na(lastLongStopBar) ? lastShortStopBar : na(lastShortStopBar) ? lastLongStopBar : math.max(lastLongStopBar, lastShortStopBar)

globalEntryOK = cooldownBars == 15 or na(lastTradeBar) or bar_index - lastTradeBar >= math.max(0, cooldownBars)
globalLossOK = lossCooldownBars == 35 or na(lastAnyStopBar) or bar_index - lastAnyStopBar >= math.max(0, lossCooldownBars)

applySideCooldown = useSeparateSideRisk or buyLossCooldownBars != 15 or sellLossCooldownBars != 30
buySideCooldownOK = not applySideCooldown or na(lastLongStopBar) or bar_index - lastLongStopBar >= math.max(0, buyLossCooldownBars)
sellSideCooldownOK = not applySideCooldown or na(lastShortStopBar) or bar_index - lastShortStopBar >= math.max(0, sellLossCooldownBars)

applyTypeCooldown = useSY333TypeRisk
longTypeCooldownOK = not applyTypeCooldown or na(longLastStopForType) or bar_index - longLastStopForType >= math.max(0, longLossCooldownForType)
shortTypeCooldownOK = not applyTypeCooldown or na(shortLastStopForType) or bar_index - shortLastStopForType >= math.max(0, shortLossCooldownForType)

canCooldown = baseCanCooldown and globalEntryOK
canLongAfterLoss = baseCanLongAfterLoss and globalLossOK and buySideCooldownOK and longTypeCooldownOK
canShortAfterLoss = baseCanShortAfterLoss and globalLossOK and sellSideCooldownOK and shortTypeCooldownOK

// R11 FIX: فصل نافذة الإحصائيات عن بوابة الدخول — الجدول للعرض بس، ما لازم يمنع صفقات
// ━━━ فلاتر ذكية مثبتة على 23,932 صفقة × 7 سنوات: حظر ساعات الخسارة + حظر التذبذب العنيف ━━━
G_SMART = "18 ■ Smart Filters (validated 7y lab)"
sfUseTimeFilter = input.bool(false, "Time Filter: block dead hours", group=G_SMART)
sfTzOffset = input.int(2, "Broker server hour offset vs chart (adjust if shifted)", minval=-12, maxval=12, group=G_SMART)
sfBlockH1 = input.int(3, "Block hour #1 (-1=off)", minval=-1, maxval=23, group=G_SMART)
sfBlockH2 = input.int(5, "Block hour #2 (-1=off)", minval=-1, maxval=23, group=G_SMART)
sfBlockH3 = input.int(8, "Block hour #3 (-1=off)", minval=-1, maxval=23, group=G_SMART)
sfBlockH4 = input.int(10, "Block hour #4 (-1=off)", minval=-1, maxval=23, group=G_SMART)
sfUseAtrFilter = input.bool(false, "ATR Filter: block extreme volatility", group=G_SMART)
sfAtrMaxRatio = input.float(2.8, "Max ATR ratio (ATR14 / ATR avg 240)", minval=1.0, maxval=5.0, step=0.1, group=G_SMART)
sfServerHour = (hour(time, "Etc/UTC") + sfTzOffset + 24) % 24
sfBlockedHour = sfUseTimeFilter and (sfServerHour == sfBlockH1 or sfServerHour == sfBlockH2 or sfServerHour == sfBlockH3 or sfServerHour == sfBlockH4)
sfAtr14 = ta.atr(14)
sfAtrAvg = ta.sma(sfAtr14, 240)
sfAtrRatio = sfAtrAvg > 0 ? sfAtr14 / sfAtrAvg : 1.0
sfBlockedAtr = sfUseAtrFilter and sfAtrRatio > sfAtrMaxRatio
sfBlock = sfBlockedHour or sfBlockedAtr
buySignal := buySignal and not sfBlock
sellSignal := sellSignal and not sfBlock

// ━━━ أبطال المختبر 2026 — TRIPLE + SNIPER + ULSWEEP + متحقق الترند ━━━
G_CH = "23 ■ Lab Champions (TRIPLE/SNIPER/ULS/Verifier)"
chTriUse = input.bool(true, "TRIPLE — ON", group=G_CH)
chTriDepth = input.float(5.0, "TRIPLE depth — CHAMPION=2.0", minval=0.5, maxval=6.0, step=0.1, group=G_CH)
chTriTh = input.float(18.0, "TRIPLE RSI3 threshold", minval=5.0, maxval=30.0, step=1.0, group=G_CH)
chSniUse = input.bool(false, "SNIPER — ON", group=G_CH)
chSniDepth = input.float(7.0, "SNIPER depth", minval=2.0, maxval=8.0, step=0.1, group=G_CH)
chUlsUse = input.bool(true, "ULSWEEP v2 — ON", group=G_CH)
chUlsStr = input.float(1.5, "ULS stretch filter", minval=0.5, maxval=4.0, step=0.1, group=G_CH)
chUlsRsi = input.float(30.0, "ULS RSI3 extreme", minval=10, maxval=40, step=1, group=G_CH)
chUlsLen = input.int(85, "ULS level length", minval=20, maxval=400, group=G_CH)
chVerUse = input.bool(false, "Trend Verifier (M15 Donchian 25 + vol) — ON", group=G_CH)
chAtrV = ta.atr(14)
chEma = ta.ema(close, 20)
chStretch = chAtrV == 0 ? 0.0 : (close - chEma) / chAtrV
chRsi3 = ta.rsi(close, 3)
chVSma = ta.sma(nz(volume, 0.0), 20)
chClim = nz(volume, 0.0) > 2.0 * chVSma
chBig = (high - low) > 1.5 * chAtrV
chDHi = request.security(syminfo.tickerid, "15", ta.highest(high, 25)[1], barmerge.gaps_off, barmerge.lookahead_off)
chDLo = request.security(syminfo.tickerid, "15", ta.lowest(low, 25)[1], barmerge.gaps_off, barmerge.lookahead_off)
chEma15 = request.security(syminfo.tickerid, "15", ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_off)
var bool chTrUp = false
var bool chTrDn = false
if chVerUse and close > chDHi and nz(volume, 0.0) > 2.0 * chVSma
    chTrUp := true
    chTrDn := false
if chVerUse and close < chDLo and nz(volume, 0.0) > 2.0 * chVSma
    chTrDn := true
    chTrUp := false
if chTrUp and close < chEma15
    chTrUp := false
if chTrDn and close > chEma15
    chTrDn := false
chTriB = chTriUse and chStretch < -chTriDepth and chRsi3 < chTriTh and chBig and not chTrDn
chTriS = chTriUse and chStretch > chTriDepth and chRsi3 > 100 - chTriTh and chBig and not chTrUp
chSniB = chSniUse and chStretch < -chSniDepth and nz(volume, 0.0) > 1.5 * chVSma and chRsi3 < 18.0 and chBig and not chTrDn
chSniS = chSniUse and chStretch > chSniDepth and nz(volume, 0.0) > 1.5 * chVSma and chRsi3 > 82.0 and chBig and not chTrUp
chSprUse = input.bool(true, "SPRING Wyckoff — ON", group=G_R11)
chSprWickK = input.float(2.3, "SPRING wick x body", minval=0.5, maxval=5.0, step=0.1, group=G_R11)
chSprLo = ta.lowest(low, 20)
chSprHi = ta.highest(high, 20)
chLw = math.min(open, close) - low
chUw = high - math.max(open, close)
chSprB = chSprUse and low < chSprLo[1] and close > chSprLo[1] and chLw > chSprWickK * math.abs(close - open) and not chTrDn
chSprS = chSprUse and high > chSprHi[1] and close < chSprHi[1] and chUw > chSprWickK * math.abs(close - open) and not chTrUp
buySignal := buySignal or chSprB
sellSignal := sellSignal or chSprS
chUoUse = input.bool(true, "ULTIMATE OSC — ON", group=G_MOM_NEW)
chUoAdx = input.float(25.0, "UO: max ADX", minval=10, maxval=40, step=1, group=G_MOM_NEW)
chUoTh = input.float(30.0, "UO: extreme level", minval=10, maxval=40, step=1, group=G_MOM_NEW)
chBp = close - math.min(low, close[1])
chTr2 = math.max(high, close[1]) - math.min(low, close[1])
chA7 = ta.sma(chBp, 7) * 7 / (ta.sma(chTr2, 7) * 7 + 0.00001)
chA14 = ta.sma(chBp, 14) * 14 / (ta.sma(chTr2, 14) * 14 + 0.00001)
chA28 = ta.sma(chBp, 28) * 28 / (ta.sma(chTr2, 28) * 28 + 0.00001)
chUo = 100 * (4 * chA7 + 7 * chA14 + chA28) / 18
chUoB = chUoUse and adx < chUoAdx and chUo < chUoTh and close > open
chUoS = chUoUse and adx < chUoAdx and chUo > 100 - chUoTh and close < open
buySignal := buySignal or chUoB
sellSignal := sellSignal or chUoS
chRibUse = input.bool(true, "EMA RIBBON pullback (بديل VWAP Pull) — ON", group=G_PULLBACK_NEW)
chE100 = ta.ema(close, 100)
chRibB = chRibUse and chEma > ta.ema(close, 50) and ta.ema(close, 50) > chE100 and low <= ta.ema(close, 50) and close > ta.ema(close, 50) and close > open
chRibS = chRibUse and chEma < ta.ema(close, 50) and ta.ema(close, 50) < chE100 and high >= ta.ema(close, 50) and close < ta.ema(close, 50) and close < open
buySignal := buySignal or chRibB
sellSignal := sellSignal or chRibS
// ━━━ المدارس المنقذة (بحث + اختراع مثبت) ━━━
chWtUse = input.bool(true, "WAVETREND v2 (WT + chassis) — ON", group=G_CH)
chWtTp3 = (high + low + close) / 3
chWtEsa = ta.ema(chWtTp3, 10)
chWtDe = ta.ema(math.abs(chWtTp3 - chWtEsa), 10)
chWtCi = (chWtTp3 - chWtEsa) / (0.015 * chWtDe + 0.00001)
chWt1 = ta.ema(chWtCi, 21)
chWtB = chWtUse and chWt1 < -60 and chRsi3 < 18.0 and chBig
chWtS = chWtUse and chWt1 > 60 and chRsi3 > 82.0 and chBig
buySignal := buySignal or chWtB
sellSignal := sellSignal or chWtS
chUls2B = chUlsUse and low < ta.lowest(low, chUlsLen)[1] and close > ta.lowest(low, chUlsLen)[1] and chStretch < -chUlsStr and chRsi3 < chUlsRsi
chUls2S = chUlsUse and high > ta.highest(high, chUlsLen)[1] and close < ta.highest(high, chUlsLen)[1] and chStretch > chUlsStr and chRsi3 > 100 - chUlsRsi
chVzUse = input.bool(true, "VWAP Absorption Fade — ON", group=G_PULLBACK_NEW)
chVzDev = input.float(2.0, "VZ deviation mult", minval=1.0, maxval=4.0, step=0.1, group=G_PULLBACK_NEW)
chTp3 = (high + low + close) / 3
chVw = ta.sma(chTp3 * nz(volume, 0.0), 20) / (ta.sma(nz(volume, 0.0), 20) + 0.00001)
chSdv = ta.stdev(chTp3 - chVw, 50)
chVzB = chVzUse and low < chVw - chVzDev * chSdv and chRsi3 < 18.0 and chBig
chVzS = chVzUse and high > chVw + chVzDev * chSdv and chRsi3 > 82.0 and chBig
chCrevUse = input.bool(true, "CLIMAX REVERSAL (بديل MACD Vol) — ON", group=G_MOM_NEW)
chCrevB = chCrevUse and chClim[1] and close[1] < open[1] and close > open and close > close[1]
chCrevS = chCrevUse and chClim[1] and close[1] > open[1] and close < open and close < close[1]
chCmoUse = input.bool(true, "CMO SNAP — ON", group=G_MOM_NEW)
chCmoLen = input.int(9, "CMO length", minval=3, maxval=30, group=G_MOM_NEW)
chCmoLvl = input.float(60.0, "CMO extreme level", minval=30, maxval=90, step=5, group=G_MOM_NEW)
chUp = math.max(close - close[1], 0)
chDn = math.max(close[1] - close, 0)
chCmo = 100 * (ta.sma(chUp, chCmoLen) * chCmoLen - ta.sma(chDn, chCmoLen) * chCmoLen) / (ta.sma(chUp, chCmoLen) * chCmoLen + ta.sma(chDn, chCmoLen) * chCmoLen + 0.00001)
chCmoB = chCmoUse and chCmo < -chCmoLvl and chRsi3 < 18.0 and chBig
chCmoS = chCmoUse and chCmo > chCmoLvl and chRsi3 > 82.0 and chBig
buySignal := buySignal or chUls2B or chVzB or chCrevB or chCmoB
sellSignal := sellSignal or chUls2S or chVzS or chCrevS or chCmoS
// ━━━ الأربعة العنيدة — بدائل مخترعة مثبتة ━━━
chKeltUse = input.bool(true, "KELTNER v2 — ON", group=G_PULLBACK_NEW)
chKeltK = input.float(2.0, "Keltner mult", minval=0.5, maxval=5.0, step=0.1, group=G_PULLBACK_NEW)
chKcU = chEma + chKeltK * chAtrV
chKcL = chEma - chKeltK * chAtrV
chKeltB = chKeltUse and low < chKcL and chRsi3 < 18.0 and chBig
chKeltS = chKeltUse and high > chKcU and chRsi3 > 82.0 and chBig
chQuadUse = input.bool(false, "QUAD v2 — ON", group=G_MOM_NEW)
chQuadR14 = input.float(40.0, "QUAD RSI14 buy below", minval=20, maxval=50, step=1, group=G_MOM_NEW)
chRsi14v = ta.rsi(close, 14)
chQuadB = chQuadUse and chRsi3 < 18.0 and chRsi14v < chQuadR14 and chBig
chQuadS = chQuadUse and chRsi3 > 82.0 and chRsi14v > 100 - chQuadR14 and chBig
chR14Use = input.bool(true, "RSI14 TURN — ON", group=G_MOM_NEW)
chR14Str = input.float(1.0, "R14 stretch filter", minval=0.5, maxval=4.0, step=0.1, group=G_MOM_NEW)
chR14B = chR14Use and chRsi14v < 30 and chRsi14v > chRsi14v[1] and chStretch < -chR14Str
chR14S = chR14Use and chRsi14v > 70 and chRsi14v < chRsi14v[1] and chStretch > chR14Str
buySignal := buySignal or chKeltB or chQuadB or chR14B
sellSignal := sellSignal or chKeltS or chQuadS or chR14S
// ━━━ CLOUD (بديل Ichimoku+BBKC) + UT v2 ━━━
chCldUse = input.bool(true, "EMA CLOUD break — ON", group=G_SCHOOLS_NEW)
chCldLen = input.int(55, "Cloud slow EMA", minval=20, maxval=200, group=G_SCHOOLS_NEW)
chE55 = ta.ema(close, chCldLen)
chCloudHi = math.max(chEma, chE55)
chCloudLo = math.min(chEma, chE55)
chCldB = chCldUse and close[1] <= chCloudHi[1] and close > chCloudHi and close > open
chCldS = chCldUse and close[1] >= chCloudLo[1] and close < chCloudLo and close < open
chUtUse = input.bool(true, "UT v2 — ON", group=G_RISK_NEW)
chUtMult = input.float(6.0, "UT supertrend mult", minval=0.5, maxval=8.0, step=0.1, group=G_RISK_NEW)
chUtLen = input.int(7, "UT supertrend ATR len", minval=2, maxval=60, group=G_RISK_NEW)
[chCldUT, chUtDir] = ta.supertrend(chUtMult, chUtLen)
chUtB = chUtUse and chUtDir == -1 and chRsi3 < 18.0 and chBig
chUtS = chUtUse and chUtDir == 1 and chRsi3 > 82.0 and chBig
buySignal := buySignal or chCldB or chUtB
sellSignal := sellSignal or chCldS or chUtS
// ━━━ باقي البدائل الخضراء ━━━
chTsiUse = input.bool(false, "TSI fade — ON", group=G_MOM_NEW)
chTsiLvl = input.float(15.0, "TSI extreme level", minval=5, maxval=30, step=1, group=G_MOM_NEW)
chPc = (close - close[1]) / (close[1] + 0.00001)
chTsiN = ta.ema(ta.ema(chPc, 13), 7)
chTsiD = ta.ema(ta.ema(math.abs(chPc), 13), 7)
chTsi = 100 * chTsiN / (chTsiD + 0.00001)
chTsiB = chTsiUse and chTsi < -chTsiLvl and chRsi3 < 18.0 and chBig
chTsiS = chTsiUse and chTsi > chTsiLvl and chRsi3 > 82.0 and chBig
chDixUse = input.bool(false, "DI spread reversion — OFF (ablation: loses points in both halves)", group=G_MOM_NEW)
chDixLvl = input.float(20.0, "DI spread level", minval=5, maxval=30, step=1, group=G_MOM_NEW)
chDixB = chDixUse and mDI > pDI + chDixLvl and close > open
chDixS = chDixUse and pDI > mDI + chDixLvl and close < open
chPsUse = input.bool(true, "PRO SCALPER — ON", group=G_PULLBACK_NEW)
chPsRsi = input.float(25.0, "PS RSI extreme", minval=10, maxval=40, step=1, group=G_PULLBACK_NEW)
chPsAdx = input.float(30.0, "PS max ADX", minval=10, maxval=40, step=1, group=G_PULLBACK_NEW)
chBbM = ta.sma(close, 20)
chBbS = ta.stdev(close, 20)
chPsB = chPsUse and chRsi14v < chPsRsi and low <= chBbM - 2 * chBbS and (math.min(open, close) - low > math.abs(close - open) or close > high[1]) and adx < chPsAdx
chPsS = chPsUse and chRsi14v > 100 - chPsRsi and high >= chBbM + 2 * chBbS and (high - math.max(open, close) > math.abs(close - open) or close < low[1]) and adx < chPsAdx
buySignal := buySignal or chTsiB or chDixB or chPsB
sellSignal := sellSignal or chTsiS or chDixS or chPsS

// ━━━ CVD + REG35 (تكملة الـ38) ━━━
chCvdUse = input.bool(true, "CVD divergence — ON", group=G_MOM_NEW)
chCvdLen = input.int(30, "CVD window", minval=10, maxval=100, group=G_MOM_NEW)
chCvdShift = input.int(5, "CVD compare shift", minval=1, maxval=30, group=G_MOM_NEW)
chCvdRng = math.max(high - low, syminfo.mintick)
chCvdFast = ta.sma((2 * close - high - low) / chCvdRng * nz(volume, 0.0), chCvdLen) * chCvdLen
chCvdB = chCvdUse and low <= ta.lowest(low, chCvdLen) and chCvdFast > chCvdFast[chCvdShift] and close > open
chCvdS = chCvdUse and high >= ta.highest(high, chCvdLen) and chCvdFast < chCvdFast[chCvdShift] and close < open
buySignal := buySignal or chCvdB
sellSignal := sellSignal or chCvdS
buySignal := buySignal or chTriB or chSniB
sellSignal := sellSignal or chTriS or chSniS

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 18 ■ RMI FILTER — المؤشر الثاني + الحماية
// Applied at the FINAL entry gate so every signal source above
// (including all champion OR sources) must pass it. No bypass.
// ① Zone block: no BUY in overbought, no SELL in oversold.
//    Lifted for WITH-trend entries in a confirmed strong trend,
//    because RMI stays pinned inside the zone during strong trends.
// ② Strict reversal: fading a zone needs RMI already turning
//    (falling / signal-line cross), never while still climbing.
// ③ Strong Trend Guard: counter-trend fades are fully blocked
//    while ADX + HTF map confirm a strong trend.
// ④ Zone-Only Mode: BUY only from low RMI, SELL only from high RMI,
//    middle blocked. With-trend continuation passes only while RMI
//    momentum agrees with the trade direction.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
G_RMIF = "18 ■ RMI Filter (المؤشر الثاني + الحماية)"
useRmiFilter = input.bool(false, "Use RMI Filter (OFF = موشرك الأصلي 100%)", group=G_RMIF)
rmiFLen = input.int(20, "RMI Length", minval=2, maxval=100, group=G_RMIF)
rmiFMom = input.int(4, "RMI Momentum", minval=1, maxval=50, group=G_RMIF)
rmiFSigLen = input.int(6, "RMI Signal Smooth", minval=1, maxval=50, group=G_RMIF)
rmiFUpper = input.float(70.0, "Overbought Level", minval=50.0, maxval=99.0, step=0.5, group=G_RMIF)
rmiFLower = input.float(30.0, "Oversold Level", minval=1.0, maxval=50.0, step=0.5, group=G_RMIF)
rmiFBlockBuyOB = input.bool(true, "① Block BUY In Overbought", group=G_RMIF)
rmiFBlockSellOS = input.bool(true, "① Block SELL In Oversold", group=G_RMIF)
rmiFStrict = input.bool(true, "② Strict Reversal Confirm", group=G_RMIF)
rmiFTrendGuard = input.bool(true, "③ Strong Trend Guard", group=G_RMIF)
rmiFTrendADX = input.float(28.0, "③ Strong Trend Min ADX", minval=5.0, maxval=60.0, step=1.0, group=G_RMIF)
rmiFZoneOnly = input.bool(true, "④ Zone-Only Mode: BUY Low / SELL High", group=G_RMIF)
rmiFBuyMax = input.float(45.0, "④ BUY Only Below RMI", minval=10.0, maxval=90.0, step=1.0, group=G_RMIF)
rmiFSellMin = input.float(60.0, "④ SELL Only Above RMI", minval=10.0, maxval=90.0, step=1.0, group=G_RMIF)
rmiFShowBlocked = input.bool(true, "Show Blocked X Marks", group=G_RMIF)

// Exact TheLark RMI formula (EMA smoothing, dn==0 -> 0 guard)
f_rmi_filter_val(_len, _mom) =>
    _u = ta.ema(math.max(close - close[_mom], 0.0), _len)
    _d = ta.ema(math.max(close[_mom] - close, 0.0), _len)
    _d == 0.0 ? 0.0 : 100.0 - 100.0 / (1.0 + _u / _d)

rmiFVal = f_rmi_filter_val(rmiFLen, rmiFMom)
rmiFSigLine = ta.sma(rmiFVal, rmiFSigLen)
rmiFOB = rmiFVal >= rmiFUpper
rmiFOS = rmiFVal <= rmiFLower
rmiFRising = rmiFVal > rmiFVal[1]
rmiFFalling = rmiFVal < rmiFVal[1]
rmiFCrossUp = ta.crossover(rmiFVal, rmiFSigLine)
rmiFCrossDn = ta.crossunder(rmiFVal, rmiFSigLine)

// ③ strong trend read from the indicator's own map (ADX + HTF score + EMA structure)
rmiFStrongUp = adx >= rmiFTrendADX and (htfScore >= 2.0 or (tf5Dir == 1 and tf15Dir == 1)) and ema20 > ema50 and close > ema20
rmiFStrongDown = adx >= rmiFTrendADX and (htfScore <= -2.0 or (tf5Dir == -1 and tf15Dir == -1)) and ema20 < ema50 and close < ema20

rmiFBuyZoneOK = not rmiFBlockBuyOB or not rmiFOB or (rmiFStrongUp and rmiFRising)
rmiFSellZoneOK = not rmiFBlockSellOS or not rmiFOS or (rmiFStrongDown and rmiFFalling)
rmiFBuyStrictOK = not rmiFStrict or not rmiFOS or rmiFRising or rmiFCrossUp
rmiFSellStrictOK = not rmiFStrict or not rmiFOB or rmiFFalling or rmiFCrossDn
rmiFBuyTrendOK = not rmiFTrendGuard or not rmiFStrongDown
rmiFSellTrendOK = not rmiFTrendGuard or not rmiFStrongUp
rmiFZoneOnlyBuyOK = not rmiFZoneOnly or rmiFVal <= rmiFBuyMax or (rmiFStrongUp and rmiFRising)
rmiFZoneOnlySellOK = not rmiFZoneOnly or rmiFVal >= rmiFSellMin or (rmiFStrongDown and rmiFFalling)

rmiFBuyOK = not useRmiFilter or (rmiFBuyZoneOK and rmiFBuyStrictOK and rmiFBuyTrendOK and rmiFZoneOnlyBuyOK)
rmiFSellOK = not useRmiFilter or (rmiFSellZoneOK and rmiFSellStrictOK and rmiFSellTrendOK and rmiFZoneOnlySellOK)

rmiFBlockedBuy = rmiFShowBlocked and useRmiFilter and barstate.isconfirmed and not active and canCooldown and canLongAfterLoss and buySignal and not rmiFBuyOK
rmiFBlockedSell = rmiFShowBlocked and useRmiFilter and barstate.isconfirmed and not active and canCooldown and canShortAfterLoss and sellSignal and not rmiFSellOK
plotshape(rmiFBlockedBuy, title="RMI BLOCKED BUY", style=shape.xcross, location=location.belowbar, color=color.new(color.gray, 25), size=size.tiny)
plotshape(rmiFBlockedSell, title="RMI BLOCKED SELL", style=shape.xcross, location=location.abovebar, color=color.new(color.gray, 25), size=size.tiny)

// ━━━ 20 ■ Source Solo Test — فحص كل مصدر لحاله ━━━
// NOTE: champion add-on signals inherit source code 0, so "BASE ONLY"
// means base engine + champions together; FUSION/TV/M1/POC are clean.
G_SOLO = "20 ■ Source Solo Test (فحص مصدر لحاله)"
soloSourceMode = input.string("ALL", "Solo Source", options=["ALL", "FUSION ONLY", "BASE ONLY", "TREND VOTE ONLY", "M1 ONLY", "POC ONLY"], group=G_SOLO)
ourSoloOK = soloSourceMode == "ALL" or (soloSourceMode == "FUSION ONLY" and m1SelectedSourceCode == 6) or (soloSourceMode == "BASE ONLY" and m1SelectedSourceCode == 0) or (soloSourceMode == "TREND VOTE ONLY" and m1SelectedSourceCode == 5) or (soloSourceMode == "M1 ONLY" and m1SelectedSourceCode >= 1 and m1SelectedSourceCode <= 3) or (soloSourceMode == "POC ONLY" and m1SelectedSourceCode == 4)
canEnterLong = barstate.isconfirmed and not active and canCooldown and canLongAfterLoss and buySignal and rmiFBuyOK and ourSoloOK
canEnterShort = barstate.isconfirmed and not active and canCooldown and canShortAfterLoss and sellSignal and rmiFSellOK and ourSoloOK

if canEnterLong or canEnterShort
    active := true
    side := canEnterLong ? 1 : -1
    entryPrice := close
    tradeKind := side == 1 ? longTypeNow : shortTypeNow
    tradeEntrySourceCode := m1SelectedSourceCode
    tradeEntrySource := tradeEntrySourceCode == 1 ? "M1 OWN" : tradeEntrySourceCode == 2 ? "M1 SAME" : tradeEntrySourceCode == 3 ? "M1 TAKE" : tradeEntrySourceCode == 4 ? "POC+BRK" : tradeEntrySourceCode == 5 ? "TREND VOTE" : tradeEntrySourceCode == 6 ? "SCHOOL FUSION" : "BASE 999"

    [basePlannedTarget, basePlannedStop] = f_sy999_source_plan(side, entryPrice, tradeEntrySourceCode, tradeKind)
    [plannedTarget, plannedStop, plannedExitMode, plannedDirectionScore] = f_dae_exit_plan(side, entryPrice, basePlannedTarget, basePlannedStop, tradeKind)
    tradeTargetPts := math.max(30.0, plannedTarget)
    tradeStopPts := math.min(plannedStop, tradeTargetPts + 20.0)
    tradeExitMode := plannedExitMode
    tradeDirectionScore := plannedDirectionScore

    exitModeText = tradeExitMode == 0 ? "STRONG" : tradeExitMode == 1 ? "ALIGNED" : tradeExitMode == 2 ? "RANGE" : tradeExitMode == 3 ? "REVERSAL" : tradeExitMode == 4 ? "COUNTER" : "LATE"
    tradeRiskState := useDirectionalAdaptiveExit ? "DIR " + exitModeText + " HARD" : "BASE HARD"
    tradeTargetSource := useDirectionalAdaptiveExit ? "M1/M5/M15 + LIQ" : "BASE PLAN"
    if tradeEntrySourceCode == 1
        m1LiveOwnTrades += 1
    else if tradeEntrySourceCode == 2
        m1LiveSameTrades += 1
    else if tradeEntrySourceCode == 3
        m1LiveTakeTrades += 1
    else if tradeEntrySourceCode == 5
        trendVoteLiveTrades += 1
    else if tradeEntrySourceCode == 6
        finalFusionLiveTrades += 1
    if useMainFixedRisk
        tradeTargetPts := targetPoints
        tradeStopPts := stopPoints
        tradeRiskState := "FIXED 1:1 HARD"
        tradeTargetSource := "MAIN ③"
    lastExitPlan := tradeEntrySource + " | " + tradeRiskState + " SCORE " + str.tostring(tradeDirectionScore, "#.##") + " TP " + str.tostring(tradeTargetPts, "#") + " SL " + str.tostring(tradeStopPts, "#")
    tpPrice := side == 1 ? entryPrice + tradeTargetPts * pointUnit : entryPrice - tradeTargetPts * pointUnit
    slPrice := side == 1 ? entryPrice - tradeStopPts * pointUnit : entryPrice + tradeStopPts * pointUnit
    entryBar := bar_index
    lastTradeBar := bar_index
    sy999TradeMFE := 0.0
    sy999TradeMAE := 0.0
    sy999TradeRegime := sy999SignalRegime
    sy999TradeId += 1
    sy999CloseAlertTradeId := na
    sy999IntrabarExitTradeId := na
    sy999IntrabarExitPrice := na
    if side == 1
        if statsActive
            longTrades += 1
    else
        if statsActive
            shortTrades += 1
    sy348EntryBuyPlot := side == 1
    sy348EntrySellPlot := side == -1
    if smartShowExitState and showSignals and statsActive
        label.new(bar_index, side == 1 ? low : high, lastExitPlan, style=side == 1 ? label.style_label_up : label.style_label_down, color=color.new(EN_C, 0), textcolor=color.black, size=size.tiny)
    if showTradeLines
        if not na(sy348EntryLine)
            line.delete(sy348EntryLine)
        if not na(sy348TPLine)
            line.delete(sy348TPLine)
        if not na(sy348SLLine)
            line.delete(sy348SLLine)
        sy348EntryLine := line.new(bar_index, entryPrice, bar_index + lineBars, entryPrice, color=EN_C, width=1)
        sy348TPLine := line.new(bar_index, tpPrice, bar_index + lineBars, tpPrice, color=TP_C, width=1)
        sy348SLLine := line.new(bar_index, slPrice, bar_index + lineBars, slPrice, color=SL_C, width=1)

if active and bar_index > entryBar
    favPts = side == 1 ? (high - entryPrice) / pointUnit : (entryPrice - low) / pointUnit
    advPts = side == 1 ? (entryPrice - low) / pointUnit : (high - entryPrice) / pointUnit
    sy999TradeMFE := math.max(sy999TradeMFE, math.max(0.0, favPts))
    sy999TradeMAE := math.max(sy999TradeMAE, math.max(0.0, advPts))
    currentPnl = side == 1 ? (close - entryPrice) / pointUnit : (entryPrice - close) / pointUnit
    regimeKey = f_sy999_regime_key(sy999TradeRegime, sy999TradeMFE, sy999TradeMAE, bar_index - entryBar, tradeTargetPts, tradeStopPts)
    [pRegime, nRegime] = f_sy999_prob(sy999RCnt, sy999RWin, regimeKey)

    hitTPraw = side == 1 ? high >= tpPrice : low <= tpPrice
    hitSLraw = side == 1 ? low <= slPrice : high >= slPrice
    bothRaw = hitTPraw and hitSLraw

    // TP and SL are fixed from the entry bar; no partial close and no trailing.
    hitTP = hitTPraw
    hitSL = side == 1 ? low <= slPrice : high >= slPrice
    both = hitTP and hitSL
    skipTrade = both and sameCandleRule == "Skip"
    isWin = both ? (not skipTrade and sameCandleRule == "Target First") : hitTP
    isLoss = both ? (not skipTrade and sameCandleRule == "Stop First") : hitSL
    hardExit = isWin or isLoss or skipTrade

    regimeExitNow = useRealCloseSender and sy999LearnClosedTrades >= wfWarmupTrades and not hardExit and barstate.isconfirmed and f_sy999_regime80_exit(currentPnl, sy999TradeMFE, bar_index - entryBar, tradeTargetPts, tradeStopPts, pRegime, nRegime)
    regimeExitAllowed = regimeExitNow and (not realCloseOnlyIfProfit or currentPnl > 0)

    if regimeExitAllowed and realClosePendingTradeId != sy999TradeId
        realClosePendingTradeId := sy999TradeId
        realCloseLastSendBar := na
        realCloseAttempts := 0

    realCloseCanRetry = realClosePendingTradeId == sy999TradeId and realCloseAttempts < realCloseMaxAttempts and (na(realCloseLastSendBar) or bar_index - realCloseLastSendBar >= realCloseRetryEveryBars)
    realCloseFire = realCloseCanRetry and sy963UseAlertFunction and barstate.isrealtime and barstate.isconfirmed and not hardExit

    if realCloseFire
        realCloseLastSendBar := bar_index
        realCloseAttempts += 1
        realCloseRequestCount += 1
        realCloseRequestPlot := true
        closeSide = side == 1 ? "BUY" : "SELL"
        closePtsLive = currentPnl
        closeJson = '{"key":"' + sy963WebhookKey + '","action":"' + sy999CloseAction + '","side":"' + closeSide + '","symbol":"' + sy963BotSymbol + '","lot":' + str.tostring(sy963LotSize) + ',"entry":' + str.tostring(entryPrice, format.mintick) + ',"close_price":' + str.tostring(close, format.mintick) + ',"close_points":' + str.tostring(closePtsLive, "#.##") + ',"reason":"REGIME_80_REAL","trade_id":' + str.tostring(sy999TradeId) + ',"trade_uid":"' + realCloseTradeUid + '","attempt":' + str.tostring(realCloseAttempts) + ',"max_attempts":' + str.tostring(realCloseMaxAttempts) + ',"hard_tp_price":' + str.tostring(tpPrice, format.mintick) + ',"hard_sl_price":' + str.tostring(slPrice, format.mintick) + ',"indicator":"SYR30","time":"' + str.tostring(time) + '"}'
        closeSimple = sy963WebhookKey + " " + sy999CloseAction + " " + sy963BotSymbol + " " + closeSide + " REGIME_80_REAL UID " + realCloseTradeUid + " TRY " + str.tostring(realCloseAttempts)
        alert(sy963AlertFormat == "JSON" ? closeJson : closeSimple, alert.freq_once_per_bar_close)

    earlyExit = false
    if hardExit or earlyExit
        exitPts = skipTrade ? 0.0 : (earlyExit ? f_clamp_float(side == 1 ? (sy999IntrabarExitPrice - entryPrice) / pointUnit : (entryPrice - sy999IntrabarExitPrice) / pointUnit, -tradeStopPts, tradeTargetPts) : (isWin ? tradeTargetPts : -tradeStopPts))
        exitPrice = earlyExit ? sy999IntrabarExitPrice : (isWin ? tpPrice : slPrice)
        statsCounted = statsActive and not skipTrade
        if statsCounted
            trades += 1
        if statsCounted and tradeEntrySourceCode >= 1 and tradeEntrySourceCode <= 3
            if exitPts > 0
                m1LiveM1Wins += 1
            else
                m1LiveM1Losses += 1
        if statsCounted and tradeEntrySourceCode == 5
            if exitPts > 0
                trendVoteLiveWins += 1
            else
                trendVoteLiveLosses += 1
        if statsCounted and tradeEntrySourceCode == 6
            if exitPts > 0
                finalFusionLiveWins += 1
            else
                finalFusionLiveLosses += 1
        if exitPts > 0
            if statsCounted
                wins += 1
                netPts += exitPts
                sumWinPts += exitPts
                lastClosedPts := exitPts
                curWin += 1
                curLoss := 0
                maxWin := math.max(maxWin, curWin)
                if side == 1
                    longWins += 1
                    longNetPts += exitPts
                else
                    shortWins += 1
                    shortNetPts += exitPts
                if tradeEntrySourceCode == 0
                    baseSrcWins += 1
                    baseSrcNet += exitPts
                else if tradeEntrySourceCode <= 3
                    m1SrcNet += exitPts
                else if tradeEntrySourceCode == 4
                    pocSrcNet += exitPts
                else if tradeEntrySourceCode == 5
                    tvSrcNet += exitPts
                else
                    fusionSrcNet += exitPts
            if not earlyExit and statsCounted
                sy348ExitTPPlot := true
        else if not skipTrade
            if statsCounted
                losses += 1
                netPts += exitPts
                sumLossPts += math.abs(exitPts)
                lastClosedPts := exitPts
                curLoss += 1
                curWin := 0
                maxLoss := math.max(maxLoss, curLoss)
                if side == 1
                    longLossN += 1
                    longNetPts += exitPts
                else
                    shortLossN += 1
                    shortNetPts += exitPts
                if tradeEntrySourceCode == 0
                    baseSrcLosses += 1
                    baseSrcNet += exitPts
                else if tradeEntrySourceCode <= 3
                    m1SrcNet += exitPts
                else if tradeEntrySourceCode == 4
                    pocSrcNet += exitPts
                else if tradeEntrySourceCode == 5
                    tvSrcNet += exitPts
                else
                    fusionSrcNet += exitPts
            if side == 1
                lastLongStopBar := bar_index
                if tradeKind == 1
                    lastBuyRangeStopBar := bar_index
                else if tradeKind == 2
                    lastBuySweepStopBar := bar_index
                else
                    lastBuyTrendStopBar := bar_index
            else
                lastShortStopBar := bar_index
                if tradeKind == -1
                    lastSellRangeStopBar := bar_index
                else if tradeKind == -2
                    lastSellSweepStopBar := bar_index
                else
                    lastSellTrendStopBar := bar_index
            if not earlyExit and statsCounted
                sy348ExitSLPlot := true

        if earlyExit
            if statsActive
                sy999EarlyExitCount += 1
                sy999ExitPlot := true
            if showSignals and sy999ShowExitMarks and statsActive
                label.new(bar_index, exitPrice, "EXIT " + (exitPts > 0 ? "+" : "") + str.tostring(exitPts, "#.##"), style=side == 1 ? label.style_label_down : label.style_label_up, color=exitPts > 0 ? BUY_C : EN_C, textcolor=exitPts > 0 ? TXT_C : color.black, size=size.tiny)
        else if showSignals and statsCounted
            if isWin
                label.new(bar_index, tpPrice, "TP " + str.tostring(tradeTargetPts, "#"), style=label.style_label_down, color=TP_C, textcolor=TXT_C, size=size.tiny)
            else
                label.new(bar_index, slPrice, "SL " + str.tostring(tradeStopPts, "#"), style=label.style_label_up, color=SL_C, textcolor=TXT_C, size=size.tiny)

        if showTradeLines
            if not na(sy348EntryLine)
                line.delete(sy348EntryLine)
            if not na(sy348TPLine)
                line.delete(sy348TPLine)
            if not na(sy348SLLine)
                line.delete(sy348SLLine)
            sy348EntryLine := na
            sy348TPLine := na
            sy348SLLine := na
        realClosePendingTradeId := na
        realCloseLastSendBar := na
        realCloseAttempts := 0
        active := false
        side := 0
        entryPrice := na
        tpPrice := na
        slPrice := na
        tradeTargetPts := na
        tradeStopPts := na
        tradeKind := 0
        entryBar := na
        tradeRiskState := ""
        tradeTargetSource := ""
        tradeEntrySource := ""
        tradeEntrySourceCode := 0
        tradeExitMode := 1
        tradeDirectionScore := 0.0
        sy999TradeMFE := 0.0
        sy999TradeMAE := 0.0
        sy999TradeRegime := 1

if statsActive and not useMainFixedRisk
    learnLongTypeNow = sy334BuySweep ? 2 : sy334BuyRange ? 1 : 3
    learnShortTypeNow = sy334SellSweep ? -2 : sy334SellRange ? -1 : -3

    learnLongLastTypeStop = learnLongTypeNow == 1 ? sy999LearnLastBuyRangeStop : learnLongTypeNow == 2 ? sy999LearnLastBuySweepStop : sy999LearnLastBuyTrendStop
    learnShortLastTypeStop = learnShortTypeNow == -1 ? sy999LearnLastSellRangeStop : learnShortTypeNow == -2 ? sy999LearnLastSellSweepStop : sy999LearnLastSellTrendStop
    learnLongTypeCooldown = buyLossCooldownBars
    learnShortTypeCooldown = sellLossCooldownBars

    learnBaseCooldownBarsNow = useSY337QuickRouter ? sy339EffCooldown : cooldownBars
    learnBaseLongLossCooldownNow = useSY337QuickRouter ? sy339EffLossCooldown : (useSeparateSideRisk ? buyLossCooldownBars : lossCooldownBars)
    learnBaseShortLossCooldownNow = useSY337QuickRouter ? sy339EffLossCooldown : (useSeparateSideRisk ? sellLossCooldownBars : lossCooldownBars)

    learnBaseCooldownOK = na(sy999LearnLastTrade) or bar_index - sy999LearnLastTrade >= learnBaseCooldownBarsNow
    learnBaseLongOK = na(sy999LearnLastLongStop) or bar_index - sy999LearnLastLongStop >= learnBaseLongLossCooldownNow
    learnBaseShortOK = na(sy999LearnLastShortStop) or bar_index - sy999LearnLastShortStop >= learnBaseShortLossCooldownNow

    learnLastAnyStop = na(sy999LearnLastLongStop) ? sy999LearnLastShortStop : na(sy999LearnLastShortStop) ? sy999LearnLastLongStop : math.max(sy999LearnLastLongStop, sy999LearnLastShortStop)

    learnGlobalEntryOK = cooldownBars == 15 or na(sy999LearnLastTrade) or bar_index - sy999LearnLastTrade >= math.max(0, cooldownBars)
    learnGlobalLossOK = lossCooldownBars == 35 or na(learnLastAnyStop) or bar_index - learnLastAnyStop >= math.max(0, lossCooldownBars)

    learnApplySideCooldown = useSeparateSideRisk or buyLossCooldownBars != 15 or sellLossCooldownBars != 30
    learnBuySideOK = not learnApplySideCooldown or na(sy999LearnLastLongStop) or bar_index - sy999LearnLastLongStop >= math.max(0, buyLossCooldownBars)
    learnSellSideOK = not learnApplySideCooldown or na(sy999LearnLastShortStop) or bar_index - sy999LearnLastShortStop >= math.max(0, sellLossCooldownBars)

    learnApplyTypeCooldown = useSY333TypeRisk
    learnLongTypeOK = not learnApplyTypeCooldown or na(learnLongLastTypeStop) or bar_index - learnLongLastTypeStop >= math.max(0, learnLongTypeCooldown)
    learnShortTypeOK = not learnApplyTypeCooldown or na(learnShortLastTypeStop) or bar_index - learnShortLastTypeStop >= math.max(0, learnShortTypeCooldown)

    learnCooldown = learnBaseCooldownOK and learnGlobalEntryOK
    learnLongOK = learnBaseLongOK and learnGlobalLossOK and learnBuySideOK and learnLongTypeOK
    learnShortOK = learnBaseShortOK and learnGlobalLossOK and learnSellSideOK and learnShortTypeOK

    learnGoLong = not sy999LearnActive and learnCooldown and learnLongOK and buySignal
    learnGoShort = not sy999LearnActive and learnCooldown and learnShortOK and sellSignal
    if learnGoLong or learnGoShort
        sy999LearnSide := learnGoLong ? 1 : -1
        sy999LearnTradeKind := sy999LearnSide == 1 ? learnLongTypeNow : learnShortTypeNow
        sy999LearnEntry := close
        [learnBaseTarget, learnBaseStop] = f_sy999_source_plan(sy999LearnSide, sy999LearnEntry, m1SelectedSourceCode, sy999LearnTradeKind)
        [learnTarget, learnStop, learnExitMode, learnDirectionScore] = f_dae_exit_plan(sy999LearnSide, sy999LearnEntry, learnBaseTarget, learnBaseStop, sy999LearnTradeKind)
        sy999LearnTarget := learnTarget
        sy999LearnStop := learnStop
        sy999LearnTP := sy999LearnSide == 1 ? sy999LearnEntry + sy999LearnTarget * pointUnit : sy999LearnEntry - sy999LearnTarget * pointUnit
        sy999LearnSL := sy999LearnSide == 1 ? sy999LearnEntry - sy999LearnStop * pointUnit : sy999LearnEntry + sy999LearnStop * pointUnit
        sy999LearnMFE := 0.0
        sy999LearnMAE := 0.0
        sy999LearnEntryBar := bar_index
        sy999LearnLastTrade := bar_index
        sy999LearnRegime := sy999SignalRegime
        sy999LearnActive := true
        array.clear(sy999VisitedR)

    if sy999LearnActive and bar_index > sy999LearnEntryBar
        learnFav = sy999LearnSide == 1 ? (high - sy999LearnEntry) / pointUnit : (sy999LearnEntry - low) / pointUnit
        learnAdv = sy999LearnSide == 1 ? (sy999LearnEntry - low) / pointUnit : (high - sy999LearnEntry) / pointUnit
        sy999LearnMFE := math.max(sy999LearnMFE, math.max(0.0, learnFav))
        sy999LearnMAE := math.max(sy999LearnMAE, math.max(0.0, learnAdv))
        learnKey = f_sy999_regime_key(sy999LearnRegime, sy999LearnMFE, sy999LearnMAE, bar_index - sy999LearnEntryBar, sy999LearnTarget, sy999LearnStop)
        f_sy999_add_unique(sy999VisitedR, learnKey)
        learnHitTP = sy999LearnSide == 1 ? high >= sy999LearnTP : low <= sy999LearnTP
        learnHitSL = sy999LearnSide == 1 ? low <= sy999LearnSL : high >= sy999LearnSL
        learnBoth = learnHitTP and learnHitSL
        learnSkip = learnBoth and sameCandleRule == "Skip"
        learnWin = learnBoth ? (not learnSkip and sameCandleRule == "Target First") : learnHitTP
        learnLoss = learnBoth ? (not learnSkip and sameCandleRule == "Stop First") : learnHitSL
        if learnWin or learnLoss
            f_sy999_learn_update(sy999RCnt, sy999RWin, sy999VisitedR, learnWin)
            sy999LearnClosedTrades += 1
            if learnLoss
                if sy999LearnSide == 1
                    sy999LearnLastLongStop := bar_index
                    if sy999LearnTradeKind == 1
                        sy999LearnLastBuyRangeStop := bar_index
                    else if sy999LearnTradeKind == 2
                        sy999LearnLastBuySweepStop := bar_index
                    else
                        sy999LearnLastBuyTrendStop := bar_index
                else
                    sy999LearnLastShortStop := bar_index
                    if sy999LearnTradeKind == -1
                        sy999LearnLastSellRangeStop := bar_index
                    else if sy999LearnTradeKind == -2
                        sy999LearnLastSellSweepStop := bar_index
                    else
                        sy999LearnLastSellTrendStop := bar_index
            sy999LearnActive := false
            sy999LearnSide := 0
            sy999LearnEntry := na
            sy999LearnTP := na
            sy999LearnSL := na
            sy999LearnTarget := na
            sy999LearnStop := na
            sy999LearnMFE := 0.0
            sy999LearnMAE := 0.0
            sy999LearnEntryBar := na
            sy999LearnTradeKind := 0
            sy999LearnRegime := 1
            array.clear(sy999VisitedR)

sy963WebhookFire = sy963UseAlertFunction and barstate.isconfirmed and (canEnterLong or canEnterShort) and (na(sy963LastWebhookAlertBar) or sy963LastWebhookAlertBar != bar_index)
if sy963WebhookFire
    sy963LastWebhookAlertBar := bar_index
    sy963SideText = side == 1 ? "BUY" : "SELL"

    sy963AlertTargetPts = na(tradeTargetPts) ? sy963WebhookTargetPoints : tradeTargetPts
    sy963AlertStopPts = na(tradeStopPts) ? sy963WebhookStopPoints : tradeStopPts
    sy963AlertTPPrice = na(tpPrice) ? (side == 1 ? entryPrice + sy963AlertTargetPts * pointUnit : entryPrice - sy963AlertTargetPts * pointUnit) : tpPrice
    sy963AlertSLPrice = na(slPrice) ? (side == 1 ? entryPrice - sy963AlertStopPts * pointUnit : entryPrice + sy963AlertStopPts * pointUnit) : slPrice
    sy963JsonMsg = '{"key":"' + sy963WebhookKey + '","action":"' + sy963SideText + '","side":"' + sy963SideText + '","symbol":"' + sy963BotSymbol + '","lot":' + str.tostring(sy963LotSize) + ',"tp_points":' + str.tostring(sy963AlertTargetPts, "#.##") + ',"sl_points":' + str.tostring(sy963AlertStopPts, "#.##") + ',"target_points":' + str.tostring(sy963AlertTargetPts, "#.##") + ',"stop_points":' + str.tostring(sy963AlertStopPts, "#.##") + ',"point_unit":' + str.tostring(pointUnit) + ',"entry":' + str.tostring(entryPrice, format.mintick) + ',"tp_price":' + str.tostring(sy963AlertTPPrice, format.mintick) + ',"sl_price":' + str.tostring(sy963AlertSLPrice, format.mintick) + ',"exit_state":"' + tradeRiskState + '","target_source":"' + tradeTargetSource + '","exit_model":"ADAPTIVE_AT_ENTRY_HARD_TP_SL_WITH_REAL_CLOSE","trade_id":' + str.tostring(sy999TradeId) + ',"trade_uid":"' + realCloseTradeUid + '","indicator":"SYR30","time":"' + str.tostring(time) + '"}'
    sy963SimpleMsg = sy963WebhookKey + " " + sy963SideText + " " + sy963BotSymbol + " MODEL ADAPTIVE_AT_ENTRY_HARD_TP_SL LOT " + str.tostring(sy963LotSize) + " TP " + str.tostring(sy963AlertTargetPts, "#.##") + " SL " + str.tostring(sy963AlertStopPts, "#.##")
    alert(sy963AlertFormat == "JSON" ? sy963JsonMsg : sy963SimpleMsg, alert.freq_once_per_bar_close)

plotshape(showSignals and statsActive and sy348EntryBuyPlot, title="SY354 Stable BUY", style=shape.labelup, location=location.belowbar, color=BUY_C, text="BUY", textcolor=TXT_C, size=size.small)
plotshape(showSignals and statsActive and sy348EntrySellPlot, title="SY354 Stable SELL", style=shape.labeldown, location=location.abovebar, color=SELL_C, text="SELL", textcolor=TXT_C, size=size.small)
plotshape(showSignals and sy348ExitTPPlot, title="SYXAUUSD TP", style=shape.circle, location=location.abovebar, color=TP_C, text="TP", textcolor=TXT_C, size=size.tiny)
plotshape(showSignals and sy348ExitSLPlot, title="SYXAUUSD SL", style=shape.circle, location=location.belowbar, color=SL_C, text="SL", textcolor=TXT_C, size=size.tiny)
plotshape(realCloseShowMarks and realCloseRequestPlot, title="SYXAUUSD REAL CLOSE REQUEST", style=shape.diamond, location=location.top, color=EN_C, text="CLOSE", textcolor=color.black, size=size.tiny)
plotshape(showSignals and sy999ShowExitMarks and sy999ExitPlot, title="SYXAUUSD REGIME 80 EXIT", style=shape.diamond, location=location.top, color=EN_C, text="EXIT", textcolor=color.black, size=size.tiny)

plotshape(showResearchMarks and quadBuy, title="Quad Buy", style=shape.circle, location=location.belowbar, color=color.new(BUY_C, 65), size=size.tiny)
plotshape(showResearchMarks and quadSell, title="Quad Sell", style=shape.circle, location=location.abovebar, color=color.new(SELL_C, 65), size=size.tiny)
plotshape(showResearchMarks and trendCorrBuy, title="Trend Correction Buy", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 45), size=size.tiny)
plotshape(showResearchMarks and trendCorrSell, title="Trend Correction Sell", style=shape.circle, location=location.abovebar, color=color.new(color.red, 45), size=size.tiny)
plotshape(showResearchMarks and rsi14ShiftBuy, title="RSI14 Shift Buy", style=shape.diamond, location=location.belowbar, color=color.new(BUY_C, 40), size=size.tiny)
plotshape(showResearchMarks and rsi14ShiftSell, title="RSI14 Shift Sell", style=shape.diamond, location=location.abovebar, color=color.new(SELL_C, 40), size=size.tiny)
plotshape(showResearchMarks and bbkcBuy, title="BBKC Buy", style=shape.triangleup, location=location.belowbar, color=color.new(BUY_C, 40), size=size.tiny)
plotshape(showResearchMarks and bbkcSell, title="BBKC Sell", style=shape.triangledown, location=location.abovebar, color=color.new(SELL_C, 40), size=size.tiny)
plotshape(showResearchMarks and sy319TrendBuy, title="SY319 Trend Addon Buy", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 35), size=size.tiny)
plotshape(showResearchMarks and sy319TrendSell, title="SY319 Trend Addon Sell", style=shape.circle, location=location.abovebar, color=color.new(color.red, 35), size=size.tiny)
plotshape(showResearchMarks and buySignal and longTypeNow == 1, title="SYXAUUSD BUY Range", style=shape.labelup, location=location.belowbar, color=color.new(BUY_C, 25), text="BR", textcolor=TXT_C, size=size.tiny)
plotshape(showResearchMarks and buySignal and longTypeNow == 2, title="SYXAUUSD BUY Sweep", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 20), text="BS", textcolor=TXT_C, size=size.tiny)
plotshape(showResearchMarks and sellSignal and shortTypeNow == -1, title="SYXAUUSD SELL Range", style=shape.labeldown, location=location.abovebar, color=color.new(SELL_C, 25), text="SR", textcolor=TXT_C, size=size.tiny)


wr = trades > 0 ? wins * 100.0 / trades : 0.0

color TBL_BG = color.rgb(16, 18, 26)
color TBL_BG_HEAD = color.rgb(22, 24, 34)
color TBL_BG_ROW = color.rgb(18, 20, 30)
color TBL_BG_ROW2 = color.rgb(20, 22, 32)

var table t = table.new(position.top_right, 2, 22, bgcolor=TBL_BG, border_width=0, frame_color=color.new(color.black, 100), frame_width=0)
if showTable and barstate.islast
    table.cell(t, 0, 0, "SYXAUUSD", text_color=color.white, bgcolor=TBL_BG_HEAD, text_size=size.small)
    table.cell(t, 1, 0, "FINAL K3 CACHE | F>TV>B", text_color=EN_C, bgcolor=TBL_BG_HEAD, text_size=size.small)

    table.cell(t, 0, 1, "Win", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(wins), text_color=BUY_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 2, "Loss", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(losses), text_color=SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 3, "WR", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(wr, "#.##") + "%", text_color=wr >= 60 ? BUY_C : wr >= 55 ? EN_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 4, "Net", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(netPts, "#.##"), text_color=netPts >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 5, "Max W", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(maxWin), text_color=BUY_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 6, "Max L", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(maxLoss), text_color=maxLoss <= 9 ? EN_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    avgWinPts = wins > 0 ? sumWinPts / wins : 0.0
    avgLossPts = losses > 0 ? sumLossPts / losses : 0.0
    table.cell(t, 0, 7, "Avg TP", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 7, str.tostring(avgWinPts, "#.##"), text_color=BUY_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 8, "Avg SL", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 8, str.tostring(avgLossPts, "#.##"), text_color=SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 9, "Last", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 9, (lastClosedPts > 0 ? "+" : "") + str.tostring(lastClosedPts, "#.##"), text_color=lastClosedPts >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 10, "From", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 10, statsMode == "All Loaded History" ? "ALL" : str.format_time(statsStartTime, "dd MMM HH:mm 'UTC'", "UTC"), text_color=EN_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 11, "Manager", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 11, useRealCloseSender ? "DIR M1/M5/M15 HARD/CLOSE" : "DIR M1/M5/M15 HARD", text_color=BUY_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 12, "TV W/L", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 12, str.tostring(trendVoteLiveWins) + "/" + str.tostring(trendVoteLiveLosses), text_color=trendVoteLiveWins >= trendVoteLiveLosses ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 13, "Fusion W/L", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 13, str.tostring(finalFusionLiveWins) + "/" + str.tostring(finalFusionLiveLosses), text_color=finalFusionLiveWins >= finalFusionLiveLosses ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 14, "Close Req", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 14, str.tostring(realCloseRequestCount), text_color=EN_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 15, "M1 O/S/T", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 15, str.tostring(m1LiveOwnTrades) + "/" + str.tostring(m1LiveSameTrades) + "/" + str.tostring(m1LiveTakeTrades), text_color=(m1LiveOwnTrades + m1LiveSameTrades + m1LiveTakeTrades) > 0 ? EN_C : WAIT_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 16, "M1 W/L", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 16, str.tostring(m1LiveM1Wins) + "/" + str.tostring(m1LiveM1Losses), text_color=m1LiveM1Wins >= m1LiveM1Losses ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 17, "BASE W/L Net", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 17, str.tostring(baseSrcWins) + "/" + str.tostring(baseSrcLosses) + "  " + (baseSrcNet >= 0 ? "+" : "") + str.tostring(baseSrcNet, "#"), text_color=baseSrcNet >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 18, "Net TV | FUSN", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 18, (tvSrcNet >= 0 ? "+" : "") + str.tostring(tvSrcNet, "#") + " | " + (fusionSrcNet >= 0 ? "+" : "") + str.tostring(fusionSrcNet, "#"), text_color=(tvSrcNet + fusionSrcNet) >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 19, "Net M1 | POC", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 19, (m1SrcNet >= 0 ? "+" : "") + str.tostring(m1SrcNet, "#") + " | " + (pocSrcNet >= 0 ? "+" : "") + str.tostring(pocSrcNet, "#"), text_color=(m1SrcNet + pocSrcNet) >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 20, "BUY W/L Net", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 20, str.tostring(longWins) + "/" + str.tostring(longLossN) + "  " + (longNetPts >= 0 ? "+" : "") + str.tostring(longNetPts, "#"), text_color=longNetPts >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 21, "SELL W/L Net", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 21, str.tostring(shortWins) + "/" + str.tostring(shortLossN) + "  " + (shortNetPts >= 0 ? "+" : "") + str.tostring(shortNetPts, "#"), text_color=shortNetPts >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)
else if not showTable and barstate.islast
    table.clear(t, 0, 0, 1, 21)

alertcondition(canEnterLong, "SYR30 BUY", "SYR30 BUY | FINAL K3 CACHE")
alertcondition(canEnterShort, "SYR30 SELL", "SYR30 SELL | FINAL K3 CACHE")

alertcondition(sy963UseBuyCondition and canEnterLong, "SYR30 WEBHOOK BUY", "SYR30 BUY | use Any alert() function call for key/action/lot/tp/sl")
alertcondition(sy963UseSellCondition and canEnterShort, "SYR30 WEBHOOK SELL", "SYR30 SELL | use Any alert() function call for key/action/lot/tp/sl")
alertcondition(useRealCloseSender, "SYXAUUSD REAL CLOSE ENABLED", "Use Any alert() function call for the dynamic CLOSE payload")

var table sy389T = table.new(position.bottom_left, 2, 8, border_width=1)

if sy389ShowBiasTable and barstate.islast
    table.cell(sy389T, 0, 0, "SYXAUUSD BIAS", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(sy389T, 1, 0, useSY389BiasEngine ? "ON" : "OFF", bgcolor=color.new(color.black, 0), text_color=useSY389BiasEngine ? color.lime : color.gray)

    table.cell(sy389T, 0, 1, "State", text_color=color.white)
    table.cell(sy389T, 1, 1, sy389BiasUp ? "UP" : sy389BiasDown ? "DOWN" : "RANGE", text_color=sy389BiasUp ? BUY_C : sy389BiasDown ? SELL_C : color.yellow)

    table.cell(sy389T, 0, 2, "Local Slope", text_color=color.white)
    table.cell(sy389T, 1, 2, str.tostring(sy389LocalSlope, "#.##"), text_color=sy389LocalSlope > 0 ? BUY_C : sy389LocalSlope < 0 ? SELL_C : color.white)

    table.cell(sy389T, 0, 3, "Local ER", text_color=color.white)
    table.cell(sy389T, 1, 3, str.tostring(sy389LocalER, "#.##"), text_color=sy389LocalER >= sy389MinER ? color.lime : color.gray)

    table.cell(sy389T, 0, 4, "HTF Bias", text_color=color.white)
    table.cell(sy389T, 1, 4, sy389HTFUp ? "UP" : sy389HTFDown ? "DOWN" : "RANGE", text_color=sy389HTFUp ? BUY_C : sy389HTFDown ? SELL_C : color.yellow)

    table.cell(sy389T, 0, 5, "HTF Slope", text_color=color.white)
    table.cell(sy389T, 1, 5, str.tostring(sy389SlopeHTF, "#.##"), text_color=sy389SlopeHTF > 0 ? BUY_C : sy389SlopeHTF < 0 ? SELL_C : color.white)

    table.cell(sy389T, 0, 6, "Old htfScore", text_color=color.white)
    table.cell(sy389T, 1, 6, str.tostring(htfScore, "#.##"), text_color=htfScore > 0 ? BUY_C : htfScore < 0 ? SELL_C : color.white)

    table.cell(sy389T, 0, 7, "Flip B/S", text_color=color.white)
    table.cell(sy389T, 1, 7, (sy389WrongSellInUp ? "S->B " : "") + (sy389WrongBuyInDown ? "B->S" : ""), text_color=color.white)
