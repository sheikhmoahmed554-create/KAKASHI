// R1 original with only vote/cooldown input paths repaired.
// Defaults matched to the complete user screenshot set dated 2026-07-22.
// Updated again to match the 17 screenshots supplied on 2026-07-23.
// Screenshot settings applied; existing trading logic preserved, including the supplied smart filters.
// R13: Fast Trend TF is connected to both the base map and the final K3 router.
// SYR30: old Stochastic/Donchian Reset, Compression entry family, and Range/Donchian Fade sources are removed.
// Replacements are Balance Reset Launch, Asia Accepted Break-Retest, and Dead Auction Reclaim.
indicator("SYR30 NO FILTERS TEST", shorttitle="SYR30 NOFILT", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000, dynamic_requests=true)
// Exact defaults transcribed from the 24 SYR30 settings screenshots supplied on 2026-07-29.

// ══════════════════════════════════════════════════════════════════
// R16 — M1 Directional Adaptive Exit / 2025–2026 Monthly Stability Tune
//   • Same entry logic, schools and router as R15; only the entry-time TP/SL plan changed.
//   • Minimum target is 30 points to leave practical room for spread on XAUUSD M1.
//   • General adaptive plan: target 30–55, structural stop 55–60, lookback 8.
//   • Four directional context profiles are applied at entry:
//       BUY aligned 50/60 | SELL aligned 40/48 | BUY late 45/60 | SELL late 45/60.
//   • Protected swing high/low is calculated on every bar before entry-plan calls.
//   • TP and SL are calculated once on confirmed M1 close and remain fixed.
//   • No HALF target, no partial close and no trade-exit trailing.
// ══════════════════════════════════════════════════════════════════

f_roll_sum(src, len) =>
    float s = 0.0
    for i = 0 to len - 1
        s += nz(src[i])
    s

f_clamp_float(_v, _lo, _hi) =>
    math.max(_lo, math.min(_hi, _v))

f_nearest_buy_liq_pts(_entry, _minPts, _maxPts, _lookback, _swingOnly, _pu) =>
    float best = na
    for i = 1 to _lookback
        _h = high[i]
        _right = nz(high[i - 1], _h)
        _left = nz(high[i + 1], _h)
        _isSwing = not _swingOnly or (_h >= _left and _h >= _right)
        _pts = (_h - _entry) / _pu
        if not na(_h) and _isSwing and _pts >= _minPts and _pts <= _maxPts
            best := na(best) ? _pts : math.min(best, _pts)
    best

f_nearest_sell_liq_pts(_entry, _minPts, _maxPts, _lookback, _swingOnly, _pu) =>
    float best = na
    for i = 1 to _lookback
        _l = low[i]
        _right = nz(low[i - 1], _l)
        _left = nz(low[i + 1], _l)
        _isSwing = not _swingOnly or (_l <= _left and _l <= _right)
        _pts = (_entry - _l) / _pu
        if not na(_l) and _isSwing and _pts >= _minPts and _pts <= _maxPts
            best := na(best) ? _pts : math.min(best, _pts)
    best

