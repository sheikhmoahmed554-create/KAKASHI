sy325SellOK = not sy325SellAgainstDriver

legacyRawBuy = rawBuy0 and htfBuyOK and sy320BuyOK and sy322BuyOK and sy324QuietOK and sy325BuyOK
legacyRawSell = rawSell0 and htfSellOK and sy320SellOK and sy322SellOK and sy324QuietOK and sy325SellOK

typeGuardBuy = not sy334ApplyOldGuardsToType or (htfBuyOK and sy320BuyOK and sy322BuyOK and sy324QuietOK and sy325BuyOK)
typeGuardSell = not sy334ApplyOldGuardsToType or (htfSellOK and sy320SellOK and sy322SellOK and sy324QuietOK and sy325SellOK)
typeRawBuy = sy334TypeBuy and typeGuardBuy
typeRawSell = sy334TypeSell and typeGuardSell

oldRawBuy = sy334Engine == "Legacy Only" ? legacyRawBuy : sy334Engine == "Type + Legacy" ? (typeRawBuy or legacyRawBuy) : typeRawBuy
oldRawSell = sy334Engine == "Legacy Only" ? legacyRawSell : sy334Engine == "Type + Legacy" ? (typeRawSell or legacyRawSell) : typeRawSell

sy339IsHigherWR = mode == "Higher WR"
sy339IsMoreTrades = mode == "More Trades"
sy339ModeLateMult = not sy337RouterModeAffects ? 1.0 : sy339IsHigherWR ? 0.72 : sy339IsMoreTrades ? 1.35 : 1.0
sy339ModeCooldownAdd = not sy337RouterModeAffects ? 0 : sy339IsHigherWR ? 8 : sy339IsMoreTrades ? -2 : 0
sy339EffMaxLateMovePts = math.max(10.0, sy337MaxLateMovePts * sy339ModeLateMult)
sy339EffCooldown = math.max(0, sy337Cooldown + sy339ModeCooldownAdd)
sy339EffLossCooldown = math.max(0, sy337LossCooldown + (not sy337RouterModeAffects ? 0 : sy339IsHigherWR ? 10 : sy339IsMoreTrades ? -5 : 0))

sy337UpMovePts = (close - ta.lowest(low, sy337LateLookback)) / pointUnit
sy337DownMovePts = (ta.highest(high, sy337LateLookback) - close) / pointUnit
sy337BuyLate = sy337UseNotLate and sy337UpMovePts > sy339EffMaxLateMovePts and rangePos > 45
sy337SellLate = sy337UseNotLate and sy337DownMovePts > sy339EffMaxLateMovePts and rangePos < 55
sy337NotLateBuy = not sy337BuyLate
sy337NotLateSell = not sy337SellLate

sy337BuyCore = (sy337BuyUseSweep and sy334BuySweepRaw) or (sy337BuyUseRealRev and realRevBuy)
sy337SellCore = (sy337SellUseSweep and sy334SellSweepRaw) or (sy337SellUseRange and sy334SellRangeRaw) or (sy337SellUseTrend and sy334SellTrendRaw) or (sy337SellUseSY336Best and sy336SellBest) or (sy337SellUseBase and baseSell)
sy337RawBuy = tradeableBase and sy337BuyCore and sy337NotLateBuy
sy337RawSell = tradeableBase and sy337SellCore and sy337NotLateSell

sy338MSSBuy = close > ta.highest(high, sy338MSSLen)[1]
sy338MSSSell = close < ta.lowest(low, sy338MSSLen)[1]
sy338FastDriverBuy = close > ema20 and ema20 >= ema50 and sy325EmaSlope >= sy325DriverSlopeATR
sy338FastDriverSell = close < ema20 and ema20 <= ema50 and sy325EmaSlope <= -sy325DriverSlopeATR

sy339EffTrendScoreLevel = not sy337RouterModeAffects ? sy338TrendScoreLevel : sy339IsHigherWR ? math.max(1.0, sy338TrendScoreLevel - 0.5) : sy339IsMoreTrades ? math.min(4.5, sy338TrendScoreLevel + 0.5) : sy338TrendScoreLevel
sy338StrongUp = useSY338TrendGuard and htfScore >= sy339EffTrendScoreLevel and tf5Dir == 1 and tf15Dir == 1 and (not sy338RequireFastDriver or sy338FastDriverBuy)
sy338StrongDown = useSY338TrendGuard and htfScore <= -sy339EffTrendScoreLevel and tf5Dir == -1 and tf15Dir == -1 and (not sy338RequireFastDriver or sy338FastDriverSell)

sy338TrueCounterBuy = rangePos <= sy338CounterBuyMaxRange and bullReject and (not sy338AllowCounterOnlyWithSweep or (sweepLow and realRevBuy)) and (not sy338RequireCounterMSS or sy338MSSBuy)
sy338TrueCounterSell = rangePos >= sy338CounterSellMinRange and bearReject and (not sy338AllowCounterOnlyWithSweep or (sweepHigh and realRevSell)) and (not sy338RequireCounterMSS or sy338MSSSell)

