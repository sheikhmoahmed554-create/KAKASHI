indicator("SYXAUUSD FINAL FUSION FIXED V2", shorttitle="SYXAUUSD FIXED V2", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000, dynamic_requests=true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SY389 - CLEAN BASELINE + REAL BIAS TREND ENGINE
// Tested concept on XAUUSD M1 2021 + 2023 + 2025
// Fixed risk: TP 40 pts / SL 50 pts / pointUnit 0.10 / Stop First
// SY305 base with added HTF Master Guard so research/quad entries cannot fight the 5m/15m/60m trend.
// Final tested gate:
// SY307 base kept as the core.
// Added tested web add-ons ON TOP of exact SY307, not replacing it:
f_roll_sum(src, len) =>
    float s = 0.0
    for i = 0 to len - 1
        s += nz(src[i])
    s

// SYXAUUSD CLEAN: SY973F Current Adaptive + active REGIME 80 only.
f_clamp_float(_v, _lo, _hi) =>
    math.max(_lo, math.min(_hi, _v))

f_nearest_buy_liq_pts(_entry, _minPts, _maxPts, _lookback, _swingOnly, _pu) =>
    float best = na
    for i = 1 to _lookback
        _h = high[i]
        _right = nz(high[i - 1], _h)
        _left = nz(high[i + 1], _h)
        _isSwing = not _swingOnly or (_h >= _left and _h >= _right)
        _pts = (_h - _entry) / _pu
        if not na(_h) and _isSwing and _pts >= _minPts and _pts <= _maxPts
            best := na(best) ? _pts : math.min(best, _pts)
    best

f_nearest_sell_liq_pts(_entry, _minPts, _maxPts, _lookback, _swingOnly, _pu) =>
    float best = na
    for i = 1 to _lookback
        _l = low[i]
        _right = nz(low[i - 1], _l)
        _left = nz(low[i + 1], _l)
        _isSwing = not _swingOnly or (_l <= _left and _l <= _right)
        _pts = (_entry - _l) / _pu
        if not na(_l) and _isSwing and _pts >= _minPts and _pts <= _maxPts
            best := na(best) ? _pts : math.min(best, _pts)
    best

