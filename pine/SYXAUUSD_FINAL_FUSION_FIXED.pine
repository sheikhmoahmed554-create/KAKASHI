// SYXAUUSD REGIME 80 LIVE ENGINE + PAST-ONLY BASELINE LEARNER
// One active manager only. No shadow models and no old experiment tables.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var array<int> sy999RCnt = array.new_int(625, 0)
var array<int> sy999RWin = array.new_int(625, 0)
var array<int> sy999VisitedR = array.new_int()

// Untouched baseline learner state.
