allowLong = tradeSide == "BOTH" or tradeSide == "LONG"
allowShort = tradeSide == "BOTH" or tradeSide == "SHORT"
pointUnit = math.max(pointUnitInput, syminfo.mintick)
slDist = stopPoints * pointUnit
tpDist = targetPoints * pointUnit
buySlDist = buyStopPoints * pointUnit
buyTpDist = buyTargetPoints * pointUnit
sellSlDist = sellStopPoints * pointUnit
sellTpDist = sellTargetPoints * pointUnit
statsActive = statsMode == "All Loaded History" or time >= statsStartTime
statsResetByTime = statsMode == "From Custom Time" and time >= statsStartTime and (na(time[1]) or time[1] < statsStartTime)
tblPos = tablePos == "Bottom Right" ? position.bottom_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Left" ? position.bottom_left : position.top_right

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUNCTIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_hidden_fib_assist() =>
    _atr = ta.atr(14)
    _pHigh = ta.pivothigh(high, hiddenFibPivotLen, hiddenFibPivotLen)
    _pLow = ta.pivotlow(low, hiddenFibPivotLen, hiddenFibPivotLen)

    var float _lastPivotHigh = na
    var float _lastPivotLow = na
    var int _lastPivotHighBar = na
    var int _lastPivotLowBar = na
    var float _lockedHigh = na
    var float _lockedLow = na
    var int _lockedDir = 0

    if not na(_pHigh)
        _lastPivotHigh := _pHigh
        _lastPivotHighBar := bar_index - hiddenFibPivotLen

    if not na(_pLow)
        _lastPivotLow := _pLow
        _lastPivotLowBar := bar_index - hiddenFibPivotLen

    _ready = not na(_lastPivotHigh) and not na(_lastPivotLow) and not na(_lastPivotHighBar) and not na(_lastPivotLowBar)
    _wave = _ready ? math.abs(_lastPivotHigh - _lastPivotLow) : na
    _strongWave = _ready and _wave >= _atr * hiddenFibMinWaveATR

    _newUpWave = _strongWave and _lastPivotHighBar > _lastPivotLowBar
    _newDownWave = _strongWave and _lastPivotLowBar > _lastPivotHighBar

    if _strongWave
        if _newUpWave and (_lockedDir != 1 or _lockedHigh != _lastPivotHigh or _lockedLow != _lastPivotLow)
            _lockedHigh := _lastPivotHigh
            _lockedLow := _lastPivotLow
            _lockedDir := 1
        if _newDownWave and (_lockedDir != -1 or _lockedHigh != _lastPivotHigh or _lockedLow != _lastPivotLow)
            _lockedHigh := _lastPivotHigh
            _lockedLow := _lastPivotLow
            _lockedDir := -1

    _hasFib = not na(_lockedHigh) and not na(_lockedLow) and _lockedDir != 0
    _rng = _hasFib ? math.max(_lockedHigh - _lockedLow, syminfo.mintick) : na

    _zTop = math.min(hiddenFibZoneTop, hiddenFibZoneBottom)
    _zBot = math.max(hiddenFibZoneTop, hiddenFibZoneBottom)

    // Up wave: BUY on pullback into 0.50 - 0.786.
    _buyTop = _hasFib ? _lockedHigh - _rng * _zTop : na
    _buyBot = _hasFib ? _lockedHigh - _rng * _zBot : na

    // Down wave: SELL on pullback into 0.50 - 0.786.
    _sellBot = _hasFib ? _lockedLow + _rng * _zTop : na
    _sellTop = _hasFib ? _lockedLow + _rng * _zBot : na

    _tol = _atr * hiddenFibToleranceATR
    _cRange = math.max(high - low, syminfo.mintick)
    _closePos = (close - low) / _cRange
    _bullReject = close > open and _closePos >= 0.55
    _bearReject = close < open and _closePos <= 0.45

    _inBuy = _hasFib and _lockedDir == 1 and close <= _buyTop + _tol and close >= _buyBot - _tol
    _inSell = _hasFib and _lockedDir == -1 and close >= _sellBot - _tol and close <= _sellTop + _tol

    _buyOK = _inBuy and (not hiddenFibRequireReaction or _bullReject)
    _sellOK = _inSell and (not hiddenFibRequireReaction or _bearReject)

    // Return previous closed Hidden Fib TF values only, so the assist does not repaint.
    [_buyOK[1], _sellOK[1], _inBuy[1], _inSell[1], _lockedDir[1]]


f_hidden_liq_sweep_assist() =>
    _prevLow = ta.lowest(low, hiddenLiqLookback)[1]
    _prevHigh = ta.highest(high, hiddenLiqLookback)[1]
    _buySweep = not na(_prevLow) and low < _prevLow and (hiddenLiqRequireCloseReclaim ? close > _prevLow : close > low)
    _sellSweep = not na(_prevHigh) and high > _prevHigh and (hiddenLiqRequireCloseReclaim ? close < _prevHigh : close < high)

    // Return previous closed Liquidity TF values only, so it does not repaint.
    [_buySweep[1], _sellSweep[1], _prevLow[1], _prevHigh[1]]


f_sy130_smoothrng(_x, _t, _m) =>
    _wper = _t * 2 - 1
    _avrng = ta.ema(math.abs(_x - _x[1]), _t)
    ta.ema(_avrng, _wper) * _m

f_sy130_rngfilt(_x, _r) =>
    var float _rf = na
    _prev = nz(_rf[1], _x)
    _rf := _x > _prev ? math.max(_prev, _x - _r) : math.min(_prev, _x + _r)
    _rf

f_sy130_rp_dir() =>
    _src = close
    _smrng1 = f_sy130_smoothrng(_src, sy130RPFastSmooth, sy130RPFastMult)
    _smrng2 = f_sy130_smoothrng(_src, sy130RPSlowSmooth, sy130RPSensitivity)
    _smrng = (_smrng1 + _smrng2) / 2.0
    _filt = f_sy130_rngfilt(_src, _smrng)
    int _dir = 0
    _dir := _filt > _filt[1] ? 1 : _filt < _filt[1] ? -1 : nz(_dir[1], 0)
    [_dir, _filt]

f_sy130_ualgo_dir() =>
    _atr = ta.atr(sy130ATRLen)
    _up = sy130ATRSource - sy130ATRMult * _atr
    _up1 = nz(_up[1], _up)
    _up := close[1] > _up1 ? math.max(_up, _up1) : _up
    _dn = sy130ATRSource + sy130ATRMult * _atr
    _dn1 = nz(_dn[1], _dn)
    _dn := close[1] < _dn1 ? math.min(_dn, _dn1) : _dn
    var int _trend = 1
    _trend := nz(_trend[1], _trend)
    _trend := _trend == -1 and close > _dn1 ? 1 : _trend == 1 and close < _up1 ? -1 : _trend
    [_trend, _up, _dn]

f_sy130_rp_dir_only() =>
    [_d, _line] = f_sy130_rp_dir()
    _d

f_sy130_ualgo_dir_only() =>
    [_d, _up, _dn] = f_sy130_ualgo_dir()
    _d


f_sy389_bias() =>
    _atr = ta.atr(14)
    _ema20 = ta.ema(close, 20)
    _ema50 = ta.ema(close, 50)
    _reg = ta.linreg(close, sy389RegLen, 0)
    _slope = (_reg - _reg[sy389SlopeLen]) / math.max(_atr, syminfo.mintick)
    _move = math.abs(close - close[sy389RegLen])
    _noise = ta.sma(math.abs(ta.change(close)), sy389RegLen) * sy389RegLen
    _er = _noise <= syminfo.mintick ? 0.0 : _move / _noise
    _up = _slope >= sy389MinSlopeATR and close > _ema50 and _ema20 >= _ema50 and _er >= sy389MinER
    _down = _slope <= -sy389MinSlopeATR and close < _ema50 and _ema20 <= _ema50 and _er >= sy389MinER
    _dir = _up ? 1 : _down ? -1 : 0
    [_dir[1], _slope[1], _er[1], _ema20[1], _ema50[1], close[1]]



f_poc_breaker_ob() =>
    _atr = ta.atr(14)
    _prevHigh = ta.highest(high, pbObBosLookback)[1]
    _prevLow = ta.lowest(low, pbObBosLookback)[1]
    _bullBos = not na(_prevHigh) and close > _prevHigh and close[1] <= _prevHigh and close > open
    _bearBos = not na(_prevLow) and close < _prevLow and close[1] >= _prevLow and close < open

    var float _bullTop = na
    var float _bullBottom = na
    var int _bullId = na
    var bool _bullActive = false
    var float _bearTop = na
    var float _bearBottom = na
    var int _bearId = na
    var bool _bearActive = false

    if _bullBos
        _lb = int(math.abs(ta.lowestbars(low[1], pbObBosLookback))) + 1
        _poc = (high[_lb] + low[_lb] + close[_lb]) / 3.0
        _bullTop := math.max(math.max(open[_lb], close[_lb]), _poc)
        _bullBottom := math.min(low[_lb], _poc)
        _bullId := time
        _bullActive := true

    if _bearBos
        _hb = int(math.abs(ta.highestbars(high[1], pbObBosLookback))) + 1
        _poc = (high[_hb] + low[_hb] + close[_hb]) / 3.0
        _bearTop := math.max(high[_hb], _poc)
        _bearBottom := math.min(math.min(open[_hb], close[_hb]), _poc)
        _bearId := time
        _bearActive := true

    if _bullActive and close < _bullBottom - _atr * pbObInvalidATR
        _bullActive := false
    if _bearActive and close > _bearTop + _atr * pbObInvalidATR
        _bearActive := false

    [_bullTop[1], _bullBottom[1], _bullId[1], _bullActive[1],
     _bearTop[1], _bearBottom[1], _bearId[1], _bearActive[1]]

f_poc_breaker_structure(_len) =>
    _ph = ta.pivothigh(high, _len, _len)
    _pl = ta.pivotlow(low, _len, _len)

    var float _lastHigh = na
    var float _lastLow = na
    var int _trend = 0
    var int _lastBullBreakTime = na
    var int _lastBearBreakTime = na
    var float _lastBullBreakLevel = na
    var float _lastBearBreakLevel = na

    if not na(_ph)
        _lastHigh := _ph
    if not na(_pl)
        _lastLow := _pl

    _bullBreak = not na(_lastHigh) and close > _lastHigh and close[1] <= _lastHigh
    _bearBreak = not na(_lastLow) and close < _lastLow and close[1] >= _lastLow

    if _bullBreak
        _trend := 1
        _lastBullBreakTime := time
        _lastBullBreakLevel := _lastHigh

    if _bearBreak
        _trend := -1
        _lastBearBreakTime := time
        _lastBearBreakLevel := _lastLow

    [_trend[1], _lastHigh[1], _lastLow[1],
     _lastBullBreakTime[1], _lastBearBreakTime[1],
     _lastBullBreakLevel[1], _lastBearBreakLevel[1]]

f_htf_dir() =>
    _ema20 = ta.ema(close, 20)[1]
    _ema50 = ta.ema(close, 50)[1]
    _ema100 = ta.ema(close, 100)[1]
    [_p, _m, _adx] = ta.dmi(14, 14)
    _c = close[1]
    _buy = _ema20 > _ema50 and _ema50 > _ema100 and _c > _ema50 and _p[1] >= _m[1]
    _sell = _ema20 < _ema50 and _ema50 < _ema100 and _c < _ema50 and _m[1] >= _p[1]
    _dir = _buy ? 1 : _sell ? -1 : 0
    [_dir, _adx[1], _p[1], _m[1], _c]

f_safe_div(_a, _b) =>
    _b == 0.0 ? 0.0 : _a / _b

f_cross_up(_src, _level) =>
    _src[1] < _level and _src >= _level

f_cross_dn(_src, _level) =>
    _src[1] > _level and _src <= _level

f_trix(_src, _len) =>
    _e1 = ta.ema(_src, _len)
    _e2 = ta.ema(_e1, _len)
    _e3 = ta.ema(_e2, _len)
    nz((_e3 - _e3[1]) / math.max(math.abs(_e3[1]), syminfo.mintick) * 10000.0)

f_smi(_len) =>
    _hh = ta.highest(high, _len)
    _ll = ta.lowest(low, _len)
    _mid = (_hh + _ll) / 2.0
    _rng = math.max((_hh - _ll) / 2.0, syminfo.mintick)
    _num = ta.ema(ta.ema(close - _mid, 3), 3)
    _den = math.max(ta.ema(ta.ema(_rng, 3), 3), syminfo.mintick)
    100.0 * _num / _den

f_tr(_h, _l, _c) =>
    math.max(_h - _l, math.max(math.abs(_h - nz(_c[1], _c)), math.abs(_l - nz(_c[1], _c))))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HTF MAP — RELOAD-VALIDATED TIMING LOCK
// IMPORTANT:
// Keep the exact lookahead_off mapping that produced and reload-validated
// the V4-8 result. The HTF helper functions already reference prior values.
// Do not switch these calls to lookahead_on because that changes the model.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[tf5Dir, tf5Adx, tf5P, tf5M, tf5Close] = request.security(syminfo.tickerid, tfFast, f_htf_dir(), barmerge.gaps_off, barmerge.lookahead_off)
[tf15Dir, tf15Adx, tf15P, tf15M, tf15Close] = request.security(syminfo.tickerid, tfMid, f_htf_dir(), barmerge.gaps_off, barmerge.lookahead_off)
[tf60Dir, tf60Adx, tf60P, tf60M, tf60Close] = request.security(syminfo.tickerid, tfBig, f_htf_dir(), barmerge.gaps_off, barmerge.lookahead_off)
[sy389BiasDirHTF, sy389SlopeHTF, sy389ERHTF, sy389Ema20HTF, sy389Ema50HTF, sy389CloseHTF] = request.security(syminfo.tickerid, sy389BiasTF, f_sy389_bias(), barmerge.gaps_off, barmerge.lookahead_off)

[pbObBullTop, pbObBullBottom, pbObBullId, pbObBullActive, pbObBearTop, pbObBearBottom, pbObBearId, pbObBearActive] = request.security(syminfo.tickerid, pbObTF, f_poc_breaker_ob(), barmerge.gaps_off, barmerge.lookahead_off)
[pbBreakTrend, pbBreakHigh, pbBreakLow, pbBreakBullTime, pbBreakBearTime, pbBreakBullLevel, pbBreakBearLevel] = request.security(syminfo.tickerid, pbStructureTF, f_poc_breaker_structure(pbStructurePivotLen), barmerge.gaps_off, barmerge.lookahead_off)
[pbSlowTrend, pbSlowHigh, pbSlowLow, pbSlowBullTime, pbSlowBearTime, pbSlowBullLevel, pbSlowBearLevel] = request.security(syminfo.tickerid, pbSlowTF, f_poc_breaker_structure(pbStructurePivotLen), barmerge.gaps_off, barmerge.lookahead_off)

htfScore = (tf5Dir == 1 ? 1.0 : tf5Dir == -1 ? -1.0 : 0.0) + (tf15Dir == 1 ? 1.5 : tf15Dir == -1 ? -1.5 : 0.0) + (tf60Dir == 1 ? 2.0 : tf60Dir == -1 ? -2.0 : 0.0)
mapBuy = htfScore > 1.0
mapSell = htfScore < -1.0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LOCAL FEATURES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
atr = ta.atr(atrLen)
atrAvg = ta.sma(atr, atrAvgLen)
atrRatio = atrAvg <= syminfo.mintick ? 1.0 : atr / atrAvg
ema9 = ta.ema(close, 9)
ema10 = ta.ema(close, emaFastLen)
ema20 = ta.ema(close, 20)
ema34 = ta.ema(close, 34)
ema50 = ta.ema(close, emaMidLen)
ema90 = ta.ema(close, emaSlowLen)
ema100 = ta.ema(close, 100)
vwapVal = ta.vwap(hlc3)
[pDI, mDI, adx] = ta.dmi(14, 14)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)


barRange = math.max(high - low, syminfo.mintick)
body = math.abs(close - open)
bodyPct = body / barRange * 100.0
upperWickPct = (high - math.max(open, close)) / barRange * 100.0
lowerWickPct = (math.min(open, close) - low) / barRange * 100.0
closePosBuy = (close - low) / barRange
closePosSell = (high - close) / barRange
bullReject = close > open and bodyPct >= minBodyPct and lowerWickPct >= minWickPct and closePosBuy >= 0.55
bearReject = close < open and bodyPct >= minBodyPct and upperWickPct >= minWickPct and closePosSell >= 0.55
bullMomentum = close > open and bodyPct >= strongBodyPct and closePosBuy >= 0.55
bearMomentum = close < open and bodyPct >= strongBodyPct and closePosSell >= 0.55
signalCandleOK = barRange <= atr * maxSignalCandleATR
crazyCandle = barRange >= atr * newsSpikeATR or body >= atr * newsSpikeATR * 0.70
atrOK = atrRatio >= minAtrVsAvg and atrRatio <= maxAtrVsAvg
tradeableBase = barstate.isconfirmed and signalCandleOK and not crazyCandle and atrOK

localHigh = ta.highest(high, localSwingLen)
localLow = ta.lowest(low, localSwingLen)
localRange = math.max(localHigh - localLow, syminfo.mintick)
rangePos = (close - localLow) / localRange * 100.0
premium = rangePos >= premiumLevel
discount = rangePos <= discountLevel

localTrendBuy = ema10 > ema50 and ema50 > ema90 and close > ema50 and pDI >= mDI
localTrendSell = ema10 < ema50 and ema50 < ema90 and close < ema50 and mDI >= pDI
powerUp = htfScore >= 2 and ema20 > ema50 and close > ema20
powerDown = htfScore <= -2 and ema20 < ema50 and close < ema20

roomBuy = not useRoomFilter or (localHigh - close) / pointUnit >= targetPoints
roomSell = not useRoomFilter or (close - localLow) / pointUnit >= targetPoints

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SYXAUUSD VOLATILITY TRANSITION ZONE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Improved version: detects the actual compression box and breakout zone,
// instead of only making volatility rules stronger.
vtzTR = ta.tr(true)
vtzFastVol = ta.ema(vtzTR, vtzATRLenFast)
vtzSlowVol = ta.sma(vtzTR, vtzATRLenSlow)
vtzVolRatio = vtzSlowVol <= syminfo.mintick ? 1.0 : vtzFastVol / vtzSlowVol

vtzBoxHigh = ta.highest(high, vtzBoxLookback)
vtzBoxLow = ta.lowest(low, vtzBoxLookback)
vtzBoxSizePts = (vtzBoxHigh - vtzBoxLow) / pointUnit
vtzBoxATR = (vtzBoxHigh - vtzBoxLow) / math.max(vtzSlowVol, syminfo.mintick)
vtzCompressed = useVTZ and vtzMode != "Off" and vtzBoxATR <= vtzMaxBoxATR and vtzVolRatio <= vtzQuietATRRatio

vtzBreakUpNow = vtzCompressed[1] and close > vtzBoxHigh[1] + vtzBreakBufferPts * pointUnit and vtzTR >= vtzSlowVol * vtzImpulseTR and close > open
vtzBreakDownNow = vtzCompressed[1] and close < vtzBoxLow[1] - vtzBreakBufferPts * pointUnit and vtzTR >= vtzSlowVol * vtzImpulseTR and close < open

var int vtzLastBreakBar = na
var int vtzDir = 0
var float vtzBreakHigh = na
var float vtzBreakLow = na
var float vtzBreakPrice = na

if vtzBreakUpNow
    vtzLastBreakBar := bar_index
    vtzDir := 1
    vtzBreakHigh := vtzBoxHigh[1]
    vtzBreakLow := vtzBoxLow[1]
    vtzBreakPrice := close

if vtzBreakDownNow
    vtzLastBreakBar := bar_index
    vtzDir := -1
    vtzBreakHigh := vtzBoxHigh[1]
    vtzBreakLow := vtzBoxLow[1]
    vtzBreakPrice := close

vtzBarsFromBreak = na(vtzLastBreakBar) ? 100000 : bar_index - vtzLastBreakBar
vtzActive = useVTZ and vtzMode != "Off" and not na(vtzLastBreakBar) and vtzBarsFromBreak <= vtzFollowBars
vtzUp = vtzActive and vtzDir == 1
vtzDown = vtzActive and vtzDir == -1

vtzUpperRetest = not na(vtzBreakHigh) and math.abs(close - vtzBreakHigh) / pointUnit <= vtzRetestTolerancePts
vtzLowerRetest = not na(vtzBreakLow) and math.abs(close - vtzBreakLow) / pointUnit <= vtzRetestTolerancePts
vtzRetestBuyZone = vtzUp and vtzUpperRetest
vtzRetestSellZone = vtzDown and vtzLowerRetest

vtzChasePts = na(vtzBreakPrice) ? 0.0 : math.abs(close - vtzBreakPrice) / pointUnit
vtzLateChase = vtzActive and vtzChasePts > vtzLateChasePts

vtzMiddleFadeZone = not vtzBlockMiddleFade ? true : rangePos > discountLevel and rangePos < premiumLevel


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BASE STORIES FROM OUR ORIGINAL MAP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
sweepHighLevel = ta.highest(high, 14)[1]
sweepLowLevel = ta.lowest(low, 14)[1]
sweepLow = not na(sweepLowLevel) and low < sweepLowLevel and close > sweepLowLevel
sweepHigh = not na(sweepHighLevel) and high > sweepHighLevel and close < sweepHighLevel

breakHigh20 = ta.highest(high, 20)[1]
breakLow20 = ta.lowest(low, 20)[1]
retestBuy = not na(breakHigh20) and low <= breakHigh20 + atr * 0.45 and close > breakHigh20 and close > open
retestSell = not na(breakLow20) and high >= breakLow20 - atr * 0.45 and close < breakLow20 and close < open

bullFVG = low > high[2] and (low - high[2]) >= atr * 0.18 and close > ema20
bearFVG = high < low[2] and (low[2] - high) >= atr * 0.18 and close < ema20

fibBuy = rangePos >= 21 and rangePos <= 50 and (bullReject or bullMomentum)
fibSell = rangePos >= 50 and rangePos <= 79 and (bearReject or bearMomentum)

bb20Basis = ta.sma(close, 20)
bb20Dev = ta.stdev(close, 20) * 2.0
bb20U = bb20Basis + bb20Dev
bb20L = bb20Basis - bb20Dev
rangeMarket = adx < 20 and math.abs(htfScore) < 1.5
bbRangeBuy = rangeMarket and low <= bb20L and bullReject and discount
bbRangeSell = rangeMarket and high >= bb20U and bearReject and premium

valueBuy = low <= ema20 + atr * 0.45 or low <= ema34 + atr * 0.45 or low <= ema50 + atr * 0.45 or (not na(vwapVal) and low <= vwapVal + atr * 0.45)
valueSell = high >= ema20 - atr * 0.45 or high >= ema34 - atr * 0.45 or high >= ema50 - atr * 0.45 or (not na(vwapVal) and high >= vwapVal - atr * 0.45)

cleanMove = math.abs(close - close[20]) / math.max(ta.sma(math.abs(close - close[1]), 20) * 20, syminfo.mintick) >= 0.25
momentumBuy = cleanMove and mapBuy and bullMomentum and not premium
momentumSell = cleanMove and mapSell and bearMomentum and not discount
realRevBuy = sweepLow and (discount or bbRangeBuy) and (bullReject or bullMomentum)
realRevSell = sweepHigh and (premium or bbRangeSell) and (bearReject or bearMomentum)

buyStory = (localTrendBuy and valueBuy and (bullReject or bullMomentum) and (mapBuy or powerUp)) or (sweepLow and (discount or mapBuy) and (bullReject or bullMomentum)) or retestBuy or bullFVG or fibBuy or bbRangeBuy or momentumBuy or realRevBuy
sellStory = (localTrendSell and valueSell and (bearReject or bearMomentum) and (mapSell or powerDown)) or (sweepHigh and (premium or mapSell) and (bearReject or bearMomentum)) or retestSell or bearFVG or fibSell or bbRangeSell or momentumSell or realRevSell
buyPlace = discount or rangePos <= 35 or sweepLow or retestBuy or bullFVG or realRevBuy
sellPlace = premium or rangePos >= 65 or sweepHigh or retestSell or bearFVG or realRevSell

baseBuy = tradeableBase and buyStory and buyPlace and not (powerDown and not realRevBuy) and roomBuy
baseSell = tradeableBase and sellStory and sellPlace and not (powerUp and not realRevSell) and roomSell

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BEST QUAD + RESEARCH UPGRADES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rsi14 = ta.rsi(close, 14)
rsi28 = ta.rsi(close, 28)
rsi34 = ta.rsi(close, 34)

stoch10Lo = ta.lowest(low, 10)
stoch10Hi = ta.highest(high, 10)
stoch10 = (close - stoch10Lo) / math.max(stoch10Hi - stoch10Lo, syminfo.mintick) * 100.0
stoch10D = ta.sma(stoch10, 3)
stoch50Lo = ta.lowest(low, 50)
stoch50Hi = ta.highest(high, 50)
stoch50 = (close - stoch50Lo) / math.max(stoch50Hi - stoch50Lo, syminfo.mintick) * 100.0

rsi28Buy = rsi28[1] < 55 and rsi28 >= 55 and close > ema20
rsi28Sell = rsi28[1] > 45 and rsi28 <= 45 and close < ema20
rsi34Buy = rsi34[1] < 55 and rsi34 >= 55 and close > ema20
rsi34Sell = rsi34[1] > 45 and rsi34 <= 45 and close < ema20
stoch10Buy = stoch10 > stoch10[1] and stoch10[1] < 20 and stoch10 < 85 and close > ema20
stoch10Sell = stoch10 < stoch10[1] and stoch10[1] > 80 and stoch10 > 15 and close < ema20
stoch50Buy = stoch50 > stoch50[1] and stoch50[1] < 15 and stoch50 < 85 and close > ema20
stoch50Sell = stoch50 < stoch50[1] and stoch50[1] > 85 and stoch50 > 15 and close < ema20
quadBuy = useQuad and (rsi28Buy or stoch10Buy or rsi34Buy or stoch50Buy)
quadSell = useQuad and (rsi28Sell or stoch10Sell or rsi34Sell or stoch50Sell)

// RSI14 range shift 40/60
rsi14BullRange = ta.lowest(rsi14, rsiRangeBars) > 38
rsi14BearRange = ta.highest(rsi14, rsiRangeBars) < 62
rsi14ShiftBuy = useRSI14Shift and rsi14BullRange and rsi14[1] < 40 and rsi14 >= 40 and close > ema20
rsi14ShiftSell = useRSI14Shift and rsi14BearRange and rsi14[1] > 60 and rsi14 <= 60 and close < ema20

// BB/KC 50 squeeze release
bb50Basis = ta.sma(close, 50)
bb50Dev = ta.stdev(close, 50) * 2.0
bb50U = bb50Basis + bb50Dev
bb50L = bb50Basis - bb50Dev
kc50Basis = ta.ema(close, 50)
kc50U = kc50Basis + atr * 1.5
kc50L = kc50Basis - atr * 1.5
squeeze50 = bb50U < kc50U and bb50L > kc50L
wasSqueeze50 = ta.highest(squeeze50 ? 1.0 : 0.0, squeezeLookback) > 0
bbkcBuy = useBBKCSqueeze and wasSqueeze50 and not squeeze50 and close > bb50Basis and close > ema20
bbkcSell = useBBKCSqueeze and wasSqueeze50 and not squeeze50 and close < bb50Basis and close < ema20

stochGuardBuy = not useStoch50Guard or stoch50 < 70
stochGuardSell = not useStoch50Guard or stoch50 > 30
// Trend Correction Booster: follows 15m + 60m trend and enters on 1m correction reset.
trendCorrBuyContext = tf15Dir == 1 and tf60Dir == 1 and pDI >= mDI
trendCorrSellContext = tf15Dir == -1 and tf60Dir == -1 and mDI >= pDI
stoch10PullbackBuy = stoch10[1] < stoch10D[1] and stoch10 >= stoch10D and stoch10 < 70 and ta.lowest(stoch10, 40) < 35 and close > ema50
stoch10PullbackSell = stoch10[1] > stoch10D[1] and stoch10 <= stoch10D and stoch10 > 30 and ta.highest(stoch10, 40) > 65 and close < ema50
trendCorrBuy = useTrendCorrection and trendCorrBuyContext and stoch10PullbackBuy
trendCorrSell = useTrendCorrection and trendCorrSellContext and stoch10PullbackSell

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SY315 WEB ADD-ONS ABOVE EXACT SY307
// These are not replacements. They are additional entries on top of SY307 only.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
tfCtxBuy = tf15Dir == 1 and tf60Dir != -1
tfCtxSell = tf15Dir == -1 and tf60Dir != 1

// QQE-like RSI28 smooth cross
rsi28Smooth = ta.ema(rsi28, 5)
rsi28Signal = ta.ema(rsi28Smooth, 13)
qqe28Buy = useSY315WebAddons and useQQE28Addon and tfCtxBuy and ta.crossover(rsi28Smooth, rsi28Signal) and rsi28Smooth < 65 and close > ema20
qqe28Sell = useSY315WebAddons and useQQE28Addon and tfCtxSell and ta.crossunder(rsi28Smooth, rsi28Signal) and rsi28Smooth > 35 and close < ema20

// Vortex14 RSI reset
tr14 = f_roll_sum(f_tr(high, low, close), 14)
viPlus14 = tr14 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(high - low[1]), 14) / tr14
viMinus14 = tr14 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(low - high[1]), 14) / tr14
vortex14Buy = useSY315WebAddons and useVortex14Addon and tfCtxBuy and viPlus14 > viMinus14 and rsi14[1] < 45 and rsi14 >= 45 and close > ema20
vortex14Sell = useSY315WebAddons and useVortex14Addon and tfCtxSell and viMinus14 > viPlus14 and rsi14[1] > 55 and rsi14 <= 55 and close < ema20

// Donchian70 mid reclaim
don70High = ta.highest(high, 70)[1]
don70Low = ta.lowest(low, 70)[1]
don70Mid = (don70High + don70Low) / 2.0
don70Buy = useSY315WebAddons and useDonchian70Addon and tfCtxBuy and not na(don70Mid) and close[1] < don70Mid[1] and close >= don70Mid and close > open
don70Sell = useSY315WebAddons and useDonchian70Addon and tfCtxSell and not na(don70Mid) and close[1] > don70Mid[1] and close <= don70Mid and close < open

// Donchian200 false break / liquidity reclaim
don200High = ta.highest(high, 200)[1]
don200Low = ta.lowest(low, 200)[1]
don200Buy = useSY315WebAddons and useDonchian200Addon and tfCtxBuy and not na(don200Low) and low < don200Low and close > don200Low and (bullReject or bullMomentum)
don200Sell = useSY315WebAddons and useDonchian200Addon and tfCtxSell and not na(don200High) and high > don200High and close < don200High and (bearReject or bearMomentum)

// BB34 squeeze release / researched original-school upgrade
// Uses Bollinger width percentile to detect compression, then only accepts release with HTF context and range guard.
bb34Basis = ta.sma(close, 34)
bb34Dev = ta.stdev(close, 34) * 2.0
bb34U = bb34Basis + bb34Dev
bb34L = bb34Basis - bb34Dev
bb34Width = (bb34U - bb34L) / math.max(math.abs(bb34Basis), syminfo.mintick)
bb34NarrowLine = ta.percentile_nearest_rank(bb34Width, 300, 35)
bb34Squeeze = bb34Width <= bb34NarrowLine
bb34RangeBuyOK = rangePos < 90
bb34RangeSellOK = rangePos > 10
bb34SqueezeBuy = useSY315WebAddons and useBB34SqueezeAddon and tfCtxBuy and bb34Squeeze[1] and close > bb34U and ema20 > ema50 and bb34RangeBuyOK
bb34SqueezeSell = useSY315WebAddons and useBB34SqueezeAddon and tfCtxSell and bb34Squeeze[1] and close < bb34L and ema20 < ema50 and bb34RangeSellOK

// SY319 New Trend/Momentum add-ons: TRIX + SMI, tested as additions above current best.
// They only fire during the chosen active session and keep HTF context.
sy319SessionOK = not na(time(timeframe.period, sy319Session, sy319SessionTz))
trix15 = f_trix(close, 15)
trix21 = f_trix(close, 21)
trix34 = f_trix(close, 34)
trix15Sig = ta.ema(trix15, 9)
trix21Sig = ta.ema(trix21, 9)
trix34Sig = ta.ema(trix34, 9)
smi14 = f_smi(14)
smi14Sig = ta.ema(smi14, 5)
trix15Buy = useSY319TrendAddons and useTRIX15Addon and sy319SessionOK and tfCtxBuy and ta.crossover(trix15, trix15Sig) and trix15 < 10 and close > ema20
trix15Sell = useSY319TrendAddons and useTRIX15Addon and sy319SessionOK and tfCtxSell and ta.crossunder(trix15, trix15Sig) and trix15 > -10 and close < ema20
trix21Buy = useSY319TrendAddons and useTRIX21Addon and sy319SessionOK and tfCtxBuy and ta.crossover(trix21, trix21Sig) and trix21 < 10 and close > ema20
trix21Sell = useSY319TrendAddons and useTRIX21Addon and sy319SessionOK and tfCtxSell and ta.crossunder(trix21, trix21Sig) and trix21 > -10 and close < ema20
trix34Buy = useSY319TrendAddons and useTRIX34Addon and sy319SessionOK and tfCtxBuy and ta.crossover(trix34, trix34Sig) and trix34 < 10 and close > ema20
trix34Sell = useSY319TrendAddons and useTRIX34Addon and sy319SessionOK and tfCtxSell and ta.crossunder(trix34, trix34Sig) and trix34 > -10 and close < ema20
smi14Buy = useSY319TrendAddons and useSMI14Addon and sy319SessionOK and tfCtxBuy and ta.crossover(smi14, smi14Sig) and smi14 < 20 and close > ema20
smi14Sell = useSY319TrendAddons and useSMI14Addon and sy319SessionOK and tfCtxSell and ta.crossunder(smi14, smi14Sig) and smi14 > -20 and close < ema20
sy319TrendBuy = trix15Buy or smi14Buy or trix21Buy or trix34Buy
sy319TrendSell = trix15Sell or smi14Sell or trix21Sell or trix34Sell

// SY326 VWAP Pullback Add-on:
// Tested with raw 1m signal regeneration. It adds continuation trades only when the fast
// local driver agrees, price has pulled back to VWAP, and then reclaims/rejects VWAP.
sy326VWAPSlope = (ema20 - ema20[5]) / math.max(atr, syminfo.mintick)
sy326DriverBuy = close > ema20 and ema20 >= ema50 and sy326VWAPSlope >= 0.10
sy326DriverSell = close < ema20 and ema20 <= ema50 and sy326VWAPSlope <= -0.10
sy326TouchBuy = ta.lowest(low, sy326VWAPTouchBars) <= vwapVal + atr * sy326VWAPTouchATR
sy326TouchSell = ta.highest(high, sy326VWAPTouchBars) >= vwapVal - atr * sy326VWAPTouchATR
sy326DistVWAP = (close - vwapVal) / math.max(atr, syminfo.mintick)
sy326VWAPBuy = useSY326VWAPPullback and sy326DriverBuy and sy326TouchBuy and close > vwapVal and close > open and rsi14 >= sy326RSIBuyMin and rsi14 <= sy326RSIBuyMax and sy326DistVWAP >= 0 and sy326DistVWAP <= sy326VWAPMaxDistATR
sy326VWAPSell = useSY326VWAPPullback and sy326DriverSell and sy326TouchSell and close < vwapVal and close < open and rsi14 >= sy326RSISellMin and rsi14 <= sy326RSISellMax and sy326DistVWAP <= 0 and sy326DistVWAP >= -sy326VWAPMaxDistATR

// SY327 School 1: CCI20 Pullback.
// A continuation entry after a pullback: CCI leaves oversold/overbought while fast driver agrees.
sy327CCI = ta.cci(hlc3, sy327CCILen)
sy327CCIBuy = useSY327CCI and sy326DriverBuy and ta.crossover(sy327CCI, sy327CCIBuyLevel) and close > ema20 and sy319SessionOK
sy327CCISell = useSY327CCI and sy326DriverSell and ta.crossunder(sy327CCI, sy327CCISellLevel) and close < ema20 and sy319SessionOK

// SY327 School 2: Quiet Range Edge.
// Works only at true range edges, not in the middle. Designed to add trades without chasing trend.
sy327RangeHigh = ta.highest(high, sy327RangeLen)
sy327RangeLow = ta.lowest(low, sy327RangeLen)
sy327Range = math.max(sy327RangeHigh - sy327RangeLow, syminfo.mintick)
sy327RangeATR = sy327Range / math.max(atr, syminfo.mintick)
sy327RangePos = (close - sy327RangeLow) / sy327Range * 100.0
sy327Quiet = sy327RangeATR < sy327MaxRangeATR
sy327RangeBuy = useSY327QuietRange and sy327Quiet and sy327RangePos < sy327BuyEdge and stoch10 < 30 and stoch10 > stoch10D and close > open and closePosBuy > 0.55
sy327RangeSell = useSY327QuietRange and sy327Quiet and sy327RangePos > sy327SellEdge and stoch10 > 70 and stoch10 < stoch10D and close < open and closePosSell > 0.55

// SY328 School 1: Range Edge-to-Mid.
// This is not a market-avoid filter. It actively trades bad/choppy market at the edges
// and targets the return toward the middle, instead of using trend logic inside chop.
sy328RangeHigh = ta.highest(high, sy328RangeLen)
sy328RangeLow = ta.lowest(low, sy328RangeLen)
sy328Range = math.max(sy328RangeHigh - sy328RangeLow, syminfo.mintick)
sy328RangeATR = sy328Range / math.max(atr, syminfo.mintick)
sy328RangePos = (close - sy328RangeLow) / sy328Range * 100.0
sy328RangeEdgeBuy = useSY328RangeEdgeToMid and sy328RangeATR < sy328MaxRangeATR and sy328RangePos < sy328BuyEdge and close > open and stoch10 > stoch10D and sy319SessionOK
sy328RangeEdgeSell = useSY328RangeEdgeToMid and sy328RangeATR < sy328MaxRangeATR and sy328RangePos > sy328SellEdge and close < open and stoch10 < stoch10D and sy319SessionOK

// SY328 School 2: Ichimoku Tenkan/Kijun Cross.
// Faster trend-switch school that catches direction changes without waiting for the old big HTF.
sy328Tenkan = (ta.highest(high, sy328TenkanLen) + ta.lowest(low, sy328TenkanLen)) / 2.0
sy328Kijun = (ta.highest(high, sy328KijunLen) + ta.lowest(low, sy328KijunLen)) / 2.0
sy328IchiBuy = useSY328Ichimoku and ta.crossover(sy328Tenkan, sy328Kijun) and close > ema50 and sy319SessionOK
sy328IchiSell = useSY328Ichimoku and ta.crossunder(sy328Tenkan, sy328Kijun) and close < ema50 and sy319SessionOK

// SY331 Side-Specific Schools:
// Instead of using the same school pack for BUY and SELL, this version uses different
// best-tested schools for each side.
// BUY pack: BB 2.5 mean reversion + Donchian30 false-break + fast Range20/40 edge.
// SELL pack: slow/medium range-edge shorts only.
sy331Stoch5Low = ta.lowest(low, 5)
sy331Stoch5High = ta.highest(high, 5)
sy331Stoch5 = (close - sy331Stoch5Low) / math.max(sy331Stoch5High - sy331Stoch5Low, syminfo.mintick) * 100.0
sy331Stoch5D = ta.sma(sy331Stoch5, 3)

sy331BBBasis = ta.sma(close, 20)
sy331BBDev = ta.stdev(close, 20)
sy331BBLower25 = sy331BBBasis - sy331BBDev * 2.5
sy331BBBuy = useSY331BuySchools and low < sy331BBLower25 and close > sy331BBLower25 and close > open and rsi14 < 46 and sy319SessionOK

sy331Don30High = ta.highest(high, 30)
sy331Don30Low = ta.lowest(low, 30)
sy331Don30Range = math.max(sy331Don30High - sy331Don30Low, syminfo.mintick)
sy331Don30Pos = (close - sy331Don30Low) / sy331Don30Range * 100.0
sy331Don30Buy = useSY331BuySchools and low < sy331Don30Low[1] and close > sy331Don30Low[1] and close > open and sy331Don30Pos < 35 and sy319SessionOK

sy331Range20High = ta.highest(high, 20)
sy331Range20Low = ta.lowest(low, 20)
sy331Range20 = math.max(sy331Range20High - sy331Range20Low, syminfo.mintick)
sy331Range20ATR = sy331Range20 / math.max(atr, syminfo.mintick)
sy331Range20Pos = (close - sy331Range20Low) / sy331Range20 * 100.0
sy331Range20Buy = useSY331BuySchools and sy331Range20ATR < 5.67 and sy331Range20Pos < 10 and close > open and sy331Stoch5 > sy331Stoch5D and sy319SessionOK

sy331Range40High = ta.highest(high, 40)
sy331Range40Low = ta.lowest(low, 40)
sy331Range40 = math.max(sy331Range40High - sy331Range40Low, syminfo.mintick)
sy331Range40ATR = sy331Range40 / math.max(atr, syminfo.mintick)
sy331Range40Pos = (close - sy331Range40Low) / sy331Range40 * 100.0
sy331Range40Buy = useSY331BuySchools and sy331Range40ATR < 6.33 and sy331Range40Pos < 10 and close > open and sy331Stoch5 > sy331Stoch5D and sy319SessionOK

sy331Range160High = ta.highest(high, 160)
sy331Range160Low = ta.lowest(low, 160)
sy331Range160 = math.max(sy331Range160High - sy331Range160Low, syminfo.mintick)
sy331Range160ATR = sy331Range160 / math.max(atr, syminfo.mintick)
sy331Range160Pos = (close - sy331Range160Low) / sy331Range160 * 100.0
sy331Range160Sell = useSY331SellSchools and sy331Range160ATR < 11.40 and sy331Range160Pos > 88 and close < open and stoch10 < stoch10D and sy319SessionOK

sy331Range30High = ta.highest(high, 30)
sy331Range30Low = ta.lowest(low, 30)
sy331Range30 = math.max(sy331Range30High - sy331Range30Low, syminfo.mintick)
sy331Range30ATR = sy331Range30 / math.max(atr, syminfo.mintick)
sy331Range30Pos = (close - sy331Range30Low) / sy331Range30 * 100.0
sy331Range30Sell = useSY331SellSchools and sy331Range30ATR < 6.20 and sy331Range30Pos > 88 and close < open and stoch10 < stoch10D and sy319SessionOK

sy331Range50High = ta.highest(high, 50)
sy331Range50Low = ta.lowest(low, 50)
sy331Range50 = math.max(sy331Range50High - sy331Range50Low, syminfo.mintick)
sy331Range50ATR = sy331Range50 / math.max(atr, syminfo.mintick)
sy331Range50Pos = (close - sy331Range50Low) / sy331Range50 * 100.0
sy331Range50Sell = useSY331SellSchools and sy331Range50ATR < 7.00 and sy331Range50Pos > 88 and close < open and stoch10 < stoch10D and sy319SessionOK

sy331Range100High = ta.highest(high, 100)
sy331Range100Low = ta.lowest(low, 100)
sy331Range100 = math.max(sy331Range100High - sy331Range100Low, syminfo.mintick)
sy331Range100ATR = sy331Range100 / math.max(atr, syminfo.mintick)
sy331Range100Pos = (close - sy331Range100Low) / sy331Range100 * 100.0
sy331Range100Sell = useSY331SellSchools and sy331Range100ATR < 8.33 and sy331Range100Pos > 86 and close < open and sy331Stoch5 < sy331Stoch5D and sy319SessionOK

sy331Range30XSell = useSY331SellSchools and sy331Range30ATR < 6.00 and sy331Range30Pos > 86 and close < open and sy331Stoch5 < sy331Stoch5D and sy319SessionOK

sy331Range40XSell = useSY331SellSchools and sy331Range40ATR < 6.33 and sy331Range40Pos > 86 and close < open and sy331Stoch5 < sy331Stoch5D and sy319SessionOK

sy331Buy = sy331BBBuy or sy331Don30Buy or sy331Range20Buy or sy331Range40Buy
sy331Sell = sy331Range160Sell or sy331Range30Sell or sy331Range50Sell or sy331Range100Sell or sy331Range30XSell or sy331Range40XSell

// SY336: signals that are controlled directly by the new type settings.
// This fixes the old problem where legacy signals could enter before the new schools,
// making user setting changes feel like they do not affect results.
// SY336 optimized internal add-ons.
// These are the best internal settings found from 313 schools and 154k+ raw close-entry tests.
sy336VWAPDev50 = ta.stdev(hlc3 - vwapVal, 50)
sy336VWAPLower16 = vwapVal - sy336VWAPDev50 * 1.6
sy336VWAPLower20 = vwapVal - sy336VWAPDev50 * 2.0
sy336VWAPUpper20 = vwapVal + sy336VWAPDev50 * 2.0

sy336VWAPZBuy16 = useSY336Best and sy336UseVWAPZ and low < sy336VWAPLower16 and close > sy336VWAPLower16 and close > open
sy336VWAPZBuy20 = useSY336Best and sy336UseVWAPZ and low < sy336VWAPLower20 and close > sy336VWAPLower20 and close > open
sy336VWAPZSell20 = useSY336Best and sy336UseVWAPZ and high > sy336VWAPUpper20 and close < sy336VWAPUpper20 and close < open

sy336VWAPPullBuy = useSY336Best and sy336UseVWAPPull and ema20 > ema50 and close > vwapVal and low <= vwapVal + atr * 0.25 and close > open

sy336R80High = ta.highest(high, 80)
sy336R80Low = ta.lowest(low, 80)
sy336R80 = math.max(sy336R80High - sy336R80Low, syminfo.mintick)
sy336R80Pos = (close - sy336R80Low) / sy336R80 * 100.0
sy336R80ATR = sy336R80 / math.max(atr, syminfo.mintick)
sy336Range80Buy = useSY336Best and sy336UseRangeBuy and sy336R80ATR < 10.0 and sy336R80Pos < 22 and close > open and sy331Stoch5 > sy331Stoch5D

sy336R60High = ta.highest(high, 60)
sy336R60Low = ta.lowest(low, 60)
sy336R60 = math.max(sy336R60High - sy336R60Low, syminfo.mintick)
sy336R60Pos = (close - sy336R60Low) / sy336R60 * 100.0
sy336R60ATR = sy336R60 / math.max(atr, syminfo.mintick)
sy336Range60Buy = useSY336Best and sy336UseRangeBuy and sy336R60ATR < 8.0 and sy336R60Pos < 12 and close > open and sy331Stoch5 > sy331Stoch5D
sy336Range60Sell = useSY336Best and sy336UseSellRange and sy336R60ATR < 8.0 and sy336R60Pos > 90 and close < open and sy331Stoch5 < sy331Stoch5D

sy336VolMA50 = ta.sma(volume, 50)
sy336MacdVolBuy = useSY336Best and sy336UseMacdVol and ta.crossover(macdHist, 0) and volume > sy336VolMA50 * 1.1 and close > open

sy336KeltMid80 = ta.ema(hlc3, 80)
sy336KeltAtr80 = ta.rma(ta.tr(true), 80)
sy336KeltUpper80 = sy336KeltMid80 + sy336KeltAtr80 * 1.5
sy336KeltSell = useSY336Best and sy336UseKeltnerSell and high > sy336KeltUpper80 and close < sy336KeltUpper80 and close < open

sy336NYIn = not na(time(timeframe.period, "1330-1400", sy319SessionTz))
sy336NYAfter = not na(time(timeframe.period, "1400-1730", sy319SessionTz))
sy336LONIn = not na(time(timeframe.period, "0800-0830", sy319SessionTz))
sy336LONAfter = not na(time(timeframe.period, "0830-1200", sy319SessionTz))
sy336NewDay = ta.change(time("D")) != 0

var float sy336NYHi = na
var float sy336NYLo = na
var float sy336LONHi = na
var float sy336LONLo = na
if sy336NewDay
    sy336NYHi := na
    sy336NYLo := na
    sy336LONHi := na
    sy336LONLo := na
if sy336NYIn
    sy336NYHi := na(sy336NYHi) ? high : math.max(sy336NYHi, high)
    sy336NYLo := na(sy336NYLo) ? low : math.min(sy336NYLo, low)
if sy336LONIn
    sy336LONHi := na(sy336LONHi) ? high : math.max(sy336LONHi, high)
    sy336LONLo := na(sy336LONLo) ? low : math.min(sy336LONLo, low)

sy336NYBreakBuy = useSY336Best and sy336UseNYORB and sy336NYAfter and not na(sy336NYHi) and close > sy336NYHi and close > open
sy336NYFakeSell = useSY336Best and sy336UseNYFake and sy336NYAfter and not na(sy336NYHi) and high > sy336NYHi and close < sy336NYHi and close < open
sy336LONRetestSell = useSY336Best and sy336UseLONORB and sy336LONAfter and not na(sy336LONLo) and close < sy336LONLo and high >= sy336LONLo - atr * 0.20 and close < open

sy336BuyBest = sy336VWAPZBuy16 or sy336VWAPZBuy20 or sy336VWAPPullBuy or sy336Range80Buy or sy336Range60Buy or sy336MacdVolBuy or sy336NYBreakBuy
sy336SellBest = sy336VWAPZSell20 or sy336Range60Sell or sy336KeltSell or sy336LONRetestSell or sy336NYFakeSell

sy334BuyRangeRaw = sy331BBBuy or sy331Range20Buy or sy331Range40Buy
sy334BuySweepRaw = sy331Don30Buy
sy334BuyTrendRaw = sy319TrendBuy or sy326VWAPBuy or sy328IchiBuy or sy336BuyBest

sy334SellRangeRaw = sy331Sell
sy334Don30Sell = useSY331SellSchools and high > sy331Don30High[1] and close < sy331Don30High[1] and close < open and sy331Don30Pos > 65 and sy319SessionOK
sy334SellSweepRaw = sy334Don30Sell
sy334SellTrendRaw = sy319TrendSell or sy326VWAPSell or sy328IchiSell or sy336SellBest

sy334BuyRange = sy334UseBuyRange and sy334BuyRangeRaw
sy334BuySweep = sy334UseBuySweep and sy334BuySweepRaw
sy334BuyTrend = sy334UseBuyTrend and sy334BuyTrendRaw
sy334SellRange = sy334UseSellRange and sy334SellRangeRaw
sy334SellSweep = sy334UseSellSweep and sy334SellSweepRaw
sy334SellTrend = sy334UseSellTrend and sy334SellTrendRaw

sy334TypeBuy = sy334BuySweep or sy334BuyRange or sy334BuyTrend
sy334TypeSell = sy334SellSweep or sy334SellRange or sy334SellTrend

sy315WebBuy = qqe28Buy or vortex14Buy or don70Buy or don200Buy or bb34SqueezeBuy or sy319TrendBuy or sy326VWAPBuy or sy327CCIBuy or sy327RangeBuy or sy328RangeEdgeBuy or sy328IchiBuy or sy331Buy
sy315WebSell = qqe28Sell or vortex14Sell or don70Sell or don200Sell or bb34SqueezeSell or sy319TrendSell or sy326VWAPSell or sy327CCISell or sy327RangeSell or sy328IchiSell or sy331Sell

extraBuyVotes = (quadBuy ? 1.0 : 0.0) + (rsi14ShiftBuy ? 1.0 : 0.0) + (bbkcBuy ? 1.0 : 0.0)
extraSellVotes = (quadSell ? 1.0 : 0.0) + (rsi14ShiftSell ? 1.0 : 0.0) + (bbkcSell ? 1.0 : 0.0)

bestNetBuy = (((baseBuy or quadBuy or rsi14ShiftBuy or bbkcBuy) and stochGuardBuy) or trendCorrBuy or sy315WebBuy)
bestNetSell = (((baseSell or quadSell or rsi14ShiftSell or bbkcSell) and stochGuardSell) or trendCorrSell or sy315WebSell)
higherWRBuy = (((baseBuy or quadBuy or rsi14ShiftBuy) and rsi28 < 72 and atrRatio >= 0.18 and atrRatio <= 3.6 and stochGuardBuy) or trendCorrBuy or sy315WebBuy)
higherWRSell = (((baseSell or quadSell or rsi14ShiftSell) and rsi28 > 28 and atrRatio >= 0.18 and atrRatio <= 3.6 and stochGuardSell) or trendCorrSell or sy315WebSell)
moreTradesBuy = (((baseBuy or quadBuy or rsi14ShiftBuy or bbkcBuy or (extraBuyVotes >= minVotes and close > ema20)) and stochGuardBuy) or trendCorrBuy or sy315WebBuy)
moreTradesSell = (((baseSell or quadSell or rsi14ShiftSell or bbkcSell or (extraSellVotes >= minVotes and close < ema20)) and stochGuardSell) or trendCorrSell or sy315WebSell)

rawBuy0 = useResearchGate ? (mode == "Higher WR" ? higherWRBuy : mode == "More Trades" ? moreTradesBuy : bestNetBuy) : baseBuy
rawSell0 = useResearchGate ? (mode == "Higher WR" ? higherWRSell : mode == "More Trades" ? moreTradesSell : bestNetSell) : baseSell

// HTF Master Guard Fix:
// In SY305 the research modules could fire by themselves and bypass the larger map,
// so the indicator sometimes followed the 1m micro trend against 5m/15m/60m.
// This guard blocks the wrong side whenever HTF score is clearly opposite,
// except for a real liquidity sweep reversal from premium/discount with a rejection candle.
counterBuyZoneOK = not counterNeedsZone or discount or rangePos <= 30
counterSellZoneOK = not counterNeedsZone or premium or rangePos >= 70
counterBuyCandleOK = not counterNeedsCandle or bullReject or bullMomentum
counterSellCandleOK = not counterNeedsCandle or bearReject or bearMomentum
counterBuyAllowed = allowCounterReversal and realRevBuy and sweepLow and counterBuyZoneOK and counterBuyCandleOK
counterSellAllowed = allowCounterReversal and realRevSell and sweepHigh and counterSellZoneOK and counterSellCandleOK
wrongBuyHTF = htfScore <= -htfBlockLevel
wrongSellHTF = htfScore >= htfBlockLevel
htfBuyOK = not useHTFMasterGuard or not wrongBuyHTF or counterBuyAllowed
htfSellOK = not useHTFMasterGuard or not wrongSellHTF or counterSellAllowed

// SY320 Phase Error Guard:
// This was discovered from visual candle review + rule testing. It does not replace SY319; it removes the weakest entry pockets.
// 1) Block the weak opposite HTF pocket, where the signal fights the map just enough to be dangerous.
// 2) Block SELL while TRIX34 momentum is still clearly rising.
// 3) Block the tested weak SELL hour pocket.
trix34Diff = trix34 - trix34Sig
sy320WeakOppBuy = htfScore <= -0.5 and htfScore >= -2.0
sy320WeakOppSell = htfScore >= 0.5 and htfScore <= 2.0
sy320WeakHTFBlockBuy = useSY320PhaseGuard and useSY320WeakHTFBlock and sy320WeakOppBuy and not counterBuyAllowed
sy320WeakHTFBlockSell = useSY320PhaseGuard and useSY320WeakHTFBlock and sy320WeakOppSell and not counterSellAllowed
sy320SellTrixBlock = useSY320PhaseGuard and useSY320SellTrixBlock and trix34Diff >= sy320Trix34BlockLevel and not counterSellAllowed
sy320SellHourActive = not na(time(timeframe.period, sy320SellHourSession, sy320HourTz))
sy320SellHourBlock = useSY320PhaseGuard and useSY320SellHourBlock and sy320SellHourActive and not counterSellAllowed
sy320BuyOK = not sy320WeakHTFBlockBuy
sy320SellOK = not sy320WeakHTFBlockSell and not sy320SellTrixBlock and not sy320SellHourBlock

// SY323 Robust Market State Guard:
// Robust version: keeps trade count near 10/day while improving monthly stability. Default blocks weak/dead market, shock block is optional.
// 1) Dead ATR + weak HTF: market is too quiet and the map is not helping the trade direction.
// 2) Optional Shock ATR: ATR is too expanded versus its average, where 1m signals can be late/choppy.
sy322ShockBlock = useSY322RegimeGuard and useSY322ShockATRBlock and atrRatio >= sy322MaxAtrRatio
sy322DeadWeakBuy = useSY322RegimeGuard and useSY322DeadATRWeakHTF and atrRatio <= sy322DeadAtrRatio and htfScore <= 0
sy322DeadWeakSell = useSY322RegimeGuard and useSY322DeadATRWeakHTF and atrRatio <= sy322DeadAtrRatio and htfScore >= 0
sy322BuyOK = not sy322ShockBlock and not sy322DeadWeakBuy
sy322SellOK = not sy322ShockBlock and not sy322DeadWeakSell

// SY324 Quiet Market / Stale HTF Fix:
// Problem seen on 1m screenshots: after a large impulse, HTF score can stay bullish/bearish
// while price compresses in the middle of the impulse box. In that state pullback signals
// often fire against the current local flow. This block pauses BOTH directions until price
// leaves the middle compression or a real new impulse appears.
sy324ImpulseHigh = ta.highest(high, sy324ImpulseLookback)
sy324ImpulseLow = ta.lowest(low, sy324ImpulseLookback)
sy324ImpulseRange = math.max(sy324ImpulseHigh - sy324ImpulseLow, syminfo.mintick)
sy324CompressionHigh = ta.highest(high, sy324CompressionLookback)
sy324CompressionLow = ta.lowest(low, sy324CompressionLookback)
sy324CompressionRange = math.max(sy324CompressionHigh - sy324CompressionLow, syminfo.mintick)
sy324ImpulseATR = sy324ImpulseRange / math.max(atr, syminfo.mintick)
sy324CompressionRatio = sy324CompressionRange / sy324ImpulseRange
sy324ImpulsePos = (close - sy324ImpulseLow) / sy324ImpulseRange * 100.0
sy324PostImpulseQuiet = useSY324QuietFix and sy324ImpulseATR >= sy324MinImpulseATR and sy324CompressionRatio <= sy324MaxCompression and sy324ImpulsePos >= sy324MiddleMin and sy324ImpulsePos <= sy324MiddleMax
sy324QuietOK = not sy324PostImpulseQuiet

// SY325 Fast Trend Driver:
// The older versions could keep BUY bias from a larger HTF after the 1m trend already turned down.
// This driver is closer to price: EMA20 slope + EMA20/EMA50 phase on the active 1m chart.
// It blocks BOTH directions only when the fast local driver is clearly opposite.
// Real sweep reversals can still pass if enabled.
sy325EmaSlope = (ema20 - ema20[sy325DriverBars]) / math.max(atr, syminfo.mintick)
sy325DriverBuy = close > ema20 and sy325EmaSlope >= sy325DriverSlopeATR and (not sy325UseEMA50 or ema20 >= ema50)
sy325DriverSell = close < ema20 and sy325EmaSlope <= -sy325DriverSlopeATR and (not sy325UseEMA50 or ema20 <= ema50)
sy325BuyAgainstDriver = useSY325FastDriver and sy325DriverSell and not (sy325AllowRealReversal and realRevBuy)
sy325SellAgainstDriver = useSY325FastDriver and sy325DriverBuy and not (sy325AllowRealReversal and realRevSell)
sy325BuyOK = not sy325BuyAgainstDriver
sy325SellOK = not sy325SellAgainstDriver

legacyRawBuy = rawBuy0 and htfBuyOK and sy320BuyOK and sy322BuyOK and sy324QuietOK and sy325BuyOK
legacyRawSell = rawSell0 and htfSellOK and sy320SellOK and sy322SellOK and sy324QuietOK and sy325SellOK

typeGuardBuy = not sy334ApplyOldGuardsToType or (htfBuyOK and sy320BuyOK and sy322BuyOK and sy324QuietOK and sy325BuyOK)
typeGuardSell = not sy334ApplyOldGuardsToType or (htfSellOK and sy320SellOK and sy322SellOK and sy324QuietOK and sy325SellOK)
typeRawBuy = sy334TypeBuy and typeGuardBuy
typeRawSell = sy334TypeSell and typeGuardSell

oldRawBuy = sy334Engine == "Legacy Only" ? legacyRawBuy : sy334Engine == "Type + Legacy" ? (typeRawBuy or legacyRawBuy) : typeRawBuy
oldRawSell = sy334Engine == "Legacy Only" ? legacyRawSell : sy334Engine == "Type + Legacy" ? (typeRawSell or legacyRawSell) : typeRawSell

// SY349 Active Router from the fixed 40/50 search:
// IMPORTANT: inputs below are tied directly to the signal. If you switch a module OFF, it cannot create entries.
// Mode also changes the router if "Mode Changes Router Sensitivity" is ON.
sy339IsHigherWR = mode == "Higher WR"
sy339IsMoreTrades = mode == "More Trades"
sy339ModeLateMult = not sy337RouterModeAffects ? 1.0 : sy339IsHigherWR ? 0.72 : sy339IsMoreTrades ? 1.35 : 1.0
sy339ModeCooldownAdd = not sy337RouterModeAffects ? 0 : sy339IsHigherWR ? 8 : sy339IsMoreTrades ? -2 : 0
sy339EffMaxLateMovePts = math.max(10.0, sy337MaxLateMovePts * sy339ModeLateMult)
sy339EffCooldown = math.max(0, sy337Cooldown + sy339ModeCooldownAdd)
sy339EffLossCooldown = math.max(0, sy337LossCooldown + (not sy337RouterModeAffects ? 0 : sy339IsHigherWR ? 10 : sy339IsMoreTrades ? -5 : 0))

sy337UpMovePts = (close - ta.lowest(low, sy337LateLookback)) / pointUnit
sy337DownMovePts = (ta.highest(high, sy337LateLookback) - close) / pointUnit
sy337BuyLate = sy337UseNotLate and sy337UpMovePts > sy339EffMaxLateMovePts and rangePos > 45
sy337SellLate = sy337UseNotLate and sy337DownMovePts > sy339EffMaxLateMovePts and rangePos < 55
sy337NotLateBuy = not sy337BuyLate
sy337NotLateSell = not sy337SellLate

sy337BuyCore = (sy337BuyUseVWAPPull and sy326VWAPBuy) or (sy337BuyUseVWAPPull and sy336VWAPPullBuy) or (sy337BuyUseSweep and sy334BuySweepRaw) or (sy337BuyUseDon200 and don200Buy) or (sy337BuyUseRealRev and realRevBuy) or (sy337BuyUseVWAPZ and (sy336VWAPZBuy16 or sy336VWAPZBuy20)) or (sy337BuyUseBase and baseBuy)
sy337SellCore = (sy337SellUseSweep and sy334SellSweepRaw) or (sy337SellUseRange and sy334SellRangeRaw) or (sy337SellUseTrend and sy334SellTrendRaw) or (sy337SellUseSY336Best and sy336SellBest) or (sy337SellUseBase and baseSell)
sy337RawBuy = tradeableBase and sy337BuyCore and sy337NotLateBuy
sy337RawSell = tradeableBase and sy337SellCore and sy337NotLateSell

// SY338 Strong Trend Anti-Reversal Guard:
// Problem fixed: in a strong trend, a tiny 1m correction/rejection could trigger a countertrend signal.
// Now countertrend is blocked unless it is a real reversal: HTF extreme zone + liquidity sweep + rejection + optional M1 MSS.
sy338MSSBuy = close > ta.highest(high, sy338MSSLen)[1]
sy338MSSSell = close < ta.lowest(low, sy338MSSLen)[1]
sy338FastDriverBuy = close > ema20 and ema20 >= ema50 and sy325EmaSlope >= sy325DriverSlopeATR
sy338FastDriverSell = close < ema20 and ema20 <= ema50 and sy325EmaSlope <= -sy325DriverSlopeATR
// Higher WR blocks countertrend earlier. More Trades lets more countertrend attempts pass.
sy339EffTrendScoreLevel = not sy337RouterModeAffects ? sy338TrendScoreLevel : sy339IsHigherWR ? math.max(1.0, sy338TrendScoreLevel - 0.5) : sy339IsMoreTrades ? math.min(4.5, sy338TrendScoreLevel + 0.5) : sy338TrendScoreLevel
sy338StrongUp = useSY338TrendGuard and htfScore >= sy339EffTrendScoreLevel and tf5Dir == 1 and tf15Dir == 1 and (not sy338RequireFastDriver or sy338FastDriverBuy)
sy338StrongDown = useSY338TrendGuard and htfScore <= -sy339EffTrendScoreLevel and tf5Dir == -1 and tf15Dir == -1 and (not sy338RequireFastDriver or sy338FastDriverSell)

sy338TrueCounterBuy = rangePos <= sy338CounterBuyMaxRange and bullReject and (not sy338AllowCounterOnlyWithSweep or (sweepLow and realRevBuy)) and (not sy338RequireCounterMSS or sy338MSSBuy)
sy338TrueCounterSell = rangePos >= sy338CounterSellMinRange and bearReject and (not sy338AllowCounterOnlyWithSweep or (sweepHigh and realRevSell)) and (not sy338RequireCounterMSS or sy338MSSSell)

// SY349 protection from SY130:
// Uses only confirmed signals. HTF values are pulled from the previous closed HTF candle, so they do not repaint.
[sy130LocalRPDir, sy130RPLine] = f_sy130_rp_dir()
[sy130LocalATRDir, sy130ATRUpLine, sy130ATRDnLine] = f_sy130_ualgo_dir()
sy130HTFRPDir = request.security(syminfo.tickerid, sy130ProtectTF, f_sy130_rp_dir_only()[1], barmerge.gaps_off, barmerge.lookahead_on)
sy130HTFATRDir = request.security(syminfo.tickerid, sy130ProtectTF, f_sy130_ualgo_dir_only()[1], barmerge.gaps_off, barmerge.lookahead_on)

[hiddenFibBuyOK, hiddenFibSellOK, hiddenFibInBuyZone, hiddenFibInSellZone, hiddenFibDir] = request.security(syminfo.tickerid, hiddenFibTF, f_hidden_fib_assist(), barmerge.gaps_off, barmerge.lookahead_off)

hiddenFibActive = hiddenFibMode != "Off" and hiddenFibUseRealAssist
hiddenFibBuyTouch = hiddenFibBuyOK or hiddenFibInBuyZone
hiddenFibSellTouch = hiddenFibSellOK or hiddenFibInSellZone
hiddenFibBarsSinceBuy = ta.barssince(hiddenFibBuyTouch)
hiddenFibBarsSinceSell = ta.barssince(hiddenFibSellTouch)
hiddenFibBuyRecent = hiddenFibActive and not na(hiddenFibBarsSinceBuy) and hiddenFibBarsSinceBuy <= hiddenFibValidBars
hiddenFibSellRecent = hiddenFibActive and not na(hiddenFibBarsSinceSell) and hiddenFibBarsSinceSell <= hiddenFibValidBars
hiddenFibBuyAfterPts = (close - ta.lowest(low, hiddenFibValidBars)) / pointUnit
hiddenFibSellAfterPts = (ta.highest(high, hiddenFibValidBars) - close) / pointUnit
hiddenFibBuyNotLate = hiddenFibBuyAfterPts <= hiddenFibMaxLatePoints
hiddenFibSellNotLate = hiddenFibSellAfterPts <= hiddenFibMaxLatePoints


[hiddenLiqFastBuyRaw, hiddenLiqFastSellRaw, hiddenLiqFastPrevLow, hiddenLiqFastPrevHigh] = request.security(syminfo.tickerid, hiddenLiqFastTF, f_hidden_liq_sweep_assist(), barmerge.gaps_off, barmerge.lookahead_off)
[hiddenLiqSlowBuyRaw, hiddenLiqSlowSellRaw, hiddenLiqSlowPrevLow, hiddenLiqSlowPrevHigh] = request.security(syminfo.tickerid, hiddenLiqSlowTF, f_hidden_liq_sweep_assist(), barmerge.gaps_off, barmerge.lookahead_off)

hiddenLiqBuyTouch = hiddenLiqUseAssist and (hiddenLiqFastBuyRaw or hiddenLiqSlowBuyRaw)
hiddenLiqSellTouch = hiddenLiqUseAssist and (hiddenLiqFastSellRaw or hiddenLiqSlowSellRaw)
hiddenLiqBarsSinceBuy = ta.barssince(hiddenLiqBuyTouch)
hiddenLiqBarsSinceSell = ta.barssince(hiddenLiqSellTouch)
hiddenLiqBuyRecent = hiddenLiqUseAssist and not na(hiddenLiqBarsSinceBuy) and hiddenLiqBarsSinceBuy <= hiddenLiqValidBars
hiddenLiqSellRecent = hiddenLiqUseAssist and not na(hiddenLiqBarsSinceSell) and hiddenLiqBarsSinceSell <= hiddenLiqValidBars

hiddenLiqBuyAfterPts = (close - ta.lowest(low, hiddenLiqValidBars)) / pointUnit
hiddenLiqSellAfterPts = (ta.highest(high, hiddenLiqValidBars) - close) / pointUnit
hiddenLiqBuyNotLate = hiddenLiqBuyAfterPts <= hiddenLiqMaxLatePoints
hiddenLiqSellNotLate = hiddenLiqSellAfterPts <= hiddenLiqMaxLatePoints



sy130BuyVotes = (sy130UseRP and sy130LocalRPDir == 1 ? 1 : 0) + (sy130UseATRTrend and sy130LocalATRDir == 1 ? 1 : 0) + (sy130UseRP and sy130HTFRPDir == 1 ? 1 : 0) + (sy130UseATRTrend and sy130HTFATRDir == 1 ? 1 : 0)
sy130SellVotes = (sy130UseRP and sy130LocalRPDir == -1 ? 1 : 0) + (sy130UseATRTrend and sy130LocalATRDir == -1 ? 1 : 0) + (sy130UseRP and sy130HTFRPDir == -1 ? 1 : 0) + (sy130UseATRTrend and sy130HTFATRDir == -1 ? 1 : 0)
sy130TrendUp = useSY130TrendProtect and sy130BuyVotes >= sy130MinVotes and sy130BuyVotes > sy130SellVotes
sy130TrendDown = useSY130TrendProtect and sy130SellVotes >= sy130MinVotes and sy130SellVotes > sy130BuyVotes

sy130ProtectOff = not useSY130TrendProtect or sy130ProtectMode == "Off" or sy130ProtectMode == "Assist Only"
sy130BuyAllowed = sy130ProtectOff or (sy130ProtectMode == "Block Countertrend" ? (not sy130TrendDown or sy338TrueCounterBuy) : (sy130TrendUp or sy338TrueCounterBuy))
sy130SellAllowed = sy130ProtectOff or (sy130ProtectMode == "Block Countertrend" ? (not sy130TrendUp or sy338TrueCounterSell) : (sy130TrendDown or sy338TrueCounterSell))
sy130BlockBuy = useSY130TrendProtect and not sy130BuyAllowed
sy130BlockSell = useSY130TrendProtect and not sy130SellAllowed

sy360FibCounterBuyOK = hiddenFibMode != "Off" and hiddenFibCanBypassTrendBlock and hiddenFibBuyOK
sy360FibCounterSellOK = hiddenFibMode != "Off" and hiddenFibCanBypassTrendBlock and hiddenFibSellOK

sy338BlockBuyAgainstDownTrend = sy338StrongDown and not (sy338TrueCounterBuy or sy360FibCounterBuyOK)
sy338BlockSellAgainstUpTrend = sy338StrongUp and not (sy338TrueCounterSell or sy360FibCounterSellOK)


// SY360 Real Hidden Fib Assist for M1:
// Fib cannot enter alone by default. It only boosts a near-valid SY356 story after a recent hidden Fib touch.
// This keeps the chart clean and avoids turning the system into a standalone Fib indicator.
sy360FibM1ReactionBuy = not hiddenFibNeedM1Reaction or bullReject or bullMomentum or sweepLow or realRevBuy
sy360FibM1ReactionSell = not hiddenFibNeedM1Reaction or bearReject or bearMomentum or sweepHigh or realRevSell
sy360FibRoomBuy = not hiddenFibNeedRoom or roomBuy
sy360FibRoomSell = not hiddenFibNeedRoom or roomSell

sy360BuyNearSY356Story = hiddenFibEntryAlone ? true : (buyStory or sy326VWAPBuy or sy336VWAPPullBuy or sy334BuySweepRaw or don200Buy or realRevBuy or retestBuy or bullFVG or sy336VWAPZBuy16 or sy336VWAPZBuy20)
sy360SellNearSY356Story = hiddenFibEntryAlone ? true : (sellStory or sy334SellSweepRaw or sy334SellRangeRaw or sy334SellTrendRaw or sy336SellBest or baseSell or realRevSell or retestSell or bearFVG)

sy360FibBoostBuy = hiddenFibActive and hiddenFibBuyRecent and hiddenFibBuyNotLate and sy360BuyNearSY356Story and sy360FibM1ReactionBuy and sy360FibRoomBuy and not (powerDown and not realRevBuy and not sweepLow)
sy360FibBoostSell = hiddenFibActive and hiddenFibSellRecent and hiddenFibSellNotLate and sy360SellNearSY356Story and sy360FibM1ReactionSell and sy360FibRoomSell and not (powerUp and not realRevSell and not sweepHigh)

// SY362 Hidden Liquidity Sweep Assist:
// No lines, no labels. It boosts a near-valid M1 scalp after a closed 5m/15m sweep and reclaim.
sy361LiqM1ReactionBuy = not hiddenLiqNeedM1Reaction or bullReject or bullMomentum or sweepLow or realRevBuy
sy361LiqM1ReactionSell = not hiddenLiqNeedM1Reaction or bearReject or bearMomentum or sweepHigh or realRevSell
sy361LiqRoomBuy = not hiddenLiqNeedRoom or roomBuy
sy361LiqRoomSell = not hiddenLiqNeedRoom or roomSell

sy361BuyNearSY356Story = hiddenLiqEntryAlone ? true : (buyStory or sy326VWAPBuy or sy336VWAPPullBuy or sy334BuySweepRaw or don200Buy or realRevBuy or retestBuy or bullFVG or sy336VWAPZBuy16 or sy336VWAPZBuy20)
sy361SellNearSY356Story = hiddenLiqEntryAlone ? true : (sellStory or sy334SellSweepRaw or sy334SellRangeRaw or sy334SellTrendRaw or sy336SellBest or baseSell or realRevSell or retestSell or bearFVG)

sy361LiqBoostBuy = hiddenLiqBuyRecent and hiddenLiqBuyNotLate and sy361BuyNearSY356Story and sy361LiqM1ReactionBuy and sy361LiqRoomBuy and not (powerDown and not realRevBuy and not sweepLow)
sy361LiqBoostSell = hiddenLiqSellRecent and hiddenLiqSellNotLate and sy361SellNearSY356Story and sy361LiqM1ReactionSell and sy361LiqRoomSell and not (powerUp and not realRevSell and not sweepHigh)

sy967RawBuyBeforeVTZ = useSY337QuickRouter ? (sy337RawBuy or sy360FibBoostBuy or sy361LiqBoostBuy) : (oldRawBuy or sy360FibBoostBuy or sy361LiqBoostBuy)
sy967RawSellBeforeVTZ = useSY337QuickRouter ? (sy337RawSell or sy360FibBoostSell or sy361LiqBoostSell) : (oldRawSell or sy360FibBoostSell or sy361LiqBoostSell)

// SYXAUUSD Transition Zone logic:
// This improves the "area" reading:
// - After upside breakout from compression, weak SELL fades are blocked in the middle.
// - After downside breakout, weak BUY fades are blocked in the middle.
// - Continuation from breakout/retest is allowed.
// - True edge sweep/reversal can still pass.
sy967VTZActive = useVTZ and vtzMode != "Off" and vtzMode != "Assist Only"

// Exceptions are calculated here AFTER the schools exist.
vtzEdgeBuyException = vtzAllowEdgeReversal and (realRevBuy or sweepLow or sy338TrueCounterBuy or sy360FibBoostBuy or sy361LiqBoostBuy) and (discount or vtzLowerRetest)
vtzEdgeSellException = vtzAllowEdgeReversal and (realRevSell or sweepHigh or sy338TrueCounterSell or sy360FibBoostSell or sy361LiqBoostSell) and (premium or vtzUpperRetest)

sy967BuyContinuationOK = not vtzActive or not vtzDown or vtzRetestBuyZone or close > ema20 or bullMomentum or sy130TrendUp
sy967SellContinuationOK = not vtzActive or not vtzUp or vtzRetestSellZone or close < ema20 or bearMomentum or sy130TrendDown

sy967BlockBuyFade = sy967VTZActive and vtzDown and vtzMiddleFadeZone and not vtzEdgeBuyException
sy967BlockSellFade = sy967VTZActive and vtzUp and vtzMiddleFadeZone and not vtzEdgeSellException

sy967BlockLateBuy = sy967VTZActive and vtzLateChase and vtzUp and not vtzRetestBuyZone and not sy360FibBoostBuy and not sy361LiqBoostBuy
sy967BlockLateSell = sy967VTZActive and vtzLateChase and vtzDown and not vtzRetestSellZone and not sy360FibBoostSell and not sy361LiqBoostSell

sy967ZoneGuardBuyOK = not sy967BlockBuyFade and not sy967BlockLateBuy
sy967ZoneGuardSellOK = not sy967BlockSellFade and not sy967BlockLateSell

sy967RetestGuardBuyOK = sy967ZoneGuardBuyOK and sy967BuyContinuationOK
sy967RetestGuardSellOK = sy967ZoneGuardSellOK and sy967SellContinuationOK

sy967VTZBuyOK = not sy967VTZActive ? true : vtzMode == "Retest Guard" ? sy967RetestGuardBuyOK : sy967ZoneGuardBuyOK
sy967VTZSellOK = not sy967VTZActive ? true : vtzMode == "Retest Guard" ? sy967RetestGuardSellOK : sy967ZoneGuardSellOK

rawBuyBeforeTrendGuard = sy967RawBuyBeforeVTZ and sy967VTZBuyOK
rawSellBeforeTrendGuard = sy967RawSellBeforeVTZ and sy967VTZSellOK

// SY354 direct active controls:
// 1) Timeframes / EMA map are active through htfScore and directOppScoreBlock.
// 2) User range gates match your saved SY352 settings: BUY under range %, SELL over range %.
// 3) Premium/Discount direct gate is optional. Default OFF so it does not choke the SY349 feel.
sy354MapBuyOK = not useRealMapDirectGate or htfScore > -directOppScoreBlock or sy338TrueCounterBuy or sweepLow or realRevBuy
sy354MapSellOK = not useRealMapDirectGate or htfScore < directOppScoreBlock or sy338TrueCounterSell or sweepHigh or realRevSell
sy354RangeBuyOK = not sy354UseDirectGates or rangePos <= sy354BuyMaxRange or sweepLow or realRevBuy or retestBuy or bullFVG
sy354RangeSellOK = not sy354UseDirectGates or rangePos >= sy354SellMinRange or sweepHigh or realRevSell or retestSell or bearFVG
sy354PremiumDiscountBuyOK = not useZoneDirectGate or rangePos <= discountLevel or sweepLow or realRevBuy or retestBuy or bullFVG
sy354PremiumDiscountSellOK = not useZoneDirectGate or rangePos >= premiumLevel or sweepHigh or realRevSell or retestSell or bearFVG
sy354CandleBuyOK = not useCandleDirectGate or not sy354RequireReaction or bullReject or bullMomentum or realRevBuy or sweepLow
sy354CandleSellOK = not useCandleDirectGate or not sy354RequireReaction or bearReject or bearMomentum or realRevSell or sweepHigh

// Hidden Fib Assist is internal only: no lines, no boxes, no labels.
// SY358 adds a strength score so Fib helps only where it matters: weak middle entries.
hiddenFibOffOrAssist = hiddenFibMode == "Off" or hiddenFibMode == "Assist Only"

sy358MiddleLow = math.min(hiddenFibMiddleLow, hiddenFibMiddleHigh)
sy358MiddleHigh = math.max(hiddenFibMiddleLow, hiddenFibMiddleHigh)
sy358InMiddle = not na(rangePos) and rangePos >= sy358MiddleLow and rangePos <= sy358MiddleHigh

sy358BuyAssistStory = sweepLow or realRevBuy or retestBuy or bullFVG
sy358SellAssistStory = sweepHigh or realRevSell or retestSell or bearFVG

sy358FibBuyScore = (hiddenFibBuyOK ? 2 : hiddenFibInBuyZone ? 1 : 0) + (sy358BuyAssistStory ? 1 : 0) + (htfScore >= 0 ? 1 : 0) + (rangePos <= hiddenFibBuyMaxNoFib ? 1 : 0)
sy358FibSellScore = (hiddenFibSellOK ? 2 : hiddenFibInSellZone ? 1 : 0) + (sy358SellAssistStory ? 1 : 0) + (htfScore <= 0 ? 1 : 0) + (rangePos >= hiddenFibSellMinNoFib ? 1 : 0)

sy358SmartBuyOK = not sy358InMiddle or sy358FibBuyScore >= hiddenFibMinScore
sy358SmartSellOK = not sy358InMiddle or sy358FibSellScore >= hiddenFibMinScore

sy358OldMiddleBuyOK = hiddenFibBuyOK or sy358BuyAssistStory or na(rangePos) or rangePos <= hiddenFibBuyMaxNoFib
sy358OldMiddleSellOK = hiddenFibSellOK or sy358SellAssistStory or na(rangePos) or rangePos >= hiddenFibSellMinNoFib

hiddenFibBuyFilterOK = hiddenFibOffOrAssist ? true : hiddenFibMode == "Require Fib Zone" ? hiddenFibBuyOK : hiddenFibMode == "Smart Assist Score" ? sy358SmartBuyOK : sy358OldMiddleBuyOK
hiddenFibSellFilterOK = hiddenFibOffOrAssist ? true : hiddenFibMode == "Require Fib Zone" ? hiddenFibSellOK : hiddenFibMode == "Smart Assist Score" ? sy358SmartSellOK : sy358OldMiddleSellOK

// SY389 Real Bias Trend Engine:
// This fixes the actual trend recognition problem.
// It does not add schools and it does not delete range logic.
// In clear UP bias: final direction must be BUY.
// In clear DOWN bias: final direction must be SELL.
// In RANGE/MIXED: original indicator behavior stays untouched.
rawBuyBase389 = rawBuyBeforeTrendGuard and sy354MapBuyOK and sy354RangeBuyOK and sy354PremiumDiscountBuyOK and sy354CandleBuyOK and hiddenFibBuyFilterOK and not sy338BlockBuyAgainstDownTrend and sy130BuyAllowed
rawSellBase389 = rawSellBeforeTrendGuard and sy354MapSellOK and sy354RangeSellOK and sy354PremiumDiscountSellOK and sy354CandleSellOK and hiddenFibSellFilterOK and not sy338BlockSellAgainstUpTrend and sy130SellAllowed

sy389LocalSlope = (ta.linreg(close, sy389RegLen, 0) - ta.linreg(close, sy389RegLen, 0)[sy389SlopeLen]) / math.max(atr, syminfo.mintick)
sy389LocalMove = math.abs(close - close[sy389RegLen])
sy389LocalNoise = ta.sma(math.abs(ta.change(close)), sy389RegLen) * sy389RegLen
sy389LocalER = sy389LocalNoise <= syminfo.mintick ? 0.0 : sy389LocalMove / sy389LocalNoise

sy389LocalUp = sy389LocalSlope >= sy389MinSlopeATR and close > ema50 and ema20 >= ema50 and sy389LocalER >= sy389MinER
sy389LocalDown = sy389LocalSlope <= -sy389MinSlopeATR and close < ema50 and ema20 <= ema50 and sy389LocalER >= sy389MinER
sy389HTFUp = sy389BiasDirHTF == 1
sy389HTFDown = sy389BiasDirHTF == -1

sy389OldHTFUp = tf5Dir == 1 or tf15Dir == 1 or htfScore > 0
sy389OldHTFDown = tf5Dir == -1 or tf15Dir == -1 or htfScore < 0

sy389UpAggressive = sy389LocalUp or sy389HTFUp
sy389DownAggressive = sy389LocalDown or sy389HTFDown
sy389UpBalanced = (sy389LocalUp and not sy389HTFDown) or (sy389HTFUp and not sy389LocalDown)
sy389DownBalanced = (sy389LocalDown and not sy389HTFUp) or (sy389HTFDown and not sy389LocalUp)
sy389UpConservative = sy389LocalUp and sy389HTFUp
sy389DownConservative = sy389LocalDown and sy389HTFDown

sy389BiasUpRaw = sy389BiasMode == "Conservative" ? sy389UpConservative : sy389BiasMode == "Aggressive" ? sy389UpAggressive : sy389UpBalanced
sy389BiasDownRaw = sy389BiasMode == "Conservative" ? sy389DownConservative : sy389BiasMode == "Aggressive" ? sy389DownAggressive : sy389DownBalanced

sy389BiasUp = useSY389BiasEngine and sy389BiasUpRaw and not sy389BiasDownRaw and (not sy389UseHTFConfirm or sy389OldHTFUp)
sy389BiasDown = useSY389BiasEngine and sy389BiasDownRaw and not sy389BiasUpRaw and (not sy389UseHTFConfirm or sy389OldHTFDown)
sy389BiasRange = not sy389BiasUp and not sy389BiasDown

sy389WrongSellInUp = sy389BiasUp and rawSellBase389 and roomBuy
sy389WrongBuyInDown = sy389BiasDown and rawBuyBase389 and roomSell

rawBuy = not useSY389BiasEngine ? rawBuyBase389 : sy389BiasUp ? (rawBuyBase389 or (sy389ConvertWrongSide and sy389WrongSellInUp)) : sy389BiasDown ? false : (sy389KeepRangeOriginal ? rawBuyBase389 : false)
rawSell = not useSY389BiasEngine ? rawSellBase389 : sy389BiasDown ? (rawSellBase389 or (sy389ConvertWrongSide and sy389WrongBuyInDown)) : sy389BiasUp ? false : (sy389KeepRangeOriginal ? rawSellBase389 : false)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FINAL ENTRY SIGNALS — ORIGINAL SY999 + M1 BOS ARBITRATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
baseBuySignal = allowLong and rawBuy and not rawSell
baseSellSignal = allowShort and rawSell and not rawBuy

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SYXAUUSD PROFESSIONAL M1 BOS CONTINUATION
// Calibrated for XAUUSD M1.
// BOS can be added, receive priority, replace an opposite BASE signal,
// or run alone so its independent quality can be measured.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
m1AtrSafe = math.max(atr, syminfo.mintick)
m1Ema20Slope = (ema20 - ema20[m1SlopeBars]) / m1AtrSafe
m1Ema50Slope = (ema50 - ema50[m1SlopeBars + 2]) / m1AtrSafe

m1UpContextRaw = htfScore >= m1TrendMinScore and tf15Dir != -1 and (tf5Dir == 1 or sy389BiasUp) and ema20 > ema50 and close > ema50 and m1Ema20Slope >= m1MinSlopeATR and m1Ema50Slope >= -0.01 and adx >= m1MinADX and pDI > mDI
m1DownContextRaw = htfScore <= -m1TrendMinScore and tf15Dir != 1 and (tf5Dir == -1 or sy389BiasDown) and ema20 < ema50 and close < ema50 and m1Ema20Slope <= -m1MinSlopeATR and m1Ema50Slope <= 0.01 and adx >= m1MinADX and mDI > pDI

m1UpVotes = (m1UpContextRaw ? 1 : 0) + (m1UpContextRaw[1] ? 1 : 0) + (m1UpContextRaw[2] ? 1 : 0)
m1DownVotes = (m1DownContextRaw ? 1 : 0) + (m1DownContextRaw[1] ? 1 : 0) + (m1DownContextRaw[2] ? 1 : 0)
m1StrongUp = m1UpVotes >= m1TrendPersistence
m1StrongDown = m1DownVotes >= m1TrendPersistence

m1BuyNotChased = (close - ema20) / m1AtrSafe <= m1MaxChaseATR
m1SellNotChased = (ema20 - close) / m1AtrSafe <= m1MaxChaseATR
m1RoomBuy = not useRoomFilter or (localHigh - close) / pointUnit >= math.min(targetPoints, 30) or close >= localHigh[1]
m1RoomSell = not useRoomFilter or (close - localLow) / pointUnit >= math.min(targetPoints, 30) or close <= localLow[1]

m1CompressionHigh = ta.highest(high, m1CompressionBars)[1]
m1CompressionLow = ta.lowest(low, m1CompressionBars)[1]
m1CompressionRangeATR = (m1CompressionHigh - m1CompressionLow) / math.max(atr[1], syminfo.mintick)
m1Compressed = not na(m1CompressionHigh) and not na(m1CompressionLow) and m1CompressionRangeATR <= m1CompressionATR
m1BosHigh = ta.highest(high, m1BosLookback)[1]
m1BosLow = ta.lowest(low, m1BosLookback)[1]

m1BosBuyRaw = m1UseEngine and tradeableBase and m1StrongUp and m1Compressed and close > m1BosHigh and close > open and bodyPct >= m1BosBodyPct and closePosBuy >= 0.62 and close > ema20 and m1BuyNotChased and rsi14 < 76 and rangePos <= m1MaxRangeBuy and m1RoomBuy
m1BosSellRaw = m1UseEngine and tradeableBase and m1StrongDown and m1Compressed and close < m1BosLow and close < open and bodyPct >= m1BosBodyPct and closePosSell >= 0.62 and close < ema20 and m1SellNotChased and rsi14 > 24 and rangePos >= m1MinRangeSell and m1RoomSell

m1BosStrongBuy = m1BosBuyRaw and htfScore >= m1SmartMinHTF and adx >= m1SmartMinADX and bodyPct >= m1SmartBodyPct and closePosBuy >= 0.66 and (close - ema20) / m1AtrSafe <= m1SmartMaxChaseATR
m1BosStrongSell = m1BosSellRaw and htfScore <= -m1SmartMinHTF and adx >= m1SmartMinADX and bodyPct >= m1SmartBodyPct and closePosSell >= 0.66 and (ema20 - close) / m1AtrSafe <= m1SmartMaxChaseATR


m1BaseSide = baseBuySignal and not baseSellSignal ? 1 : baseSellSignal and not baseBuySignal ? -1 : 0
m1BosSide = m1BosBuyRaw and not m1BosSellRaw ? 1 : m1BosSellRaw and not m1BosBuyRaw ? -1 : 0
m1StrongBosSide = m1BosStrongBuy and not m1BosStrongSell ? 1 : m1BosStrongSell and not m1BosStrongBuy ? -1 : 0

int m1SelectedSide = m1BaseSide
int m1SelectedSourceCode = 0
// Source codes: 0 = SY999 BASE, 1 = SMART TAKE own entry,
// 2 = same-direction overlap, 3 = SMART TAKE replaced opposite BASE.
if m1BaseSide == 0
    m1SelectedSide := m1BosSide
    m1SelectedSourceCode := m1BosSide != 0 ? 1 : 0
else if m1BosSide == m1BaseSide
    m1SelectedSide := m1BaseSide
    m1SelectedSourceCode := 2
else if m1StrongBosSide != 0 and m1StrongBosSide == -m1BaseSide
    m1SelectedSide := m1StrongBosSide
    m1SelectedSourceCode := 3
else
    m1SelectedSide := m1BaseSide
    m1SelectedSourceCode := 0

// Preserve the exact original selected signal.
int sy8624BaseSide = m1SelectedSide
int sy8624BaseSourceCode = m1SelectedSourceCode

// Exact M1 confirmation settings used by the winning Combination Lab row.
pbTol = atr * pbRetestTolATR
pbM1Bull = tradeableBase and close > open and bodyPct >= pbM1MinBodyPct and closePosBuy >= pbM1MinClosePos
pbM1Bear = tradeableBase and close < open and bodyPct >= pbM1MinBodyPct and closePosSell >= pbM1MinClosePos

// POC Order Block: first confirmed M1 retest per active 5m block.
var int pbLastBullObSignalId = na
var int pbLastBearObSignalId = na

pbObBuyCandidate = pbObBullActive and not na(pbObBullId) and high >= pbObBullBottom and low <= pbObBullTop and close > pbObBullTop and pbM1Bull
pbObSellCandidate = pbObBearActive and not na(pbObBearId) and high >= pbObBearBottom and low <= pbObBearTop and close < pbObBearBottom and pbM1Bear

pbObBuyNow = pbObBuyCandidate and (na(pbLastBullObSignalId) or pbLastBullObSignalId != pbObBullId)
pbObSellNow = pbObSellCandidate and (na(pbLastBearObSignalId) or pbLastBearObSignalId != pbObBearId)

if pbObBuyNow
    pbLastBullObSignalId := pbObBullId
if pbObSellNow
    pbLastBearObSignalId := pbObBearId

// Breaker/structure retest from the latest confirmed 5m break.
pbBreakBullNew = not na(pbBreakBullTime) and pbBreakBullTime != pbBreakBullTime[1]
pbBreakBearNew = not na(pbBreakBearTime) and pbBreakBearTime != pbBreakBearTime[1]
pbBreakBullBars = ta.barssince(pbBreakBullNew)
pbBreakBearBars = ta.barssince(pbBreakBearNew)

pbSlowBuyOK = not pbRequireSlowTrend or pbSlowTrend != -1
pbSlowSellOK = not pbRequireSlowTrend or pbSlowTrend != 1
pbBreakerBuyNow = not na(pbBreakBullBars) and pbBreakBullBars <= pbBreakValidBars and not na(pbBreakBullLevel) and low <= pbBreakBullLevel + pbTol and close > pbBreakBullLevel and pbM1Bull and pbSlowBuyOK
pbBreakerSellNow = not na(pbBreakBearBars) and pbBreakBearBars <= pbBreakValidBars and not na(pbBreakBearLevel) and high >= pbBreakBearLevel - pbTol and close < pbBreakBearLevel and pbM1Bear and pbSlowSellOK

// Exact tested harmony: either engine may be the current trigger;
// the matching engine remains valid for four closed M1 bars.
pbObBuyBars = ta.barssince(pbObBuyNow)
pbObSellBars = ta.barssince(pbObSellNow)
pbBreakerBuyBars = ta.barssince(pbBreakerBuyNow)
pbBreakerSellBars = ta.barssince(pbBreakerSellNow)

pbObBuyRecent = not na(pbObBuyBars) and pbObBuyBars <= pbHarmonyWindow
pbObSellRecent = not na(pbObSellBars) and pbObSellBars <= pbHarmonyWindow
pbBreakerBuyRecent = not na(pbBreakerBuyBars) and pbBreakerBuyBars <= pbHarmonyWindow
pbBreakerSellRecent = not na(pbBreakerSellBars) and pbBreakerSellBars <= pbHarmonyWindow

pbEitherBuy = (pbObBuyNow and pbBreakerBuyRecent) or (pbBreakerBuyNow and pbObBuyRecent)
pbEitherSell = (pbObSellNow and pbBreakerSellRecent) or (pbBreakerSellNow and pbObSellRecent)
pbPocThenBreakerBuy = pbBreakerBuyNow and pbObBuyRecent
pbPocThenBreakerSell = pbBreakerSellNow and pbObSellRecent
pbBreakerThenPocBuy = pbObBuyNow and pbBreakerBuyRecent
pbBreakerThenPocSell = pbObSellNow and pbBreakerSellRecent

pbPairBuyRaw = pbPairMode == "POC Then Breaker" ? pbPocThenBreakerBuy : pbPairMode == "Breaker Then POC" ? pbBreakerThenPocBuy : pbEitherBuy
pbPairSellRaw = pbPairMode == "POC Then Breaker" ? pbPocThenBreakerSell : pbPairMode == "Breaker Then POC" ? pbBreakerThenPocSell : pbEitherSell
pbPairBuy = usePocBreakerPair and pbEnableBuy and pbPairBuyRaw
pbPairSell = usePocBreakerPair and pbEnableSell and pbPairSellRaw
pbPairSide = pbPairBuy and not pbPairSell ? 1 : pbPairSell and not pbPairBuy ? -1 : 0

// Default ON preserves the tested 8624 behavior. OFF lets the new pair take priority when both exist.
int sy8624SelectedSide = pbOriginalPriority ? (sy8624BaseSide != 0 ? sy8624BaseSide : pbPairSide) : (pbPairSide != 0 ? pbPairSide : sy8624BaseSide)
int sy8624SelectedSourceCode = pbOriginalPriority ? (sy8624BaseSide != 0 ? sy8624BaseSourceCode : pbPairSide != 0 ? 4 : 0) : (pbPairSide != 0 ? 4 : sy8624BaseSourceCode)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RELOAD-VALIDATED TREND VOTE WINNER
// Exact BUY + Strict SELL.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
tvRet = close - close[1]
tvERMove = math.abs(close - close[20])
tvERPath = math.max(f_roll_sum(math.abs(tvRet), 20), syminfo.mintick)
tvER = tvERMove / tvERPath

tvLin = ta.linreg(close, 40, 0)
tvLinPrev = ta.linreg(close, 40, 1)
tvSlopeATR = (tvLin - tvLinPrev) / math.max(atr, syminfo.mintick)

tvRetStd10 = math.max(ta.stdev(tvRet, 10), syminfo.mintick)
tvRetStd60 = math.max(ta.stdev(tvRet, 60), syminfo.mintick)
tvVolRatio = tvRetStd10 / tvRetStd60
tvRetZ = tvRet / math.max(ta.stdev(tvRet, 40), syminfo.mintick)
tvAutoCorr = nz(ta.correlation(tvRet, tvRet[1], 20), 0.0)
tvUpShare = f_roll_sum(close > close[1] ? 1.0 : 0.0, 12) / 12.0
tvDownShare = 1.0 - tvUpShare

tvHigh8 = ta.highest(high[1], 8)
tvLow8 = ta.lowest(low[1], 8)
tvHigh10 = ta.highest(high[1], 10)
tvLow10 = ta.lowest(low[1], 10)
tvHigh12 = ta.highest(high[1], 12)
tvLow12 = ta.lowest(low[1], 12)
tvHigh15 = ta.highest(high[1], 15)
tvLow15 = ta.lowest(low[1], 15)
tvHigh20 = ta.highest(high[1], 20)
tvLow20 = ta.lowest(low[1], 20)
tvHigh24 = ta.highest(high[1], 24)
tvLow24 = ta.lowest(low[1], 24)

tvBreak8Buy = tradeableBase and close > tvHigh8 and close[1] <= tvHigh8[1]
tvBreak12Buy = tradeableBase and close > tvHigh12 and close[1] <= tvHigh12[1]
tvBreak20Buy = tradeableBase and close > tvHigh20 and close[1] <= tvHigh20[1]

tvBreak10Sell = tradeableBase and close < tvLow10 and close[1] >= tvLow10[1]
tvBreak15Sell = tradeableBase and close < tvLow15 and close[1] >= tvLow15[1]
tvBreak24Sell = tradeableBase and close < tvLow24 and close[1] >= tvLow24[1]

tvWasCompressedExact = ta.lowest(tvVolRatio[1], 6) <= 0.72
tvExpandingExact = tvVolRatio >= 0.90 and tvVolRatio > tvVolRatio[1]

tvExactFastBuy = tvBreak8Buy and tvER >= 0.25 and tvSlopeATR > 0.015 and tvAutoCorr >= -0.08 and tvUpShare >= 0.58
tvExactBalBuy = tvBreak12Buy and tvER >= 0.35 and tvSlopeATR > 0.025 and tvAutoCorr >= -0.02 and tvVolRatio >= 0.82
tvExactStrictBuy = tvBreak20Buy and tvER >= 0.45 and tvSlopeATR > 0.035 and tvAutoCorr >= 0.02 and tvVolRatio >= 0.90
tvExactCompressBuy = tvWasCompressedExact and tvExpandingExact and tvBreak12Buy and tvER >= 0.30 and tvSlopeATR > 0.020
tvExactImpulseBuy = tradeableBase and tvRetZ >= 1.50 and tvER >= 0.35 and tvSlopeATR > 0.025 and tvUpShare >= 0.67 and bodyPct >= 48 and closePosBuy >= 0.70
tvExactBuyVotes = (tvExactFastBuy ? 1 : 0) + (tvExactBalBuy ? 1 : 0) + (tvExactStrictBuy ? 1 : 0) + (tvExactCompressBuy ? 1 : 0) + (tvExactImpulseBuy ? 1 : 0)

tvWasCompressedStrict = ta.lowest(tvVolRatio[1], 6) <= 0.66
tvExpandingStrict = tvVolRatio >= 0.95 and tvVolRatio > tvVolRatio[1]

tvStrictFastSell = tvBreak10Sell and tvER >= 0.30 and tvSlopeATR < -0.020 and tvAutoCorr >= -0.04 and tvDownShare >= 0.62
tvStrictBalSell = tvBreak15Sell and tvER >= 0.40 and tvSlopeATR < -0.030 and tvAutoCorr >= 0.00 and tvVolRatio >= 0.88
tvStrictStrictSell = tvBreak24Sell and tvER >= 0.50 and tvSlopeATR < -0.045 and tvAutoCorr >= 0.05 and tvVolRatio >= 0.95
tvStrictCompressSell = tvWasCompressedStrict and tvExpandingStrict and tvBreak15Sell and tvER >= 0.35 and tvSlopeATR < -0.025
tvStrictImpulseSell = tradeableBase and tvRetZ <= -1.80 and tvER >= 0.42 and tvSlopeATR < -0.035 and tvDownShare >= 0.72 and bodyPct >= 55 and closePosSell >= 0.76
tvStrictSellVotes = (tvStrictFastSell ? 1 : 0) + (tvStrictBalSell ? 1 : 0) + (tvStrictStrictSell ? 1 : 0) + (tvStrictCompressSell ? 1 : 0) + (tvStrictImpulseSell ? 1 : 0)

tvAddonBuy = useTrendVoteAddon and trendVoteEnableBuy and tvExactBuyVotes >= 2
tvAddonSell = useTrendVoteAddon and trendVoteEnableSell and tvStrictSellVotes >= 2
int tvAddonSide = tvAddonBuy and not tvAddonSell ? 1 : tvAddonSell and not tvAddonBuy ? -1 : 0

// BASE always wins. Add-on is source code 5 and uses the original adaptive entry-time plan.
int syCleanSelectedSide = sy8624SelectedSide != 0 ? sy8624SelectedSide : tvAddonSide
int syCleanSelectedSourceCode = sy8624SelectedSide != 0 ? sy8624SelectedSourceCode : tvAddonSide != 0 ? 5 : 0

buySignal = syCleanSelectedSide == 1
sellSignal = syCleanSelectedSide == -1
m1SelectedSourceCode := syCleanSelectedSourceCode

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SCHOOL CAPACITY VARIANT STREAMS
// All calculations are performed on every closed M1 bar.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// 01 — Liquidity Sweep / Real Reversal
capSweepExactBuy = realRevBuy
capSweepExactSell = realRevSell
capSweepLooseBuy = tradeableBase and sweepLow and rangePos <= 42 and (bullReject or bullMomentum or (close > open and closePosBuy >= 0.55)) and roomBuy
capSweepLooseSell = tradeableBase and sweepHigh and rangePos >= 58 and (bearReject or bearMomentum or (close < open and closePosSell >= 0.55)) and roomSell
capSweepStrictBuy = tradeableBase and sweepLow and discount and bullReject and bodyPct >= 30 and closePosBuy >= 0.65 and roomBuy and htfScore >= -0.5
capSweepStrictSell = tradeableBase and sweepHigh and premium and bearReject and bodyPct >= 30 and closePosSell >= 0.65 and roomSell and htfScore <= 0.5

// 02 — Break & Retest
capRetHigh14 = ta.highest(high, 14)[1]
capRetLow14 = ta.lowest(low, 14)[1]
capRetHigh30 = ta.highest(high, 30)[1]
capRetLow30 = ta.lowest(low, 30)[1]
capRetExactBuy = retestBuy
capRetExactSell = retestSell
capRetLooseBuy = tradeableBase and not na(capRetHigh14) and low <= capRetHigh14 + atr * 0.60 and close > capRetHigh14 and close > open and closePosBuy >= 0.55
capRetLooseSell = tradeableBase and not na(capRetLow14) and high >= capRetLow14 - atr * 0.60 and close < capRetLow14 and close < open and closePosSell >= 0.55
capRetStrictBuy = tradeableBase and not na(capRetHigh30) and low <= capRetHigh30 + atr * 0.25 and close > capRetHigh30 and bodyPct >= 35 and closePosBuy >= 0.65 and roomBuy and htfScore >= 0
capRetStrictSell = tradeableBase and not na(capRetLow30) and high >= capRetLow30 - atr * 0.25 and close < capRetLow30 and bodyPct >= 35 and closePosSell >= 0.65 and roomSell and htfScore <= 0

// 03 — Fair Value Gap
capFvgExactBuy = bullFVG
capFvgExactSell = bearFVG
capFvgLooseBuy = tradeableBase and low > high[2] and (low - high[2]) >= atr * 0.10 and close > ema20 and close > open
capFvgLooseSell = tradeableBase and high < low[2] and (low[2] - high) >= atr * 0.10 and close < ema20 and close < open
capFvgStrictBuy = tradeableBase and low > high[2] and (low - high[2]) >= atr * 0.25 and close > ema20 and ema20 >= ema50 and bodyPct >= 40 and closePosBuy >= 0.68 and roomBuy
capFvgStrictSell = tradeableBase and high < low[2] and (low[2] - high) >= atr * 0.25 and close < ema20 and ema20 <= ema50 and bodyPct >= 40 and closePosSell >= 0.68 and roomSell

// 04 — Fibonacci Range Location
capFibExactBuy = fibBuy
capFibExactSell = fibSell
capFibLooseBuy = tradeableBase and rangePos >= 15 and rangePos <= 56 and (bullReject or bullMomentum)
capFibLooseSell = tradeableBase and rangePos >= 44 and rangePos <= 85 and (bearReject or bearMomentum)
capFibStrictBuy = tradeableBase and rangePos >= 25 and rangePos <= 45 and bullReject and htfScore >= 0 and roomBuy
capFibStrictSell = tradeableBase and rangePos >= 55 and rangePos <= 75 and bearReject and htfScore <= 0 and roomSell

// 05 — Bollinger Range Reversion
capBB17Dev = ta.stdev(close, 20) * 1.70
capBB23Dev = ta.stdev(close, 20) * 2.30
capBB17U = bb20Basis + capBB17Dev
capBB17L = bb20Basis - capBB17Dev
capBB23U = bb20Basis + capBB23Dev
capBB23L = bb20Basis - capBB23Dev
capBBExactBuy = bbRangeBuy
capBBExactSell = bbRangeSell
capBBLooseBuy = tradeableBase and adx < 24 and math.abs(htfScore) < 2.0 and low <= capBB17L and (bullReject or closePosBuy >= 0.60) and rangePos <= 35
capBBLooseSell = tradeableBase and adx < 24 and math.abs(htfScore) < 2.0 and high >= capBB17U and (bearReject or closePosSell >= 0.60) and rangePos >= 65
capBBStrictBuy = tradeableBase and adx < 16 and math.abs(htfScore) < 1.0 and low <= capBB23L and bullReject and discount and roomBuy
capBBStrictSell = tradeableBase and adx < 16 and math.abs(htfScore) < 1.0 and high >= capBB23U and bearReject and premium and roomSell

// 06 — Momentum / Value Continuation
capCleanMoveLoose = math.abs(close - close[20]) / math.max(ta.sma(math.abs(close - close[1]), 20) * 20, syminfo.mintick) >= 0.18
capCleanMoveStrict = math.abs(close - close[20]) / math.max(ta.sma(math.abs(close - close[1]), 20) * 20, syminfo.mintick) >= 0.35
capMomExactBuy = momentumBuy
capMomExactSell = momentumSell
capMomLooseBuy = tradeableBase and capCleanMoveLoose and bullMomentum and close > ema20 and not premium and htfScore >= -0.5
capMomLooseSell = tradeableBase and capCleanMoveLoose and bearMomentum and close < ema20 and not discount and htfScore <= 0.5
capMomStrictBuy = tradeableBase and capCleanMoveStrict and bullMomentum and bodyPct >= 50 and closePosBuy >= 0.72 and htfScore >= 1.5 and roomBuy
capMomStrictSell = tradeableBase and capCleanMoveStrict and bearMomentum and bodyPct >= 50 and closePosSell >= 0.72 and htfScore <= -1.5 and roomSell

// 07 — Quad Oscillator
capQuadVoteBuy = (rsi28Buy ? 1 : 0) + (stoch10Buy ? 1 : 0) + (rsi34Buy ? 1 : 0) + (stoch50Buy ? 1 : 0)
capQuadVoteSell = (rsi28Sell ? 1 : 0) + (stoch10Sell ? 1 : 0) + (rsi34Sell ? 1 : 0) + (stoch50Sell ? 1 : 0)
capRsi28LooseBuy = rsi28[1] < 52 and rsi28 >= 52 and close > ema20
capRsi28LooseSell = rsi28[1] > 48 and rsi28 <= 48 and close < ema20
capRsi34LooseBuy = rsi34[1] < 52 and rsi34 >= 52 and close > ema20
capRsi34LooseSell = rsi34[1] > 48 and rsi34 <= 48 and close < ema20
capStoch10LooseBuy = stoch10 > stoch10[1] and stoch10[1] < 25 and stoch10 < 90 and close > ema20
capStoch10LooseSell = stoch10 < stoch10[1] and stoch10[1] > 75 and stoch10 > 10 and close < ema20
capQuadExactBuy = quadBuy
capQuadExactSell = quadSell
capQuadLooseBuy = tradeableBase and (capRsi28LooseBuy or capRsi34LooseBuy or capStoch10LooseBuy or stoch50Buy)
capQuadLooseSell = tradeableBase and (capRsi28LooseSell or capRsi34LooseSell or capStoch10LooseSell or stoch50Sell)
capQuadStrictBuy = tradeableBase and capQuadVoteBuy >= 2 and htfScore >= 0 and roomBuy
capQuadStrictSell = tradeableBase and capQuadVoteSell >= 2 and htfScore <= 0 and roomSell

// 08 — RSI14 Range Shift
capRsiLow40 = ta.lowest(rsi14, 40)
capRsiHigh40 = ta.highest(rsi14, 40)
capRsiLow80 = ta.lowest(rsi14, 80)
capRsiHigh80 = ta.highest(rsi14, 80)
capRsiExactBuy = rsi14ShiftBuy
capRsiExactSell = rsi14ShiftSell
capRsiLooseBuy = tradeableBase and capRsiLow40 > 35 and rsi14[1] < 42 and rsi14 >= 42 and close > ema20
capRsiLooseSell = tradeableBase and capRsiHigh40 < 65 and rsi14[1] > 58 and rsi14 <= 58 and close < ema20
capRsiStrictBuy = tradeableBase and capRsiLow80 > 40 and rsi14[1] < 45 and rsi14 >= 45 and close > ema20 and htfScore >= 0.5 and roomBuy
capRsiStrictSell = tradeableBase and capRsiHigh80 < 60 and rsi14[1] > 55 and rsi14 <= 55 and close < ema20 and htfScore <= -0.5 and roomSell

// 09 — BB/KC Squeeze
capBB34B = ta.sma(close, 34)
capBB34D2 = ta.stdev(close, 34) * 2.0
capBB34U2 = capBB34B + capBB34D2
capBB34L2 = capBB34B - capBB34D2
capKC34B = ta.ema(close, 34)
capKC34U17 = capKC34B + atr * 1.70
capKC34L17 = capKC34B - atr * 1.70
capSq34 = capBB34U2 < capKC34U17 and capBB34L2 > capKC34L17
capWasSq34 = ta.highest(capSq34 ? 1.0 : 0.0, 80) > 0
capBB70B = ta.sma(close, 70)
capBB70D = ta.stdev(close, 70) * 2.0
capBB70U = capBB70B + capBB70D
capBB70L = capBB70B - capBB70D
capKC70B = ta.ema(close, 70)
capKC70U = capKC70B + atr * 1.30
capKC70L = capKC70B - atr * 1.30
capSq70 = capBB70U < capKC70U and capBB70L > capKC70L
capWasSq70 = ta.highest(capSq70 ? 1.0 : 0.0, 50) > 0
capBBKCExactBuy = bbkcBuy
capBBKCExactSell = bbkcSell
capBBKCLooseBuy = tradeableBase and capWasSq34 and not capSq34 and close > capBB34B and close > ema20
capBBKCLooseSell = tradeableBase and capWasSq34 and not capSq34 and close < capBB34B and close < ema20
capBBKCStrictBuy = tradeableBase and capWasSq70 and not capSq70 and close > capBB70U and bodyPct >= 40 and htfScore >= 0.5 and roomBuy
capBBKCStrictSell = tradeableBase and capWasSq70 and not capSq70 and close < capBB70L and bodyPct >= 40 and htfScore <= -0.5 and roomSell

// 10 — Trend Correction
capTCExactBuy = trendCorrBuy
capTCExactSell = trendCorrSell
capTCLooseBuy = tradeableBase and tf15Dir == 1 and pDI >= mDI and stoch10[1] < stoch10D[1] and stoch10 >= stoch10D and stoch10 < 80 and ta.lowest(stoch10, 45) < 40 and close > ema20
capTCLooseSell = tradeableBase and tf15Dir == -1 and mDI >= pDI and stoch10[1] > stoch10D[1] and stoch10 <= stoch10D and stoch10 > 20 and ta.highest(stoch10, 45) > 60 and close < ema20
capTCStrictBuy = tradeableBase and trendCorrBuyContext and stoch10[1] < stoch10D[1] and stoch10 >= stoch10D and stoch10 < 60 and ta.lowest(stoch10, 35) < 25 and close > ema50 and bodyPct >= 30 and roomBuy
capTCStrictSell = tradeableBase and trendCorrSellContext and stoch10[1] > stoch10D[1] and stoch10 <= stoch10D and stoch10 > 40 and ta.highest(stoch10, 35) > 75 and close < ema50 and bodyPct >= 30 and roomSell

// 11 — QQE + Vortex Reset Pack
capRsi21 = ta.rsi(close, 21)
capRsi21S = ta.ema(capRsi21, 3)
capRsi21Sig = ta.ema(capRsi21S, 8)
capQqeLooseBuy = tfCtxBuy and ta.crossover(capRsi21S, capRsi21Sig) and capRsi21S < 70 and close > ema20
capQqeLooseSell = tfCtxSell and ta.crossunder(capRsi21S, capRsi21Sig) and capRsi21S > 30 and close < ema20
capRsi34S = ta.ema(rsi34, 8)
capRsi34Sig = ta.ema(capRsi34S, 21)
capQqeStrictBuy = tfCtxBuy and ta.crossover(capRsi34S, capRsi34Sig) and capRsi34S < 60 and close > ema20 and adx >= 18
capQqeStrictSell = tfCtxSell and ta.crossunder(capRsi34S, capRsi34Sig) and capRsi34S > 40 and close < ema20 and adx >= 18
capTr10 = f_roll_sum(f_tr(high, low, close), 10)
capViP10 = capTr10 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(high - low[1]), 10) / capTr10
capViM10 = capTr10 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(low - high[1]), 10) / capTr10
capVLooseBuy = tfCtxBuy and capViP10 > capViM10 and rsi14[1] < 43 and rsi14 >= 43 and close > ema20
capVLooseSell = tfCtxSell and capViM10 > capViP10 and rsi14[1] > 57 and rsi14 <= 57 and close < ema20
capQVExactBuy = qqe28Buy or vortex14Buy
capQVExactSell = qqe28Sell or vortex14Sell
capQVLooseBuy = tradeableBase and (capQqeLooseBuy or capVLooseBuy)
capQVLooseSell = tradeableBase and (capQqeLooseSell or capVLooseSell)
capQVStrictBuy = tradeableBase and capQqeStrictBuy and viPlus14 > viMinus14 and pDI > mDI and roomBuy
capQVStrictSell = tradeableBase and capQqeStrictSell and viMinus14 > viPlus14 and mDI > pDI and roomSell

// 12 — Donchian Mid + False Break Pack
capDon50H = ta.highest(high, 50)[1]
capDon50L = ta.lowest(low, 50)[1]
capDon50M = (capDon50H + capDon50L) / 2.0
capDon120H = ta.highest(high, 120)[1]
capDon120L = ta.lowest(low, 120)[1]
capDon100H = ta.highest(high, 100)[1]
capDon100L = ta.lowest(low, 100)[1]
capDon100M = (capDon100H + capDon100L) / 2.0
capDon250H = ta.highest(high, 250)[1]
capDon250L = ta.lowest(low, 250)[1]
capDonExactBuy = don70Buy or don200Buy
capDonExactSell = don70Sell or don200Sell
capDonLooseBuy = tradeableBase and tf15Dir != -1 and ((close[1] < capDon50M[1] and close >= capDon50M) or (low < capDon120L and close > capDon120L)) and close > open
capDonLooseSell = tradeableBase and tf15Dir != 1 and ((close[1] > capDon50M[1] and close <= capDon50M) or (high > capDon120H and close < capDon120H)) and close < open
capDonStrictBuy = tradeableBase and tfCtxBuy and (((close[1] < capDon100M[1] and close >= capDon100M) and bodyPct >= 35) or ((low < capDon250L and close > capDon250L) and bullReject)) and roomBuy
capDonStrictSell = tradeableBase and tfCtxSell and (((close[1] > capDon100M[1] and close <= capDon100M) and bodyPct >= 35) or ((high > capDon250H and close < capDon250H) and bearReject)) and roomSell

// 13 — BB34 Squeeze Release
capBB20Basis2 = ta.sma(close, 20)
capBB20Dev2 = ta.stdev(close, 20) * 2.0
capBB20U2 = capBB20Basis2 + capBB20Dev2
capBB20L2 = capBB20Basis2 - capBB20Dev2
capBB20W = (capBB20U2 - capBB20L2) / math.max(math.abs(capBB20Basis2), syminfo.mintick)
capBB20N = ta.percentile_nearest_rank(capBB20W, 200, 45)
capBB20Sq = capBB20W <= capBB20N
capBB55Basis = ta.sma(close, 55)
capBB55Dev = ta.stdev(close, 55) * 2.0
capBB55U = capBB55Basis + capBB55Dev
capBB55L = capBB55Basis - capBB55Dev
capBB55W = (capBB55U - capBB55L) / math.max(math.abs(capBB55Basis), syminfo.mintick)
capBB55N = ta.percentile_nearest_rank(capBB55W, 400, 25)
capBB55Sq = capBB55W <= capBB55N
capBB34ExactBuy = bb34SqueezeBuy
capBB34ExactSell = bb34SqueezeSell
capBB34LooseBuy = tradeableBase and tf15Dir != -1 and capBB20Sq[1] and close > capBB20U2 and ema20 > ema50 and rangePos < 93
capBB34LooseSell = tradeableBase and tf15Dir != 1 and capBB20Sq[1] and close < capBB20L2 and ema20 < ema50 and rangePos > 7
capBB34StrictBuy = tradeableBase and tfCtxBuy and capBB55Sq[1] and close > capBB55U and ema20 > ema50 and bodyPct >= 40 and roomBuy
capBB34StrictSell = tradeableBase and tfCtxSell and capBB55Sq[1] and close < capBB55L and ema20 < ema50 and bodyPct >= 40 and roomSell

// 14 — TRIX / SMI Trend Pack
capTrendExactBuy = sy319TrendBuy
capTrendExactSell = sy319TrendSell
capTrendLooseBuy = tradeableBase and tf15Dir != -1 and (trix15Buy or trix21Buy or trix34Buy or smi14Buy or (ta.crossover(trix15, trix15Sig) and close > ema20))
capTrendLooseSell = tradeableBase and tf15Dir != 1 and (trix15Sell or trix21Sell or trix34Sell or smi14Sell or (ta.crossunder(trix15, trix15Sig) and close < ema20))
capTrendStrictBuy = tradeableBase and sy319TrendBuy and htfScore >= 1.0 and adx >= 18 and bodyPct >= 28 and roomBuy
capTrendStrictSell = tradeableBase and sy319TrendSell and htfScore <= -1.0 and adx >= 18 and bodyPct >= 28 and roomSell

// 15 — VWAP Pullback
capVWAPSlope3 = (ema20 - ema20[3]) / math.max(atr, syminfo.mintick)
capVWAPSlope8 = (ema20 - ema20[8]) / math.max(atr, syminfo.mintick)
capVWAPTouchLooseBuy = ta.lowest(low, 7) <= vwapVal + atr * 0.35
capVWAPTouchLooseSell = ta.highest(high, 7) >= vwapVal - atr * 0.35
capVWAPTouchStrictBuy = ta.lowest(low, 3) <= vwapVal + atr * 0.15
capVWAPTouchStrictSell = ta.highest(high, 3) >= vwapVal - atr * 0.15
capVWAPExactBuy = sy326VWAPBuy
capVWAPExactSell = sy326VWAPSell
capVWAPLooseBuy = tradeableBase and close > ema20 and ema20 >= ema50 and capVWAPSlope3 >= 0.07 and capVWAPTouchLooseBuy and close > vwapVal and close > open and rsi14 >= 44 and rsi14 <= 76 and sy326DistVWAP <= 2.0
capVWAPLooseSell = tradeableBase and close < ema20 and ema20 <= ema50 and capVWAPSlope3 <= -0.07 and capVWAPTouchLooseSell and close < vwapVal and close < open and rsi14 >= 24 and rsi14 <= 56 and sy326DistVWAP >= -2.0
capVWAPStrictBuy = tradeableBase and close > ema20 and ema20 > ema50 and capVWAPSlope8 >= 0.15 and capVWAPTouchStrictBuy and close > vwapVal and rsi14 >= 52 and rsi14 <= 68 and bodyPct >= 30 and roomBuy
capVWAPStrictSell = tradeableBase and close < ema20 and ema20 < ema50 and capVWAPSlope8 <= -0.15 and capVWAPTouchStrictSell and close < vwapVal and rsi14 >= 32 and rsi14 <= 48 and bodyPct >= 30 and roomSell

// 16 — CCI Pullback
capCCI14 = ta.cci(hlc3, 14)
capCCI30 = ta.cci(hlc3, 30)
capCCIExactBuy = sy327CCIBuy
capCCIExactSell = sy327CCISell
capCCILooseBuy = tradeableBase and close > ema20 and ema20 >= ema50 and ta.crossover(capCCI14, -80) and sy319SessionOK
capCCILooseSell = tradeableBase and close < ema20 and ema20 <= ema50 and ta.crossunder(capCCI14, 80) and sy319SessionOK
capCCIStrictBuy = tradeableBase and sy326DriverBuy and ta.crossover(capCCI30, -120) and tfCtxBuy and bodyPct >= 30 and roomBuy
capCCIStrictSell = tradeableBase and sy326DriverSell and ta.crossunder(capCCI30, 120) and tfCtxSell and bodyPct >= 30 and roomSell

// 17 — Quiet Range / Edge-to-Mid Pack
capRange40H = ta.highest(high, 40)
capRange40L = ta.lowest(low, 40)
capRange40R = math.max(capRange40H - capRange40L, syminfo.mintick)
capRange40ATR = capRange40R / math.max(atr, syminfo.mintick)
capRange40Pos = (close - capRange40L) / capRange40R * 100.0
capRange80H = ta.highest(high, 80)
capRange80L = ta.lowest(low, 80)
capRange80R = math.max(capRange80H - capRange80L, syminfo.mintick)
capRange80ATR = capRange80R / math.max(atr, syminfo.mintick)
capRange80Pos = (close - capRange80L) / capRange80R * 100.0
capRangeExactBuy = sy327RangeBuy or sy328RangeEdgeBuy
capRangeExactSell = sy327RangeSell or sy328RangeEdgeSell
capRangeLooseBuy = tradeableBase and capRange40ATR < 8.0 and capRange40Pos < 25 and stoch10 > stoch10D and close > open
capRangeLooseSell = tradeableBase and capRange40ATR < 8.0 and capRange40Pos > 75 and stoch10 < stoch10D and close < open
capRangeStrictBuy = tradeableBase and capRange80ATR < 6.0 and capRange80Pos < 15 and stoch10[1] < 25 and stoch10 > stoch10D and bullReject and roomBuy
capRangeStrictSell = tradeableBase and capRange80ATR < 6.0 and capRange80Pos > 85 and stoch10[1] > 75 and stoch10 < stoch10D and bearReject and roomSell

// 18 — Ichimoku Tenkan / Kijun
capTen6 = (ta.highest(high, 6) + ta.lowest(low, 6)) / 2.0
capKij18 = (ta.highest(high, 18) + ta.lowest(low, 18)) / 2.0
capTen12 = (ta.highest(high, 12) + ta.lowest(low, 12)) / 2.0
capKij36 = (ta.highest(high, 36) + ta.lowest(low, 36)) / 2.0
capIchiExactBuy = sy328IchiBuy
capIchiExactSell = sy328IchiSell
capIchiLooseBuy = tradeableBase and ta.crossover(capTen6, capKij18) and close > ema20 and sy319SessionOK
capIchiLooseSell = tradeableBase and ta.crossunder(capTen6, capKij18) and close < ema20 and sy319SessionOK
capIchiStrictBuy = tradeableBase and ta.crossover(capTen12, capKij36) and close > ema50 and tfCtxBuy and bodyPct >= 30 and roomBuy
capIchiStrictSell = tradeableBase and ta.crossunder(capTen12, capKij36) and close < ema50 and tfCtxSell and bodyPct >= 30 and roomSell

// 19 — SY331 Side-Specific Pack
cap331BBL22 = sy331BBBasis - sy331BBDev * 2.20
cap331Don20H = ta.highest(high, 20)
cap331Don20L = ta.lowest(low, 20)
cap331Don20R = math.max(cap331Don20H - cap331Don20L, syminfo.mintick)
cap331Don20Pos = (close - cap331Don20L) / cap331Don20R * 100.0
cap331ExactBuy = sy331Buy
cap331ExactSell = sy331Sell
cap331LooseBuy = tradeableBase and sy319SessionOK and ((low < cap331BBL22 and close > cap331BBL22 and close > open and rsi14 < 50) or (low < cap331Don20L[1] and close > cap331Don20L[1] and cap331Don20Pos < 42) or (capRange40ATR < 7.5 and capRange40Pos < 15 and close > open))
cap331LooseSell = tradeableBase and sy319SessionOK and ((sy331Range30ATR < 7.0 and sy331Range30Pos > 84) or (sy331Range50ATR < 8.0 and sy331Range50Pos > 84) or (sy331Range100ATR < 9.0 and sy331Range100Pos > 84)) and close < open
cap331StrictBuy = tradeableBase and sy331Buy and bodyPct >= 30 and closePosBuy >= 0.62 and roomBuy
cap331StrictSell = tradeableBase and sy331Sell and bodyPct >= 30 and closePosSell >= 0.62 and roomSell

// 20 — SY336 Optimized Internal Pack
cap336VWAPL14 = vwapVal - sy336VWAPDev50 * 1.40
cap336VWAPL18 = vwapVal - sy336VWAPDev50 * 1.80
cap336VWAPU18 = vwapVal + sy336VWAPDev50 * 1.80
cap336KeltU13 = sy336KeltMid80 + sy336KeltAtr80 * 1.30
cap336LooseBuy = tradeableBase and ((low < cap336VWAPL14 and close > cap336VWAPL14 and close > open) or (ema20 > ema50 and close > vwapVal and low <= vwapVal + atr * 0.35 and close > open) or (sy336R80ATR < 11.0 and sy336R80Pos < 26 and close > open) or (ta.crossover(macdHist, 0) and volume > sy336VolMA50))
cap336LooseSell = tradeableBase and ((high > cap336VWAPU18 and close < cap336VWAPU18 and close < open) or (sy336R60ATR < 9.0 and sy336R60Pos > 86 and close < open) or (high > cap336KeltU13 and close < cap336KeltU13 and close < open) or sy336LONRetestSell or sy336NYFakeSell)
cap336ExactBuy = sy336BuyBest
cap336ExactSell = sy336SellBest
cap336StrictBuy = tradeableBase and sy336BuyBest and htfScore >= 0.5 and bodyPct >= 35 and closePosBuy >= 0.62 and roomBuy
cap336StrictSell = tradeableBase and sy336SellBest and htfScore <= -0.5 and bodyPct >= 35 and closePosSell >= 0.62 and roomSell

// 21 — Hidden Fibonacci Assist
capFibAssistExactBuy = sy360FibBoostBuy
capFibAssistExactSell = sy360FibBoostSell
capFibAssistLooseBuy = tradeableBase and hiddenFibActive and hiddenFibBuyRecent and hiddenFibBuyAfterPts <= 25 and (hiddenFibBuyTouch or hiddenFibInBuyZone) and (bullReject or bullMomentum or close > open)
capFibAssistLooseSell = tradeableBase and hiddenFibActive and hiddenFibSellRecent and hiddenFibSellAfterPts <= 25 and (hiddenFibSellTouch or hiddenFibInSellZone) and (bearReject or bearMomentum or close < open)
capFibAssistStrictBuy = tradeableBase and hiddenFibBuyOK and not na(hiddenFibBarsSinceBuy) and hiddenFibBarsSinceBuy <= 1 and hiddenFibBuyAfterPts <= 10 and sy358BuyAssistStory and bullReject and roomBuy and htfScore >= 0
capFibAssistStrictSell = tradeableBase and hiddenFibSellOK and not na(hiddenFibBarsSinceSell) and hiddenFibBarsSinceSell <= 1 and hiddenFibSellAfterPts <= 10 and sy358SellAssistStory and bearReject and roomSell and htfScore <= 0

// 22 — Hidden Liquidity Sweep Assist
capLiqExactBuy = sy361LiqBoostBuy
capLiqExactSell = sy361LiqBoostSell
capLiqLooseBuy = tradeableBase and hiddenLiqBuyRecent and hiddenLiqBuyAfterPts <= 25 and (bullReject or bullMomentum or close > open)
capLiqLooseSell = tradeableBase and hiddenLiqSellRecent and hiddenLiqSellAfterPts <= 25 and (bearReject or bearMomentum or close < open)
capLiqStrictBuy = tradeableBase and hiddenLiqFastBuyRaw and hiddenLiqSlowBuyRaw and not na(hiddenLiqBarsSinceBuy) and hiddenLiqBarsSinceBuy <= 3 and hiddenLiqBuyAfterPts <= 10 and bullReject and roomBuy
capLiqStrictSell = tradeableBase and hiddenLiqFastSellRaw and hiddenLiqSlowSellRaw and not na(hiddenLiqBarsSinceSell) and hiddenLiqBarsSinceSell <= 3 and hiddenLiqSellAfterPts <= 10 and bearReject and roomSell

// 23 — M1 SMART TAKE
capM1Slope8 = (ema20 - ema20[8]) / m1AtrSafe
capM1Slope12 = (ema20 - ema20[12]) / m1AtrSafe
capM1Hi3 = ta.highest(high, 3)[1]
capM1Lo3 = ta.lowest(low, 3)[1]
capM1Hi6 = ta.highest(high, 6)[1]
capM1Lo6 = ta.lowest(low, 6)[1]
capM1Comp6H = ta.highest(high, 6)[1]
capM1Comp6L = ta.lowest(low, 6)[1]
capM1Comp10H = ta.highest(high, 10)[1]
capM1Comp10L = ta.lowest(low, 10)[1]
capM1Comp6 = (capM1Comp6H - capM1Comp6L) / math.max(atr[1], syminfo.mintick) <= 3.60
capM1Comp10 = (capM1Comp10H - capM1Comp10L) / math.max(atr[1], syminfo.mintick) <= 2.70
capM1ExactBuy = m1BosBuyRaw
capM1ExactSell = m1BosSellRaw
capM1LooseBuy = tradeableBase and htfScore >= 1.5 and tf15Dir != -1 and ema20 > ema50 and capM1Slope8 >= 0.14 and adx >= 15 and pDI > mDI and capM1Comp6 and close > capM1Hi3 and bodyPct >= 18 and closePosBuy >= 0.58 and (close - ema20) / m1AtrSafe <= 3.4 and roomBuy
capM1LooseSell = tradeableBase and htfScore <= -1.5 and tf15Dir != 1 and ema20 < ema50 and capM1Slope8 <= -0.14 and adx >= 15 and mDI > pDI and capM1Comp6 and close < capM1Lo3 and bodyPct >= 18 and closePosSell >= 0.58 and (ema20 - close) / m1AtrSafe <= 3.4 and roomSell
capM1StrictBuy = tradeableBase and htfScore >= 2.5 and tf15Dir == 1 and ema20 > ema50 and capM1Slope12 >= 0.24 and adx >= 21 and pDI > mDI and capM1Comp10 and close > capM1Hi6 and bodyPct >= 32 and closePosBuy >= 0.68 and (close - ema20) / m1AtrSafe <= 0.9 and roomBuy
capM1StrictSell = tradeableBase and htfScore <= -2.5 and tf15Dir == -1 and ema20 < ema50 and capM1Slope12 <= -0.24 and adx >= 21 and mDI > pDI and capM1Comp10 and close < capM1Lo6 and bodyPct >= 32 and closePosSell >= 0.68 and (ema20 - close) / m1AtrSafe <= 0.9 and roomSell

// 24 — POC Order Block + Breaker
capPocExactBuy = pbPairBuy
capPocExactSell = pbPairSell
capPocLooseObBuyRecent = not na(pbObBuyBars) and pbObBuyBars <= 6
capPocLooseObSellRecent = not na(pbObSellBars) and pbObSellBars <= 6
capPocLooseBrBuyRecent = not na(pbBreakerBuyBars) and pbBreakerBuyBars <= 6
capPocLooseBrSellRecent = not na(pbBreakerSellBars) and pbBreakerSellBars <= 6
capPocLooseBuy = tradeableBase and ((pbObBuyNow and capPocLooseBrBuyRecent) or (pbBreakerBuyNow and capPocLooseObBuyRecent)) and bodyPct >= 18 and closePosBuy >= 0.54
capPocLooseSell = tradeableBase and ((pbObSellNow and capPocLooseBrSellRecent) or (pbBreakerSellNow and capPocLooseObSellRecent)) and bodyPct >= 18 and closePosSell >= 0.54
capPocStrictObBuyRecent = not na(pbObBuyBars) and pbObBuyBars <= 2
capPocStrictObSellRecent = not na(pbObSellBars) and pbObSellBars <= 2
capPocStrictBrBuyRecent = not na(pbBreakerBuyBars) and pbBreakerBuyBars <= 2
capPocStrictBrSellRecent = not na(pbBreakerSellBars) and pbBreakerSellBars <= 2
capPocStrictBuy = tradeableBase and ((pbObBuyNow and capPocStrictBrBuyRecent) or (pbBreakerBuyNow and capPocStrictObBuyRecent)) and bodyPct >= 32 and closePosBuy >= 0.66 and pbSlowBuyOK and roomBuy
capPocStrictSell = tradeableBase and ((pbObSellNow and capPocStrictBrSellRecent) or (pbBreakerSellNow and capPocStrictObSellRecent)) and bodyPct >= 32 and closePosSell >= 0.66 and pbSlowSellOK and roomSell

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DEEP V2 SCHOOL-SPECIFIC SETTINGS
// MID = balanced neighborhood around current settings.
// ULTRA = selective neighborhood intended to protect quality.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// 01 Sweep / Reversal
capSweepMidBuy = tradeableBase and sweepLow and rangePos <= 38 and (bullReject or (bullMomentum and closePosBuy >= 0.62)) and bodyPct >= 20 and roomBuy
capSweepMidSell = tradeableBase and sweepHigh and rangePos >= 62 and (bearReject or (bearMomentum and closePosSell >= 0.62)) and bodyPct >= 20 and roomSell
capSweepUltraBuy = tradeableBase and sweepLow and discount and bullReject and bodyPct >= 40 and closePosBuy >= 0.72 and htfScore >= 0.5 and roomBuy
capSweepUltraSell = tradeableBase and sweepHigh and premium and bearReject and bodyPct >= 40 and closePosSell >= 0.72 and htfScore <= -0.5 and roomSell

// 02 Break & Retest
capRetHigh20 = ta.highest(high, 20)[1]
capRetLow20 = ta.lowest(low, 20)[1]
capRetHigh40 = ta.highest(high, 40)[1]
capRetLow40 = ta.lowest(low, 40)[1]
capRetMidBuy = tradeableBase and low <= capRetHigh20 + atr * 0.40 and close > capRetHigh20 and bodyPct >= 25 and closePosBuy >= 0.60 and roomBuy
capRetMidSell = tradeableBase and high >= capRetLow20 - atr * 0.40 and close < capRetLow20 and bodyPct >= 25 and closePosSell >= 0.60 and roomSell
capRetUltraBuy = tradeableBase and low <= capRetHigh40 + atr * 0.15 and close > capRetHigh40 and bodyPct >= 45 and closePosBuy >= 0.72 and htfScore >= 1.0 and roomBuy
capRetUltraSell = tradeableBase and high >= capRetLow40 - atr * 0.15 and close < capRetLow40 and bodyPct >= 45 and closePosSell >= 0.72 and htfScore <= -1.0 and roomSell

// 03 FVG
capFvgMidBuy = tradeableBase and low > high[2] and (low - high[2]) >= atr * 0.18 and close > ema20 and bodyPct >= 25 and closePosBuy >= 0.60 and roomBuy
capFvgMidSell = tradeableBase and high < low[2] and (low[2] - high) >= atr * 0.18 and close < ema20 and bodyPct >= 25 and closePosSell >= 0.60 and roomSell
capFvgUltraBuy = tradeableBase and low > high[2] and (low - high[2]) >= atr * 0.35 and close > ema20 and ema20 > ema50 and bodyPct >= 50 and closePosBuy >= 0.74 and htfScore >= 1.0 and roomBuy
capFvgUltraSell = tradeableBase and high < low[2] and (low[2] - high) >= atr * 0.35 and close < ema20 and ema20 < ema50 and bodyPct >= 50 and closePosSell >= 0.74 and htfScore <= -1.0 and roomSell

// 04 Fibonacci Range
capFibMidBuy = tradeableBase and rangePos >= 20 and rangePos <= 50 and (bullReject or bullMomentum) and bodyPct >= 22 and roomBuy
capFibMidSell = tradeableBase and rangePos >= 50 and rangePos <= 80 and (bearReject or bearMomentum) and bodyPct >= 22 and roomSell
capFibUltraBuy = tradeableBase and rangePos >= 30 and rangePos <= 42 and bullReject and bodyPct >= 35 and htfScore >= 0.5 and roomBuy
capFibUltraSell = tradeableBase and rangePos >= 58 and rangePos <= 70 and bearReject and bodyPct >= 35 and htfScore <= -0.5 and roomSell

// 05 Bollinger Range
capBB26Dev = ta.stdev(close, 20) * 2.60
capBB26U = bb20Basis + capBB26Dev
capBB26L = bb20Basis - capBB26Dev
capBBMidBuy = tradeableBase and adx < 20 and math.abs(htfScore) < 1.4 and low <= bb20L and bullReject and rangePos <= 28 and roomBuy
capBBMidSell = tradeableBase and adx < 20 and math.abs(htfScore) < 1.4 and high >= bb20U and bearReject and rangePos >= 72 and roomSell
capBBUltraBuy = tradeableBase and adx < 14 and math.abs(htfScore) < 0.8 and low <= capBB26L and bullReject and discount and closePosBuy >= 0.68 and roomBuy
capBBUltraSell = tradeableBase and adx < 14 and math.abs(htfScore) < 0.8 and high >= capBB26U and bearReject and premium and closePosSell >= 0.68 and roomSell

// 06 Momentum
capCleanMoveMid = math.abs(close - close[20]) / math.max(ta.sma(math.abs(close - close[1]), 20) * 20, syminfo.mintick) >= 0.25
capCleanMoveUltra = math.abs(close - close[20]) / math.max(ta.sma(math.abs(close - close[1]), 20) * 20, syminfo.mintick) >= 0.45
capMomMidBuy = tradeableBase and capCleanMoveMid and bullMomentum and bodyPct >= 35 and closePosBuy >= 0.65 and close > ema20 and htfScore >= 0.5 and roomBuy
capMomMidSell = tradeableBase and capCleanMoveMid and bearMomentum and bodyPct >= 35 and closePosSell >= 0.65 and close < ema20 and htfScore <= -0.5 and roomSell
capMomUltraBuy = tradeableBase and capCleanMoveUltra and bullMomentum and bodyPct >= 60 and closePosBuy >= 0.78 and close > ema50 and htfScore >= 2.0 and roomBuy
capMomUltraSell = tradeableBase and capCleanMoveUltra and bearMomentum and bodyPct >= 60 and closePosSell >= 0.78 and close < ema50 and htfScore <= -2.0 and roomSell

// 07 Quad
capQuadMidBuy = tradeableBase and capQuadVoteBuy >= 2 and close > ema20 and htfScore >= -0.25 and roomBuy
capQuadMidSell = tradeableBase and capQuadVoteSell >= 2 and close < ema20 and htfScore <= 0.25 and roomSell
capQuadUltraBuy = tradeableBase and capQuadVoteBuy >= 3 and close > ema50 and htfScore >= 0.75 and bodyPct >= 28 and roomBuy
capQuadUltraSell = tradeableBase and capQuadVoteSell >= 3 and close < ema50 and htfScore <= -0.75 and bodyPct >= 28 and roomSell

// 08 RSI14 Shift
capRsiLow60 = ta.lowest(rsi14, 60)
capRsiHigh60 = ta.highest(rsi14, 60)
capRsiLow100 = ta.lowest(rsi14, 100)
capRsiHigh100 = ta.highest(rsi14, 100)
capRsiMidBuy = tradeableBase and capRsiLow60 > 38 and rsi14[1] < 44 and rsi14 >= 44 and close > ema20 and roomBuy
capRsiMidSell = tradeableBase and capRsiHigh60 < 62 and rsi14[1] > 56 and rsi14 <= 56 and close < ema20 and roomSell
capRsiUltraBuy = tradeableBase and capRsiLow100 > 42 and rsi14[1] < 47 and rsi14 >= 47 and close > ema50 and htfScore >= 0.75 and roomBuy
capRsiUltraSell = tradeableBase and capRsiHigh100 < 58 and rsi14[1] > 53 and rsi14 <= 53 and close < ema50 and htfScore <= -0.75 and roomSell

// 09 BB/KC Squeeze
capBBKCMidBuy = tradeableBase and capWasSq34 and not capSq34 and close > capBB34U2 and bodyPct >= 28 and htfScore >= 0 and roomBuy
capBBKCMidSell = tradeableBase and capWasSq34 and not capSq34 and close < capBB34L2 and bodyPct >= 28 and htfScore <= 0 and roomSell
capBBKCUltraBuy = tradeableBase and capWasSq70 and not capSq70 and close > capBB70U and bodyPct >= 50 and closePosBuy >= 0.72 and htfScore >= 1.0 and roomBuy
capBBKCUltraSell = tradeableBase and capWasSq70 and not capSq70 and close < capBB70L and bodyPct >= 50 and closePosSell >= 0.72 and htfScore <= -1.0 and roomSell

// 10 Trend Correction
capTCMidBuy = tradeableBase and trendCorrBuyContext and stoch10[1] < stoch10D[1] and stoch10 >= stoch10D and stoch10 < 70 and ta.lowest(stoch10, 40) < 32 and close > ema20 and roomBuy
capTCMidSell = tradeableBase and trendCorrSellContext and stoch10[1] > stoch10D[1] and stoch10 <= stoch10D and stoch10 > 30 and ta.highest(stoch10, 40) > 68 and close < ema20 and roomSell
capTCUltraBuy = tradeableBase and trendCorrBuyContext and stoch10[1] < stoch10D[1] and stoch10 >= stoch10D and stoch10 < 52 and ta.lowest(stoch10, 30) < 20 and adx >= 22 and bodyPct >= 40 and roomBuy
capTCUltraSell = tradeableBase and trendCorrSellContext and stoch10[1] > stoch10D[1] and stoch10 <= stoch10D and stoch10 > 48 and ta.highest(stoch10, 30) > 80 and adx >= 22 and bodyPct >= 40 and roomSell

// 11 QQE + Vortex
capRsi18 = ta.rsi(close, 18)
capRsi18S = ta.ema(capRsi18, 4)
capRsi18Sig = ta.ema(capRsi18S, 10)
capQVmidQBuy = tfCtxBuy and ta.crossover(capRsi18S, capRsi18Sig) and capRsi18S < 64
capQVmidQSell = tfCtxSell and ta.crossunder(capRsi18S, capRsi18Sig) and capRsi18S > 36
capTr21 = f_roll_sum(f_tr(high, low, close), 21)
capViP21 = capTr21 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(high - low[1]), 21) / capTr21
capViM21 = capTr21 <= syminfo.mintick ? 0.0 : f_roll_sum(math.abs(low - high[1]), 21) / capTr21
capQVMidBuy = tradeableBase and capQVmidQBuy and viPlus14 > viMinus14 and close > ema20 and roomBuy
capQVMidSell = tradeableBase and capQVmidQSell and viMinus14 > viPlus14 and close < ema20 and roomSell
capQVUltraBuy = tradeableBase and capQqeStrictBuy and capViP21 > capViM21 and pDI > mDI and adx >= 22 and htfScore >= 1.0 and roomBuy
capQVUltraSell = tradeableBase and capQqeStrictSell and capViM21 > capViP21 and mDI > pDI and adx >= 22 and htfScore <= -1.0 and roomSell

// 12 Donchian
capDon150H = ta.highest(high, 150)[1]
capDon150L = ta.lowest(low, 150)[1]
capDon150M = (capDon150H + capDon150L) / 2.0
capDon300H = ta.highest(high, 300)[1]
capDon300L = ta.lowest(low, 300)[1]
capDonMidBuy = tradeableBase and tf15Dir != -1 and (((close[1] < capDon100M[1] and close >= capDon100M) and bodyPct >= 28) or ((low < capDon250L and close > capDon250L) and bullReject)) and roomBuy
capDonMidSell = tradeableBase and tf15Dir != 1 and (((close[1] > capDon100M[1] and close <= capDon100M) and bodyPct >= 28) or ((high > capDon250H and close < capDon250H) and bearReject)) and roomSell
capDonUltraBuy = tradeableBase and tfCtxBuy and (((close[1] < capDon150M[1] and close >= capDon150M) and bodyPct >= 45 and closePosBuy >= 0.70) or ((low < capDon300L and close > capDon300L) and bullReject)) and roomBuy
capDonUltraSell = tradeableBase and tfCtxSell and (((close[1] > capDon150M[1] and close <= capDon150M) and bodyPct >= 45 and closePosSell >= 0.70) or ((high > capDon300H and close < capDon300H) and bearReject)) and roomSell

// 13 BB34 Squeeze
capBB34MidBuy = tradeableBase and tf15Dir != -1 and capBB20Sq[1] and close > capBB20U2 and ema20 > ema50 and bodyPct >= 30 and rangePos < 90 and roomBuy
capBB34MidSell = tradeableBase and tf15Dir != 1 and capBB20Sq[1] and close < capBB20L2 and ema20 < ema50 and bodyPct >= 30 and rangePos > 10 and roomSell
capBB34UltraBuy = tradeableBase and tfCtxBuy and capBB55Sq[1] and close > capBB55U and ema20 > ema50 and bodyPct >= 50 and closePosBuy >= 0.72 and roomBuy
capBB34UltraSell = tradeableBase and tfCtxSell and capBB55Sq[1] and close < capBB55L and ema20 < ema50 and bodyPct >= 50 and closePosSell >= 0.72 and roomSell

// 14 TRIX + SMI
capTrendVotesBuy = (trix15Buy ? 1 : 0) + (trix21Buy ? 1 : 0) + (trix34Buy ? 1 : 0) + (smi14Buy ? 1 : 0)
capTrendVotesSell = (trix15Sell ? 1 : 0) + (trix21Sell ? 1 : 0) + (trix34Sell ? 1 : 0) + (smi14Sell ? 1 : 0)
capTrendMidBuy = tradeableBase and capTrendVotesBuy >= 2 and tf15Dir != -1 and close > ema20 and roomBuy
capTrendMidSell = tradeableBase and capTrendVotesSell >= 2 and tf15Dir != 1 and close < ema20 and roomSell
capTrendUltraBuy = tradeableBase and capTrendVotesBuy >= 3 and tfCtxBuy and adx >= 22 and bodyPct >= 35 and close > ema50 and roomBuy
capTrendUltraSell = tradeableBase and capTrendVotesSell >= 3 and tfCtxSell and adx >= 22 and bodyPct >= 35 and close < ema50 and roomSell

// 15 VWAP Pullback
capVWAPMidBuy = tradeableBase and close > ema20 and ema20 > ema50 and capVWAPSlope8 >= 0.11 and ta.lowest(low, 5) <= vwapVal + atr * 0.24 and close > vwapVal and rsi14 >= 48 and rsi14 <= 72 and bodyPct >= 22 and roomBuy
capVWAPMidSell = tradeableBase and close < ema20 and ema20 < ema50 and capVWAPSlope8 <= -0.11 and ta.highest(high, 5) >= vwapVal - atr * 0.24 and close < vwapVal and rsi14 >= 28 and rsi14 <= 52 and bodyPct >= 22 and roomSell
capVWAPUltraBuy = tradeableBase and close > ema20 and ema20 > ema50 and capVWAPSlope8 >= 0.20 and ta.lowest(low, 3) <= vwapVal + atr * 0.08 and close > vwapVal and rsi14 >= 55 and rsi14 <= 65 and bodyPct >= 40 and htfScore >= 1.0 and roomBuy
capVWAPUltraSell = tradeableBase and close < ema20 and ema20 < ema50 and capVWAPSlope8 <= -0.20 and ta.highest(high, 3) >= vwapVal - atr * 0.08 and close < vwapVal and rsi14 >= 35 and rsi14 <= 45 and bodyPct >= 40 and htfScore <= -1.0 and roomSell

// 16 CCI Pullback
capCCI20 = ta.cci(hlc3, 20)
capCCI40 = ta.cci(hlc3, 40)
capCCIMidBuy = tradeableBase and close > ema20 and ema20 >= ema50 and ta.crossover(capCCI20, -100) and tf15Dir != -1 and roomBuy
capCCIMidSell = tradeableBase and close < ema20 and ema20 <= ema50 and ta.crossunder(capCCI20, 100) and tf15Dir != 1 and roomSell
capCCIUltraBuy = tradeableBase and sy326DriverBuy and ta.crossover(capCCI40, -140) and tfCtxBuy and adx >= 20 and bodyPct >= 38 and roomBuy
capCCIUltraSell = tradeableBase and sy326DriverSell and ta.crossunder(capCCI40, 140) and tfCtxSell and adx >= 20 and bodyPct >= 38 and roomSell

// 17 Range Edge
capRange60H = ta.highest(high, 60)
capRange60L = ta.lowest(low, 60)
capRange60R = math.max(capRange60H - capRange60L, syminfo.mintick)
capRange60ATR = capRange60R / math.max(atr, syminfo.mintick)
capRange60Pos = (close - capRange60L) / capRange60R * 100.0
capRange120H = ta.highest(high, 120)
capRange120L = ta.lowest(low, 120)
capRange120R = math.max(capRange120H - capRange120L, syminfo.mintick)
capRange120ATR = capRange120R / math.max(atr, syminfo.mintick)
capRange120Pos = (close - capRange120L) / capRange120R * 100.0
capRangeMidBuy = tradeableBase and capRange60ATR < 7.0 and capRange60Pos < 20 and stoch10 > stoch10D and bullReject and roomBuy
capRangeMidSell = tradeableBase and capRange60ATR < 7.0 and capRange60Pos > 80 and stoch10 < stoch10D and bearReject and roomSell
capRangeUltraBuy = tradeableBase and capRange120ATR < 5.0 and capRange120Pos < 10 and stoch10[1] < 18 and stoch10 > stoch10D and bullReject and roomBuy
capRangeUltraSell = tradeableBase and capRange120ATR < 5.0 and capRange120Pos > 90 and stoch10[1] > 82 and stoch10 < stoch10D and bearReject and roomSell

// 18 Ichimoku
capTen9 = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2.0
capKij26 = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2.0
capTen18 = (ta.highest(high, 18) + ta.lowest(low, 18)) / 2.0
capKij52 = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2.0
capIchiMidBuy = tradeableBase and ta.crossover(capTen9, capKij26) and close > ema20 and tf15Dir != -1 and roomBuy
capIchiMidSell = tradeableBase and ta.crossunder(capTen9, capKij26) and close < ema20 and tf15Dir != 1 and roomSell
capIchiUltraBuy = tradeableBase and ta.crossover(capTen18, capKij52) and close > ema100 and tfCtxBuy and bodyPct >= 38 and roomBuy
capIchiUltraSell = tradeableBase and ta.crossunder(capTen18, capKij52) and close < ema100 and tfCtxSell and bodyPct >= 38 and roomSell

// 19 SY331 Pack
cap331MidBuy = tradeableBase and cap331ExactBuy and bodyPct >= 24 and closePosBuy >= 0.58 and roomBuy
cap331MidSell = tradeableBase and cap331ExactSell and bodyPct >= 24 and closePosSell >= 0.58 and roomSell
cap331UltraBuy = tradeableBase and cap331ExactBuy and bodyPct >= 42 and closePosBuy >= 0.72 and htfScore >= 1.0 and roomBuy
cap331UltraSell = tradeableBase and cap331ExactSell and bodyPct >= 42 and closePosSell >= 0.72 and htfScore <= -1.0 and roomSell

// 20 SY336 Pack
cap336MidBuy = tradeableBase and sy336BuyBest and bodyPct >= 25 and closePosBuy >= 0.58 and htfScore >= 0 and roomBuy
cap336MidSell = tradeableBase and sy336SellBest and bodyPct >= 25 and closePosSell >= 0.58 and htfScore <= 0 and roomSell
cap336UltraBuy = tradeableBase and sy336BuyBest and bodyPct >= 45 and closePosBuy >= 0.74 and htfScore >= 1.5 and roomBuy
cap336UltraSell = tradeableBase and sy336SellBest and bodyPct >= 45 and closePosSell >= 0.74 and htfScore <= -1.5 and roomSell

// 21 Hidden Fib
capFibAssistMidBuy = tradeableBase and hiddenFibBuyOK and not na(hiddenFibBarsSinceBuy) and hiddenFibBarsSinceBuy <= 2 and hiddenFibBuyAfterPts <= 15 and sy358BuyAssistStory and (bullReject or bullMomentum) and roomBuy
capFibAssistMidSell = tradeableBase and hiddenFibSellOK and not na(hiddenFibBarsSinceSell) and hiddenFibBarsSinceSell <= 2 and hiddenFibSellAfterPts <= 15 and sy358SellAssistStory and (bearReject or bearMomentum) and roomSell
capFibAssistUltraBuy = tradeableBase and hiddenFibBuyOK and hiddenFibBarsSinceBuy == 0 and hiddenFibBuyAfterPts <= 5 and sy358BuyAssistStory and bullReject and bodyPct >= 35 and htfScore >= 0.5 and roomBuy
capFibAssistUltraSell = tradeableBase and hiddenFibSellOK and hiddenFibBarsSinceSell == 0 and hiddenFibSellAfterPts <= 5 and sy358SellAssistStory and bearReject and bodyPct >= 35 and htfScore <= -0.5 and roomSell

// 22 Hidden Liquidity
capLiqMidBuy = tradeableBase and hiddenLiqFastBuyRaw and hiddenLiqSlowBuyRaw and not na(hiddenLiqBarsSinceBuy) and hiddenLiqBarsSinceBuy <= 3 and hiddenLiqBuyAfterPts <= 15 and (bullReject or bullMomentum) and roomBuy
capLiqMidSell = tradeableBase and hiddenLiqFastSellRaw and hiddenLiqSlowSellRaw and not na(hiddenLiqBarsSinceSell) and hiddenLiqBarsSinceSell <= 3 and hiddenLiqSellAfterPts <= 15 and (bearReject or bearMomentum) and roomSell
capLiqUltraBuy = tradeableBase and hiddenLiqFastBuyRaw and hiddenLiqSlowBuyRaw and hiddenLiqBarsSinceBuy <= 1 and hiddenLiqBuyAfterPts <= 6 and bullReject and bodyPct >= 38 and htfScore >= 0.5 and roomBuy
capLiqUltraSell = tradeableBase and hiddenLiqFastSellRaw and hiddenLiqSlowSellRaw and hiddenLiqBarsSinceSell <= 1 and hiddenLiqSellAfterPts <= 6 and bearReject and bodyPct >= 38 and htfScore <= -0.5 and roomSell

// 23 M1 Smart
capM1MidBuy = tradeableBase and htfScore >= 2.0 and tf15Dir != -1 and ema20 > ema50 and capM1Slope8 >= 0.19 and adx >= 18 and pDI > mDI and capM1Comp6 and close > capM1Hi3 and bodyPct >= 25 and closePosBuy >= 0.63 and (close - ema20) / m1AtrSafe <= 2.0 and roomBuy
capM1MidSell = tradeableBase and htfScore <= -2.0 and tf15Dir != 1 and ema20 < ema50 and capM1Slope8 <= -0.19 and adx >= 18 and mDI > pDI and capM1Comp6 and close < capM1Lo3 and bodyPct >= 25 and closePosSell >= 0.63 and (ema20 - close) / m1AtrSafe <= 2.0 and roomSell
capM1UltraBuy = tradeableBase and htfScore >= 3.0 and tf15Dir == 1 and ema20 > ema50 and capM1Slope12 >= 0.30 and adx >= 25 and pDI > mDI and capM1Comp10 and close > capM1Hi6 and bodyPct >= 40 and closePosBuy >= 0.74 and (close - ema20) / m1AtrSafe <= 0.65 and roomBuy
capM1UltraSell = tradeableBase and htfScore <= -3.0 and tf15Dir == -1 and ema20 < ema50 and capM1Slope12 <= -0.30 and adx >= 25 and mDI > pDI and capM1Comp10 and close < capM1Lo6 and bodyPct >= 40 and closePosSell >= 0.74 and (ema20 - close) / m1AtrSafe <= 0.65 and roomSell

// 24 POC + Breaker
capPocMidObBuyRecent = not na(pbObBuyBars) and pbObBuyBars <= 3
capPocMidObSellRecent = not na(pbObSellBars) and pbObSellBars <= 3
capPocMidBrBuyRecent = not na(pbBreakerBuyBars) and pbBreakerBuyBars <= 3
capPocMidBrSellRecent = not na(pbBreakerSellBars) and pbBreakerSellBars <= 3
capPocMidBuy = tradeableBase and ((pbObBuyNow and capPocMidBrBuyRecent) or (pbBreakerBuyNow and capPocMidObBuyRecent)) and bodyPct >= 25 and closePosBuy >= 0.60 and pbSlowBuyOK and roomBuy
capPocMidSell = tradeableBase and ((pbObSellNow and capPocMidBrSellRecent) or (pbBreakerSellNow and capPocMidObSellRecent)) and bodyPct >= 25 and closePosSell >= 0.60 and pbSlowSellOK and roomSell
capPocUltraObBuyRecent = not na(pbObBuyBars) and pbObBuyBars <= 1
capPocUltraObSellRecent = not na(pbObSellBars) and pbObSellBars <= 1
capPocUltraBrBuyRecent = not na(pbBreakerBuyBars) and pbBreakerBuyBars <= 1
capPocUltraBrSellRecent = not na(pbBreakerSellBars) and pbBreakerSellBars <= 1
capPocUltraBuy = tradeableBase and ((pbObBuyNow and capPocUltraBrBuyRecent) or (pbBreakerBuyNow and capPocUltraObBuyRecent)) and bodyPct >= 40 and closePosBuy >= 0.72 and pbSlowBuyOK and htfScore >= 0.5 and roomBuy
capPocUltraSell = tradeableBase and ((pbObSellNow and capPocUltraBrSellRecent) or (pbBreakerSellNow and capPocUltraObSellRecent)) and bodyPct >= 40 and closePosSell >= 0.72 and pbSlowSellOK and htfScore <= -0.5 and roomSell

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FINAL V4-8 SCHOOL FUSION ROUTER
// Best settings retained from the validated school labs:
// 06 Momentum       = ULTRA
// 09 BB/KC          = BUY EXACT
// 11 QQE + Vortex   = ULTRA
// 12 Donchian       = SELL EXACT
// 17 Range Edge     = ULTRA BUY / MID SELL
// 18 Ichimoku       = ULTRA BUY / MID SELL
// 19 SY331 Pack     = ULTRA BUY / MID SELL
// 22 Hidden Liquidity = EXACT
// 23 M1 Smart       = MID
// Trend Correction, VWAP and Break & Retest are excluded only from
// extra Fusion entries; their original BASE logic is unchanged.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_final_school_side(_buy, _sell) =>
    _buy and not _sell ? 1 : _sell and not _buy ? -1 : 0

finalS06 = f_final_school_side(capMomUltraBuy, capMomUltraSell)
finalS09 = f_final_school_side(capBBKCExactBuy, false)
finalS11 = f_final_school_side(capQVUltraBuy, capQVUltraSell)
finalS12 = f_final_school_side(false, capDonExactSell)
finalS17 = f_final_school_side(capRangeUltraBuy, capRangeMidSell)
finalS18 = f_final_school_side(capIchiUltraBuy, capIchiMidSell)
finalS19 = f_final_school_side(cap331UltraBuy, cap331MidSell)
finalS22 = f_final_school_side(capLiqExactBuy, capLiqExactSell)
finalS23 = f_final_school_side(capM1MidBuy, capM1MidSell)

finalFusionBuyVotes = (finalS06 == 1 ? 1 : 0) + (finalS09 == 1 ? 1 : 0) + (finalS11 == 1 ? 1 : 0) + (finalS12 == 1 ? 1 : 0) + (finalS17 == 1 ? 1 : 0) + (finalS18 == 1 ? 1 : 0) + (finalS19 == 1 ? 1 : 0) + (finalS22 == 1 ? 1 : 0) + (finalS23 == 1 ? 1 : 0)
finalFusionSellVotes = (finalS06 == -1 ? 1 : 0) + (finalS09 == -1 ? 1 : 0) + (finalS11 == -1 ? 1 : 0) + (finalS12 == -1 ? 1 : 0) + (finalS17 == -1 ? 1 : 0) + (finalS18 == -1 ? 1 : 0) + (finalS19 == -1 ? 1 : 0) + (finalS22 == -1 ? 1 : 0) + (finalS23 == -1 ? 1 : 0)

finalFusionBuy = useFinalSchoolFusion and finalFusionBuyVotes > finalFusionSellVotes
finalFusionSell = useFinalSchoolFusion and finalFusionSellVotes > finalFusionBuyVotes
int finalFusionSide = finalFusionBuy ? 1 : finalFusionSell ? -1 : 0

finalFusionWinningVotes = finalFusionSide == 1 ? finalFusionBuyVotes : finalFusionSide == -1 ? finalFusionSellVotes : 0
finalFusionM1Only = finalFusionWinningVotes == 1 and ((finalFusionSide == 1 and finalS23 == 1) or (finalFusionSide == -1 and finalS23 == -1))
int finalFusionSourceCode = finalFusionSide == 0 ? 0 : finalFusionM1Only ? 1 : 6

// Existing BASE + Trend Vote always has priority.
int syFinalSelectedSide = syCleanSelectedSide != 0 ? syCleanSelectedSide : finalFusionSide
int syFinalSelectedSourceCode = syCleanSelectedSide != 0 ? syCleanSelectedSourceCode : finalFusionSourceCode

buySignal := syFinalSelectedSide == 1
sellSignal := syFinalSelectedSide == -1
m1SelectedSourceCode := syFinalSelectedSourceCode

plotshape(showFinalFusionMarks and syCleanSelectedSide == 0 and finalFusionSide == 1, title="FINAL FUSION BUY", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), text="F", textcolor=color.black, size=size.tiny)
plotshape(showFinalFusionMarks and syCleanSelectedSide == 0 and finalFusionSide == -1, title="FINAL FUSION SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), text="F", textcolor=color.white, size=size.tiny)

plotshape(trendVoteShowMarks and sy8624SelectedSide == 0 and tvAddonSide == 1, title="TREND VOTE CLEAN BUY", style=shape.triangleup, location=location.belowbar, color=color.new(color.aqua, 0), text="TV", textcolor=color.black, size=size.tiny)
plotshape(trendVoteShowMarks and sy8624SelectedSide == 0 and tvAddonSide == -1, title="TREND VOTE CLEAN SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), text="TV", textcolor=color.black, size=size.tiny)

