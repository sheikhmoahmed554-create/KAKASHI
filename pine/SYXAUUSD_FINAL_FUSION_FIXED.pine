// SYXAUUSD REGIME 80 STATE MAP
// The live manager learns only from prior closed baseline trades.
// The active trade never teaches the learner before its own decision.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
sy999BuyCounter = sy389BiasDown or htfScore <= -0.5
sy999SellCounter = sy389BiasUp or htfScore >= 0.5
sy999SignalCounter = buySignal ? sy999BuyCounter : sy999SellCounter
sy999SignalAligned = buySignal ? (sy389BiasUp or htfScore > 0) : (sy389BiasDown or htfScore < 0)
sy999SignalStrongAligned = sy999SignalAligned and math.abs(htfScore) >= 2.0 and adx >= 20
sy999SignalRange = math.abs(htfScore) < 1.0 and adx < 20
sy999SignalHighVol = atrRatio >= 1.55
sy999SignalQuiet = atrRatio <= 0.72 or adx < 15
sy999SignalRegime = (vtzActive or sy999SignalHighVol) ? 4 : sy999SignalCounter ? 3 : (sy999SignalRange or sy999SignalQuiet) ? 2 : sy999SignalStrongAligned ? 0 : 1

f_sy999_progress_bin(_mfe, _target) =>
    _x = _mfe / math.max(_target, 1.0)
    _x < 0.15 ? 0 : _x < 0.35 ? 1 : _x < 0.60 ? 2 : _x < 0.85 ? 3 : 4

f_sy999_adverse_bin(_mae, _stop) =>
    _x = _mae / math.max(_stop, 1.0)
    _x < 0.15 ? 0 : _x < 0.35 ? 1 : _x < 0.60 ? 2 : _x < 0.85 ? 3 : 4

f_sy999_time_bin(_bars) =>
    _bars <= 2 ? 0 : _bars <= 5 ? 1 : _bars <= 10 ? 2 : _bars <= 20 ? 3 : 4

f_sy999_regime_key(_regime, _mfe, _mae, _bars, _target, _stop) =>
    _rg = math.max(0, math.min(4, _regime))
    _pg = f_sy999_progress_bin(_mfe, _target)
    _ad = f_sy999_adverse_bin(_mae, _stop)
    _tb = f_sy999_time_bin(_bars)
    (((_rg * 5) + _pg) * 5 + _ad) * 5 + _tb

f_sy999_prob(array<int> _cnt, array<int> _win, _key) =>
    _n = _key >= 0 and _key < array.size(_cnt) ? array.get(_cnt, _key) : 0
    _w = _key >= 0 and _key < array.size(_win) ? array.get(_win, _key) : 0
    _p = (_w + wfPriorWinRate * wfPriorStrength) / math.max(_n + wfPriorStrength, 1.0)
    [_p, _n]

f_sy999_upper_bound(_p, _n) =>
    _se = math.sqrt(math.max(_p * (1.0 - _p), 0.000001) / math.max(_n + wfPriorStrength, 1.0))
    math.min(1.0, _p + wfConfidenceZ * _se)

f_sy999_regime80_exit(_pnl, _mfe, _bars, _target, _stop, _pR, _nR) =>
    _holdR = _pR * _target - (1.0 - _pR) * _stop
    _advR = _pnl - _holdR
    _giveback = _mfe - _pnl
    _profitProtect = _pnl >= realCostPts + 6.0 and _giveback >= math.max(8.0, _target * 0.14)
    _uR = f_sy999_upper_bound(_pR, _nR)
    _bars >= 3 and _nR >= wfMinSamples and _profitProtect and _uR < 0.80 and _advR >= math.max(5.0, wfMinExitAdvantage - 2.0)

f_sy999_add_unique(array<int> _a, _v) =>
    if array.indexof(_a, _v) == -1
        array.push(_a, _v)

f_sy999_learn_update(array<int> _cnt, array<int> _win, array<int> _visited, _isWin) =>
    if array.size(_visited) > 0
        for i = 0 to array.size(_visited) - 1
            _k = array.get(_visited, i)
            if _k >= 0 and _k < array.size(_cnt)
                array.set(_cnt, _k, array.get(_cnt, _k) + 1)
                if _isWin
                    array.set(_win, _k, array.get(_win, _k) + 1)

// SYXAUUSD CURRENT ADAPTIVE TP/SL
// Exact dynamic TP/SL plan used by SY973F.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_sy999_current_plan(_side, _entry) =>
    _buy = _side == 1
    _atrSafe = math.max(atr, syminfo.mintick)
    _atrPts = _atrSafe / pointUnit

    // Normalize user inputs so every entered TP/SL value is respected.
    // There are no hidden 120-point TP or 100-point SL caps anymore.
    _stopLo = math.max(1.0, math.min(smartMinStopPts, smartMaxStopPts))
    _stopHi = math.max(_stopLo, math.max(smartMinStopPts, smartMaxStopPts))
    _targetLo = math.max(1.0, math.min(smartMinTargetPts, smartMaxTargetPts))
    _targetHi = math.max(_targetLo, math.max(smartMinTargetPts, smartMaxTargetPts))

    _trend = _buy ? (powerUp or localTrendBuy or mapBuy or sy130TrendUp or htfScore >= 2.0 or (adx >= smartMomentumADX and pDI > mDI) or bullMomentum) : (powerDown or localTrendSell or mapSell or sy130TrendDown or htfScore <= -2.0 or (adx >= smartMomentumADX and mDI > pDI) or bearMomentum)
    _sweep = _buy ? (sweepLow or realRevBuy or sy338TrueCounterBuy or sy361LiqBoostBuy) : (sweepHigh or realRevSell or sy338TrueCounterSell or sy361LiqBoostSell)
    _highVol = atrRatio >= smartHighVolRatio or barRange / _atrSafe >= 1.35
    _chop = rangeMarket or (adx <= smartChopADX and math.abs(htfScore) < 1.5 and atrRatio < smartHighVolRatio)

    _buf = smartFixedBufferPts + _atrPts * smartATRBufferMult + ((_highVol or _sweep) ? smartMomentumStopAdd : 0.0)
    _rawStop = _buy ? (_entry - ta.lowest(low, smartStopLookback)) / pointUnit + _buf : (ta.highest(high, smartStopLookback) - _entry) / pointUnit + _buf
    _stop = f_clamp_float(_rawStop, _stopLo, _stopHi)

    _stateMaxRaw = _chop ? math.max(_targetLo, _targetHi - smartChopTargetCut) : _trend ? _targetHi : math.max(_targetLo, _targetHi - smartChopTargetCut * 0.35)
    _stateMax = f_clamp_float(_stateMaxRaw, _targetLo, _targetHi)
    _minT = f_clamp_float(math.max(_targetLo, _stop * smartMinRR), _targetLo, _stateMax)
    _maxT = f_clamp_float(math.max(_minT, _stop * smartMaxRR), _minT, _stateMax)
    _swing = _buy ? f_nearest_buy_liq_pts(_entry, _minT, _maxT, smartTargetLookback, true, pointUnit) : f_nearest_sell_liq_pts(_entry, _minT, _maxT, smartTargetLookback, true, pointUnit)
    _any = na(_swing) and not smartUseSwingTargetOnly ? (_buy ? f_nearest_buy_liq_pts(_entry, _minT, _maxT, smartTargetLookback, false, pointUnit) : f_nearest_sell_liq_pts(_entry, _minT, _maxT, smartTargetLookback, false, pointUnit)) : _swing
    _fallbackRaw = _trend ? targetPoints + smartMomentumTargetAdd : _chop ? targetPoints - smartChopTargetCut : targetPoints
    _fallback = f_clamp_float(_fallbackRaw, _minT, _maxT)
    _target = na(_any) ? _fallback : _any

    [math.round(f_clamp_float(_target, _targetLo, _targetHi)), math.round(f_clamp_float(_stop, _stopLo, _stopHi))]

// Live source-specific plan.
// IMPORTANT: f_sy999_current_plan() remains unchanged for the historical
// REGIME 80 learner, matching the winning shadow-test architecture.
f_sy999_source_plan(_side, _entry, _sourceCode) =>
    [_adaptiveTarget, _adaptiveStop] = f_sy999_current_plan(_side, _entry)

    float _target = useSmartExitPlanner ? _adaptiveTarget : targetPoints
    float _stop = useSmartExitPlanner ? _adaptiveStop : stopPoints

    _isM1Source = _sourceCode >= 1 and _sourceCode <= 3
    _isPocSource = _sourceCode == 4

    // Winning asymmetric setup: change M1 risk only for SELL.
    if useSourceRiskManager and useM1SellFixedRisk and _isM1Source and _side == -1
        _target := m1SellTargetPoints
        _stop := m1SellStopPoints

    // Winning POC setup: preserve adaptive stop and extend adaptive target.
    if useSourceRiskManager and usePocTargetExtension and _isPocSource
        _target := _adaptiveTarget + pocTargetAddPoints
        _stop := pocKeepAdaptiveStop ? _adaptiveStop : pocFixedStopPoints

    [math.round(_target), math.round(_stop)]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
