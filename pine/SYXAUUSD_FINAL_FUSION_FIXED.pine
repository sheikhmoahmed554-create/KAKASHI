var int lastResetKey = manualResetKey
var line sy348EntryLine = na
var line sy348TPLine = na
var line sy348SLLine = na
var bool sy348EntryBuyPlot = false
var bool sy348EntrySellPlot = false
var bool sy348ExitTPPlot = false
var bool sy348ExitSLPlot = false
var bool sy999ExitPlot = false
var int sy963LastWebhookAlertBar = na
var float sy999TradeMFE = 0.0
var float sy999TradeMAE = 0.0
var int sy999TradeRegime = 1
var int sy999TradeId = 0
var int sy999EarlyExitCount = 0
varip int sy999CloseAlertTradeId = na
varip int sy999IntrabarExitTradeId = na
varip float sy999IntrabarExitPrice = na

sy348EntryBuyPlot := false
sy348EntrySellPlot := false
sy348ExitTPPlot := false
sy348ExitSLPlot := false
sy999ExitPlot := false
realCloseRequestPlot := false

if statsResetByTime or manualResetKey != lastResetKey
    for i = 0 to 624
        array.set(sy999RCnt, i, 0)
        array.set(sy999RWin, i, 0)
    array.clear(sy999VisitedR)
    sy999LearnActive := false
    sy999LearnSide := 0
    sy999LearnEntry := na
    sy999LearnTP := na
    sy999LearnSL := na
    sy999LearnTarget := na
    sy999LearnStop := na
    sy999LearnMFE := 0.0
