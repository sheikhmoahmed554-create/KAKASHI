var int m1LiveM1Losses = 0
var int trendVoteLiveTrades = 0
var int trendVoteLiveWins = 0
var int trendVoteLiveLosses = 0
var int finalFusionLiveTrades = 0
var int finalFusionLiveWins = 0
var int finalFusionLiveLosses = 0
var int realClosePendingTradeId = na
var int realCloseLastSendBar = na
var int realCloseAttempts = 0
var int realCloseRequestCount = 0
var int realCloseEntryTime = na
