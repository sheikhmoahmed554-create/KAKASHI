    sy999LearnEntryBar := na
    sy999LearnLastTrade := na
    sy999LearnLastLongStop := na
    sy999LearnLastShortStop := na
    sy999LearnRegime := 1
    sy999LearnClosedTrades := 0

    active := false
    side := 0
    entryPrice := na
    tpPrice := na
    slPrice := na
    tradeTargetPts := na
    tradeStopPts := na
    tradeKind := 0
    entryBar := na
    lastTradeBar := na
    lastLongStopBar := na
    lastShortStopBar := na
    lastBuyRangeStopBar := na
    lastBuySweepStopBar := na
    lastBuyTrendStopBar := na
    lastSellRangeStopBar := na
    lastSellSweepStopBar := na
    lastSellTrendStopBar := na
    wins := 0
    losses := 0
    trades := 0
    longTrades := 0
    shortTrades := 0
    longWins := 0
    shortWins := 0
    curLoss := 0
    maxLoss := 0
    curWin := 0
    maxWin := 0
