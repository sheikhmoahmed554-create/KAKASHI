//@version=6
indicator("SY265", shorttitle="SY265", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200, max_bars_back=5000, dynamic_requests=true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SY265 YOUR SETTINGS LOCKED
// Defaults copied from your screenshots: Smart / 1m XAUUSD / UT Entry + Our Filters / Sell Balance More Sell.
// Fixes from SY183:
// 1) Table counts closed STOP/TP trades clearly.
// 2) More logical trades: trend pullback, continuation, sweep, retest, FVG, OB, fib, range edge.
// 3) Map is not only trend. It reads HTF trend, fib, premium/discount, liquidity, structure, value, momentum, room and veto.
// 4) Signals are confirmed after candle close only.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color BUY_C  = color.rgb(0, 170, 90)
color SELL_C = color.rgb(230, 45, 55)
color TP_C   = color.rgb(0, 120, 255)
color SL_C   = color.rgb(230, 45, 55)
color EN_C   = color.rgb(255, 210, 0)
color TXT_C  = color.white
color BG_C   = color.rgb(20, 20, 20)
color WAIT_C = color.rgb(150, 150, 150)
color WARN_C = color.rgb(255, 170, 0)

G_MAIN = "■ SY265 Real Market Map"
mode = input.string("Smart", "Mode", options=["Fast", "Smart", "Strict"], group=G_MAIN)
tradeSide = input.string("BOTH", "Trade Side", options=["BOTH", "LONG", "SHORT"], group=G_MAIN)
tfFast = input.timeframe("10", "HTF Fast Trend", group=G_MAIN)
tfZone = input.timeframe("60", "HTF Zone Map", group=G_MAIN)
tfBig = input.timeframe("240", "HTF Big Map", group=G_MAIN)
cooldownBars = input.int(6, "Cooldown Candles Between Trades", minval=0, maxval=500, group=G_MAIN)
lossCooldownBars = input.int(13, "Block Same Direction After STOP Candles", minval=0, maxval=500, group=G_MAIN)
maxTradesPerDay = input.int(200, "Max Trades Per Day", minval=1, maxval=500, group=G_MAIN)
minScoreFast = input.float(10, "Min Score Fast", minval=1, maxval=150, step=0.5, group=G_MAIN)
minScoreSmart = input.float(10, "Min Score Smart", minval=1, maxval=150, step=0.5, group=G_MAIN)
minScoreStrict = input.float(19, "Min Score Strict", minval=1, maxval=150, step=0.5, group=G_MAIN)
maxRiskFast = input.float(9, "Max Risk Fast", minval=0, maxval=100, step=0.5, group=G_MAIN)
maxRiskSmart = input.float(6.5, "Max Risk Smart", minval=0, maxval=100, step=0.5, group=G_MAIN)
maxRiskStrict = input.float(4.5, "Max Risk Strict", minval=0, maxval=100, step=0.5, group=G_MAIN)
minQFast = input.int(8, "Min Confirmed Map Questions Fast", minval=1, maxval=250, group=G_MAIN)
minQSmart = input.int(1, "Min Confirmed Map Questions Smart", minval=1, maxval=250, group=G_MAIN)
minQStrict = input.int(18, "Min Confirmed Map Questions Strict", minval=1, maxval=250, group=G_MAIN)
scoreGapFast = input.float(0.8, "Direction Gap Fast", minval=0, maxval=50, step=0.5, group=G_MAIN)
scoreGapSmart = input.float(1.3, "Direction Gap Smart", minval=0, maxval=50, step=0.5, group=G_MAIN)
scoreGapStrict = input.float(2.5, "Direction Gap Strict", minval=0, maxval=50, step=0.5, group=G_MAIN)

G_SCHOOL_TF = "■ School Timeframes"
useSchoolTF = input.bool(true, "Use Separate TF Per School", group=G_SCHOOL_TF)
