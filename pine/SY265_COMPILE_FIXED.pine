atrAvgLen = input.int(60, "ATR Average Length", minval=10, maxval=500, group=G_MOM)
minBodyPct = input.float(23.0, "Min Rejection Body %", minval=5, maxval=95, step=1, group=G_MOM)
strongBodyPct = input.float(46.0, "Strong Body %", minval=10, maxval=95, step=1, group=G_MOM)
minWickPct = input.float(10.0, "Min Rejection Wick %", minval=0, maxval=90, step=1, group=G_MOM)
maxSignalCandleATR = input.float(2.15, "Max Signal Candle ATR", minval=0.3, maxval=10, step=0.05, group=G_MOM)
newsSpikeATR = input.float(3, "Block Crazy Candle ATR", minval=0.8, maxval=10, step=0.05, group=G_MOM)
minAtrVsAvg = input.float(0.12, "Min ATR / Avg ATR", minval=0.01, maxval=3, step=0.05, group=G_MOM)
maxAtrVsAvg = input.float(4.8, "Max ATR / Avg ATR", minval=0.5, maxval=15, step=0.05, group=G_MOM)
maxChaseATR = input.float(1.7, "Max Chase From EMA20 ATR", minval=0.2, maxval=10, step=0.05, group=G_MOM)
exhaustATR = input.float(3.7, "Exhaustion Move ATR", minval=0.5, maxval=15, step=0.1, group=G_MOM)
volumeSpikeMult = input.float(1.3, "Volume Spike Mult", minval=0.5, maxval=10, step=0.05, group=G_MOM)

G_VIS = "■ Visual"
showSignals = input.bool(true, "Show BUY / SELL", group=G_VIS)
showTradeLines = input.bool(true, "Show Entry / TP / SL", group=G_VIS)
showTable = input.bool(true, "Show Stats + Map Table", group=G_VIS)
showHiddenMap = input.bool(false, "Show Hidden Map Zones", group=G_VIS)
showDebug = input.bool(false, "Show Debug Table", group=G_VIS)
cleanChartMode = input.bool(true, "Clean Chart Mode: Only BUY / SELL / ENTRY / TP / SL", group=G_VIS)
showSetupNamesOnSignal = input.bool(false, "Show Setup Name On Signal Label", group=G_VIS)
signalOffsetPts = input.int(8, "Signal Offset Points", minval=0, maxval=500, group=G_VIS)
lineBars = input.int(50, "Active Line Bars", minval=5, maxval=500, group=G_VIS)
tablePos = input.string("Top Right", "Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=G_VIS)
tableSizeInput = input.string("Small", "Table Size", options=["Tiny", "Small", "Normal"], group=G_VIS)

G_STATS = "■ Stats / Reset"
statsMode = input.string("All Loaded History", "Stats Count", options=["All Loaded History", "From Custom Time"], group=G_STATS)
statsStartTime = input.time(1783040400000, "Reset / Start Stats From", group=G_STATS)
manualResetKey = input.int(0, "Manual Reset Number", minval=0, group=G_STATS)

allowLong = tradeSide == "BOTH" or tradeSide == "LONG"
allowShort = tradeSide == "BOTH" or tradeSide == "SHORT"
minScore = mode == "Fast" ? minScoreFast : mode == "Strict" ? minScoreStrict : minScoreSmart
maxRisk = mode == "Fast" ? maxRiskFast : mode == "Strict" ? maxRiskStrict : maxRiskSmart
minQ = mode == "Fast" ? minQFast : mode == "Strict" ? minQStrict : minQSmart
scoreGap = mode == "Fast" ? scoreGapFast : mode == "Strict" ? scoreGapStrict : scoreGapSmart
pointUnit = math.max(pointUnitInput, syminfo.mintick)
slDist = stopPoints * pointUnit
tpDist = targetPoints * pointUnit
tblSize = tableSizeInput == "Tiny" ? size.tiny : tableSizeInput == "Normal" ? size.normal : size.small
tblPos = tablePos == "Bottom Right" ? position.bottom_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Left" ? position.bottom_left : position.top_right
statsActive = statsMode == "All Loaded History" or time >= statsStartTime
statsResetByTime = statsMode == "From Custom Time" and time >= statsStartTime and (na(time[1]) or time[1] < statsStartTime)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUNCTIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_er(_len) =>
    _change = math.abs(close - close[_len])
    _vol = ta.sma(math.abs(close - close[1]), _len) * _len
    _vol <= syminfo.mintick ? 0.0 : _change / _vol

f_rmi_value(_len, _mom) =>
    _momChg = close - close[_mom]
    _up = ta.rma(math.max(_momChg, 0.0), _len)
    _dn = ta.rma(math.max(-_momChg, 0.0), _len)
    _dn == 0.0 ? 100.0 : _up == 0.0 ? 0.0 : 100.0 - (100.0 / (1.0 + _up / _dn))

f_rmi_engine() =>
    _r = f_rmi_value(rmiLen, rmiMom)
    _rng = math.max(high - low, syminfo.mintick)
    _body = math.abs(close - open)
    _bodyPct = _body / _rng * 100.0
    _upW = (high - math.max(open, close)) / _rng * 100.0
    _dnW = (math.min(open, close) - low) / _rng * 100.0
    _cpB = (close - low) / _rng
    _cpS = (high - close) / _rng
    _bullReact = close > open and _dnW >= minWickPct and _cpB >= 0.55
    _bearReact = close < open and _upW >= minWickPct and _cpS >= 0.55
    _buy = (_r[1] <= rmiLower and _r > _r[1] and (not rmiMustReact or _bullReact)) or ta.crossover(_r, rmiLower)
    _sell = (_r[1] >= rmiUpper and _r < _r[1] and (not rmiMustReact or _bearReact)) or ta.crossunder(_r, rmiUpper)
    [_r, _buy, _sell, _bullReact, _bearReact]

f_rmi_flip_engine() =>
    _r = f_rmi_value(rmiFlipLen, rmiFlipMom)
    _sig = ta.ema(_r, rmiFlipSigLen)
    _blue = _r >= _sig
    _red = _r < _sig
    _blueFlip = _blue and not _blue[1]
    _redFlip = _red and not _red[1]
    _wasLow = ta.lowest(_r, rmiFlipBars + 1) <= rmiFlipLower
    _wasHigh = ta.highest(_r, rmiFlipBars + 1) >= rmiFlipUpper
    _crossUp = ta.crossover(_r, _sig) or ta.crossover(_r, rmiFlipLower)
    _crossDn = ta.crossunder(_r, _sig) or ta.crossunder(_r, rmiFlipUpper)
    _rng = math.max(high - low, syminfo.mintick)
    _upW = (high - math.max(open, close)) / _rng * 100.0
    _dnW = (math.min(open, close) - low) / _rng * 100.0
    _cpB = (close - low) / _rng
    _cpS = (high - close) / _rng
    _bullReact = close > open and _dnW >= minWickPct and _cpB >= 0.55
    _bearReact = close < open and _upW >= minWickPct and _cpS >= 0.55
    _buyColor = _wasLow and _blueFlip and (not rmiFlipNeedsCandle or _bullReact)
    _sellColor = _wasHigh and _redFlip and (not rmiFlipNeedsCandle or _bearReact)
    [_r, _sig, _blue, _red, _buyColor, _sellColor, _bullReact, _bearReact, _wasLow, _wasHigh, _crossUp, _crossDn]

f_htf_map() =>
    _emaFast = ta.ema(close, emaFastLen)[1]
    _emaMid = ta.ema(close, emaMidLen)[1]
    _emaSlow = ta.ema(close, emaSlowLen)[1]
    [_p, _m, _adxRaw] = ta.dmi(dmiLen, adxSmooth)
    _adx = _adxRaw[1]
    _erRaw = f_er(erLen)
    _er = _erRaw[1]
    _hi = ta.highest(high, htfSwingLen)[1]
    _lo = ta.lowest(low, htfSwingLen)[1]
    _rng = math.max(_hi - _lo, syminfo.mintick)
    _c = close[1]
    _emaBuy = _emaFast > _emaMid and _emaMid > _emaSlow and _c > _emaMid
    _emaSell = _emaFast < _emaMid and _emaMid < _emaSlow and _c < _emaMid
    _dmiBuy = _p[1] > _m[1]
    _dmiSell = _m[1] > _p[1]
    _dir = _emaBuy and _dmiBuy ? 1 : _emaSell and _dmiSell ? -1 : 0
    _fibBuyLow = _hi - _rng * 0.786
    _fibBuyHigh = _hi - _rng * 0.500
    _fibSellLow = _lo + _rng * 0.500
    _fibSellHigh = _lo + _rng * 0.786
    _pos = (_c - _lo) / _rng * 100.0
    [_dir, _adx, _er, _hi, _lo, _fibBuyLow, _fibBuyHigh, _fibSellLow, _fibSellHigh, _pos, _emaFast, _emaMid]

f_tf_pick(_raw) =>
    confirmSchoolTF ? _raw[1] : _raw

f_school_candle() =>
    _rng = math.max(high - low, syminfo.mintick)
    _body = math.abs(close - open)
    _bodyPct = _body / _rng * 100.0
    _upW = (high - math.max(open, close)) / _rng * 100.0
    _dnW = (math.min(open, close) - low) / _rng * 100.0
    _cpB = (close - low) / _rng
    _cpS = (high - close) / _rng
    _bullReject = close > open and _bodyPct >= minBodyPct and _dnW >= minWickPct and _cpB >= 0.55
    _bearReject = close < open and _bodyPct >= minBodyPct and _upW >= minWickPct and _cpS >= 0.55
    _bullMom = close > open and _bodyPct >= strongBodyPct and _cpB >= 0.55
    _bearMom = close < open and _bodyPct >= strongBodyPct and _cpS >= 0.55
    [_bullReject, _bearReject, _bullMom, _bearMom]

f_school_trend() =>
    _atr = ta.atr(atrLen)
    _ema9 = ta.ema(close, 9)
    _ema20 = ta.ema(close, 20)
    _ema34 = ta.ema(close, 34)
    _ema50 = ta.ema(close, 50)
    [_p, _m, _adx] = ta.dmi(dmiLen, adxSmooth)
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _valueBuy = low <= _ema20 + _atr * zoneAtrBuffer or low <= _ema34 + _atr * zoneAtrBuffer or low <= _ema50 + _atr * zoneAtrBuffer
    _valueSell = high >= _ema20 - _atr * zoneAtrBuffer or high >= _ema34 - _atr * zoneAtrBuffer or high >= _ema50 - _atr * zoneAtrBuffer
    _buy = _ema9 > _ema20 and _ema20 > _ema50 and close > _ema20 and _p >= _m and _valueBuy and (_bullReject or _bullMom)
    _sell = _ema9 < _ema20 and _ema20 < _ema50 and close < _ema20 and _m >= _p and _valueSell and (_bearReject or _bearMom)
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_continuation() =>
    _atr = ta.atr(atrLen)
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _h = ta.highest(high, math.max(pivotLen * 4, 10))[1]
    _l = ta.lowest(low, math.max(pivotLen * 4, 10))[1]
    _breakUp = not na(_h) and close > _h and close[1] <= _h
    _breakDn = not na(_l) and close < _l and close[1] >= _l
    _ema20 = ta.ema(close, 20)
    _ema50 = ta.ema(close, 50)
    _buy = _breakUp and _bullMom and close > _ema20 and _ema20 >= _ema50 and (high - low) <= _atr * maxSignalCandleATR
    _sell = _breakDn and _bearMom and close < _ema20 and _ema20 <= _ema50 and (high - low) <= _atr * maxSignalCandleATR
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_liquidity() =>
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _sh = ta.highest(high, sweepLen)[1]
    _sl = ta.lowest(low, sweepLen)[1]
    _ph = ta.pivothigh(high, pivotLen, pivotLen)
    _pl = ta.pivotlow(low, pivotLen, pivotLen)
    _lastPH = ta.valuewhen(not na(_ph), _ph, 0)
    _lastPL = ta.valuewhen(not na(_pl), _pl, 0)
    _mssUp = not na(_lastPH) and close > _lastPH and close[1] <= _lastPH
    _mssDn = not na(_lastPL) and close < _lastPL and close[1] >= _lastPL
    _buy = not na(_sl) and low < _sl and close > _sl and (_bullReject or _bullMom or _mssUp)
    _sell = not na(_sh) and high > _sh and close < _sh and (_bearReject or _bearMom or _mssDn)
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_structure() =>
    _ph = ta.pivothigh(high, pivotLen, pivotLen)
    _pl = ta.pivotlow(low, pivotLen, pivotLen)
    _lastPH = ta.valuewhen(not na(_ph), _ph, 0)
    _lastPL = ta.valuewhen(not na(_pl), _pl, 0)
    _prevPH = ta.valuewhen(not na(_ph), _ph, 1)
    _prevPL = ta.valuewhen(not na(_pl), _pl, 1)
    _up = (not na(_lastPH) and close > _lastPH and close[1] <= _lastPH) or (not na(_lastPH) and not na(_prevPH) and not na(_lastPL) and not na(_prevPL) and _lastPH > _prevPH and _lastPL > _prevPL)
    _dn = (not na(_lastPL) and close < _lastPL and close[1] >= _lastPL) or (not na(_lastPH) and not na(_prevPH) and not na(_lastPL) and not na(_prevPL) and _lastPH < _prevPH and _lastPL < _prevPL)
    [f_tf_pick(_up), f_tf_pick(_dn)]

f_school_retest() =>
    _atr = ta.atr(atrLen)
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _ph = ta.pivothigh(high, pivotLen, pivotLen)
    _pl = ta.pivotlow(low, pivotLen, pivotLen)
    _lastPH = ta.valuewhen(not na(_ph), _ph, 0)
    _lastPL = ta.valuewhen(not na(_pl), _pl, 0)
    _brUp = not na(_lastPH) and close > _lastPH and close[1] <= _lastPH
    _brDn = not na(_lastPL) and close < _lastPL and close[1] >= _lastPL
    _barsUp = ta.barssince(_brUp)
    _barsDn = ta.barssince(_brDn)
    _res = ta.valuewhen(_brUp, _lastPH, 0)
    _sup = ta.valuewhen(_brDn, _lastPL, 0)
    _buy = not na(_barsUp) and _barsUp > 0 and _barsUp <= retestBars and not na(_res) and low <= _res + _atr * retestAtr and close > _res and (_bullReject or _bullMom)
    _sell = not na(_barsDn) and _barsDn > 0 and _barsDn <= retestBars and not na(_sup) and high >= _sup - _atr * retestAtr and close < _sup and (_bearReject or _bearMom)
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_ob() =>
    _atr = ta.atr(atrLen)
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _impUp = close > open and math.abs(close - open) >= _atr * impulseAtrMult and close > high[1]
    _impDn = close < open and math.abs(close - open) >= _atr * impulseAtrMult and close < low[1]
    _bLow = ta.valuewhen(_impUp, low[1], 0)
    _bHigh = ta.valuewhen(_impUp, high[1], 0)
    _sLow = ta.valuewhen(_impDn, low[1], 0)
    _sHigh = ta.valuewhen(_impDn, high[1], 0)
    _buy = not na(_bLow) and not na(_bHigh) and low <= _bHigh + _atr * obRetestAtr and close >= _bLow and (_bullReject or _bullMom)
    _sell = not na(_sLow) and not na(_sHigh) and high >= _sLow - _atr * obRetestAtr and close <= _sHigh and (_bearReject or _bearMom)
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_fvg() =>
    _atr = ta.atr(atrLen)
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _bullFVG = low > high[2] and (low - high[2]) >= _atr * fvgMinAtr
    _bearFVG = high < low[2] and (low[2] - high) >= _atr * fvgMinAtr
    _bLow = ta.valuewhen(_bullFVG, high[2], 0)
    _bHigh = ta.valuewhen(_bullFVG, low, 0)
    _sLow = ta.valuewhen(_bearFVG, high, 0)
    _sHigh = ta.valuewhen(_bearFVG, low[2], 0)
    _buy = not na(_bLow) and not na(_bHigh) and low <= _bHigh + _atr * fvgRetestAtr and close >= _bLow and (_bullReject or _bullMom)
    _sell = not na(_sLow) and not na(_sHigh) and high >= _sLow - _atr * fvgRetestAtr and close <= _sHigh and (_bearReject or _bearMom)
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_fib() =>
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _hi = ta.highest(high, localSwingLen)
    _lo = ta.lowest(low, localSwingLen)
    _rng = math.max(_hi - _lo, syminfo.mintick)
    _buyLow = _hi - _rng * 0.786
    _buyHigh = _hi - _rng * 0.500
    _sellLow = _lo + _rng * 0.500
    _sellHigh = _lo + _rng * 0.786
    _buy = close >= _buyLow and close <= _buyHigh and (_bullReject or _bullMom)
    _sell = close >= _sellLow and close <= _sellHigh and (_bearReject or _bearMom)
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_range() =>
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    [_p, _m, _adx] = ta.dmi(dmiLen, adxSmooth)
    _basis = ta.sma(close, 20)
    _dev = ta.stdev(close, 20) * 2.0
    _u = _basis + _dev
    _l = _basis - _dev
    _hi = ta.highest(high, localSwingLen)
    _lo = ta.lowest(low, localSwingLen)
    _rng = math.max(_hi - _lo, syminfo.mintick)
    _pos = (close - _lo) / _rng * 100.0
    _range = _adx < adxTrendMin
    _buy = _range and low <= _l and _bullReject and _pos <= discountLevel
    _sell = _range and high >= _u and _bearReject and _pos >= premiumLevel
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_value() =>
    _atr = ta.atr(atrLen)
    _ema20 = ta.ema(close, 20)
    _ema34 = ta.ema(close, 34)
    _ema50 = ta.ema(close, 50)
    _vw = ta.vwap(hlc3)
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _buy = (low <= _ema20 + _atr * zoneAtrBuffer or low <= _ema34 + _atr * zoneAtrBuffer or low <= _ema50 + _atr * zoneAtrBuffer or (not na(_vw) and low <= _vw + _atr * zoneAtrBuffer)) and (_bullReject or _bullMom)
    _sell = (high >= _ema20 - _atr * zoneAtrBuffer or high >= _ema34 - _atr * zoneAtrBuffer or high >= _ema50 - _atr * zoneAtrBuffer or (not na(_vw) and high >= _vw - _atr * zoneAtrBuffer)) and (_bearReject or _bearMom)
    [f_tf_pick(_buy), f_tf_pick(_sell)]

f_school_momentum() =>
    [_bullReject, _bearReject, _bullMom, _bearMom] = f_school_candle()
    _rsi = ta.rsi(close, 14)
    _rsiSlope = _rsi - _rsi[3]
    [_macdLine, _macdSignal, _macdHist] = ta.macd(close, 12, 26, 9)
    _macdUp = _macdHist > _macdHist[1] and _macdHist > _macdHist[2]
    _macdDown = _macdHist < _macdHist[1] and _macdHist < _macdHist[2]
    _volAvg = ta.sma(volume, 30)
    _volBull = _volAvg > 0 ? volume > _volAvg * volumeSpikeMult and close > open : false
    _volBear = _volAvg > 0 ? volume > _volAvg * volumeSpikeMult and close < open : false
    _buy = (_macdUp and _rsiSlope > 0) or _bullMom or _volBull or _bullReject
    _sell = (_macdDown and _rsiSlope < 0) or _bearMom or _volBear or _bearReject
    [f_tf_pick(_buy), f_tf_pick(_sell), f_tf_pick(_bullReject), f_tf_pick(_bearReject), f_tf_pick(_bullMom), f_tf_pick(_bearMom), f_tf_pick(_volBull), f_tf_pick(_volBear)]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HTF MAPS - CONFIRMED ONLY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[tf1Dir, tf1Adx, tf1Er, tf1High, tf1Low, tf1FibBL, tf1FibBH, tf1FibSL, tf1FibSH, tf1Pos, tf1EmaF, tf1EmaM] = request.security(syminfo.tickerid, tfFast, f_htf_map(), barmerge.gaps_off, barmerge.lookahead_off)
[tf2Dir, tf2Adx, tf2Er, tf2High, tf2Low, tf2FibBL, tf2FibBH, tf2FibSL, tf2FibSH, tf2Pos, tf2EmaF, tf2EmaM] = request.security(syminfo.tickerid, tfZone, f_htf_map(), barmerge.gaps_off, barmerge.lookahead_off)
[tf3Dir, tf3Adx, tf3Er, tf3High, tf3Low, tf3FibBL, tf3FibBH, tf3FibSL, tf3FibSH, tf3Pos, tf3EmaF, tf3EmaM] = request.security(syminfo.tickerid, tfBig, f_htf_map(), barmerge.gaps_off, barmerge.lookahead_off)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SCHOOL TIMEFRAME ENGINES - EACH SCHOOL CAN READ ITS OWN TF
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[tfTrendBuy, tfTrendSell] = request.security(syminfo.tickerid, trendSchoolTF, f_school_trend(), barmerge.gaps_off, barmerge.lookahead_off)
[tfContBuy, tfContSell] = request.security(syminfo.tickerid, continuationSchoolTF, f_school_continuation(), barmerge.gaps_off, barmerge.lookahead_off)
[tfLiqBuy, tfLiqSell] = request.security(syminfo.tickerid, liquiditySchoolTF, f_school_liquidity(), barmerge.gaps_off, barmerge.lookahead_off)
[tfStructBuy, tfStructSell] = request.security(syminfo.tickerid, structureSchoolTF, f_school_structure(), barmerge.gaps_off, barmerge.lookahead_off)
[tfRetestBuy, tfRetestSell] = request.security(syminfo.tickerid, retestSchoolTF, f_school_retest(), barmerge.gaps_off, barmerge.lookahead_off)
[tfOBBuy, tfOBSell] = request.security(syminfo.tickerid, obSchoolTF, f_school_ob(), barmerge.gaps_off, barmerge.lookahead_off)
[tfFVGBuy, tfFVGSell] = request.security(syminfo.tickerid, fvgSchoolTF, f_school_fvg(), barmerge.gaps_off, barmerge.lookahead_off)
[tfFibBuy, tfFibSell] = request.security(syminfo.tickerid, fibSchoolTF, f_school_fib(), barmerge.gaps_off, barmerge.lookahead_off)
[tfRangeBuy, tfRangeSell] = request.security(syminfo.tickerid, rangeSchoolTF, f_school_range(), barmerge.gaps_off, barmerge.lookahead_off)
[tfValueBuy, tfValueSell] = request.security(syminfo.tickerid, valueSchoolTF, f_school_value(), barmerge.gaps_off, barmerge.lookahead_off)
[tfMomBuy, tfMomSell, tfBullReject, tfBearReject, tfBullMomentum, tfBearMomentum, tfVolumeBull, tfVolumeBear] = request.security(syminfo.tickerid, momentumSchoolTF, f_school_momentum(), barmerge.gaps_off, barmerge.lookahead_off)

// RMI reaction is only an assist/filter, not a standalone entry.
[rmiVal, rmiBuyReactionRaw, rmiSellReactionRaw, rmiBullReact, rmiBearReact] = request.security(syminfo.tickerid, rmiTF, f_rmi_engine(), barmerge.gaps_off, barmerge.lookahead_off)
rmiBuyReaction = useRMI and rmiBuyReactionRaw
rmiSellReaction = useRMI and rmiSellReactionRaw
rmiFlipResolvedTF = rmiFlipTF == "" ? timeframe.period : rmiFlipTF
[rmiFlipVal, rmiFlipSig, rmiFlipBlue, rmiFlipRed, rmiFlipBuyColorRaw, rmiFlipSellColorRaw, rmiFlipBullReact, rmiFlipBearReact, rmiFlipWasLowRaw, rmiFlipWasHighRaw, rmiFlipCrossUpRaw, rmiFlipCrossDnRaw] = request.security(syminfo.tickerid, rmiFlipResolvedTF, f_rmi_flip_engine(), barmerge.gaps_off, barmerge.lookahead_off)
rmiFlipRecentLow = useRMIFlip and rmiFlipWasLowRaw
rmiFlipRecentHigh = useRMIFlip and rmiFlipWasHighRaw

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LOCAL MARKET MAP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
atr = ta.atr(atrLen)
atrAvg = ta.sma(atr, atrAvgLen)
atrRatio = atrAvg <= syminfo.mintick ? 1.0 : atr / atrAvg
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema34 = ta.ema(close, 34)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
vwapVal = ta.vwap(hlc3)
[pDI, mDI, adx] = ta.dmi(dmiLen, adxSmooth)
er = f_er(erLen)
barRange = math.max(high - low, syminfo.mintick)
body = math.abs(close - open)
bodyPct = body / barRange * 100.0
upperWickPct = (high - math.max(open, close)) / barRange * 100.0
lowerWickPct = (math.min(open, close) - low) / barRange * 100.0
closePosBuy = (close - low) / barRange
closePosSell = (high - close) / barRange
bullReject = close > open and bodyPct >= minBodyPct and lowerWickPct >= minWickPct and closePosBuy >= 0.55
bearReject = close < open and bodyPct >= minBodyPct and upperWickPct >= minWickPct and closePosSell >= 0.55
bullMomentum = close > open and bodyPct >= strongBodyPct and closePosBuy >= 0.55
bearMomentum = close < open and bodyPct >= strongBodyPct and closePosSell >= 0.55
signalCandleOK = barRange <= atr * maxSignalCandleATR
crazyCandle = barRange >= atr * newsSpikeATR or body >= atr * newsSpikeATR * 0.70
deadMarket = atrRatio < minAtrVsAvg
wildMarket = atrRatio > maxAtrVsAvg
volumeAvg = ta.sma(volume, 30)
volumeSpike = volumeAvg > 0 ? volume > volumeAvg * volumeSpikeMult : false
volumeBull = volumeSpike and close > open
volumeBear = volumeSpike and close < open
localHigh = ta.highest(high, localSwingLen)
localLow = ta.lowest(low, localSwingLen)
localRange = math.max(localHigh - localLow, syminfo.mintick)
rangePos = (close - localLow) / localRange * 100.0
premium = rangePos >= premiumLevel
discount = rangePos <= discountLevel
middleZone = rangePos >= middleLow and rangePos <= middleHigh
localTrendBuy = ema9 > ema20 and ema20 > ema50 and close > ema20 and pDI >= mDI
localTrendSell = ema9 < ema20 and ema20 < ema50 and close < ema20 and mDI >= pDI
localDir = localTrendBuy ? 1 : localTrendSell ? -1 : 0
htfBiasScore = (tf1Dir == 1 ? 1.0 : tf1Dir == -1 ? -1.0 : 0.0) + (tf2Dir == 1 ? 1.5 : tf2Dir == -1 ? -1.5 : 0.0) + (tf3Dir == 1 ? 2.0 : tf3Dir == -1 ? -2.0 : 0.0)
mapDir = htfBiasScore > 1.0 ? 1 : htfBiasScore < -1.0 ? -1 : 0
strongHTFBuy = htfBiasScore >= 3.0 and tf2Adx >= adxStrongMin
strongHTFSell = htfBiasScore <= -3.0 and tf2Adx >= adxStrongMin
powerUp = htfBiasScore >= 2.0 and ema20 > ema50 and close > ema20
powerDown = htfBiasScore <= -2.0 and ema20 < ema50 and close < ema20
conflictMarket = mapDir != 0 and localDir != 0 and mapDir != localDir
rangeMarket = adx < adxTrendMin and math.abs(htfBiasScore) < 1.5
cleanMove = er >= erCleanMin or tf1Er >= erCleanMin or tf2Er >= erCleanMin
tradeableBase = barstate.isconfirmed and signalCandleOK and not crazyCandle and not deadMarket and not wildMarket
trendPowerBuy = (localTrendBuy ? 1 : 0) + (tf1Dir == 1 ? 1 : 0) + (tf2Dir == 1 ? 1 : 0) + (tf3Dir == 1 ? 1 : 0)
trendPowerSell = (localTrendSell ? 1 : 0) + (tf1Dir == -1 ? 1 : 0) + (tf2Dir == -1 ? 1 : 0) + (tf3Dir == -1 ? 1 : 0)
alignmentBuy = mapDir >= 0 and localDir >= 0
alignmentSell = mapDir <= 0 and localDir <= 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FULL MAP ZONES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
inTF1FibBuy = close >= tf1FibBL and close <= tf1FibBH
inTF2FibBuy = close >= tf2FibBL and close <= tf2FibBH
inTF3FibBuy = close >= tf3FibBL and close <= tf3FibBH
inTF1FibSell = close >= tf1FibSL and close <= tf1FibSH
inTF2FibSell = close >= tf2FibSL and close <= tf2FibSH
inTF3FibSell = close >= tf3FibSL and close <= tf3FibSH
nearTF1Low = math.abs(close - tf1Low) / pointUnit <= nearHTFPoints
nearTF2Low = math.abs(close - tf2Low) / pointUnit <= nearHTFPoints
nearTF3Low = math.abs(close - tf3Low) / pointUnit <= nearHTFPoints
nearTF1High = math.abs(close - tf1High) / pointUnit <= nearHTFPoints
nearTF2High = math.abs(close - tf2High) / pointUnit <= nearHTFPoints
nearTF3High = math.abs(close - tf3High) / pointUnit <= nearHTFPoints
htfBuyZone = inTF1FibBuy or inTF2FibBuy or inTF3FibBuy or nearTF1Low or nearTF2Low or nearTF3Low or tf2Pos <= 30 or tf3Pos <= 30
htfSellZone = inTF1FibSell or inTF2FibSell or inTF3FibSell or nearTF1High or nearTF2High or nearTF3High or tf2Pos >= 70 or tf3Pos >= 70
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
lastPH = ta.valuewhen(not na(ph), ph, 0)
lastPL = ta.valuewhen(not na(pl), pl, 0)
prevPH = ta.valuewhen(not na(ph), ph, 1)
prevPL = ta.valuewhen(not na(pl), pl, 1)
structureUp = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH > prevPH and lastPL > prevPL
structureDown = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH < prevPH and lastPL < prevPL
mssUp = not na(lastPH) and close > lastPH and close[1] <= lastPH
mssDown = not na(lastPL) and close < lastPL and close[1] >= lastPL
supportTouch = not na(lastPL) and low <= lastPL + atr * zoneAtrBuffer and close > lastPL
resistanceTouch = not na(lastPH) and high >= lastPH - atr * zoneAtrBuffer and close < lastPH
supportRejectBuy = supportTouch and bullReject
resistanceRejectSell = resistanceTouch and bearReject
sweepHighLevel = ta.highest(high, sweepLen)[1]
sweepLowLevel = ta.lowest(low, sweepLen)[1]
sweepLow = not na(sweepLowLevel) and low < sweepLowLevel and close > sweepLowLevel
sweepHigh = not na(sweepHighLevel) and high > sweepHighLevel and close < sweepHighLevel
sweepLowConfirm = sweepLow and (bullReject or bullMomentum or mssUp)
sweepHighConfirm = sweepHigh and (bearReject or bearMomentum or mssDown)
equalHighNear = not na(sweepHighLevel) and math.abs(high - sweepHighLevel) / pointUnit <= eqTolPoints
equalLowNear = not na(sweepLowLevel) and math.abs(low - sweepLowLevel) / pointUnit <= eqTolPoints
stopHuntBuy = sweepLowConfirm and (discount or htfBuyZone or rangeMarket)
stopHuntSell = sweepHighConfirm and (premium or htfSellZone or rangeMarket)
breakUp = not na(lastPH) and close > lastPH and close[1] <= lastPH
breakDown = not na(lastPL) and close < lastPL and close[1] >= lastPL
barsBreakUp = ta.barssince(breakUp)
barsBreakDown = ta.barssince(breakDown)
brokenRes = ta.valuewhen(breakUp, lastPH, 0)
brokenSup = ta.valuewhen(breakDown, lastPL, 0)
retestBuy = not na(barsBreakUp) and barsBreakUp > 0 and barsBreakUp <= retestBars and not na(brokenRes) and low <= brokenRes + atr * retestAtr and close > brokenRes
retestSell = not na(barsBreakDown) and barsBreakDown > 0 and barsBreakDown <= retestBars and not na(brokenSup) and high >= brokenSup - atr * retestAtr and close < brokenSup
retestBuyConfirm = retestBuy and (bullReject or bullMomentum or mssUp)
retestSellConfirm = retestSell and (bearReject or bearMomentum or mssDown)
impulseUp = close > open and body >= atr * impulseAtrMult and close > high[1]
impulseDown = close < open and body >= atr * impulseAtrMult and close < low[1]
bullOBLow = ta.valuewhen(impulseUp, low[1], 0)
bullOBHigh = ta.valuewhen(impulseUp, high[1], 0)
bearOBLow = ta.valuewhen(impulseDown, low[1], 0)
bearOBHigh = ta.valuewhen(impulseDown, high[1], 0)
inBullOB = not na(bullOBLow) and not na(bullOBHigh) and low <= bullOBHigh + atr * obRetestAtr and close >= bullOBLow
inBearOB = not na(bearOBLow) and not na(bearOBHigh) and high >= bearOBLow - atr * obRetestAtr and close <= bearOBHigh
bullOBConfirm = inBullOB and (bullReject or bullMomentum or mssUp)
bearOBConfirm = inBearOB and (bearReject or bearMomentum or mssDown)
bullFVG = low > high[2] and (low - high[2]) >= atr * fvgMinAtr
bearFVG = high < low[2] and (low[2] - high) >= atr * fvgMinAtr
lastBullFVGLow = ta.valuewhen(bullFVG, high[2], 0)
lastBullFVGHigh = ta.valuewhen(bullFVG, low, 0)
lastBearFVGLow = ta.valuewhen(bearFVG, high, 0)
lastBearFVGHigh = ta.valuewhen(bearFVG, low[2], 0)
inBullFVG = not na(lastBullFVGLow) and not na(lastBullFVGHigh) and low <= lastBullFVGHigh + atr * fvgRetestAtr and close >= lastBullFVGLow
inBearFVG = not na(lastBearFVGLow) and not na(lastBearFVGHigh) and high >= lastBearFVGLow - atr * fvgRetestAtr and close <= lastBearFVGHigh
bullFVGConfirm = inBullFVG and (bullReject or bullMomentum or mssUp)
bearFVGConfirm = inBearFVG and (bearReject or bearMomentum or mssDown)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VALUE / MOMENTUM / ROOM
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
valueBuy = low <= ema20 + atr * zoneAtrBuffer or low <= ema34 + atr * zoneAtrBuffer or low <= ema50 + atr * zoneAtrBuffer or (not na(vwapVal) and low <= vwapVal + atr * zoneAtrBuffer)
valueSell = high >= ema20 - atr * zoneAtrBuffer or high >= ema34 - atr * zoneAtrBuffer or high >= ema50 - atr * zoneAtrBuffer or (not na(vwapVal) and high >= vwapVal - atr * zoneAtrBuffer)
localFibBuyLow = localHigh - localRange * 0.786
localFibBuyHigh = localHigh - localRange * 0.500
localFibSellLow = localLow + localRange * 0.500
localFibSellHigh = localLow + localRange * 0.786
localFibBuy = close >= localFibBuyLow and close <= localFibBuyHigh
localFibSell = close >= localFibSellLow and close <= localFibSellHigh
fibBuyConfirm = (localFibBuy or inTF1FibBuy or inTF2FibBuy or inTF3FibBuy) and (bullReject or bullMomentum or mssUp)
fibSellConfirm = (localFibSell or inTF1FibSell or inTF2FibSell or inTF3FibSell) and (bearReject or bearMomentum or mssDown)
donHigh = ta.highest(high, 30)[1]
donLow = ta.lowest(low, 30)[1]
donMid = (donHigh + donLow) / 2.0
donBuy = not na(donMid) and low <= donMid + atr * zoneAtrBuffer and close > donMid and bullReject and not premium
donSell = not na(donMid) and high >= donMid - atr * zoneAtrBuffer and close < donMid and bearReject and not discount
bbBasis = ta.sma(close, 20)
bbDev = ta.stdev(close, 20) * 2.0
bbU = bbBasis + bbDev
bbL = bbBasis - bbDev
bbRangeBuy = rangeMarket and low <= bbL and bullReject and discount
bbRangeSell = rangeMarket and high >= bbU and bearReject and premium
rsi = ta.rsi(close, 14)
rsiSlope = rsi - rsi[3]
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
macdUp = macdHist > macdHist[1] and macdHist > macdHist[2]
macdDown = macdHist < macdHist[1] and macdHist < macdHist[2]
momentumBuy = (macdUp and rsiSlope > 0) or bullMomentum or volumeBull
momentumSell = (macdDown and rsiSlope < 0) or bearMomentum or volumeBear
moveFromLowATR = (close - ta.lowest(low, 30)) / math.max(atr, syminfo.mintick)
moveFromHighATR = (ta.highest(high, 30) - close) / math.max(atr, syminfo.mintick)
exhaustBuyRisk = premium and close > ema20 + atr * maxChaseATR and moveFromLowATR >= exhaustATR
exhaustSellRisk = discount and close < ema20 - atr * maxChaseATR and moveFromHighATR >= exhaustATR
exhaustionReversalBuy = discount and sweepLowConfirm and bullReject and moveFromHighATR >= exhaustATR * 0.50
exhaustionReversalSell = premium and sweepHighConfirm and bearReject and moveFromLowATR >= exhaustATR * 0.50
chaseBuyRisk = close > ema20 + atr * maxChaseATR and not retestBuyConfirm and not bullFVGConfirm and not bullOBConfirm and not breakUp
chaseSellRisk = close < ema20 - atr * maxChaseATR and not retestSellConfirm and not bearFVGConfirm and not bearOBConfirm and not breakDown
upMagnetRaw = math.max(localHigh, math.max(tf1High, math.max(tf2High, tf3High)))
downMagnetRaw = math.min(localLow, math.min(tf1Low, math.min(tf2Low, tf3Low)))
projectedUp = close + atr * 3.0
projectedDown = close - atr * 3.0
upTarget = upMagnetRaw > close ? upMagnetRaw : projectedUp
downTarget = downMagnetRaw < close ? downMagnetRaw : projectedDown
roomBuyPts = math.max((upTarget - close) / pointUnit, 0)
roomSellPts = math.max((close - downTarget) / pointUnit, 0)
roomBuyOK = not useRoomFilter or roomBuyPts >= minRoomPoints
roomSellOK = not useRoomFilter or roomSellPts >= minRoomPoints
targetBuyAligned = roomBuyPts >= targetPoints * 0.65 or retestBuyConfirm or momentumBuy
targetSellAligned = roomSellPts >= targetPoints * 0.65 or retestSellConfirm or momentumSell

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// APPLY SCHOOL TF OUTPUTS TO THE ORIGINAL SY265 ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if useSchoolTF
    localTrendBuy := tfTrendBuy
    localTrendSell := tfTrendSell
    localDir := localTrendBuy ? 1 : localTrendSell ? -1 : 0
    conflictMarket := mapDir != 0 and localDir != 0 and mapDir != localDir
    trendPowerBuy := (localTrendBuy ? 1 : 0) + (tf1Dir == 1 ? 1 : 0) + (tf2Dir == 1 ? 1 : 0) + (tf3Dir == 1 ? 1 : 0)
    trendPowerSell := (localTrendSell ? 1 : 0) + (tf1Dir == -1 ? 1 : 0) + (tf2Dir == -1 ? 1 : 0) + (tf3Dir == -1 ? 1 : 0)
    alignmentBuy := mapDir >= 0 and localDir >= 0
    alignmentSell := mapDir <= 0 and localDir <= 0
    mssUp := tfStructBuy
    mssDown := tfStructSell
    structureUp := tfStructBuy
    structureDown := tfStructSell
    breakUp := tfContBuy
    breakDown := tfContSell
    stopHuntBuy := tfLiqBuy
    stopHuntSell := tfLiqSell
    sweepLowConfirm := tfLiqBuy
    sweepHighConfirm := tfLiqSell
    retestBuyConfirm := tfRetestBuy
    retestSellConfirm := tfRetestSell
    bullOBConfirm := tfOBBuy
    bearOBConfirm := tfOBSell
    bullFVGConfirm := tfFVGBuy
    bearFVGConfirm := tfFVGSell
    fibBuyConfirm := tfFibBuy
    fibSellConfirm := tfFibSell
    bbRangeBuy := tfRangeBuy
    bbRangeSell := tfRangeSell
    donBuy := tfRangeBuy or donBuy
    donSell := tfRangeSell or donSell
    valueBuy := tfValueBuy
    valueSell := tfValueSell
    momentumBuy := tfMomBuy
    momentumSell := tfMomSell
    bullReject := tfBullReject
    bearReject := tfBearReject
    bullMomentum := tfBullMomentum
    bearMomentum := tfBearMomentum
    volumeBull := tfVolumeBull
    volumeBear := tfVolumeBear
    supportRejectBuy := supportRejectBuy or tfValueBuy or tfRangeBuy
    resistanceRejectSell := resistanceRejectSell or tfValueSell or tfRangeSell
    targetBuyAligned := roomBuyPts >= targetPoints * 0.65 or retestBuyConfirm or momentumBuy or tfContBuy
    targetSellAligned := roomSellPts >= targetPoints * 0.65 or retestSellConfirm or momentumSell or tfContSell

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OPTIONAL UT BOT ENGINE - can help the map or be filtered by the map
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
utActive = useUTBot
utResolvedTF = utUseCurrentTF ? timeframe.period : utBotTF
utTicker = utUseHA ? ticker.heikinashi(syminfo.tickerid) : syminfo.tickerid
utSrc = request.security(utTicker, utResolvedTF, close, barmerge.gaps_off, barmerge.lookahead_off)
utAtr = request.security(syminfo.tickerid, utResolvedTF, ta.atr(utAtrLen), barmerge.gaps_off, barmerge.lookahead_off)
utLoss = utKey * utAtr
var float utStop = 0.0
utPrevStop = nz(utStop[1], 0.0)
utStop := utSrc > utPrevStop and utSrc[1] > utPrevStop ? math.max(utPrevStop, utSrc - utLoss) : utSrc < utPrevStop and utSrc[1] < utPrevStop ? math.min(utPrevStop, utSrc + utLoss) : utSrc > utPrevStop ? utSrc - utLoss : utSrc + utLoss
utEma = ta.ema(utSrc, 1)
utRawBuy = utActive and utSrc > utStop and ta.crossover(utEma, utStop)
utRawSell = utActive and utSrc < utStop and ta.crossover(utStop, utEma)
utBull = utActive and utSrc > utStop
utBear = utActive and utSrc < utStop
utFreshBuy = utRawBuy and not utRawBuy[1]
utFreshSell = utRawSell and not utRawSell[1]
utAssistMode = utActive and utBotMode == "Assist"
utConfirmMode = utActive and utBotMode == "Confirm"
utEntryMode = utActive and utBotMode == "UT Entry + Our Filters"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MAP COURT QUESTIONS - actual score/risk engine
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float buyScore = 0.0
float sellScore = 0.0
float buyRisk = 0.0
float sellRisk = 0.0
int buyQ = 0
int sellQ = 0

// Q001: HTF fast direction
if tf1Dir == 1
    buyScore += 0.80
    buyQ += 1
if tf1Dir == -1
    sellScore += 0.80
    sellQ += 1
if tf1Dir == -1
    buyRisk += 0.40
if tf1Dir == 1
    sellRisk += 0.40

// Q002: HTF zone direction
if tf2Dir == 1
    buyScore += 1.00
    buyQ += 1
if tf2Dir == -1
    sellScore += 1.00
    sellQ += 1
if tf2Dir == -1
    buyRisk += 0.60
if tf2Dir == 1
    sellRisk += 0.60

// Q003: HTF big map
if tf3Dir == 1
    buyScore += 1.20
    buyQ += 1
if tf3Dir == -1
    sellScore += 1.20
    sellQ += 1
if tf3Dir == -1
    buyRisk += 0.80
if tf3Dir == 1
    sellRisk += 0.80

// Q004: Local trend
if localTrendBuy
    buyScore += 1.10
    buyQ += 1
if localTrendSell
    sellScore += 1.10
    sellQ += 1
if localTrendSell
    buyRisk += 0.60
if localTrendBuy
    sellRisk += 0.60

// Q005: Trend power
if trendPowerBuy >= 2
    buyScore += 1.00
    buyQ += 1
if trendPowerSell >= 2
    sellScore += 1.00
    sellQ += 1
if trendPowerSell >= 3
    buyRisk += 0.60
if trendPowerBuy >= 3
    sellRisk += 0.60

// Q006: HTF zone
if htfBuyZone
    buyScore += 1.50
    buyQ += 1
if htfSellZone
    sellScore += 1.50
    sellQ += 1
if htfSellZone and not htfBuyZone
    buyRisk += 0.80
if htfBuyZone and not htfSellZone
    sellRisk += 0.80

// Q007: Premium discount
if discount
    buyScore += 1.00
    buyQ += 1
if premium
    sellScore += 1.00
    sellQ += 1
if premium
    buyRisk += 1.00
if discount
    sellRisk += 1.00

// Q008: Middle filter
if not middleZone or retestBuyConfirm or bullOBConfirm or bullFVGConfirm
    buyScore += 0.40
    buyQ += 1
if not middleZone or retestSellConfirm or bearOBConfirm or bearFVGConfirm
    sellScore += 0.40
    sellQ += 1
if middleZone and not retestBuyConfirm and not bullOBConfirm and not bullFVGConfirm
    buyRisk += 0.80
if middleZone and not retestSellConfirm and not bearOBConfirm and not bearFVGConfirm
    sellRisk += 0.80

// Q009: Structure shift
if mssUp or structureUp
    buyScore += 1.10
    buyQ += 1
if mssDown or structureDown
    sellScore += 1.10
    sellQ += 1
if mssDown
    buyRisk += 0.70
if mssUp
    sellRisk += 0.70

// Q010: Support resistance reject
if supportRejectBuy
    buyScore += 1.30
    buyQ += 1
if resistanceRejectSell
    sellScore += 1.30
    sellQ += 1
if resistanceTouch and not supportTouch
    buyRisk += 0.60
