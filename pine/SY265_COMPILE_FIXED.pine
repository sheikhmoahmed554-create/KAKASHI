// STORY ENGINE - MAP READS WHY THE TRADE EXISTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
realReversalBuy = (stopHuntBuy or exhaustionReversalBuy) and (mssUp or close > ema20) and (bullReject or bullMomentum) and (discount or htfBuyZone) and roomBuyOK
realReversalSell = (stopHuntSell or exhaustionReversalSell) and (mssDown or close < ema20) and (bearReject or bearMomentum) and (premium or htfSellZone) and roomSellOK
buyStoryPullback = alignmentBuy and trendPowerBuy >= 2 and valueBuy and (bullReject or momentumBuy) and not premium and roomBuyOK
sellStoryPullback = alignmentSell and trendPowerSell >= 2 and valueSell and (bearReject or momentumSell) and not discount and roomSellOK
buyStorySweep = stopHuntBuy and not strongHTFSell and (bullReject or bullMomentum) and roomBuyOK
sellStorySweep = stopHuntSell and not strongHTFBuy and (bearReject or bearMomentum) and roomSellOK
buyStoryRetest = retestBuyConfirm and mapDir >= 0 and roomBuyOK
sellStoryRetest = retestSellConfirm and mapDir <= 0 and roomSellOK
buyStoryOrder = bullOBConfirm and (alignmentBuy or htfBuyZone or discount) and not premium and roomBuyOK
sellStoryOrder = bearOBConfirm and (alignmentSell or htfSellZone or premium) and not discount and roomSellOK
buyStoryFVG = bullFVGConfirm and (alignmentBuy or htfBuyZone or discount) and not premium and roomBuyOK
sellStoryFVG = bearFVGConfirm and (alignmentSell or htfSellZone or premium) and not discount and roomSellOK
buyStoryFib = fibBuyConfirm and (alignmentBuy or htfBuyZone or discount) and not premium and roomBuyOK
sellStoryFib = fibSellConfirm and (alignmentSell or htfSellZone or premium) and not discount and roomSellOK
buyStoryRange = rangeMarket and discount and (supportRejectBuy or bbRangeBuy or donBuy) and roomBuyOK
sellStoryRange = rangeMarket and premium and (resistanceRejectSell or bbRangeSell or donSell) and roomSellOK
buyStoryMomentum = cleanMove and momentumBuy and mapDir >= 0 and bullMomentum and not premium and roomBuyOK
sellStoryMomentum = cleanMove and momentumSell and mapDir <= 0 and bearMomentum and not discount and roomSellOK
utBuyZoneOK = not utEntryNeedsStory or discount or htfBuyZone or stopHuntBuy or retestBuyConfirm or bullOBConfirm or bullFVGConfirm or fibBuyConfirm or valueBuy or supportRejectBuy
utSellZoneOK = not utEntryNeedsStory or premium or htfSellZone or stopHuntSell or retestSellConfirm or bearOBConfirm or bearFVGConfirm or fibSellConfirm or valueSell or resistanceRejectSell
utBuyStory = utEntryMode and utFreshBuy and utBull and utBuyZoneOK and roomBuyOK
utSellStory = utEntryMode and utFreshSell and utBear and utSellZoneOK and roomSellOK

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// AMD / POWER OF THREE SESSION SETUP
// Accumulation -> Manipulation -> Distribution
// One full setup per day, labeled AMD BUY / AMD SELL.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_amd_setup_tf_engine() =>
    _inAsia = useAMD and not na(time(timeframe.period, amdAsiaSession, amdTz))
    _inManip = useAMD and not na(time(timeframe.period, amdManipSession, amdTz))
    _inDist = useAMD and not na(time(timeframe.period, amdDistSession, amdTz))
    _dayKey = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
    var int _lastDayKey = na
    var float _asiaHigh = na
    var float _asiaLow = na
    var int _manipDir = 0
    var int _manipBar = na
    if na(_lastDayKey) or _dayKey != _lastDayKey
        _asiaHigh := na
        _asiaLow := na
        _manipDir := 0
        _manipBar := na
        _lastDayKey := _dayKey
    if _inAsia
        _asiaHigh := na(_asiaHigh) ? high : math.max(_asiaHigh, high)
        _asiaLow := na(_asiaLow) ? low : math.min(_asiaLow, low)
    _ready = useAMD and not na(_asiaHigh) and not na(_asiaLow) and _asiaHigh > _asiaLow
    _buffer = amdSweepBufferPts * pointUnit
    _sweepHigh = _ready and _inManip and high > _asiaHigh + _buffer and close < _asiaHigh
    _sweepLow = _ready and _inManip and low < _asiaLow - _buffer and close > _asiaLow
    if _manipDir == 0
        if _sweepLow
            _manipDir := 1
            _manipBar := bar_index
        else if _sweepHigh
            _manipDir := -1
            _manipBar := bar_index
    _barsAfter = na(_manipBar) ? 1000000 : bar_index - _manipBar
    _windowOK = _barsAfter > 0 and _barsAfter <= amdMaxBarsAfterManip
    _entrySessionOK = _inDist or (amdAllowLondonEntry and _inManip)
    _mssHigh = ta.highest(high, amdMssLookback)[1]
    _mssLow = ta.lowest(low, amdMssLookback)[1]
    _buyMSS = not na(_mssHigh) and close > _mssHigh and close[1] <= _mssHigh
    _sellMSS = not na(_mssLow) and close < _mssLow and close[1] >= _mssLow
    _rng = math.max(high - low, syminfo.mintick)
    _body = math.abs(close - open)
    _bodyPct = _body / _rng * 100.0
    _upW = (high - math.max(open, close)) / _rng * 100.0
    _dnW = (math.min(open, close) - low) / _rng * 100.0
    _cpB = (close - low) / _rng
    _cpS = (high - close) / _rng
    _bullRejectTF = close > open and _bodyPct >= minBodyPct and _dnW >= minWickPct and _cpB >= 0.55
    _bearRejectTF = close < open and _bodyPct >= minBodyPct and _upW >= minWickPct and _cpS >= 0.55
    _bullMomTF = close > open and _bodyPct >= strongBodyPct and _cpB >= 0.60
    _bearMomTF = close < open and _bodyPct >= strongBodyPct and _cpS >= 0.60
    _buyPulse = _buyMSS or _bullRejectTF or _bullMomTF
    _sellPulse = _sellMSS or _bearRejectTF or _bearMomTF
    _buyZone = _ready and close > _asiaLow and close < _asiaHigh + (_asiaHigh - _asiaLow) * 0.35
    _sellZone = _ready and close < _asiaHigh and close > _asiaLow - (_asiaHigh - _asiaLow) * 0.35
    _buySetup = useAMD and _manipDir == 1 and _windowOK and _entrySessionOK and _buyPulse and _buyZone
    _sellSetup = useAMD and _manipDir == -1 and _windowOK and _entrySessionOK and _sellPulse and _sellZone
    [_asiaHigh, _asiaLow, _manipDir, _buySetup, _sellSetup, _inAsia, _inManip, _inDist, _sweepHigh, _sweepLow]

[amdTFAsiaHighRaw, amdTFAsiaLowRaw, amdTFManipDirRaw, amdTFBuyRaw0, amdTFSellRaw0, amdTFInAsia, amdTFInManip, amdTFInDist, amdTFSweepHigh, amdTFSweepLow] = request.security(syminfo.tickerid, amdSetupTF, f_amd_setup_tf_engine(), barmerge.gaps_off, barmerge.lookahead_off)
amdTFBuyRaw = amdUseClosedSetupTF ? amdTFBuyRaw0 : amdTFBuyRaw0
amdTFSellRaw = amdUseClosedSetupTF ? amdTFSellRaw0 : amdTFSellRaw0
amdTFBuyPulse = amdTFBuyRaw and not amdTFBuyRaw[1]
amdTFSellPulse = amdTFSellRaw and not amdTFSellRaw[1]
amdTFSetupBuyOK = amdUseSetupTF ? amdTFBuyRaw : false
amdTFSetupSellOK = amdUseSetupTF ? amdTFSellRaw : false


inAMDAsia = useAMD and not na(time(timeframe.period, amdAsiaSession, amdTz))
inAMDManip = useAMD and not na(time(timeframe.period, amdManipSession, amdTz))
inAMDDist = useAMD and not na(time(timeframe.period, amdDistSession, amdTz))
amdDayKey = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
var int amdLastDayKey = na
var float amdAsiaHigh = na
var float amdAsiaLow = na
var int amdManipDir = 0
var int amdManipBar = na
var int amdDoneKey = na
var int amdManipLabelDay = na

if na(amdLastDayKey) or amdDayKey != amdLastDayKey
    amdAsiaHigh := na
    amdAsiaLow := na
    amdManipDir := 0
    amdManipBar := na
    amdManipLabelDay := na
    amdLastDayKey := amdDayKey

if inAMDAsia
    amdAsiaHigh := na(amdAsiaHigh) ? high : math.max(amdAsiaHigh, high)
    amdAsiaLow := na(amdAsiaLow) ? low : math.min(amdAsiaLow, low)

amdRangeReady = useAMD and not na(amdAsiaHigh) and not na(amdAsiaLow) and amdAsiaHigh > amdAsiaLow
amdSweepBuffer = amdSweepBufferPts * pointUnit
amdAlreadyDone = amdOncePerDay and amdDoneKey == amdDayKey
amdSweepHighNow = amdRangeReady and inAMDManip and high > amdAsiaHigh + amdSweepBuffer and close < amdAsiaHigh
amdSweepLowNow = amdRangeReady and inAMDManip and low < amdAsiaLow - amdSweepBuffer and close > amdAsiaLow

if useAMD and not amdAlreadyDone and amdManipDir == 0
    if amdSweepLowNow
        amdManipDir := 1
        amdManipBar := bar_index
        if showAMDStateLabels and not cleanChartMode and amdManipLabelDay != amdDayKey
            label.new(bar_index, low, "AMD MANIP LOW", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(BUY_C, 10), textcolor=TXT_C, size=size.tiny)
            amdManipLabelDay := amdDayKey
    else if amdSweepHighNow
        amdManipDir := -1
        amdManipBar := bar_index
        if showAMDStateLabels and not cleanChartMode and amdManipLabelDay != amdDayKey
            label.new(bar_index, high, "AMD MANIP HIGH", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(SELL_C, 10), textcolor=TXT_C, size=size.tiny)
            amdManipLabelDay := amdDayKey

amdBarsAfterManip = na(amdManipBar) ? 1000000 : bar_index - amdManipBar
amdWindowOK = amdBarsAfterManip > 0 and amdBarsAfterManip <= amdMaxBarsAfterManip
amdEntrySessionOK = inAMDDist or (amdAllowLondonEntry and inAMDManip)
amdMssHigh = ta.highest(high, amdMssLookback)[1]
amdMssLow = ta.lowest(low, amdMssLookback)[1]
amdBuyMSS = not na(amdMssHigh) and close > amdMssHigh and close[1] <= amdMssHigh
amdSellMSS = not na(amdMssLow) and close < amdMssLow and close[1] >= amdMssLow
amdBuyPulse = amdBuyMSS or mssUp or breakUp or retestBuyConfirm or bullOBConfirm or bullFVGConfirm or bullReject or bullMomentum or momentumBuy or utFreshBuy
amdSellPulse = amdSellMSS or mssDown or breakDown or retestSellConfirm or bearOBConfirm or bearFVGConfirm or bearReject or bearMomentum or momentumSell or utFreshSell
amdBuyZone = close > amdAsiaLow and (discount or htfBuyZone or stopHuntBuy or sweepLowConfirm or valueBuy or supportRejectBuy or low <= amdAsiaLow + atr * zoneAtrBuffer)
amdSellZone = close < amdAsiaHigh and (premium or htfSellZone or stopHuntSell or sweepHighConfirm or valueSell or resistanceRejectSell or high >= amdAsiaHigh - atr * zoneAtrBuffer)
amdBuyFilterOK = not amdUseOurFilters or (roomBuyOK and not crazyCandle and not deadMarket and (not strongHTFSell or amdAllowCounterHTF) and buyRisk <= maxRisk + amdRiskRelief)
amdSellFilterOK = not amdUseOurFilters or (roomSellOK and not crazyCandle and not deadMarket and (not strongHTFBuy or amdAllowCounterHTF) and sellRisk <= maxRisk + amdRiskRelief)
amdBuySetupLocal = useAMD and not amdAlreadyDone and amdManipDir == 1 and amdWindowOK and amdEntrySessionOK and amdBuyPulse and amdBuyZone and amdBuyFilterOK
amdSellSetupLocal = useAMD and not amdAlreadyDone and amdManipDir == -1 and amdWindowOK and amdEntrySessionOK and amdSellPulse and amdSellZone and amdSellFilterOK
amdBuySetup = amdUseSetupTF ? useAMD and not amdAlreadyDone and amdTFSetupBuyOK and amdBuyFilterOK : amdBuySetupLocal
amdSellSetup = amdUseSetupTF ? useAMD and not amdAlreadyDone and amdTFSetupSellOK and amdSellFilterOK : amdSellSetupLocal

if amdBuySetup
    buyScore += amdScoreBoost
    buyQ += 2
    buyRisk := math.max(buyRisk - amdRiskRelief, 0.0)
if amdSellSetup
    sellScore += amdScoreBoost
    sellQ += 2
    sellRisk := math.max(sellRisk - amdRiskRelief, 0.0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RMI FLIP ANY-CONFIRMATION SETUP
// Not only 2 candles. After RMI extreme, ANY valid confirmation can trigger.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rmiFlipPriceBuyOK = not rmiFlipNeedsZone or discount or htfBuyZone or supportRejectBuy or valueBuy or stopHuntBuy or sweepLowConfirm or bullFVGConfirm or bullOBConfirm or retestBuyConfirm
rmiFlipPriceSellOK = not rmiFlipNeedsZone or premium or htfSellZone or resistanceRejectSell or valueSell or stopHuntSell or sweepHighConfirm or bearFVGConfirm or bearOBConfirm or retestSellConfirm

rmiFlipBuyColorOK = rmiFlipUseColor and rmiFlipBuyColorRaw
rmiFlipSellColorOK = rmiFlipUseColor and rmiFlipSellColorRaw
rmiFlipBuySweepOK = rmiFlipUseSweep and rmiFlipRecentLow and (stopHuntBuy or sweepLowConfirm)
rmiFlipSellSweepOK = rmiFlipUseSweep and rmiFlipRecentHigh and (stopHuntSell or sweepHighConfirm)
rmiFlipBuyWickOK = rmiFlipUseWick and rmiFlipRecentLow and (bullReject or rmiFlipBullReact)
rmiFlipSellWickOK = rmiFlipUseWick and rmiFlipRecentHigh and (bearReject or rmiFlipBearReact)
rmiFlipBuyMSSOK = rmiFlipUseMSS and rmiFlipRecentLow and (mssUp or breakUp or retestBuyConfirm)
rmiFlipSellMSSOK = rmiFlipUseMSS and rmiFlipRecentHigh and (mssDown or breakDown or retestSellConfirm)
rmiFlipBuyCrossOK = rmiFlipUseSignalCross and rmiFlipRecentLow and rmiFlipCrossUpRaw
rmiFlipSellCrossOK = rmiFlipUseSignalCross and rmiFlipRecentHigh and rmiFlipCrossDnRaw

rmiFlipBuyConfirmCount = (rmiFlipBuyColorOK ? 1 : 0) + (rmiFlipBuySweepOK ? 1 : 0) + (rmiFlipBuyWickOK ? 1 : 0) + (rmiFlipBuyMSSOK ? 1 : 0) + (rmiFlipBuyCrossOK ? 1 : 0)
rmiFlipSellConfirmCount = (rmiFlipSellColorOK ? 1 : 0) + (rmiFlipSellSweepOK ? 1 : 0) + (rmiFlipSellWickOK ? 1 : 0) + (rmiFlipSellMSSOK ? 1 : 0) + (rmiFlipSellCrossOK ? 1 : 0)
// RMI ZONE RULE:
// Above upper line = SELL only.
// Below lower line = BUY only.
// Near upper line with strong sell reason before touching upper = SELL only.
// Near lower line with strong buy reason before touching lower = BUY only.
// Middle = RMI does not create trades.
rmiTopZone = rmiBiasGuard and rmiFlipVal >= rmiFlipUpper
rmiBottomZone = rmiBiasGuard and rmiFlipVal <= rmiFlipLower
rmiNearTopZone = rmiBiasGuard and rmiFlipVal >= rmiUpperPreZone and rmiFlipVal < rmiFlipUpper
rmiNearBottomZone = rmiBiasGuard and rmiFlipVal <= rmiLowerPreZone and rmiFlipVal > rmiFlipLower
rmiMiddleZone = rmiBiasGuard and not rmiTopZone and not rmiBottomZone and not rmiNearTopZone and not rmiNearBottomZone

rmiStrongSellReason = trendPowerSell >= rmiAgainstBiasNeedsPower or strongHTFSell or amdSellSetup or rmiFlipSellSweepOK or rmiFlipSellWickOK or rmiFlipSellMSSOK or (premium or htfSellZone or resistanceRejectSell) and (bearReject or bearMomentum or mssDown or breakDown)
rmiStrongBuyReason = trendPowerBuy >= rmiAgainstBiasNeedsPower or strongHTFBuy or amdBuySetup or rmiFlipBuySweepOK or rmiFlipBuyWickOK or rmiFlipBuyMSSOK or (discount or htfBuyZone or supportRejectBuy) and (bullReject or bullMomentum or mssUp or breakUp)

rmiPreferSellZone = rmiTopZone or (rmiNearTopZone and (not rmiPreZoneNeedsStrongReason or rmiStrongSellReason))
rmiPreferBuyZone = rmiBottomZone or (rmiNearBottomZone and (not rmiPreZoneNeedsStrongReason or rmiStrongBuyReason))

// Required confirmations:
// Extreme zones are easier.
// Pre-zones need stronger reason and at least the configured near confirmations.
rmiBuyNeededConf = rmiBottomZone ? rmiExtremeNeedsConfirmations : rmiNearBottomZone ? rmiNearNeedsConfirmations : 999
rmiSellNeededConf = rmiTopZone ? rmiExtremeNeedsConfirmations : rmiNearTopZone ? rmiNearNeedsConfirmations : 999
rmiFlipBuyConfirmOK = rmiFlipBuyConfirmCount >= rmiBuyNeededConf
rmiFlipSellConfirmOK = rmiFlipSellConfirmCount >= rmiSellNeededConf

// Direction rule: top side cannot generate BUY; bottom side cannot generate SELL.
// Middle cannot generate RMI trades.
rmiBuyDirectionOK = rmiPreferBuyZone and not rmiPreferSellZone
rmiSellDirectionOK = rmiPreferSellZone and not rmiPreferBuyZone

if rmiTopSellOnly and (rmiTopZone or rmiNearTopZone) and not rmiStrongBuyReason
    buyRisk += rmiTopZone ? 6.0 : 3.0
    buyScore := math.max(buyScore - (rmiTopZone ? 3.0 : 1.5), 0.0)
if rmiBottomBuyOnly and (rmiBottomZone or rmiNearBottomZone) and not rmiStrongSellReason
    sellRisk += rmiBottomZone ? 6.0 : 3.0
    sellScore := math.max(sellScore - (rmiBottomZone ? 3.0 : 1.5), 0.0)

rmiDirectBuyReason = rmiFlipBuyColorOK or rmiFlipBuySweepOK or rmiFlipBuyWickOK or rmiFlipBuyMSSOK or rmiFlipBuyCrossOK or bullReject or bullMomentum or mssUp or breakUp
rmiDirectSellReason = rmiFlipSellColorOK or rmiFlipSellSweepOK or rmiFlipSellWickOK or rmiFlipSellMSSOK or rmiFlipSellCrossOK or bearReject or bearMomentum or mssDown or breakDown

rmiDirectBuyOK = rmiZoneDirectTrigger and rmiPreferBuyZone and rmiFlipPriceBuyOK and (not rmiZoneDirectNeedsAnyReason or rmiDirectBuyReason)
rmiDirectSellOK = rmiZoneDirectTrigger and rmiPreferSellZone and rmiFlipPriceSellOK and (not rmiZoneDirectNeedsAnyReason or rmiDirectSellReason)

rmiFlipBuySetup = useRMIFlip and rmiZoneOnlyMode and rmiBuyDirectionOK and rmiFlipPriceBuyOK and (rmiFlipBuyConfirmOK or rmiDirectBuyOK)
rmiFlipSellSetup = useRMIFlip and rmiZoneOnlyMode and rmiSellDirectionOK and rmiFlipPriceSellOK and (rmiFlipSellConfirmOK or rmiDirectSellOK)

if rmiFlipBuySetup
    buyScore += rmiFlipScoreBoost
    buyQ += rmiFlipBuyConfirmCount >= 2 ? 2 : 1
    buyRisk := math.max(buyRisk - rmiFlipRiskRelief, 0.0)
if rmiFlipSellSetup
    sellScore += rmiFlipScoreBoost
    sellQ += rmiFlipSellConfirmCount >= 2 ? 2 : 1
    sellRisk := math.max(sellRisk - rmiFlipRiskRelief, 0.0)
if rmiDirectBuyOK
    buyScore += rmiZoneDirectScoreBoost
    buyQ += 2
    buyRisk := math.max(buyRisk - rmiZoneDirectRiskRelief, 0.0)
if rmiDirectSellOK
    sellScore += rmiZoneDirectScoreBoost
    sellQ += 2
    sellRisk := math.max(sellRisk - rmiZoneDirectRiskRelief, 0.0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RMI MASTER DIRECTION GATE
// This blocks ALL BUY signals from top RMI zones and ALL SELL signals from bottom RMI zones.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RMI master rule:
// Near/top zone prefers SELL.
// Near/bottom zone prefers BUY.
// Wrong-side trades are blocked unless a strong trend is actually aligned.
rmiMasterSellZone = rmiTopZone or (rmiMasterUsePreZone and rmiNearTopZone and rmiStrongSellReason)
rmiMasterBuyZone = rmiBottomZone or (rmiMasterUsePreZone and rmiNearBottomZone and rmiStrongBuyReason)
rmiMasterTopArea = rmiTopZone or (rmiMasterUsePreZone and rmiNearTopZone)
rmiMasterBottomArea = rmiBottomZone or (rmiMasterUsePreZone and rmiNearBottomZone)
rmiMasterTop = rmiMasterGate and rmiMasterTopArea
rmiMasterBottom = rmiMasterGate and rmiMasterBottomArea
rmiMasterMiddle = rmiMasterGate and not rmiMasterTop and not rmiMasterBottom

rmiBuyTrendPermission = trendPowerBuy >= rmiWrongSideTrendPower and (not rmiWrongSideNeedsMap or mapDir >= 0 or tf1Dir == 1 or tf2Dir == 1 or strongHTFBuy)
rmiSellTrendPermission = trendPowerSell >= rmiWrongSideTrendPower and (not rmiWrongSideNeedsMap or mapDir <= 0 or tf1Dir == -1 or tf2Dir == -1 or strongHTFSell)

// Buy near top is allowed only if there is a real bullish trend.
// Sell near bottom is allowed only if there is a real bearish trend.
rmiWrongBuyNearTopOK = not rmiWrongSideNeedsTrend or not rmiMasterTopArea or rmiBuyTrendPermission
rmiWrongSellNearBottomOK = not rmiWrongSideNeedsTrend or not rmiMasterBottomArea or rmiSellTrendPermission

rmiMasterBuyOK = not rmiMasterGate or rmiWrongBuyNearTopOK
rmiMasterSellOK = not rmiMasterGate or rmiWrongSellNearBottomOK
rmiMasterTradeOK = not rmiMasterGate or not rmiMasterBlockMiddle or not rmiMasterMiddle

if rmiMasterTopArea and not rmiBuyTrendPermission
    buyRisk += rmiTopZone ? 12.0 : 7.0
    buyScore := 0.0
if rmiMasterBottomArea and not rmiSellTrendPermission
    sellRisk += rmiBottomZone ? 12.0 : 7.0
    sellScore := 0.0
if rmiMasterMiddle and rmiMasterBlockMiddle
    buyScore := 0.0
    sellScore := 0.0
    buyRisk += 12.0
    sellRisk += 12.0
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SCALP CORRECTION ENGINE
// Pullback/reaction entries with trend. It is not allowed to spam every candle.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
scalpActive = useScalpCorrection
scalpAgg = scalpCorrectionMode == "Active"
scalpCons = scalpCorrectionMode == "Conservative"
scalpBuyTrend = trendPowerBuy >= scalpMinTrendPower or localTrendBuy or mapDir == 1 or tf1Dir == 1 or tf2Dir == 1
scalpSellTrend = trendPowerSell >= scalpMinTrendPower or localTrendSell or mapDir == -1 or tf1Dir == -1 or tf2Dir == -1
scalpBuyPullback = valueBuy or supportRejectBuy or rmiBuyReaction or rmiFlipBuySetup or low <= ema20 + atr * scalpPullbackATR or low <= ema34 + atr * scalpPullbackATR or (not na(vwapVal) and low <= vwapVal + atr * scalpPullbackATR)
scalpSellPullback = valueSell or resistanceRejectSell or rmiSellReaction or rmiFlipSellSetup or high >= ema20 - atr * scalpPullbackATR or high >= ema34 - atr * scalpPullbackATR or (not na(vwapVal) and high >= vwapVal - atr * scalpPullbackATR)
scalpBuyFresh = (bullReject and not bullReject[1]) or (bullMomentum and not bullMomentum[1]) or (mssUp and not mssUp[1]) or (breakUp and not breakUp[1]) or (retestBuyConfirm and not retestBuyConfirm[1]) or utFreshBuy or rmiBuyReaction or rmiFlipBuySetup
scalpSellFresh = (bearReject and not bearReject[1]) or (bearMomentum and not bearMomentum[1]) or (mssDown and not mssDown[1]) or (breakDown and not breakDown[1]) or (retestSellConfirm and not retestSellConfirm[1]) or utFreshSell or rmiSellReaction or rmiFlipSellSetup
scalpBuyPulseOK = not scalpNeedFreshPulse or scalpBuyFresh
scalpSellPulseOK = not scalpNeedFreshPulse or scalpSellFresh
scalpBuyRoomOK = roomBuyOK or roomBuyPts >= scalpMinRoomPoints
scalpSellRoomOK = roomSellOK or roomSellPts >= scalpMinRoomPoints
scalpBuyAgainstOK = not scalpWithTrendOnly or not strongHTFSell or amdBuySetup or stopHuntBuy or sweepLowConfirm or rmiBuyReaction or rmiFlipBuySetup
scalpSellAgainstOK = not scalpWithTrendOnly or not strongHTFBuy or amdSellSetup or stopHuntSell or sweepHighConfirm or rmiSellReaction or rmiFlipSellSetup
scalpBuyQuality = (scalpBuyTrend ? 1.0 : 0.0) + (scalpBuyPullback ? 1.0 : 0.0) + (scalpBuyFresh ? 1.0 : 0.0) + (bullReject ? 0.55 : 0.0) + (bullMomentum ? 0.55 : 0.0) + (mssUp or breakUp ? 0.60 : 0.0) + (utBull ? 0.25 : 0.0) + (rmiBuyReaction ? 0.65 : 0.0) + (rmiFlipBuySetup ? 0.95 : 0.0)
scalpSellQuality = (scalpSellTrend ? 1.0 : 0.0) + (scalpSellPullback ? 1.0 : 0.0) + (scalpSellFresh ? 1.0 : 0.0) + (bearReject ? 0.55 : 0.0) + (bearMomentum ? 0.55 : 0.0) + (mssDown or breakDown ? 0.60 : 0.0) + (utBear ? 0.25 : 0.0) + (rmiSellReaction ? 0.65 : 0.0) + (rmiFlipSellSetup ? 0.95 : 0.0)
scalpMinQuality = scalpAgg ? 2.15 : scalpCons ? 3.15 : 2.55
scalpBuySetup = scalpActive and scalpBuyTrend and scalpBuyPullback and scalpBuyPulseOK and scalpBuyRoomOK and scalpBuyAgainstOK and not crazyCandle and not deadMarket and scalpBuyQuality >= scalpMinQuality and not chaseBuyRisk
scalpSellSetup = scalpActive and scalpSellTrend and scalpSellPullback and scalpSellPulseOK and scalpSellRoomOK and scalpSellAgainstOK and not crazyCandle and not deadMarket and scalpSellQuality >= scalpMinQuality and not chaseSellRisk
if scalpBuySetup
    buyScore += scalpScoreBoost * (scalpAgg ? 1.20 : 1.0) + (rmiBuyReaction ? rmiScoreBoost : 0.0) + (rmiFlipBuySetup ? rmiFlipScoreBoost : 0.0)
    buyQ += scalpAgg ? 2 : 1
    buyRisk := math.max(buyRisk - scalpRiskRelief - (rmiBuyReaction ? rmiRiskRelief : 0.0) - (rmiFlipBuySetup ? rmiFlipRiskRelief : 0.0), 0.0)
if scalpSellSetup
    sellScore += scalpScoreBoost * (scalpAgg ? 1.20 : 1.0) + (rmiSellReaction ? rmiScoreBoost : 0.0) + (rmiFlipSellSetup ? rmiFlipScoreBoost : 0.0)
    sellQ += scalpAgg ? 2 : 1
    sellRisk := math.max(sellRisk - scalpRiskRelief - (rmiSellReaction ? rmiRiskRelief : 0.0) - (rmiFlipSellSetup ? rmiFlipRiskRelief : 0.0), 0.0)
buyStory = buyStoryPullback or buyStorySweep or buyStoryRetest or buyStoryOrder or buyStoryFVG or buyStoryFib or buyStoryRange or buyStoryMomentum or realReversalBuy or utBuyStory or amdBuySetup or scalpBuySetup or rmiFlipBuySetup
sellStory = sellStoryPullback or sellStorySweep or sellStoryRetest or sellStoryOrder or sellStoryFVG or sellStoryFib or sellStoryRange or sellStoryMomentum or realReversalSell or utSellStory or amdSellSetup or scalpSellSetup or rmiFlipSellSetup
sellAgainstMap = (powerUp or strongHTFBuy or (mapDir == 1 and trendPowerBuy >= 3)) and not (realReversalSell or amdSellSetup)
buyAgainstMap = (powerDown or strongHTFSell or (mapDir == -1 and trendPowerSell >= 3)) and not (realReversalBuy or amdBuySetup)
sellTopOnly = premium or htfSellZone or stopHuntSell or retestSellConfirm or bearOBConfirm or bearFVGConfirm or realReversalSell or amdSellSetup
buyBottomOnly = discount or htfBuyZone or stopHuntBuy or retestBuyConfirm or bullOBConfirm or bullFVGConfirm or realReversalBuy or amdBuySetup
buyRisk += buyAgainstMap ? 8.0 : 0
sellRisk += sellAgainstMap ? 8.0 : 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SELL BALANCE ENGINE
// Keeps BUY quality, but gives SELL fair chance only from logical tops.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
sellBalanceActive = useSellBalance and sellBalanceMode != "Off"
sellBalanceAgg = sellBalanceMode == "More Sell"
sellBalanceZone = premium or htfSellZone or resistanceRejectSell or stopHuntSell or retestSellConfirm or bearOBConfirm or bearFVGConfirm or fibSellConfirm or valueSell or bbRangeSell or donSell
sellBalancePulse = (utFreshSell and utBear) or stopHuntSell or sweepHighConfirm or mssDown or breakDown or retestSellConfirm or bearOBConfirm or bearFVGConfirm or fibSellConfirm or bearReject or bearMomentum or momentumSell
sellBalanceTrendOK = mapDir <= 0 or trendPowerSell >= 2 or tf1Dir == -1 or tf2Dir == -1 or tf3Dir == -1 or (sellBalanceCounterHTF and (stopHuntSell or sweepHighConfirm) and (mssDown or breakDown or bearReject))
sellBalanceTopOK = not sellBalanceNeedsZone or sellBalanceZone
sellBalancePulseOK = not sellBalanceNeedsPulse or sellBalancePulse
sellBalanceOK = sellBalanceActive and sellBalanceTopOK and sellBalancePulseOK and roomSellOK and sellBalanceTrendOK
sellBalanceCounterOK = sellBalanceOK and sellBalanceCounterHTF and (stopHuntSell or sweepHighConfirm or bearReject or utFreshSell) and sellBalanceZone and (mssDown or breakDown or bearMomentum)
if sellBalanceOK
    sellScore += sellBalanceWeight * (sellBalanceAgg ? 1.10 : 1.0)
    sellQ += sellBalanceAgg ? 1 : 1
    sellRisk := math.max(sellRisk - sellBalanceRiskRelief, 0.0)
if sellBalanceActive and utBear and sellBalanceZone and not strongHTFBuy
    sellScore += sellBalanceWeight * 0.25
if sellBalanceActive and utBull and sellBalancePulse and sellBalanceZone and (stopHuntSell or sweepHighConfirm)
    sellRisk := math.max(sellRisk - sellBalanceRiskRelief * 0.25, 0.0)
if sellBalanceActive and sellBalanceAgg and not strongHTFBuy and (premium or htfSellZone) and (bearReject or bearMomentum) and (mssDown or breakDown or stopHuntSell)
    sellScore += sellBalanceWeight * 0.25

// Smart Side Guard: prevents the engine from getting stuck BUY-only or SELL-only.
strongUpGuard = smartSideGuard and (powerUp or strongHTFBuy or (mapDir == 1 and trendPowerBuy >= sideGuardTrendPower) or (tf1Dir == 1 and tf2Dir == 1))
strongDownGuard = smartSideGuard and (powerDown or strongHTFSell or (mapDir == -1 and trendPowerSell >= sideGuardTrendPower) or (tf1Dir == -1 and tf2Dir == -1))
realTopForSell = realReversalSell or amdSellSetup or ((stopHuntSell or sweepHighConfirm) and (mssDown or breakDown or bearReject or bearMomentum)) or ((premium or htfSellZone or resistanceRejectSell) and (bearReject or bearMomentum) and (utBear or momentumSell))
realBottomForBuy = realReversalBuy or amdBuySetup or ((stopHuntBuy or sweepLowConfirm) and (mssUp or breakUp or bullReject or bullMomentum)) or ((discount or htfBuyZone or supportRejectBuy) and (bullReject or bullMomentum) and (utBull or momentumBuy))
sideGuardSellOK = not smartSideGuard or not blockSellInStrongUp or not strongUpGuard or (realTopForSell and (not sideGuardNeedsSweep or stopHuntSell or sweepHighConfirm or amdSellSetup))
sideGuardBuyOK = not smartSideGuard or not blockBuyInStrongDown or not strongDownGuard or (realBottomForBuy and (not sideGuardNeedsSweep or stopHuntBuy or sweepLowConfirm or amdBuySetup))
if smartSideGuard and strongUpGuard and not realTopForSell
    sellRisk += 4.0
    sellScore := math.max(sellScore - 1.5, 0.0)
    buyScore += sideGuardScoreRelief
if smartSideGuard and strongDownGuard and not realBottomForBuy
    buyRisk += 4.0
    buyScore := math.max(buyScore - 1.5, 0.0)
    sellScore += sideGuardScoreRelief

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FINAL DECISION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
utConfirmBuyOK = not utConfirmMode or utBull or amdBuySetup
utConfirmSellOK = not utConfirmMode or utBear or sellBalanceOK or amdSellSetup
utMinQ = math.max(minQ - (utEntryMode ? utEntryMinQDrop : 0), 1)
amdBuyMinQ = math.max(utMinQ - (amdBuySetup ? amdMinQDrop : 0) - (scalpBuySetup or rmiFlipBuySetup ? scalpMinQDrop : 0), 1)
sellMinQ = math.max(utMinQ - (sellBalanceOK ? sellBalanceQDrop : 0) - (amdSellSetup ? amdMinQDrop : 0) - (scalpSellSetup or rmiFlipSellSetup ? scalpMinQDrop : 0), 1)
amdBuyMinScore = math.max(minScore - (amdBuySetup ? amdScoreDrop : 0.0) - (scalpBuySetup or rmiFlipBuySetup ? scalpScoreDrop : 0.0), 0.0)
amdSellMinScore = math.max(minScore - (amdSellSetup ? amdScoreDrop : 0.0) - (scalpSellSetup or rmiFlipSellSetup ? scalpScoreDrop : 0.0), 0.0)
sellGapFinal = math.max(scoreGap - (sellBalanceOK ? sellBalanceGapRelax : 0.0) - (amdSellSetup ? amdScoreDrop * 0.25 : 0.0), 0.0)
buyGapFinal = math.max(scoreGap - (amdBuySetup ? amdScoreDrop * 0.25 : 0.0), 0.0)
utBuyBottomOK = buyBottomOnly or (utEntryMode and utBuyZoneOK) or amdBuySetup or scalpBuySetup
utSellTopOK = sellTopOnly or (utEntryMode and utSellZoneOK) or sellBalanceOK or amdSellSetup or scalpSellSetup
sellMapOK = not sellAgainstMap or sellBalanceCounterOK or amdSellSetup
buyMapOK = not buyAgainstMap or amdBuySetup
// RMI REAL MASTER CONTROLLER + REASON LOCK
// RMI is no longer allowed to create a trade by itself.
// It only defines where BUY/SELL is logically allowed; the trade still needs reasons.
rmiRealBuyZone = rmiRealMaster and rmiFlipVal <= rmiRealBuyBelow
rmiRealSellZone = rmiRealMaster and rmiFlipVal >= rmiRealSellAbove
rmiRealMiddle = rmiRealMaster and not rmiRealBuyZone and not rmiRealSellZone

rmiRealBuyReason = rmiDirectBuyReason or rmiFlipBuyConfirmCount >= 1 or rmiStrongBuyReason or bullReject or bullMomentum or mssUp or breakUp or stopHuntBuy or sweepLowConfirm
rmiRealSellReason = rmiDirectSellReason or rmiFlipSellConfirmCount >= 1 or rmiStrongSellReason or bearReject or bearMomentum or mssDown or breakDown or stopHuntSell or sweepHighConfirm

rmiRealBuyTrendException = rmiRealAllowTrendException and trendPowerBuy >= rmiRealTrendPower and (mapDir >= 0 or tf1Dir == 1 or tf2Dir == 1 or strongHTFBuy)
rmiRealSellTrendException = rmiRealAllowTrendException and trendPowerSell >= rmiRealTrendPower and (mapDir <= 0 or tf1Dir == -1 or tf2Dir == -1 or strongHTFSell)

rmiRealBuyOK = not rmiRealMaster or rmiRealBuyZone or rmiRealBuyTrendException
rmiRealSellOK = not rmiRealMaster or rmiRealSellZone or rmiRealSellTrendException
rmiRealTradeOK = not rmiRealMaster or not rmiRealBlockMiddle or not rmiRealMiddle

// Reason counters. Each entry must have a real explanation.
buyReasonZone = discount or htfBuyZone or supportRejectBuy or valueBuy or bullOBConfirm or bullFVGConfirm or retestBuyConfirm or rmiRealBuyZone
sellReasonZone = premium or htfSellZone or resistanceRejectSell or valueSell or bearOBConfirm or bearFVGConfirm or retestSellConfirm or rmiRealSellZone

buyReasonReaction = bullReject or bullMomentum or rmiFlipBullReact or rmiBuyReaction or rmiDirectBuyReason
sellReasonReaction = bearReject or bearMomentum or rmiFlipBearReact or rmiSellReaction or rmiDirectSellReason

buyReasonLiquidity = stopHuntBuy or sweepLowConfirm or amdBuySetup
sellReasonLiquidity = stopHuntSell or sweepHighConfirm or amdSellSetup

buyReasonStructure = mssUp or breakUp or retestBuyConfirm
sellReasonStructure = mssDown or breakDown or retestSellConfirm

buyReasonTrend = reasonAllowTrendContinuation and trendPowerBuy >= reasonTrendPower and (localTrendBuy or mapDir >= 0 or tf1Dir == 1 or tf2Dir == 1 or strongHTFBuy)
sellReasonTrend = reasonAllowTrendContinuation and trendPowerSell >= reasonTrendPower and (localTrendSell or mapDir <= 0 or tf1Dir == -1 or tf2Dir == -1 or strongHTFSell)

buyReasonRoom = not reasonRequireRoom or roomBuyOK or roomBuyPts >= scalpMinRoomPoints
sellReasonRoom = not reasonRequireRoom or roomSellOK or roomSellPts >= scalpMinRoomPoints

buyReasonCount = (buyReasonZone ? 1 : 0) + (buyReasonReaction ? 1 : 0) + (buyReasonLiquidity ? 1 : 0) + (buyReasonStructure ? 1 : 0) + (buyReasonTrend ? 1 : 0) + (buyReasonRoom ? 1 : 0)
sellReasonCount = (sellReasonZone ? 1 : 0) + (sellReasonReaction ? 1 : 0) + (sellReasonLiquidity ? 1 : 0) + (sellReasonStructure ? 1 : 0) + (sellReasonTrend ? 1 : 0) + (sellReasonRoom ? 1 : 0)

buyRMINeeded = rmiRealBuyZone ? reasonMinCountRMI : reasonMinCount
sellRMINeeded = rmiRealSellZone ? reasonMinCountRMI : reasonMinCount

buyReasonOK = not useReasonLock or buyReasonCount >= buyRMINeeded
sellReasonOK = not useReasonLock or sellReasonCount >= sellRMINeeded

if useReasonLock and reasonBlockNoZone and not buyReasonZone
    buyReasonOK := false
if useReasonLock and reasonBlockNoZone and not sellReasonZone
    sellReasonOK := false

// RMI direct trigger cannot create trades alone. It can only add to the reason count.
if reasonRMIAsZoneOnly
    rmiDirectBuyOK := false
    rmiDirectSellOK := false

if useReasonLock and not buyReasonOK
    buyScore := 0.0
    buyRisk += 25.0
if useReasonLock and not sellReasonOK
    sellScore := 0.0
    sellRisk += 25.0

// RMI gate blocks the wrong side.
if rmiRealMaster and not rmiRealBuyOK
    buyScore := 0.0
    buyRisk += 30.0
if rmiRealMaster and not rmiRealSellOK
    sellScore := 0.0
    sellRisk += 30.0
if rmiRealMiddle and rmiRealBlockMiddle
    buyScore := 0.0
    sellScore := 0.0
    buyRisk += 30.0
    sellRisk += 30.0

baseBuyAllowed = allowLong and buyStory and utBuyBottomOK and utConfirmBuyOK and buyMapOK and sideGuardBuyOK and buyReasonOK and buyQ >= amdBuyMinQ and buyScore >= amdBuyMinScore and buyRisk <= maxRisk and buyScore > sellScore + buyGapFinal
baseSellAllowed = allowShort and (sellStory or sellBalanceOK or amdSellSetup) and utSellTopOK and utConfirmSellOK and sellMapOK and sideGuardSellOK and sellReasonOK and sellQ >= sellMinQ and sellScore >= amdSellMinScore and sellRisk <= maxRisk and sellScore > buyScore + sellGapFinal

// No forced entries from RMI alone.
buyAllowed = rmiRealTradeOK and rmiRealBuyOK and baseBuyAllowed
sellAllowed = rmiRealTradeOK and rmiRealSellOK and baseSellAllowed
buyDecision = tradeableBase and buyAllowed
sellDecision = tradeableBase and sellAllowed

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRADE STATE / STATS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var bool active = false
var int activeDir = 0
var int entryBar = na
var int lastEntryBar = na
var int lastDayKey = na
var int tradesToday = 0
var int lastResetKey = na
var int lastLossDir = 0
var int lastLossBar = na
var int lastResult = 0
var float entryPrice = na
var float slPrice = na
var float tpPrice = na
var int wins = 0
var int losses = 0
var int closedTrades = 0
var float winPts = 0.0
var float lossPts = 0.0
var line entryLine = na
var line tpLine = na
var line slLine = na
var label entryLabel = na
var label tpLabel = na
var label slLabel = na

dayKey = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
if na(lastDayKey) or dayKey != lastDayKey
    tradesToday := 0
    lastDayKey := dayKey

resetByKey = not na(lastResetKey) and manualResetKey != lastResetKey
if na(lastResetKey) or manualResetKey != lastResetKey
    lastResetKey := manualResetKey

if statsResetByTime or resetByKey
    active := false
    activeDir := 0
    entryBar := na
    entryPrice := na
    slPrice := na
    tpPrice := na
    wins := 0
    losses := 0
    closedTrades := 0
    winPts := 0.0
    lossPts := 0.0
    tradesToday := 0
    lastLossDir := 0
    lastLossBar := na
    lastResult := 0
    if not na(entryLine)
        line.delete(entryLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(tpLabel)
        label.delete(tpLabel)
    if not na(slLabel)
        label.delete(slLabel)

barsSinceLast = na(lastEntryBar) ? 1000000 : bar_index - lastEntryBar
barsSinceLoss = na(lastLossBar) ? 1000000 : bar_index - lastLossBar
cooldownOK = barsSinceLast >= cooldownBars
dailyOK = tradesToday < maxTradesPerDay
lossBlockLong = lastLossDir == 1 and barsSinceLoss < lossCooldownBars and not realReversalBuy and not retestBuyConfirm
lossBlockShort = lastLossDir == -1 and barsSinceLoss < lossCooldownBars and not realReversalSell and not retestSellConfirm
confirmedBuyBase = barstate.isconfirmed and buyDecision and not (bar_index > 0 and buyDecision[1])
confirmedSellBase = barstate.isconfirmed and sellDecision and not (bar_index > 0 and sellDecision[1])
longSignal = confirmedBuyBase and not active and cooldownOK and dailyOK and not lossBlockLong
shortSignal = confirmedSellBase and not active and cooldownOK and dailyOK and not lossBlockShort and not longSignal
amdLongSignal = longSignal and amdBuySetup
amdShortSignal = shortSignal and amdSellSetup
scalpLongSignal = longSignal and (scalpBuySetup or rmiFlipBuySetup) and not amdLongSignal
scalpShortSignal = shortSignal and (scalpSellSetup or rmiFlipSellSetup) and not amdShortSignal
rmiFlipLongSignal = longSignal and rmiFlipBuySetup
rmiFlipShortSignal = shortSignal and rmiFlipSellSetup
rmiPriorityLongSignal = longSignal and rmiRealBuyZone and buyReasonOK
rmiPriorityShortSignal = shortSignal and rmiRealSellZone and sellReasonOK

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OPEN TRADE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if longSignal or shortSignal
    active := true
    activeDir := longSignal ? 1 : -1
    entryBar := bar_index
    lastEntryBar := bar_index
    tradesToday += 1
    if amdLongSignal or amdShortSignal
        amdDoneKey := amdDayKey
    entryPrice := close
    slPrice := activeDir == 1 ? entryPrice - slDist : entryPrice + slDist
    tpPrice := activeDir == 1 ? entryPrice + tpDist : entryPrice - tpDist
    if not na(entryLine)
        line.delete(entryLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(tpLabel)
        label.delete(tpLabel)
    if not na(slLabel)
        label.delete(slLabel)
    if showSignals
        sigY = activeDir == 1 ? low - signalOffsetPts * pointUnit : high + signalOffsetPts * pointUnit
        label.new(bar_index, sigY, cleanChartMode or not showSetupNamesOnSignal ? (activeDir == 1 ? "BUY" : "SELL") : amdLongSignal ? "AMD 15M BUY" : amdShortSignal ? "AMD 15M SELL" : rmiPriorityLongSignal ? "RMI REAL BUY" : rmiPriorityShortSignal ? "RMI REAL SELL" : rmiFlipLongSignal ? "RMI ZONE BUY" : rmiFlipShortSignal ? "RMI ZONE SELL" : scalpLongSignal and rmiBuyReaction ? "RMI SCALP BUY" : scalpShortSignal and rmiSellReaction ? "RMI SCALP SELL" : scalpLongSignal ? "SCALP BUY" : scalpShortSignal ? "SCALP SELL" : activeDir == 1 ? "BUY" : "SELL", xloc=xloc.bar_index, yloc=yloc.price, style=activeDir == 1 ? label.style_label_up : label.style_label_down, color=amdLongSignal ? color.new(BUY_C, 0) : amdShortSignal ? color.new(SELL_C, 0) : activeDir == 1 ? BUY_C : SELL_C, textcolor=TXT_C, size=size.normal)
    if showTradeLines
        rx = bar_index + lineBars
        entryLine := line.new(bar_index, entryPrice, rx, entryPrice, xloc=xloc.bar_index, color=EN_C, width=2)
        tpLine := line.new(bar_index, tpPrice, rx, tpPrice, xloc=xloc.bar_index, color=TP_C, width=2)
        slLine := line.new(bar_index, slPrice, rx, slPrice, xloc=xloc.bar_index, color=SL_C, width=2)
        entryLabel := label.new(rx, entryPrice, "ENTRY", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=EN_C, textcolor=color.black, size=size.small)
        tpLabel := label.new(rx, tpPrice, "TP +" + str.tostring(targetPoints), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=TP_C, textcolor=TXT_C, size=size.small)
        slLabel := label.new(rx, slPrice, "SL -" + str.tostring(stopPoints), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=SL_C, textcolor=TXT_C, size=size.small)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EXIT SIMULATION - COUNTS EVERY CLOSED STOP/TP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if active and bar_index > nz(entryBar, bar_index)
    hitSL = activeDir == 1 ? low <= slPrice : high >= slPrice
    hitTP = activeDir == 1 ? high >= tpPrice : low <= tpPrice
    bool closeNow = false
    float closedPts = na
    float closePrice = close
    if barstate.isconfirmed and hitSL and hitTP
        if sameCandleRule == "Stop First"
            closeNow := true
            closedPts := -stopPoints
            closePrice := slPrice
        else
            closeNow := true
            closedPts := targetPoints
            closePrice := tpPrice
    else if barstate.isconfirmed and hitSL
        closeNow := true
        closedPts := -stopPoints
        closePrice := slPrice
    else if barstate.isconfirmed and hitTP
        closeNow := true
        closedPts := targetPoints
        closePrice := tpPrice
    if closeNow and not na(closedPts)
        closedTrades += 1
        if statsActive
            if closedPts > 0
                wins += 1
                winPts += closedPts
                lastResult := 1
            else
                losses += 1
                lossPts += math.abs(closedPts)
                lastResult := -1
        if closedPts < 0
            lastLossDir := activeDir
            lastLossBar := bar_index
        if showSignals
            label.new(bar_index, closePrice, closedPts > 0 ? "TP" : "STOP", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=closedPts > 0 ? TP_C : SL_C, textcolor=TXT_C, size=size.small)
        active := false
        activeDir := 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EXTEND ACTIVE LINES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if active and showTradeLines
    rx2 = bar_index + lineBars
    if not na(entryLine)
        line.set_x2(entryLine, rx2)
    if not na(tpLine)
        line.set_x2(tpLine, rx2)
    if not na(slLine)
        line.set_x2(slLine, rx2)
    if not na(entryLabel)
        label.set_x(entryLabel, rx2)
    if not na(tpLabel)
        label.set_x(tpLabel, rx2)
    if not na(slLabel)
        label.set_x(slLabel, rx2)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OPTIONAL MAP PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(showHiddenMap and not cleanChartMode ? tf2FibBL : na, "15m Fib Buy Low", color=color.new(BUY_C, 80))
plot(showHiddenMap and not cleanChartMode ? tf2FibBH : na, "15m Fib Buy High", color=color.new(BUY_C, 80))
plot(showHiddenMap and not cleanChartMode ? tf2FibSL : na, "15m Fib Sell Low", color=color.new(SELL_C, 80))
plot(showHiddenMap and not cleanChartMode ? tf2FibSH : na, "15m Fib Sell High", color=color.new(SELL_C, 80))
plot(showHiddenMap and not cleanChartMode ? ema20 : na, "EMA20", color=color.new(color.white, 75))
plot(showHiddenMap and not cleanChartMode ? vwapVal : na, "VWAP", color=color.new(color.yellow, 75))
plot(showUTLine and not cleanChartMode and utActive ? utStop : na, "UT Bot Stop", color=utBull ? color.new(BUY_C, 15) : utBear ? color.new(SELL_C, 15) : color.new(WAIT_C, 40), linewidth=2)
plotshape(showUTRawLabels and not cleanChartMode and utFreshBuy, title="UT Raw Buy", text="UT", style=shape.triangleup, location=location.belowbar, color=color.new(BUY_C, 0), textcolor=TXT_C, size=size.tiny)
plotshape(showUTRawLabels and not cleanChartMode and utFreshSell, title="UT Raw Sell", text="UT", style=shape.triangledown, location=location.abovebar, color=color.new(SELL_C, 0), textcolor=TXT_C, size=size.tiny)
plotshape(showRMIFlipLabels and not cleanChartMode and (not rmiHideMiddleFlipLabels or not rmiMiddleZone) and rmiFlipBuySetup, title="RMI Flip Buy Setup", text="RMI BUY", style=shape.triangleup, location=location.belowbar, color=color.new(BUY_C, 0), textcolor=TXT_C, size=size.tiny)
plotshape(showRMIFlipLabels and not cleanChartMode and (not rmiHideMiddleFlipLabels or not rmiMiddleZone) and rmiFlipSellSetup, title="RMI Flip Sell Setup", text="RMI SELL", style=shape.triangledown, location=location.abovebar, color=color.new(SELL_C, 0), textcolor=TXT_C, size=size.tiny)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STATS + MAP TABLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var table statT = table.new(tblPos, 2, 9, border_width=1, frame_color=color.new(color.white, 70), bgcolor=color.new(color.black, 10))
if barstate.islast and showTable
    totalTrades = wins + losses
    wr = totalTrades > 0 ? wins * 100.0 / totalTrades : 0.0
    netPts = winPts - lossPts
    mapTxt = powerUp ? "MAP UP" : powerDown ? "MAP DOWN" : rangeMarket ? "RANGE" : "MIX"
    mapCol = powerUp ? BUY_C : powerDown ? SELL_C : WAIT_C
    table.cell(statT, 0, 0, "SY265", text_color=TXT_C, bgcolor=BG_C, text_size=tblSize)
    table.cell(statT, 1, 0, "SMART", text_color=TXT_C, bgcolor=BG_C, text_size=tblSize)
    table.cell(statT, 0, 1, "MAP", text_color=TXT_C, text_size=tblSize)
    table.cell(statT, 1, 1, mapTxt, text_color=mapCol, text_size=tblSize)
    table.cell(statT, 0, 2, "WIN / LOSS", text_color=TXT_C, text_size=tblSize)
    table.cell(statT, 1, 2, str.tostring(wins) + " / " + str.tostring(losses), text_color=totalTrades > 0 and wins >= losses ? BUY_C : SELL_C, text_size=tblSize)
    table.cell(statT, 0, 3, "WR%", text_color=TXT_C, text_size=tblSize)
    table.cell(statT, 1, 3, str.tostring(wr, "#.0") + "%", text_color=wr >= 50 ? BUY_C : SELL_C, text_size=tblSize)
    table.cell(statT, 0, 4, "NET", text_color=TXT_C, text_size=tblSize)
    table.cell(statT, 1, 4, str.tostring(netPts, "#") + " pts", text_color=netPts >= 0 ? BUY_C : SELL_C, text_size=tblSize)
    table.cell(statT, 0, 5, "LAST", text_color=TXT_C, text_size=tblSize)
    table.cell(statT, 1, 5, lastResult == 1 ? "TP" : lastResult == -1 ? "STOP" : "-", text_color=lastResult == 1 ? TP_C : lastResult == -1 ? SL_C : WAIT_C, text_size=tblSize)
    table.cell(statT, 0, 6, "RESET", text_color=TXT_C, text_size=tblSize)
    table.cell(statT, 1, 6, "Key " + str.tostring(manualResetKey), text_color=WARN_C, text_size=tblSize)
    table.cell(statT, 0, 7, "AMD", text_color=TXT_C, text_size=tblSize)
    table.cell(statT, 1, 7, not useAMD ? "OFF" : amdAlreadyDone ? "DONE" : (amdUseSetupTF ? amdTFManipDirRaw : amdManipDir) == 1 ? "15M LOW SWEEP" : (amdUseSetupTF ? amdTFManipDirRaw : amdManipDir) == -1 ? "15M HIGH SWEEP" : (amdUseSetupTF ? amdTFInAsia : inAMDAsia) ? "ASIA" : "WAIT", text_color=not useAMD ? WAIT_C : amdAlreadyDone ? TP_C : amdManipDir == 1 ? BUY_C : amdManipDir == -1 ? SELL_C : WAIT_C, text_size=tblSize)
    table.cell(statT, 0, 8, "REASON", text_color=TXT_C, text_size=tblSize)
    table.cell(statT, 1, 8, reasonShowInTable ? "B " + str.tostring(buyReasonCount) + " / S " + str.tostring(sellReasonCount) : "-", text_color=buyReasonCount > sellReasonCount ? BUY_C : sellReasonCount > buyReasonCount ? SELL_C : WAIT_C, text_size=tblSize)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DEBUG TABLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var table dbgT = table.new(position.bottom_right, 2, 13, border_width=1, frame_color=color.new(color.white, 85), bgcolor=color.new(color.black, 20))
if barstate.islast and showDebug
    table.cell(dbgT, 0, 0, "MAP", text_color=TXT_C, bgcolor=BG_C, text_size=size.tiny)
    table.cell(dbgT, 1, 0, powerUp ? "UP" : powerDown ? "DOWN" : rangeMarket ? "RANGE" : "MIX", text_color=powerUp ? BUY_C : powerDown ? SELL_C : WAIT_C, bgcolor=BG_C, text_size=size.tiny)
    table.cell(dbgT, 0, 1, "Q", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 1, "B " + str.tostring(buyQ) + " / S " + str.tostring(sellQ), text_color=buyQ > sellQ ? BUY_C : sellQ > buyQ ? SELL_C : WAIT_C, text_size=size.tiny)
    table.cell(dbgT, 0, 2, "SCORE", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 2, "B " + str.tostring(buyScore, "#.0") + " / S " + str.tostring(sellScore, "#.0"), text_color=buyScore > sellScore ? BUY_C : sellScore > buyScore ? SELL_C : WAIT_C, text_size=size.tiny)
    table.cell(dbgT, 0, 3, "RISK", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 3, "B " + str.tostring(buyRisk, "#.0") + " / S " + str.tostring(sellRisk, "#.0"), text_color=WAIT_C, text_size=size.tiny)
    table.cell(dbgT, 0, 4, "ZONE", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 4, htfBuyZone ? "HTF BUY" : htfSellZone ? "HTF SELL" : discount ? "DISCOUNT" : premium ? "PREMIUM" : "MID", text_color=htfBuyZone or discount ? BUY_C : htfSellZone or premium ? SELL_C : WAIT_C, text_size=size.tiny)
    table.cell(dbgT, 0, 5, "ROOM", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 5, "UP " + str.tostring(roomBuyPts, "#") + " / DN " + str.tostring(roomSellPts, "#"), text_color=roomBuyOK ? BUY_C : roomSellOK ? SELL_C : WAIT_C, text_size=size.tiny)
    table.cell(dbgT, 0, 6, "STATE", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 6, crazyCandle ? "CRAZY" : deadMarket ? "DEAD" : wildMarket ? "WILD" : conflictMarket ? "CONFLICT" : "OK", text_color=crazyCandle or deadMarket or wildMarket or conflictMarket ? WARN_C : BUY_C, text_size=size.tiny)
    table.cell(dbgT, 0, 7, "ACTIVE", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 7, active ? activeDir == 1 ? "BUY" : "SELL" : "NO", text_color=active ? activeDir == 1 ? BUY_C : SELL_C : WAIT_C, text_size=size.tiny)
    table.cell(dbgT, 0, 8, "UT", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 8, not utActive ? "OFF" : utBull ? "BULL" : utBear ? "BEAR" : "MID", text_color=not utActive ? WAIT_C : utBull ? BUY_C : utBear ? SELL_C : WAIT_C, text_size=size.tiny)
    table.cell(dbgT, 0, 9, "SELL BAL", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 9, not sellBalanceActive ? "OFF" : sellBalanceOK and sideGuardSellOK ? "READY" : sellBalanceOK and not sideGuardSellOK ? "GUARD" : sellBalanceZone ? "ZONE" : "WAIT", text_color=not sellBalanceActive ? WAIT_C : sellBalanceOK ? SELL_C : sellBalanceZone ? WARN_C : WAIT_C, text_size=size.tiny)
    table.cell(dbgT, 0, 10, "AMD", text_color=TXT_C, text_size=size.tiny)
    table.cell(dbgT, 1, 10, not useAMD ? "OFF" : amdBuySetup ? "AMD 15M BUY" : amdSellSetup ? "AMD 15M SELL" : amdAlreadyDone ? "DONE" : amdManipDir == 1 ? "LOW SWP" : amdManipDir == -1 ? "HIGH SWP" : "WAIT", text_color=not useAMD ? WAIT_C : amdBuySetup ? BUY_C : amdSellSetup ? SELL_C : amdAlreadyDone ? TP_C : WAIT_C, text_size=size.tiny)

