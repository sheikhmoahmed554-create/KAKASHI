continuationSchoolTF = input.timeframe("15", "Continuation / Breakout School TF", group=G_SCHOOL_TF)
liquiditySchoolTF = input.timeframe("15", "Liquidity Sweep School TF", group=G_SCHOOL_TF)
structureSchoolTF = input.timeframe("30", "Structure MSS School TF", group=G_SCHOOL_TF)
retestSchoolTF = input.timeframe("10", "Break Retest School TF", group=G_SCHOOL_TF)
obSchoolTF = input.timeframe("10", "Order Block School TF", group=G_SCHOOL_TF)
fvgSchoolTF = input.timeframe("15", "FVG School TF", group=G_SCHOOL_TF)
fibSchoolTF = input.timeframe("15", "Fibo / OTE School TF", group=G_SCHOOL_TF)
rangeSchoolTF = input.timeframe("60", "Range Edge School TF", group=G_SCHOOL_TF)
valueSchoolTF = input.timeframe("180", "VWAP / Value School TF", group=G_SCHOOL_TF)
momentumSchoolTF = input.timeframe("1", "Momentum / Candle School TF", group=G_SCHOOL_TF)
