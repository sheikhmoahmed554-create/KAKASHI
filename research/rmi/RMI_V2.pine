//@version=6
// Relative Momentum Index (RMI) based on the original concept by Roger Altman.
// Standalone RMI trade engine with the SYR30-style statistics table and
// chart-side BUY/SELL, Entry, TP and SL visuals.
indicator("RMI + MULTICATOR SOURCES", shorttitle="RMI MC", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// ══════════════════════════════════════════════════════════════════
// COLORS — copied from the SYR30 visual system
// ══════════════════════════════════════════════════════════════════
color BUY_C  = color.rgb(0, 170, 90)
color SELL_C = color.rgb(230, 45, 55)
color TP_C   = color.rgb(0, 120, 255)
color SL_C   = color.rgb(230, 45, 55)
color EN_C   = color.rgb(255, 210, 0)
color TXT_C  = color.white
color WAIT_C = color.rgb(150, 150, 150)

color TBL_BG      = color.rgb(16, 18, 26)
color TBL_BG_HEAD = color.rgb(22, 24, 34)
color TBL_BG_ROW  = color.rgb(18, 20, 30)
color TBL_BG_ROW2 = color.rgb(20, 22, 32)

// ══════════════════════════════════════════════════════════════════
// GROUPS
// ══════════════════════════════════════════════════════════════════
G_RMI   = "01 ■ RMI"
G_ENTRY = "02 ■ RMI Reaction Entry"
G_SRC   = "03 ■ Multicator Sources"
G_RISK  = "04 ■ Trade / TP / SL"
G_EXEC  = "05 ■ Execution"
G_VIS   = "06 ■ Statistics / Visuals"
G_ALERT = "07 ■ Alerts / Bot"

// ══════════════════════════════════════════════════════════════════
// 01 ■ RMI
// ══════════════════════════════════════════════════════════════════
rmiLength = input.int(18, "Length", minval=1, group=G_RMI)
rmiMomentum = input.int(6, "Momentum", minval=1, group=G_RMI)
rmiOverbought = input.float(80.0, "Overbought / SELL Zone", minval=50.0, maxval=100.0, step=1.0, group=G_RMI)
rmiOversold = input.float(20.0, "Oversold / BUY Zone", minval=0.0, maxval=50.0, step=1.0, group=G_RMI)
rmiSignalLength = input.int(6, "Signal Length", minval=1, group=G_RMI)
rmiChangeColor = input.bool(true, "Change RMI Color", group=G_RMI)
rmiShowSignal = input.bool(true, "Show Signal Line", group=G_RMI)
rmiShowHistogram = input.bool(false, "Show Histogram", group=G_RMI)

// ══════════════════════════════════════════════════════════════════
// 02 ■ RMI Reaction Entry
// The zone arms a setup. It never opens immediately on the saturation bar.
// ══════════════════════════════════════════════════════════════════
enableRMIEntries = input.bool(true, "Enable RMI Trades", group=G_ENTRY)
enableBuy = input.bool(true, "Enable BUY", group=G_ENTRY, inline="SIDE")
enableSell = input.bool(true, "Enable SELL", group=G_ENTRY, inline="SIDE")
reactionBars = input.int(2, "Consecutive Reaction Candles", minval=1, maxval=10, group=G_ENTRY)
maxReactionWaitBars = input.int(12, "Maximum Bars After Zone", minval=1, maxval=50, group=G_ENTRY)
requirePriceReaction = input.bool(true, "Require Price Reaction", group=G_ENTRY)
requireRMISignalCross = input.bool(false, "Require RMI / Signal Cross", group=G_ENTRY)

// Optional context checks. Zero means disabled.
previousExtremeLookback = input.int(40, "Previous High/Low Lookback (0 = Off)", minval=0, maxval=500, group=G_ENTRY)
liquiditySweepLookback = input.int(0, "Liquidity Sweep Lookback (0 = Off)", minval=0, maxval=500, group=G_ENTRY)

// ══════════════════════════════════════════════════════════════════
// 03 ■ Multicator Sources
// كل أداة تعمل بأحد ثلاثة أوضاع:
//   Off    — لا أثر لها إطلاقاً
//   Source — تفتح صفقة بنفسها، بالتوازي مع RMI
//   Filter — لا تفتح شيئاً، لكنها تمنع أي دخول لا يوافقها
// الافتراضي Off في الجميع، فيبقى المؤشر مطابقاً لخط الأساس المتحقَّق منه.
// ══════════════════════════════════════════════════════════════════
mcRsiMode = input.string("Off", "RSI", options=["Off", "Source", "Filter"], group=G_SRC)
mcRsiLen = input.int(14, "RSI Length", minval=2, group=G_SRC)
mcRsiMaLen = input.int(10, "RSI MA Length", minval=2, group=G_SRC)
mcRsiOS = input.float(30.0, "RSI Oversold", minval=1.0, maxval=50.0, group=G_SRC)
mcRsiOB = input.float(70.0, "RSI Overbought", minval=50.0, maxval=99.0, group=G_SRC)

mcMacdMode = input.string("Off", "MACD", options=["Off", "Source", "Filter"], group=G_SRC)
mcMacdFast = input.int(12, "MACD Fast", minval=1, group=G_SRC)
mcMacdSlow = input.int(26, "MACD Slow", minval=2, group=G_SRC)
mcMacdSig = input.int(9, "MACD Signal", minval=1, group=G_SRC)

mcAdxMode = input.string("Off", "ADX / DMI", options=["Off", "Source", "Filter"], group=G_SRC)
mcAdxLen = input.int(17, "DMI Length", minval=1, group=G_SRC)
mcAdxSmooth = input.int(14, "ADX Smoothing", minval=1, maxval=50, group=G_SRC)
mcAdxMin = input.float(20.0, "ADX Minimum", minval=0.0, maxval=60.0, step=1.0, group=G_SRC)

mcBbMode = input.string("Off", "Bollinger", options=["Off", "Source", "Filter"], group=G_SRC)
mcBbLen = input.int(20, "BB Length", minval=2, group=G_SRC)
mcBbMult = input.float(2.0, "BB StdDev", minval=0.1, maxval=10.0, step=0.1, group=G_SRC)

mcIchiMode = input.string("Off", "Ichimoku", options=["Off", "Source", "Filter"], group=G_SRC)
mcIchiConv = input.int(9, "Conversion Length", minval=1, group=G_SRC)
mcIchiBase = input.int(26, "Base Length", minval=1, group=G_SRC)
mcIchiSpanB = input.int(52, "Leading Span B Length", minval=1, group=G_SRC)

mcSarMode = input.string("Off", "Parabolic SAR", options=["Off", "Source", "Filter"], group=G_SRC)
mcSarStart = input.float(0.02, "SAR Start", minval=0.001, step=0.001, group=G_SRC)
mcSarInc = input.float(0.02, "SAR Increment", minval=0.001, step=0.001, group=G_SRC)
mcSarMax = input.float(0.2, "SAR Maximum", minval=0.01, step=0.01, group=G_SRC)

mcPivotMode = input.string("Off", "Pivot Reclaim", options=["Off", "Source", "Filter"], group=G_SRC)
mcPivotLeft = input.int(10, "Pivot Left", minval=1, group=G_SRC)
mcPivotRight = input.int(10, "Pivot Right", minval=1, group=G_SRC)

mcFibMode = input.string("Off", "Fibonacci Retracement", options=["Off", "Source", "Filter"], group=G_SRC)
mcFibLen = input.int(233, "Fibonacci Distance", minval=8, group=G_SRC)
mcFibA = input.float(0.618, "Fib Level A", minval=0.0, maxval=1.618, step=0.001, group=G_SRC)
mcFibB = input.float(0.382, "Fib Level B", minval=0.0, maxval=1.618, step=0.001, group=G_SRC)
mcFibC = input.float(0.786, "Fib Level C", minval=0.0, maxval=1.618, step=0.001, group=G_SRC)
mcFibTolATR = input.float(0.25, "Fib Touch Tolerance ATR", minval=0.01, maxval=2.0, step=0.01, group=G_SRC)

mcMaMode = input.string("Off", "Moving Average", options=["Off", "Source", "Filter"], group=G_SRC)
mcMaType = input.string("EMA", "MA Type", options=["EMA", "SMA"], group=G_SRC)
mcMaLen = input.int(200, "MA Length", minval=2, group=G_SRC)

mcBrtMode = input.string("Off", "Breakout & Retest", options=["Off", "Source", "Filter"], group=G_SRC)
mcBrtPeriod = input.int(7, "BRT Pivot Period", minval=1, group=G_SRC)
mcBrtConfirmDiv = input.int(2, "BRT Confirmation Divider", minval=1, maxval=10, group=G_SRC)
mcBrtAtrLen = input.int(40, "BRT ATR Length", minval=1, group=G_SRC)
mcBrtAtrMult = input.float(2.0, "BRT ATR Multiplier", minval=0.1, step=0.1, group=G_SRC)

mcAtrLen = input.int(14, "ATR Length — shared by sources", minval=1, group=G_SRC)

// ══════════════════════════════════════════════════════════════════
// 04 ■ Trade / TP / SL
// ══════════════════════════════════════════════════════════════════
pointUnitInput = input.float(0.10, "1 Point = Price Move", minval=0.00001, step=0.01, group=G_RISK)
targetPoints = input.float(130.0, "Target Points", minval=1.0, step=1.0, group=G_RISK)
stopPoints = input.float(70.0, "Stop Points", minval=1.0, step=1.0, group=G_RISK)
sameCandleRule = input.string("Skip", "If TP and SL Same Candle", options=["Stop First", "Target First", "Skip"], group=G_RISK)

// ══════════════════════════════════════════════════════════════════
// 05 ■ Execution
// One open trade is always enforced.
// ══════════════════════════════════════════════════════════════════
cooldownBars = input.int(0, "Cooldown After Closed Trade", minval=0, maxval=1000, group=G_EXEC)
buyCooldownBars = input.int(0, "BUY Cooldown After BUY Loss", minval=0, maxval=1000, group=G_EXEC)
sellCooldownBars = input.int(0, "SELL Cooldown After SELL Loss", minval=0, maxval=1000, group=G_EXEC)

// ══════════════════════════════════════════════════════════════════
// 06 ■ Statistics / Visuals
// ══════════════════════════════════════════════════════════════════
showSignals = input.bool(true, "Show BUY / SELL / TP / SL", group=G_VIS)
showTradeLines = input.bool(true, "Show Entry / TP / SL Lines", group=G_VIS)
showLineTags = input.bool(true, "Show Entry / TP / SL Tags", group=G_VIS)
showTable = input.bool(true, "Show Stats Table", group=G_VIS)
lineBars = input.int(70, "Active Line Bars", minval=5, maxval=500, group=G_VIS)
statsMode = input.string("All Loaded History", "Stats Count", options=["All Loaded History", "From Custom Time"], group=G_VIS)
statsStartTime = input.time(1784512800000, "Start Stats From (UTC)", group=G_VIS)
manualResetKey = input.int(0, "Manual Reset Number", minval=0, group=G_VIS)

// ══════════════════════════════════════════════════════════════════
// 07 ■ Alerts / Bot
// Dynamic alert() payload contains the same TP/SL shown on the chart.
// ══════════════════════════════════════════════════════════════════
useAlertFunction = input.bool(false, "Send BOT Message alert()", group=G_ALERT)
webhookKey = input.string("SECRET_135", "BOT Secret Key", group=G_ALERT)
botSymbol = input.string("XAUUSD", "BOT Symbol - Message Only", group=G_ALERT)
lotSize = input.float(0.02, "BOT Lot Size - Message Only", minval=0.01, step=0.01, group=G_ALERT)
alertFormat = input.string("JSON", "alert() Message Format", options=["JSON", "Simple"], group=G_ALERT)

// ══════════════════════════════════════════════════════════════════
// RMI CALCULATION
// ══════════════════════════════════════════════════════════════════
pointUnit = math.max(pointUnitInput, syminfo.mintick)
rmiUp = ta.ema(math.max(close - close[rmiMomentum], 0.0), rmiLength)
rmiDown = ta.ema(math.max(close[rmiMomentum] - close, 0.0), rmiLength)
rmi = rmiDown == 0.0 ? (rmiUp == 0.0 ? 50.0 : 100.0) : 100.0 - 100.0 / (1.0 + rmiUp / rmiDown)
rmiSignal = ta.sma(rmi, rmiSignalLength)

// RMI remains fully calculated for entries and table statistics.
// Its oscillator, signal, histogram and guide lines are intentionally not plotted,
// so the script creates no lower RMI panel. Entry / TP / SL price lines remain active.
rmiColor = rmiChangeColor ? (rmi > rmi[1] ? color.rgb(0, 148, 255) : color.rgb(255, 0, 110)) : color.rgb(0, 148, 255)

// ══════════════════════════════════════════════════════════════════
// MULTICATOR SOURCES — كل أداة تُنتج إشارة شراء وإشارة بيع
// كلها سببية: لا تقرأ إلا شموعاً مغلقة. ta.pivot* تُرجع قيمة قديمة
// مؤكَّدة بالفعل، فلا نظرة أمامية فيها.
// ══════════════════════════════════════════════════════════════════
mcATR = ta.atr(mcAtrLen)

// RSI — تقاطع مع متوسطه قادماً من منطقة التشبّع
mcRsi = ta.rsi(close, mcRsiLen)
mcRsiMa = ta.sma(mcRsi, mcRsiMaLen)
mcRsiBuy = ta.crossover(mcRsi, mcRsiMa) and mcRsi[1] <= mcRsiOS
mcRsiSell = ta.crossunder(mcRsi, mcRsiMa) and mcRsi[1] >= mcRsiOB
mcRsiBuyOK = mcRsi > mcRsiMa
mcRsiSellOK = mcRsi < mcRsiMa

// MACD — تقاطع الخط مع خط الإشارة
[mcMacdLine, mcMacdSignal, mcMacdHist] = ta.macd(close, mcMacdFast, mcMacdSlow, mcMacdSig)
mcMacdBuy = ta.crossover(mcMacdLine, mcMacdSignal)
mcMacdSell = ta.crossunder(mcMacdLine, mcMacdSignal)
mcMacdBuyOK = mcMacdLine > mcMacdSignal
mcMacdSellOK = mcMacdLine < mcMacdSignal

// ADX / DMI — اتجاه مع قوة كافية
[mcPDI, mcMDI, mcADX] = ta.dmi(mcAdxLen, mcAdxSmooth)
mcAdxBuy = ta.crossover(mcPDI, mcMDI) and mcADX >= mcAdxMin
mcAdxSell = ta.crossunder(mcMDI, mcPDI) == false and ta.crossunder(mcPDI, mcMDI) and mcADX >= mcAdxMin
mcAdxBuyOK = mcPDI > mcMDI and mcADX >= mcAdxMin
mcAdxSellOK = mcMDI > mcPDI and mcADX >= mcAdxMin

// Bollinger — ارتداد من الحافة إلى الداخل
mcBbBasis = ta.sma(close, mcBbLen)
mcBbDev = mcBbMult * ta.stdev(close, mcBbLen)
mcBbUpper = mcBbBasis + mcBbDev
mcBbLower = mcBbBasis - mcBbDev
mcBbBuy = low <= mcBbLower and close > mcBbLower and close > open
mcBbSell = high >= mcBbUpper and close < mcBbUpper and close < open
mcBbBuyOK = close < mcBbBasis
mcBbSellOK = close > mcBbBasis

// Ichimoku — تقاطع التحويل والأساس مع موقع السعر من السحابة
mcDonchian(_len) =>
    (ta.lowest(_len) + ta.highest(_len)) / 2.0
mcConv = mcDonchian(mcIchiConv)
mcBase = mcDonchian(mcIchiBase)
mcSpanA = (mcConv + mcBase) / 2.0
mcSpanB = mcDonchian(mcIchiSpanB)
mcCloudTop = math.max(mcSpanA, mcSpanB)
mcCloudBot = math.min(mcSpanA, mcSpanB)
mcIchiBuy = ta.crossover(mcConv, mcBase) and close > mcCloudBot
mcIchiSell = ta.crossunder(mcConv, mcBase) and close < mcCloudTop
mcIchiBuyOK = close > mcCloudTop
mcIchiSellOK = close < mcCloudBot

// Parabolic SAR — مكتوب يدوياً لأن محرك الاختبار لا يوفّر ta.sar، وصيغته
// هي صيغة وايلدر نفسها فالنتيجة على TradingView واحدة. كُتب مسطّحاً بلا تفريعات
// متداخلة لأن محلّل المحرك يعلق عليها.
var float mcSarVal = na
var float mcSarEP = na
var float mcSarAF = na
var int mcSarDir = 0
mcSarSeed = na(mcSarVal)
mcSarUp = mcSarDir == 1
mcSarRaw = mcSarSeed ? na : mcSarVal + mcSarAF * (mcSarEP - mcSarVal)
mcSarClamped = mcSarSeed ? na : mcSarUp ? math.min(mcSarRaw, math.min(nz(low[1], low), nz(low[2], low))) : math.max(mcSarRaw, math.max(nz(high[1], high), nz(high[2], high)))
mcSarFlip = mcSarSeed ? false : mcSarUp ? low <= mcSarClamped : high >= mcSarClamped
mcSarNewDir = mcSarSeed ? (close >= open ? 1 : -1) : mcSarFlip ? -mcSarDir : mcSarDir
mcSarNewVal = mcSarSeed ? (mcSarNewDir == 1 ? low : high) : mcSarFlip ? mcSarEP : mcSarClamped
mcSarNewEP = mcSarSeed or mcSarFlip ? (mcSarNewDir == 1 ? high : low) : mcSarUp ? math.max(mcSarEP, high) : math.min(mcSarEP, low)
mcSarNewAF = mcSarSeed or mcSarFlip ? mcSarStart : mcSarNewEP != mcSarEP ? math.min(mcSarAF + mcSarInc, mcSarMax) : mcSarAF
mcSarDir := mcSarNewDir
mcSarVal := mcSarNewVal
mcSarEP := mcSarNewEP
mcSarAF := mcSarNewAF
mcSar = mcSarVal
mcSarBuy = mcSarFlip and mcSarDir == 1
mcSarSell = mcSarFlip and mcSarDir == -1
mcSarBuyOK = mcSarDir == 1
mcSarSellOK = mcSarDir == -1

// Pivot — استعادة آخر قاع مؤكَّد أو رفض آخر قمة مؤكَّدة
mcPh = ta.pivothigh(mcPivotLeft, mcPivotRight)
mcPl = ta.pivotlow(mcPivotLeft, mcPivotRight)
var float mcLastPh = na
var float mcLastPl = na
mcLastPh := na(mcPh) ? mcLastPh : mcPh
mcLastPl := na(mcPl) ? mcLastPl : mcPl
mcPivotBuy = not na(mcLastPl) and low <= mcLastPl and close > mcLastPl and close > open
mcPivotSell = not na(mcLastPh) and high >= mcLastPh and close < mcLastPh and close < open
mcPivotBuyOK = not na(mcLastPl) and close > mcLastPl
mcPivotSellOK = not na(mcLastPh) and close < mcLastPh

// Fibonacci — لمس أحد مستويات التصحيح ثم الإغلاق في الاتجاه
mcFibTop = ta.highest(high, mcFibLen)
mcFibBot = ta.lowest(low, mcFibLen)
mcFibRange = mcFibTop - mcFibBot
mcFibDownLeg = math.abs(ta.highestbars(mcFibLen)) < math.abs(ta.lowestbars(mcFibLen))
mcFibL1 = mcFibDownLeg ? mcFibTop - mcFibRange * mcFibA : mcFibBot + mcFibRange * mcFibA
mcFibL2 = mcFibDownLeg ? mcFibTop - mcFibRange * mcFibB : mcFibBot + mcFibRange * mcFibB
mcFibL3 = mcFibDownLeg ? mcFibTop - mcFibRange * mcFibC : mcFibBot + mcFibRange * mcFibC
mcFibTol = mcATR * mcFibTolATR
mcNearLevel(_p) =>
    math.min(math.min(math.abs(_p - mcFibL1), math.abs(_p - mcFibL2)), math.abs(_p - mcFibL3)) <= mcFibTol
mcFibBuy = mcFibRange > 0 and mcNearLevel(low) and close > open and close > math.min(math.min(mcFibL1, mcFibL2), mcFibL3)
mcFibSell = mcFibRange > 0 and mcNearLevel(high) and close < open and close < math.max(math.max(mcFibL1, mcFibL2), mcFibL3)
mcFibBuyOK = mcFibRange > 0 and close >= mcFibBot + mcFibRange * 0.236
mcFibSellOK = mcFibRange > 0 and close <= mcFibTop - mcFibRange * 0.236

// Moving average — عبور المتوسط أو الوقوف في جهته
mcMa = mcMaType == "EMA" ? ta.ema(close, mcMaLen) : ta.sma(close, mcMaLen)
mcMaBuy = ta.crossover(close, mcMa)
mcMaSell = ta.crossunder(close, mcMa)
mcMaBuyOK = close > mcMa
mcMaSellOK = close < mcMa

// Breakout & Retest — قمة محورية تتشكّل قرب قاعٍ سبق كسره تعني بيعاً، والعكس شراء.
// الأصل يحفظ آخر ثلاث نقاط محورية في قائمة؛ القوائم غير متاحة في محرك الاختبار
// فكُتبت الفتحات الثلاث صراحةً، والسلوك واحد.
mcBrtConfirm = math.max(1, mcBrtPeriod / mcBrtConfirmDiv)
mcBrtTol = ta.atr(mcBrtAtrLen) * mcBrtAtrMult
mcBrtPh = ta.pivothigh(high, mcBrtPeriod, mcBrtConfirm)
mcBrtPl = ta.pivotlow(low, mcBrtPeriod, mcBrtConfirm)

var float mcBrtH0 = na
var float mcBrtH1 = na
var float mcBrtH2 = na
var float mcBrtL0 = na
var float mcBrtL1 = na
var float mcBrtL2 = na

// المسافة إلى كل فتحة، وna تعني فتحة فارغة تُستبعد
mcBrtDL0 = na(mcBrtL0) or na(mcBrtPh) ? 1e18 : math.abs(mcBrtL0 - mcBrtPh)
mcBrtDL1 = na(mcBrtL1) or na(mcBrtPh) ? 1e18 : math.abs(mcBrtL1 - mcBrtPh)
mcBrtDL2 = na(mcBrtL2) or na(mcBrtPh) ? 1e18 : math.abs(mcBrtL2 - mcBrtPh)
mcBrtMinL = math.min(mcBrtDL0, math.min(mcBrtDL1, mcBrtDL2))
mcBrtPickL = mcBrtDL0 <= mcBrtMinL ? mcBrtL0 : mcBrtDL1 <= mcBrtMinL ? mcBrtL1 : mcBrtL2

mcBrtDH0 = na(mcBrtH0) or na(mcBrtPl) ? 1e18 : math.abs(mcBrtH0 - mcBrtPl)
mcBrtDH1 = na(mcBrtH1) or na(mcBrtPl) ? 1e18 : math.abs(mcBrtH1 - mcBrtPl)
mcBrtDH2 = na(mcBrtH2) or na(mcBrtPl) ? 1e18 : math.abs(mcBrtH2 - mcBrtPl)
mcBrtMinH = math.min(mcBrtDH0, math.min(mcBrtDH1, mcBrtDH2))
mcBrtPickH = mcBrtDH0 <= mcBrtMinH ? mcBrtH0 : mcBrtDH1 <= mcBrtMinH ? mcBrtH1 : mcBrtH2

// الإشارة: المستوى قريب ضمن التسامح، وقد كُسر فعلاً عند شمعة النقطة المحورية
mcBrtSell = not na(mcBrtPh) and mcBrtMinL < mcBrtTol and low[mcBrtConfirm] < mcBrtPickL
mcBrtBuy = not na(mcBrtPl) and mcBrtMinH < mcBrtTol and high[mcBrtConfirm] > mcBrtPickH

// الأصل يستهلك أقرب نقطة عند كل تشكّل، سواء أطلقت إشارة أم لا
mcBrtDropL0 = not na(mcBrtPh) and mcBrtDL0 <= mcBrtMinL
mcBrtDropL1 = not na(mcBrtPh) and not mcBrtDropL0 and mcBrtDL1 <= mcBrtMinL
mcBrtDropL2 = not na(mcBrtPh) and not mcBrtDropL0 and not mcBrtDropL1
mcBrtL0 := mcBrtDropL0 ? mcBrtL1 : mcBrtL0
mcBrtL1 := mcBrtDropL0 ? mcBrtL2 : mcBrtDropL1 ? mcBrtL2 : mcBrtL1
mcBrtL2 := not na(mcBrtPh) ? na : mcBrtL2

mcBrtDropH0 = not na(mcBrtPl) and mcBrtDH0 <= mcBrtMinH
mcBrtDropH1 = not na(mcBrtPl) and not mcBrtDropH0 and mcBrtDH1 <= mcBrtMinH
mcBrtDropH2 = not na(mcBrtPl) and not mcBrtDropH0 and not mcBrtDropH1
mcBrtH0 := mcBrtDropH0 ? mcBrtH1 : mcBrtH0
mcBrtH1 := mcBrtDropH0 ? mcBrtH2 : mcBrtDropH1 ? mcBrtH2 : mcBrtH1
mcBrtH2 := not na(mcBrtPl) ? na : mcBrtH2

// ثم تُدفع النقطة الجديدة إلى مقدمة الذاكرة
mcBrtH2 := not na(mcBrtPh) ? mcBrtH1 : mcBrtH2
mcBrtH1 := not na(mcBrtPh) ? mcBrtH0 : mcBrtH1
mcBrtH0 := not na(mcBrtPh) ? mcBrtPh : mcBrtH0
mcBrtL2 := not na(mcBrtPl) ? mcBrtL1 : mcBrtL2
mcBrtL1 := not na(mcBrtPl) ? mcBrtL0 : mcBrtL1
mcBrtL0 := not na(mcBrtPl) ? mcBrtPl : mcBrtL0

mcBrtBuyOK = not na(mcBrtL0) and close > mcBrtL0
mcBrtSellOK = not na(mcBrtH0) and close < mcBrtH0

// ── تجميع المصادر والفلاتر ──────────────────────────────────────────────────
f_src(_mode, _sig) =>
    _mode == "Source" and _sig

f_flt(_mode, _ok) =>
    _mode != "Filter" or _ok

mcSourceBuy = f_src(mcRsiMode, mcRsiBuy) or f_src(mcMacdMode, mcMacdBuy) or
 f_src(mcAdxMode, mcAdxBuy) or f_src(mcBbMode, mcBbBuy) or f_src(mcIchiMode, mcIchiBuy) or
 f_src(mcSarMode, mcSarBuy) or f_src(mcPivotMode, mcPivotBuy) or f_src(mcFibMode, mcFibBuy) or
 f_src(mcMaMode, mcMaBuy) or f_src(mcBrtMode, mcBrtBuy)

mcSourceSell = f_src(mcRsiMode, mcRsiSell) or f_src(mcMacdMode, mcMacdSell) or
 f_src(mcAdxMode, mcAdxSell) or f_src(mcBbMode, mcBbSell) or f_src(mcIchiMode, mcIchiSell) or
 f_src(mcSarMode, mcSarSell) or f_src(mcPivotMode, mcPivotSell) or f_src(mcFibMode, mcFibSell) or
 f_src(mcMaMode, mcMaSell) or f_src(mcBrtMode, mcBrtSell)

mcFilterBuyOK = f_flt(mcRsiMode, mcRsiBuyOK) and f_flt(mcMacdMode, mcMacdBuyOK) and
 f_flt(mcAdxMode, mcAdxBuyOK) and f_flt(mcBbMode, mcBbBuyOK) and f_flt(mcIchiMode, mcIchiBuyOK) and
 f_flt(mcSarMode, mcSarBuyOK) and f_flt(mcPivotMode, mcPivotBuyOK) and f_flt(mcFibMode, mcFibBuyOK) and
 f_flt(mcMaMode, mcMaBuyOK) and f_flt(mcBrtMode, mcBrtBuyOK)

mcFilterSellOK = f_flt(mcRsiMode, mcRsiSellOK) and f_flt(mcMacdMode, mcMacdSellOK) and
 f_flt(mcAdxMode, mcAdxSellOK) and f_flt(mcBbMode, mcBbSellOK) and f_flt(mcIchiMode, mcIchiSellOK) and
 f_flt(mcSarMode, mcSarSellOK) and f_flt(mcPivotMode, mcPivotSellOK) and f_flt(mcFibMode, mcFibSellOK) and
 f_flt(mcMaMode, mcMaSellOK) and f_flt(mcBrtMode, mcBrtSellOK)

mcActiveCount = (mcRsiMode != "Off" ? 1 : 0) + (mcMacdMode != "Off" ? 1 : 0) +
 (mcAdxMode != "Off" ? 1 : 0) + (mcBbMode != "Off" ? 1 : 0) + (mcIchiMode != "Off" ? 1 : 0) +
 (mcSarMode != "Off" ? 1 : 0) + (mcPivotMode != "Off" ? 1 : 0) + (mcFibMode != "Off" ? 1 : 0) +
 (mcMaMode != "Off" ? 1 : 0) + (mcBrtMode != "Off" ? 1 : 0)

// ══════════════════════════════════════════════════════════════════
// REACTION ENGINE
// ══════════════════════════════════════════════════════════════════
inBuyZone = rmi <= rmiOversold
inSellZone = rmi >= rmiOverbought
buyZoneEntered = inBuyZone and not inBuyZone[1]
sellZoneEntered = inSellZone and not inSellZone[1]

var bool buyArmed = false
var bool sellArmed = false
var int buyArmBar = na
var int sellArmBar = na
var int buyReactionCount = 0
var int sellReactionCount = 0
var bool buyExtremeSeen = false
var bool sellExtremeSeen = false
var bool buySweepSeen = false
var bool sellSweepSeen = false
var int buyZoneCount = 0
var int sellZoneCount = 0

extremeLen = math.max(previousExtremeLookback, 1)
sweepLen = math.max(liquiditySweepLookback, 1)
previousLow = ta.lowest(low[1], extremeLen)
previousHigh = ta.highest(high[1], extremeLen)
sweepLow = ta.lowest(low[1], sweepLen)
sweepHigh = ta.highest(high[1], sweepLen)

buyExtremeNow = previousExtremeLookback > 0 and low <= previousLow
sellExtremeNow = previousExtremeLookback > 0 and high >= previousHigh
buySweepNow = liquiditySweepLookback > 0 and low < sweepLow and close > sweepLow
sellSweepNow = liquiditySweepLookback > 0 and high > sweepHigh and close < sweepHigh

if buyZoneEntered
    buyZoneCount += 1
    buyArmed := true
    sellArmed := false
    buyArmBar := bar_index
    buyReactionCount := 0
    sellReactionCount := 0
    buyExtremeSeen := buyExtremeNow
    buySweepSeen := buySweepNow

if sellZoneEntered
    sellZoneCount += 1
    sellArmed := true
    buyArmed := false
    sellArmBar := bar_index
    sellReactionCount := 0
    buyReactionCount := 0
    sellExtremeSeen := sellExtremeNow
    sellSweepSeen := sellSweepNow

if buyArmed
    buyExtremeSeen := buyExtremeSeen or buyExtremeNow
    buySweepSeen := buySweepSeen or buySweepNow

if sellArmed
    sellExtremeSeen := sellExtremeSeen or sellExtremeNow
    sellSweepSeen := sellSweepSeen or sellSweepNow

if buyArmed and bar_index - buyArmBar > maxReactionWaitBars
    buyArmed := false
    buyReactionCount := 0

if sellArmed and bar_index - sellArmBar > maxReactionWaitBars
    sellArmed := false
    sellReactionCount := 0

buyPriceReaction = not requirePriceReaction or close > close[1]
sellPriceReaction = not requirePriceReaction or close < close[1]
buySignalCrossOK = not requireRMISignalCross or ta.crossover(rmi, rmiSignal)
sellSignalCrossOK = not requireRMISignalCross or ta.crossunder(rmi, rmiSignal)

buyReactionBar = buyArmed and bar_index > buyArmBar and rmi > rmi[1] and buyPriceReaction
sellReactionBar = sellArmed and bar_index > sellArmBar and rmi < rmi[1] and sellPriceReaction

if buyArmed
    buyReactionCount := buyReactionBar ? buyReactionCount + 1 : 0
if sellArmed
    sellReactionCount := sellReactionBar ? sellReactionCount + 1 : 0

buyOptionalOK = (previousExtremeLookback == 0 or buyExtremeSeen) and (liquiditySweepLookback == 0 or buySweepSeen)
sellOptionalOK = (previousExtremeLookback == 0 or sellExtremeSeen) and (liquiditySweepLookback == 0 or sellSweepSeen)

rmiRawBuy = enableRMIEntries and enableBuy and buyArmed and buyReactionCount >= reactionBars and buyOptionalOK and buySignalCrossOK
rmiRawSell = enableRMIEntries and enableSell and sellArmed and sellReactionCount >= reactionBars and sellOptionalOK and sellSignalCrossOK

// المصادر تُجمع بـ OR، والفلاتر تُطبَّق على النتيجة. كل المصادر مطفأة افتراضياً،
// فتؤول المعادلة إلى إشارة RMI وحدها وتبقى مطابقة لخط الأساس.
rawBuyEntry = (rmiRawBuy or (enableBuy and mcSourceBuy)) and mcFilterBuyOK
rawSellEntry = (rmiRawSell or (enableSell and mcSourceSell)) and mcFilterSellOK

// ══════════════════════════════════════════════════════════════════
// TRADE STATE / STATISTICS
// ══════════════════════════════════════════════════════════════════
statsActive = statsMode == "All Loaded History" or time >= statsStartTime

var bool active = false
var int side = 0
var float entryPrice = na
var float tpPrice = na
var float slPrice = na
var int entryBar = na
var int lastTradeBar = na
var int lastBuyLossBar = na
var int lastSellLossBar = na

var int wins = 0
var int losses = 0
var int trades = 0
var int buyTrades = 0
var int sellTrades = 0
var int buyWins = 0
var int buyLosses = 0
var int sellWins = 0
var int sellLosses = 0
var int curWin = 0
var int maxWin = 0
var int curLoss = 0
var int maxLoss = 0
var float netPts = 0.0
var float sumWinPts = 0.0
var float sumLossPts = 0.0
var float lastClosedPts = 0.0

var line entryLine = na
var line tpLine = na
var line slLine = na
var label entryTag = na
var label tpTag = na
var label slTag = na

var bool entryBuyPlot = false
var bool entrySellPlot = false
var bool exitTPPlot = false
var bool exitSLPlot = false
var int lastResetKey = manualResetKey
var int lastAlertBar = na

entryBuyPlot := false
entrySellPlot := false
exitTPPlot := false
exitSLPlot := false

f_delete_trade_visuals() =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(entryTag)
        label.delete(entryTag)
    if not na(tpTag)
        label.delete(tpTag)
    if not na(slTag)
        label.delete(slTag)

if manualResetKey != lastResetKey
    f_delete_trade_visuals()
    active := false
    side := 0
    entryPrice := na
    tpPrice := na
    slPrice := na
    entryBar := na
    lastTradeBar := na
    lastBuyLossBar := na
    lastSellLossBar := na
    wins := 0
    losses := 0
    trades := 0
    buyTrades := 0
    sellTrades := 0
    buyWins := 0
    buyLosses := 0
    sellWins := 0
    sellLosses := 0
    curWin := 0
    maxWin := 0
    curLoss := 0
    maxLoss := 0
    netPts := 0.0
    sumWinPts := 0.0
    sumLossPts := 0.0
    lastClosedPts := 0.0
    buyArmed := false
    sellArmed := false
    buyReactionCount := 0
    sellReactionCount := 0
    buyZoneCount := 0
    sellZoneCount := 0
    entryLine := na
    tpLine := na
    slLine := na
    entryTag := na
    tpTag := na
    slTag := na
    lastResetKey := manualResetKey

globalCooldownOK = na(lastTradeBar) or bar_index - lastTradeBar >= cooldownBars
buyCooldownOK = na(lastBuyLossBar) or bar_index - lastBuyLossBar >= buyCooldownBars
sellCooldownOK = na(lastSellLossBar) or bar_index - lastSellLossBar >= sellCooldownBars

canEnterLong = barstate.isconfirmed and not active and globalCooldownOK and buyCooldownOK and rawBuyEntry
canEnterShort = barstate.isconfirmed and not active and globalCooldownOK and sellCooldownOK and rawSellEntry

// A completed RMI setup is consumed immediately. It is never queued behind
// an already open trade. Only the RMI setup disarms the RMI engine — a
// Multicator source firing must not consume an RMI setup that is still valid.
if rmiRawBuy or rmiRawSell
    buyArmed := false
    sellArmed := false
    buyReactionCount := 0
    sellReactionCount := 0

if canEnterLong or canEnterShort
    active := true
    side := canEnterLong ? 1 : -1
    entryPrice := close
    tpPrice := side == 1 ? entryPrice + targetPoints * pointUnit : entryPrice - targetPoints * pointUnit
    slPrice := side == 1 ? entryPrice - stopPoints * pointUnit : entryPrice + stopPoints * pointUnit
    entryBar := bar_index
    lastTradeBar := bar_index

    if statsActive
        if side == 1
            buyTrades += 1
        else
            sellTrades += 1

    entryBuyPlot := side == 1
    entrySellPlot := side == -1

    if showTradeLines
        f_delete_trade_visuals()
        entryLine := line.new(bar_index, entryPrice, bar_index + lineBars, entryPrice, xloc=xloc.bar_index, extend=extend.none, color=EN_C, width=1, force_overlay=true)
        tpLine := line.new(bar_index, tpPrice, bar_index + lineBars, tpPrice, xloc=xloc.bar_index, extend=extend.none, color=TP_C, width=1, force_overlay=true)
        slLine := line.new(bar_index, slPrice, bar_index + lineBars, slPrice, xloc=xloc.bar_index, extend=extend.none, color=SL_C, width=1, force_overlay=true)

        if showLineTags
            entryTag := label.new(bar_index + lineBars, entryPrice, "ENTRY", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=EN_C, textcolor=color.black, size=size.tiny, force_overlay=true)
            tpTag := label.new(bar_index + lineBars, tpPrice, "TP " + str.tostring(targetPoints, "#"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=TP_C, textcolor=TXT_C, size=size.tiny, force_overlay=true)
            slTag := label.new(bar_index + lineBars, slPrice, "SL " + str.tostring(stopPoints, "#"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=SL_C, textcolor=TXT_C, size=size.tiny, force_overlay=true)

if active and bar_index > entryBar
    hitTP = side == 1 ? high >= tpPrice : low <= tpPrice
    hitSL = side == 1 ? low <= slPrice : high >= slPrice
    both = hitTP and hitSL
    skipTrade = both and sameCandleRule == "Skip"
    isWin = both ? (not skipTrade and sameCandleRule == "Target First") : hitTP
    isLoss = both ? (not skipTrade and sameCandleRule == "Stop First") : hitSL

    if isWin or isLoss or skipTrade
        exitPts = skipTrade ? 0.0 : isWin ? targetPoints : -stopPoints
        statsCounted = statsActive and not skipTrade

        if statsCounted
            trades += 1
            netPts += exitPts
            lastClosedPts := exitPts

            if exitPts > 0
                wins += 1
                sumWinPts += exitPts
                curWin += 1
                curLoss := 0
                maxWin := math.max(maxWin, curWin)
                if side == 1
                    buyWins += 1
                else
                    sellWins += 1
                exitTPPlot := true
            else
                losses += 1
                sumLossPts += math.abs(exitPts)
                curLoss += 1
                curWin := 0
                maxLoss := math.max(maxLoss, curLoss)
                if side == 1
                    buyLosses += 1
                    lastBuyLossBar := bar_index
                else
                    sellLosses += 1
                    lastSellLossBar := bar_index
                exitSLPlot := true

        if showSignals and statsCounted
            if isWin
                label.new(bar_index, tpPrice, "TP " + str.tostring(targetPoints, "#"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=TP_C, textcolor=TXT_C, size=size.tiny, force_overlay=true)
            else
                label.new(bar_index, slPrice, "SL " + str.tostring(stopPoints, "#"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=SL_C, textcolor=TXT_C, size=size.tiny, force_overlay=true)

        f_delete_trade_visuals()
        entryLine := na
        tpLine := na
        slLine := na
        entryTag := na
        tpTag := na
        slTag := na
        active := false
        side := 0
        entryPrice := na
        tpPrice := na
        slPrice := na
        entryBar := na

// ══════════════════════════════════════════════════════════════════
// BOT ALERT — uses the exact active entry/TP/SL plan.
// ══════════════════════════════════════════════════════════════════
alertFire = useAlertFunction and barstate.isconfirmed and (canEnterLong or canEnterShort) and (na(lastAlertBar) or lastAlertBar != bar_index)
if alertFire
    lastAlertBar := bar_index
    sideText = side == 1 ? "BUY" : "SELL"
    jsonMessage = '{"key":"' + webhookKey + '","action":"' + sideText + '","side":"' + sideText + '","symbol":"' + botSymbol + '","lot":' + str.tostring(lotSize) + ',"tp_points":' + str.tostring(targetPoints, "#.##") + ',"sl_points":' + str.tostring(stopPoints, "#.##") + ',"target_points":' + str.tostring(targetPoints, "#.##") + ',"stop_points":' + str.tostring(stopPoints, "#.##") + ',"point_unit":' + str.tostring(pointUnit) + ',"entry":' + str.tostring(entryPrice, format.mintick) + ',"tp_price":' + str.tostring(tpPrice, format.mintick) + ',"sl_price":' + str.tostring(slPrice, format.mintick) + ',"entry_model":"RMI_REACTION","indicator":"RMI TRADER","time":"' + str.tostring(time) + '"}'
    simpleMessage = webhookKey + " " + sideText + " " + botSymbol + " MODEL RMI_REACTION LOT " + str.tostring(lotSize) + " TP " + str.tostring(targetPoints, "#.##") + " SL " + str.tostring(stopPoints, "#.##")
    alert(alertFormat == "JSON" ? jsonMessage : simpleMessage, alert.freq_once_per_bar_close)

// ══════════════════════════════════════════════════════════════════
// CHART VISUALS — same visual language as SYR30
// ══════════════════════════════════════════════════════════════════
plotshape(showSignals and statsActive and entryBuyPlot, title="RMI BUY", style=shape.labelup, location=location.belowbar, color=BUY_C, text="BUY", textcolor=TXT_C, size=size.small, force_overlay=true)
plotshape(showSignals and statsActive and entrySellPlot, title="RMI SELL", style=shape.labeldown, location=location.abovebar, color=SELL_C, text="SELL", textcolor=TXT_C, size=size.small, force_overlay=true)
plotshape(showSignals and exitTPPlot, title="RMI TP", style=shape.circle, location=location.abovebar, color=TP_C, text="TP", textcolor=TXT_C, size=size.tiny, force_overlay=true)
plotshape(showSignals and exitSLPlot, title="RMI SL", style=shape.circle, location=location.belowbar, color=SL_C, text="SL", textcolor=TXT_C, size=size.tiny, force_overlay=true)

// ══════════════════════════════════════════════════════════════════
// SYR30-STYLE TABLE — displayed on the main price chart.
// ══════════════════════════════════════════════════════════════════
wr = trades > 0 ? wins * 100.0 / trades : 0.0
avgWinPts = wins > 0 ? sumWinPts / wins : 0.0
avgLossPts = losses > 0 ? sumLossPts / losses : 0.0

var table t = table.new(position.top_right, 2, 17, bgcolor=TBL_BG, border_width=0, frame_color=color.new(color.black, 100), frame_width=0)

if showTable and barstate.islast
    table.cell(t, 0, 0, "RMI", text_color=color.white, bgcolor=TBL_BG_HEAD, text_size=size.small)
    table.cell(t, 1, 0, "REACTION | HARD TP/SL", text_color=EN_C, bgcolor=TBL_BG_HEAD, text_size=size.small)

    table.cell(t, 0, 1, "Win", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(wins), text_color=BUY_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 2, "Loss", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(losses), text_color=SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 3, "WR", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(wr, "#.##") + "%", text_color=wr >= 60 ? BUY_C : wr >= 55 ? EN_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 4, "Net", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(netPts, "#.##"), text_color=netPts >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 5, "Max W", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(maxWin), text_color=BUY_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 6, "Max L", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(maxLoss), text_color=maxLoss <= 9 ? EN_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 7, "Avg TP", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 7, str.tostring(avgWinPts, "#.##"), text_color=BUY_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 8, "Avg SL", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 8, str.tostring(avgLossPts, "#.##"), text_color=SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 9, "Last", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 9, (lastClosedPts > 0 ? "+" : "") + str.tostring(lastClosedPts, "#.##"), text_color=lastClosedPts >= 0 ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 10, "From", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 10, statsMode == "All Loaded History" ? "ALL" : str.format_time(statsStartTime, "dd MMM HH:mm 'UTC'", "UTC"), text_color=EN_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 11, "Manager", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 11, mcActiveCount == 0 ? "RMI ONLY" : "RMI + " + str.tostring(mcActiveCount) + " MC", text_color=mcActiveCount == 0 ? BUY_C : EN_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 12, "BUY W/L", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 12, str.tostring(buyWins) + "/" + str.tostring(buyLosses), text_color=buyWins >= buyLosses ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 13, "SELL W/L", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 13, str.tostring(sellWins) + "/" + str.tostring(sellLosses), text_color=sellWins >= sellLosses ? BUY_C : SELL_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 14, "Open", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 14, active ? (side == 1 ? "BUY" : "SELL") : "-", text_color=active ? (side == 1 ? BUY_C : SELL_C) : WAIT_C, bgcolor=TBL_BG_ROW2, text_size=size.small)

    table.cell(t, 0, 15, "Zone B/S", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW, text_size=size.small)
    table.cell(t, 1, 15, str.tostring(buyZoneCount) + "/" + str.tostring(sellZoneCount), text_color=(buyZoneCount + sellZoneCount) > 0 ? EN_C : WAIT_C, bgcolor=TBL_BG_ROW, text_size=size.small)

    table.cell(t, 0, 16, "RMI / Sig", text_color=color.rgb(220, 225, 235), bgcolor=TBL_BG_ROW2, text_size=size.small)
    table.cell(t, 1, 16, str.tostring(rmi, "#.##") + " / " + str.tostring(rmiSignal, "#.##"), text_color=rmi >= rmiOverbought ? SELL_C : rmi <= rmiOversold ? BUY_C : EN_C, bgcolor=TBL_BG_ROW2, text_size=size.small)
else if not showTable and barstate.islast
    table.clear(t, 0, 0, 1, 16)

alertcondition(canEnterLong, "RMI BUY", "RMI BUY | REACTION | HARD TP/SL")
alertcondition(canEnterShort, "RMI SELL", "RMI SELL | REACTION | HARD TP/SL")
