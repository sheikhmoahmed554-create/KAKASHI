//@version=6
// KAKASHI R1 — بُني من القياس لا من الرأي.
//
// كل رقم هنا مأخوذ من تجارب موثّقة في research/results/JOURNAL.md على
// ١,٢٠٨,١٨١ شمعة دقيقة من ٢٠٢١ و٢٠٢٣ و٢٠٢٥ و٢٠٢٦، ولا يُقبل رقم لم يصمد
// في السنوات الأربع.
//
// القواعد الملزمة (research/REQUIREMENTS.md):
//   • فريم الدقيقة حصراً، ولا استدعاء لأي فريم أعلى — لا إعادة رسم إطلاقاً
//   • الدخول عند إغلاق الشمعة المؤكدة فقط
//   • صفقة واحدة مفتوحة
//   • الهدف والستوب يُثبَّتان عند الدخول ولا يتحركان
//   • لا رقم مطلق: كل عتبة مضاعف ATR، فتتكيّف مع سرعة السوق تلقائياً
//
// أرقام مقاسة مستعملة هنا:
//   بوابة التذبذب      ATR ≥ ٣٠ نقطة   (تجربة ٠٣٣: تحتها الحافة سالبة)
//   عمق السحب          ≥ ٠.٨×ATR       (تجربة ٠٣١: +٢.٣ إلى +٣.٧ في أربع سنوات)
//   السحب العميق       ≥ ٢.٠×ATR       (تجربة ٠٣١: +٤.٢ في أضعف سنة)
//   منع البيع          RSI14 > ٨٥      (تجربة ٠٣١: −٥.١ إلى −٨.٧، أقوى أثر مقاس)
//   مرشّح الإغلاق      ليس في أعلى ٢٠٪ (تجربة ٠٣١: −٠.٣ إلى −٥.٥)
//   مرشّح المسار       القمة قبل القاع  (تجربة ٠٣١: +٠.٦ إلى +٢.٢)

indicator("KAKASHI R1", shorttitle="KAKASHI R1", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// ═══════════════════ المدخلات ═══════════════════
G_ENG = "المحرك — قراءة السوق"
G_ENT = "الدخول"
G_FIL = "المرشّحات"
G_EXI = "الخروج"
G_STA = "الإحصاء"

atrLen        = input.int(14,   "طول ATR", minval=2, group=G_ENG)
minAtrPts     = input.float(30, "بوابة التذبذب — أقل ATR بالنقاط", minval=0, step=1, group=G_ENG)
regimeLen     = input.int(240,  "طول متوسط التذبذب البعيد", minval=20, group=G_ENG)
trendLen      = input.int(120,  "طول قياس الاتجاه", minval=10, group=G_ENG)

sweepLen      = input.int(20,   "نافذة القاع للسحب", minval=5, group=G_ENT)
sweepMin      = input.float(0.8,  "أقل عمق سحب × ATR", minval=0.0, step=0.05, group=G_ENT)
sweepDeep     = input.float(2.0,  "عمق السحب القوي × ATR", minval=0.0, step=0.05, group=G_ENT)
useDeepOnly   = input.bool(false, "الاكتفاء بالسحب القوي فقط", group=G_ENT)

useCloseFilter= input.bool(true,  "منع الدخول إذا أغلقت الشمعة في أعلى مداها", group=G_FIL)
closeMaxPct   = input.float(80,   "حد موضع الإغلاق ٪", minval=0, maxval=100, step=5, group=G_FIL)
usePathFilter = input.bool(true,  "اشتراط سبق القمة للقاع في آخر ٣ شمعات", group=G_FIL)
useEmaFilter  = input.bool(false, "اشتراط البعد تحت EMA50", group=G_FIL)
emaFarATR     = input.float(5.0,  "البعد تحت EMA50 × ATR", minval=0, step=0.5, group=G_FIL)
useRsiFilter  = input.bool(false, "اشتراط تشبع بيعي RSI7", group=G_FIL)
rsiBuyMax     = input.float(15,   "حد RSI7 للشراء", minval=1, maxval=99, group=G_FIL)
rsiSellBlock  = input.float(85,   "منع البيع فوق RSI14", minval=1, maxval=99, group=G_FIL)

targetATR     = input.float(1.0,  "الهدف × ATR", minval=0.1, step=0.1, group=G_EXI)
stopRatio     = input.float(1.3,  "الستوب ÷ الهدف", minval=0.1, step=0.05, group=G_EXI)
minTargetPts  = input.float(30,   "أقل هدف بالنقاط", minval=0, step=1, group=G_EXI)
maxTargetPts  = input.float(60,   "أقصى هدف بالنقاط", minval=1, step=1, group=G_EXI)
maxStopGap    = input.float(20,   "أقصى بُعد للستوب فوق الهدف", minval=0, step=1, group=G_EXI)
maxHoldBars   = input.int(480,    "أقصى مدة للصفقة بالشموع", minval=10, group=G_EXI)

pointUnit     = input.float(0.10, "وحدة النقطة بالدولار", minval=0.0001, step=0.01, group=G_STA)
statsMode     = input.string("All Data", "بداية الإحصاء", options=["All Data", "From Custom Time"], group=G_STA)
statsStartTime= input.int(1609459200000, "وقت بداية الإحصاء (ميلي ثانية UTC)", group=G_STA)
showMarks     = input.bool(true,  "إظهار العلامات", group=G_STA)

// ═══════════════════ المحرك: قراءة السوق ═══════════════════
atrPts   = ta.atr(atrLen) / pointUnit
atrLong  = ta.sma(atrPts, regimeLen)
regime   = atrLong > 0 ? atrPts / atrLong : 1.0          // انكماش تحت ١، توسع فوقها
slopeATR = atrPts > 0 ? (close - close[trendLen]) / pointUnit / atrPts : 0.0
ema20    = ta.ema(close, 20)
ema50    = ta.ema(close, 50)
rsi7     = ta.rsi(close, 7)
rsi14    = ta.rsi(close, 14)

// بوابة التذبذب: تحت العتبة لا حافة، فيصمت المؤشر بدل أن يفتح صفقات لا تصل
speedOK  = atrPts >= minAtrPts

marketState = not speedOK ? "سوق بطيء — خارج العتبة" : slopeATR < -3 ? "هبوط قائم" : slopeATR > 3 ? "صعود قائم" : regime < 0.8 ? "انكماش" : "نطاق"

// ═══════════════════ الدخول ═══════════════════
prevLow   = ta.lowest(low, sweepLen)[1]
sweepPts  = na(prevLow) or atrPts <= 0 ? na : (prevLow - low) / pointUnit / atrPts
sweptNow  = not na(sweepPts) and low < prevLow
sweepOK   = sweptNow and sweepPts >= (useDeepOnly ? sweepDeep : sweepMin)

// مرشّح الإغلاق: الدخول والسعر قرب القاع أفضل من انتظار شمعة ارتداد قوية
barRange  = math.max(high - low, syminfo.mintick)
closePos  = 100.0 * (close - low) / barRange
closeOK   = not useCloseFilter or closePos <= closeMaxPct

// مرشّح المسار: أي الطرفين تشكّل أولاً خلال آخر ثلاث شمعات
hi3i = high[2] >= high[1] and high[2] >= high ? 2 : high[1] >= high ? 1 : 0
lo3i = low[2]  <= low[1]  and low[2]  <= low  ? 2 : low[1]  <= low  ? 1 : 0
pathOK = not usePathFilter or hi3i > lo3i

emaOK = not useEmaFilter or (atrPts > 0 and (close - ema50) / pointUnit / atrPts <= -emaFarATR)
rsiOK = not useRsiFilter or rsi7 <= rsiBuyMax

buyRaw  = speedOK and sweepOK and closeOK and pathOK and emaOK and rsiOK
sellRaw = false                                   // لم يصمد أي شرط بيع في أربع سنوات
sellRaw := sellRaw and rsi14 <= rsiSellBlock      // المنع المقاس، محفوظ للتوثيق

// سبب الدخول بالكلام — لا صفقة بلا جملة تفسّرها
entryReason = buyRaw ? "سحب " + str.tostring(sweepPts, "#.##") + "×ATR تحت قاع " + str.tostring(sweepLen) + " • " + marketState + " • ATR " + str.tostring(atrPts, "#") + " نقطة" : ""

// ═══════════════════ حالة الصفقة ═══════════════════
var bool  active     = false
var int   side       = 0
var float entryPrice = na
var float tpPrice    = na
var float slPrice    = na
var float tradeTargetPts = na
var float tradeStopPts   = na
var int   entryBar   = na
var string tradeEntrySource = ""
var int    tradeEntrySourceCode = 0
var string tradeReason = ""

statsActive = statsMode == "All Data" or time >= statsStartTime

canEnterLong  = barstate.isconfirmed and not active and buyRaw
canEnterShort = barstate.isconfirmed and not active and sellRaw
tradeDecisionSide = canEnterLong and canEnterShort ? 0 : canEnterLong ? 1 : canEnterShort ? -1 : 0

// خطة الخروج: مضاعف ATR، ثم قيود صاحب المشروع بالنقاط
planTarget = math.min(math.max(targetATR * atrPts, minTargetPts), maxTargetPts)
planStop   = math.min(math.max(stopRatio * planTarget, planTarget + 1), planTarget + maxStopGap)

bool isWin  = false
bool isLoss = false
bool skipTrade = false
bool hardExit  = false

if active
    buy = side == 1
    tpHit = buy ? high >= tpPrice : low  <= tpPrice
    slHit = buy ? low  <= slPrice : high >= slPrice
    if tpHit and slHit
        // الهدف والستوب في شمعة واحدة: الستوب يفوز، كما تفعل TradingView
        isLoss := true
        active := false
    else if slHit
        isLoss := true
        active := false
    else if tpHit
        isWin := true
        active := false
    else if not na(entryBar) and bar_index - entryBar >= maxHoldBars
        hardExit := true
        skipTrade := true
        active := false

if not active and tradeDecisionSide != 0 and barstate.isconfirmed
    side       := tradeDecisionSide
    entryPrice := close
    tradeTargetPts := planTarget
    tradeStopPts   := planStop
    tpPrice    := side == 1 ? close + planTarget * pointUnit : close - planTarget * pointUnit
    slPrice    := side == 1 ? close - planStop   * pointUnit : close + planStop   * pointUnit
    entryBar   := bar_index
    tradeEntrySource := "SWEEP"
    tradeEntrySourceCode := 1
    tradeReason := entryReason
    active     := true

// ═══════════════════ الإحصاء ═══════════════════
var int   trades = 0
var int   wins   = 0
var int   losses = 0
var float netPts = 0.0
var float sumWinPts  = 0.0
var float sumLossPts = 0.0
var int   curWin = 0
var int   curLoss = 0
var int   maxWin = 0
var int   maxLoss = 0
var float lastClosedPts = 0.0

if statsActive and (isWin or isLoss)
    trades += 1
    if isWin
        wins   += 1
        netPts += tradeTargetPts
        sumWinPts += tradeTargetPts
        lastClosedPts := tradeTargetPts
        curWin  += 1
        curLoss := 0
    else
        losses += 1
        netPts -= tradeStopPts
        sumLossPts += tradeStopPts
        lastClosedPts := -tradeStopPts
        curLoss += 1
        curWin  := 0
    maxWin  := math.max(maxWin, curWin)
    maxLoss := math.max(maxLoss, curLoss)

// أسماء تتوقعها منصة V16 — بدونها تعطي صفر صفقات بصمت
sy348EntryBuyPlot  = statsActive and canEnterLong
sy348EntrySellPlot = statsActive and canEnterShort
sy348ExitTPPlot    = statsActive and isWin
sy348ExitSLPlot    = statsActive and isLoss
tradeKind = 1

// ═══════════════════ العرض ═══════════════════
plot(ema20, "EMA20", color=color.new(color.blue, 60))
plot(ema50, "EMA50", color=color.new(color.orange, 60))
plot(showMarks ? prevLow : na, "قاع النافذة", color=color.new(color.gray, 40), style=plot.style_stepline)
plotshape(showMarks and sy348EntryBuyPlot, title="دخول شراء", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(showMarks and sy348ExitTPPlot, title="هدف", style=shape.xcross, location=location.abovebar, color=color.new(color.green, 0), size=size.tiny)
plotshape(showMarks and sy348ExitSLPlot, title="ستوب", style=shape.xcross, location=location.belowbar, color=color.new(color.red, 0), size=size.tiny)
bgcolor(showMarks and not speedOK ? color.new(color.gray, 92) : na, title="خارج بوابة التذبذب")

if showMarks and sy348EntryBuyPlot
    label.new(bar_index, low, tradeReason, style=label.style_label_up, size=size.tiny, color=color.new(color.teal, 20), textcolor=color.white)

plot(active ? tpPrice : na, "الهدف", color=color.new(color.green, 0), style=plot.style_linebr)
plot(active ? slPrice : na, "الستوب", color=color.new(color.red, 0), style=plot.style_linebr)
